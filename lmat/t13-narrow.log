.","tags":["transport","guild","trade"],"priorityCategory":"government","source":"generated","catalogId":"caravaneer_s_post"},{"category":"Economy","name":"Jeweller","required":false,"baseChance":0.3,"desc":"Sets precious metal and gemstones into rings, necklaces, seals, and other luxuries. He works to commission, values stones, and now and then buys from customers who keep quiet about provenance.","tags":["luxury","trade"],"priorityCategory":"government","source":"generated","catalogId":"jeweller"},{"category":"Economy","name":"Vintner","required":false,"baseChance":0.2,"desc":"Makes and ages wine, whether from grapes grown near or must brought in. He sells by the barrel to taverns and by the bottle to the rich. Where no vine grows, he imports and blends instead.","tags":["food","trade"],"priorityCategory":"government","source":"generated","catalogId":"vintner"},{"category":"Crafts","name":"Mills (2-5)","required":true,"baseChance":1,"desc":"Multiple mills for grain, fulling cloth.","tags":["essential"],"priorityCategory":"economy","source":"required","catalogId":"mills_2_5"},{"category":"Crafts","name":"Blacksmiths (3-10)","required":false,"baseChance":0.95,"desc":"Multiple smiths with specializations.","tags":["metalwork"],"priorityCategory":"crafts","source":"generated","catalogId":"blacksmiths_3_10"},{"category":"Crafts","name":"Carpenters (5-15)","required":false,"baseChance":0.9,"desc":"They raise buildings and craft furniture both.","tags":[],"priorityCategory":"crafts","source":"generated","catalogId":"carpenters_5_15"},{"category":"Crafts","name":"Weavers/Textile workers","required":false,"baseChance":0.8,"desc":"The making of cloth, usually under a guild.","tags":["textile"],"priorityCategory":"crafts","source":"generated","catalogId":"weavers_textile_workers"},{"category":"Crafts","name":"Tanners","required":false,"exclusiveGroup":"tanneryScale","baseChance":0.7,"desc":"Leather-making. Kept downstream and downwind wherever the ground allows.","tags":["leather"],"priorityCategory":"crafts","source":"generated","catalogId":"tanners"},{"category":"Crafts","name":"Butchers (3-8)","required":false,"baseChance":0.85,"desc":"Meat dressed and sold, under close regulation.","tags":["food"],"priorityCategory":"crafts","source":"generated","catalogId":"butchers_3_8"},{"category":"Crafts","name":"Bakers (5-15)","required":false,"baseChance":0.9,"desc":"Bread baked for sale, with the guild setting the price.","tags":["food"],"priorityCategory":"crafts","source":"generated","catalogId":"bakers_5_15"},{"category":"Crafts","name":"Apothecary (established)","required":false,"baseChance":0.8,"desc":"A proper shop kept by a trained herbalist, its shelves stocked and a back room set aside for consultations. It sells herbalism kit supplies, common antidotes, medicinal herbs, and basic surgical dressings. A few of its keepers also work as chirurgeons.","tags":["healing","trade"],"priorityCategory":"crafts","source":"generated","catalogId":"apothecary_established"},{"category":"Crafts","name":"Bowyers & fletchers (guild)","required":false,"baseChance":0.75,"desc":"A guild of bowyers and fletchers. Arrows come by the sheaf, broadheads to specialty, and composite bows on commission. Enough to resupply the caravans and outfit the militias.","tags":["military","trade"],"priorityCategory":"crafts","source":"generated","catalogId":"bowyers_fletchers_guild"},{"category":"Crafts","name":"Smelter","required":false,"baseChance":0.35,"desc":"Refines crude ore into workable metal over charcoal fire. The industrial step from what the mine yields to what the smith uses.","tags":["trade"],"priorityCategory":"crafts","source":"generated","catalogId":"smelter"},{"category":"Crafts","name":"Sawmill (commercial)","required":false,"baseChance":0.28,"desc":"A water- or ox-powered mill producing planks and beams for the construction trade. A town near timber can supply an entire region's building needs. Employs a permanent crew.","tags":["trade"],"priorityCategory":"crafts","source":"generated","catalogId":"sawmill_commercial"},{"category":"Crafts","name":"Brewery","required":false,"baseChance":0.45,"desc":"A brewery working at commercial scale. It keeps the taverns stocked and sends beer across the region, and stands among the larger buyers of grain and employers in the town.","tags":["trade"],"priorityCategory":"crafts","source":"generated","catalogId":"brewery"},{"category":"Crafts","name":"Cobbler's guild","required":false,"baseChance":0.5,"desc":"A guild of shoemakers turning out boots, shoes, and sandals for the townsfolk. Its quality is strictly regulated.","tags":["guild","trade"],"priorityCategory":"crafts","source":"generated","catalogId":"cobbler_s_guild"},{"category":"Crafts","name":"Tailor's guild","required":false,"baseChance":0.55,"desc":"Master clothiers producing garments from finished cloth. Produces everything from working clothes to livery.","tags":["guild","trade"],"priorityCategory":"crafts","source":"generated","catalogId":"tailor_s_guild"},{"category":"Crafts","name":"Glassblower","required":false,"baseChance":0.25,"desc":"Small-scale glasswork: bottles, window panes, goblets. Requires silica sand, potash, and a skilled furnace operator.","tags":["trade"],"priorityCategory":"crafts","source":"generated","catalogId":"glassblower"},{"category":"Crafts","name":"Town crier","required":false,"baseChance":0.45,"desc":"At fixed times he stands in the market square and calls out the proclamations, the prices, and the news. His employer is the town, or else a guild.","tags":["guild"],"priorityCategory":"government","source":"generated","catalogId":"town_crier"},{"category":"Religious","name":"Parish churches (2-5)","required":true,"baseChance":1,"desc":"The town divided among a handful of parishes.","tags":["essential","religious","church"],"priorityCategory":"religion","source":"required","catalogId":"parish_churches_2_5"},{"category":"Religious","name":"Parish burial grounds","required":true,"baseChance":1,"desc":"Each parish keeps its own ground beside its church, and a parish that has filled its ground buries beyond the gate instead. The sexton holds the register of who lies where, which is the town's longest unbroken record and the one it reaches for in an inheritance dispute. Guilds buy plots together so their members lie among their trade.","tags":["essential","religious"],"priorityCategory":"religion","source":"required","catalogId":"parish_burial_grounds"},{"category":"Government","name":"Mayor and council","required":false,"exclusiveGroup":"government","baseChance":0.5,"desc":"A mayor and council, come to office by vote or appointment.","tags":["civic"],"priorityCategory":"government","source":"generated","catalogId":"mayor_and_council"},{"category":"Defense","name":"Town watch","required":true,"exclusiveGroup":"civilianDefense","baseChance":1,"desc":"Part-time guards. Night patrol and gate duty.","tags":["law_enforcement","defense"],"priorityCategory":"military","source":"required","catalogId":"town_watch"},{"category":"Adventuring","name":"Merchant warehouses","required":false,"baseChance":0.65,"desc":"Storage for merchants' goods held back for sale, transit, or the season's distribution. No trade-route settlement does without it.","tags":["trade","trade"],"priorityCategory":"economy","source":"generated","catalogId":"merchant_warehouses"},{"category":"Adventuring","name":"Hireling hall","required":false,"baseChance":0.5,"desc":"A board hiring out torchbearers at 1 in gold a session and porters at 5.","tags":[],"priorityCategory":"adventuring","source":"generated","catalogId":"hireling_hall"},{"category":"Adventuring","name":"Charlatan fortune tellers","required":false,"baseChance":0.3,"desc":"Non-magical 'divination' using Deception. 1-5 in gold.","tags":[],"priorityCategory":"adventuring","source":"generated","catalogId":"charlatan_fortune_tellers"},{"category":"Criminal","name":"Front businesses","required":false,"baseChance":0.45,"desc":"Honest-looking trades that mask the dishonest kind.","tags":["criminal"],"priorityCategory":"criminal","source":"generated","catalogId":"front_businesses"},{"category":"Criminal","name":"Underground network","required":false,"baseChance":0.15,"desc":"A network of excavated passages joining cellars and yards to the town's edge. None of it on any map.","tags":["criminal","smuggling","underground"],"priorityCategory":"criminal","facets":{"clandestine":"clandestine","subterranean":"subterranean"},"forbiddenResources":["marshlands","fertile_floodplain"],"source":"generated","catalogId":"underground_network"},{"category":"Entertainment","name":"Traveling performers","required":false,"baseChance":0.8,"desc":"The fairs bring bards, jugglers, and acrobats through.","tags":[],"priorityCategory":"entertainment","source":"generated","catalogId":"traveling_performers"},{"category":"Entertainment","name":"Brothel","required":false,"baseChance":0.5,"desc":"A house of prostitution, suffered or regulated.","tags":[],"priorityCategory":"entertainment","source":"generated","catalogId":"brothel"},{"category":"Infrastructure","name":"Town hall","required":true,"baseChance":1,"desc":"Where the town meets and its business is done.","tags":["civic"],"priorityCategory":"infrastructure","source":"required","catalogId":"town_hall"},{"category":"Infrastructure","name":"Small prison/stocks","required":false,"baseChance":0.7,"desc":"Holding cells and public punishment.","tags":["legal","law_enforcement"],"priorityCategory":"infrastructure","source":"generated","catalogId":"small_prison_stocks"},{"category":"Infrastructure","name":"Housing (180-1000 structures)","required":true,"baseChance":1,"desc":"Buildings of several storeys, in timber and stone.","tags":["essential","housing"],"priorityCategory":"infrastructure","source":"required","catalogId":"housing_180_1000_structures"},{"category":"Infrastructure","name":"Multiple water sources","required":true,"baseChance":1,"exclusiveGroup":"waterSupply","desc":"