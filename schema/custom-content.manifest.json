{
  "manifestVersion": "2026-08-02.1",
  "purpose": "The icon-free, category-aware authority for custom-content authoring, compiler admission, and effect truth.",
  "effectKinds": [
    "mechanical",
    "presentation"
  ],
  "activationKinds": [
    "always",
    "conditional"
  ],
  "authorableBuckets": [
    "institutions",
    "services",
    "resources",
    "stressors",
    "tradeGoods",
    "factions",
    "deities",
    "traditions"
