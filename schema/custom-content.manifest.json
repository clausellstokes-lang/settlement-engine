  "schemas": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "shortText": {
      "type": "string",
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "maxLength": 100
    },
    "stringList": {
      "type": "string-or-string-list",
      "maxItems": 40,
      "itemMaxLength": 160
    },
    "reference": {
      "type": "string-or-string-list",
      "maxItems": 80,
      "itemMaxLength": 240
    },
    "boolean": {
      "type": "boolean"
    },
    "tier": {
      "type": "enum",
      "values": [
        "thorp",
        "hamlet",
        "village",
        "town",
        "city",
        "metropolis"
      ]
    },
    "authority": {
      "type": "enum",
