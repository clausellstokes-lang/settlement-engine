onger."},"institution":{"kind":"house","key":"Dyer","family":"Dyer","title":"the dyer","veiled":false},"memberships":[{"power":"Craft Guilds","rank":null,"share":1,"veiled":false}],"importance":"minor","structuralRank":"member"},{"id":"npc_tailor_s_guild","name":"Midori Xu","gender":"female","role":"the tailor","title":"the tailor","category":"other","personality":{"dominant":"humble","flaw":"stubborn","modifier":"superstitious","tell":"never eats or drinks anything offered by a stranger without watching others first","speech":"Ends disagreements by restating the other position, slightly wrong"},"physical":{"age":"late forties","build":"lean and wiry","feature":"teeth that have been replaced with metal","clothes":"weathered gear maintained past the point of economy"},"goal":{"short":"Beat Jong Inoue at something this season, in front of people who matter.","long":"Reach the top of Craft Guilds by the long road, one earned favour at a time.","intent":{"short":{"family":"TIES","kind":"rival_enemy","key":"settle_rivalry","target":{"kind":"npc","id":"npc_inn_multiple"}},"long":{"family":"RANK","kind":"enter","key":"secure_office","target":{"kind":"power","id":"Craft Guilds"}}}},"secret":{"what":"Made a wedding coat for a man who never paid, then told the bride's family about his other debts out of spite","stakes":"The marriage fell apart, and the families have never learned who started the talk"},"plotHooks":["Their son has been seen at night with people who do not work, and comes home with coin."],"influence":"low","power":1,"presentation":{"impression":"Quietly attentive. Remembers everyone who has stood in the fitting room.","disposition":"cautious","behaviour":"Says little about other customers; asks a little about you."},"institution":{"kind":"house","key":"Tailor's guild","family":"Tailor's guild","title":"the tailor","veiled":false},"memberships":[{"power":"Craft Guilds","rank":null,"share":1,"veiled":false}],"importance":"minor","structuralRank":"member"},{"id":