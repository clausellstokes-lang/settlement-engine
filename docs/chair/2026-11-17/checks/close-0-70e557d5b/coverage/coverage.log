egory":"magic","personality":{"dominant":null,"flaw":"overbearing","modifier":"mercurial","tell":"unconsciously mimics the posture of whoever they're speaking to","speech":"Talks to everyone in the room except the person the answer is for"},"physical":{"age":"mid-forties","build":"compact and powerful","feature":"a ring on every finger","clothes":"practical dress with chalk dust in every seam"},"goal":{"short":"Beat Merchant Guilds to the next opportunity, and win the credit for Craft Guilds.","long":"Outlast Ulfhéðinn Olafsson, and be the one still standing.","intent":{"short":{"family":"POWER","kind":"competitive","key":"expand_influence","target":{"kind":"power","id":"Merchant Guilds"}},"long":{"family":"TIES","kind":"rival_enemy","key":"settle_rivalry","target":{"kind":"npc","id":"npc_stable_district"}}}},"secret":{"what":"Was present when Walpurga Ormsson did something they've never accounted for publicly. Neither has acknowledged the other was there","stakes":"The situation they're both ignoring is becoming relevant again"},"plotHooks":["They have two competing theories about what is happening to magic in this region. Both are alarming."],"influence":"low","power":3,"presentation":{"impression":"Elsewhere, mentally. The conversation is happening in the foreground while something else has most of their attention.","disposition":"dismissive","behaviour":"Barely looks up; you are plainly beneath their notice."},"institution":{"kind":"house","key":"Alchemist shop","family":"Alchemist quarter","title":"the alchemist","veiled":false},"memberships":[{"power":"Craft Guilds","rank":null,"share":1,"veiled":false}],"importance":"minor","structuralRank":"member"},{"id":"npc_cooper","name":"Yngvi Mordsson","gender":"male","role":"the cooper","title":"the cooper","category":"other","personality":{"dominant":"wise","flaw":"hypocritical","modifier":"perfectionist","tell":"never volunteers information, only answers what is asked","speech":"Pauses mid-sentence to choose words with visible care"},"physical":{"age":"early sixties","build":"heavyset and solid","feature":"teeth that have been replaced with metal","clothes":"travel-worn but well-maintained gear"},"goal":{"short":"Learn why people favour Merchant Guilds, and do better for Craft Guilds.","long":"Protect Torvald Gormsson from anyone who would bring them down.","intent":{"short":{"family":"POWER","kind":"competitive","key":"expand_influence","target":{"kind":"power","id":"Merchant Guilds"}},"long":{"family":"TIES","kind":"ally","key":"protect_ally","target":{"kind":"npc","id":"npc_fuller"}}}},"secret":{"what":"Has been sleeping with the wife of the man who buys most of the shop's barrels","stakes":"The shop would lose its best customer, and the cooper might lose more than that"},"plotHooks":["Their spouse has been making payments to someone every month for years, and will not say who."],"influence":"low","power":2,"presentation":{"impression":"Short and busy. The yard is full of half-made casks and every one is late.","disposition":"dismissive","behaviour":"Takes orders and gives dates; little time for anything else."},"institution":{"kind":"house","key":"Cooper","family":"Cooper","title":"the cooper","veiled":false},"memberships":[{"power":"Craft Guilds","rank":null,"share":1,"veiled":false}],"importance":"minor","structuralRank":"member"},{"id":"npc_parish_churches_2_5","name":"Thorvald Styrkarsson","gender":"male","role":"the dean","title":"the dean","category":"religious","personality":{"dominant":null,"flaw":"dismissive","modifier":"cynical","tell":"makes deliberate, theatrical eye contact to assert dominance","speech":"Uses the formal royal 'we' (old habit from a previous station)"},"physical":{"age":"late thirties","build":"lean and wiry","feature":"a prosthetic hand, finely crafted","clothes":"lay clothes with the collar of the order left visible"},"goal":{"short":"Have the last word in the next argument that matters.","long":"Make the houses of worship so needed by those who govern that no one dares touch the rights of the house.","intent":{"short":{"family":"PERSONALITY","kind":"sway","key":"indulge_trait","target":null},"long":{"family":"INSTITUTION","kind":"charter","key":"control_institution","target":{"kind":"house","id":"Parish churches (2-5)"}}}},"secret":{"what":"The goods they sell as locally produced are sourced from somewhere with exploitative labour practices","stakes":"The premium they charge depends entirely on the lie holding"},"plotHooks":["The holy relic in their keeping is not what everyone believes it is. Only they know this."],"influence":"moderate","power":6,"presentation":{"impression":"Watchful, in a religious way: not suspicious, but as though taking a reading.","disposition":"cautious","behaviour":"Keeps you at a distance, and makes you prove you are worth their time."},"institution":{"kind":"house","key":"Parish churches (2-5)","family":"Access to parish church","title":"the dean","veiled":false},"memberships":[],"importance":"minor","structuralRank":"unaffiliated"},{"id":"npc_charlatan_fortune_tellers","name":"Asger Torvaldsson","gender":"male","role":"the fortune teller","title":"the fortune teller","category":"other","personality":{"dominant":"astute","flaw":"domineering","modifier":"detached","tell":"never eats or drinks anything offered by a stranger without watching others first","speech":"Speaks as if dictating a letter, formal even in crisis"},"physical":{"age":"late sixties","build":"lean and wiry","feature":"a branded mark they keep covered","clothes":"whatever was available (they don't care about dress)"},"goal":{"short":"Keep the friendship with Vidar Andersson quiet, where it does the most good.","long":"Be the person everyone here defers to.","intent":{"short":{"family":"TIES","kind":"ally","key":"protect_ally","target":{"kind":"npc","id":"npc_salt_works"}},"long":{"family":"PERSONALITY","kind":"sway","key":"indulge_trait","target":null}}},"secret":{"what":"Has been telling a rich widow that her dead husband wants her money given to the fortune teller","stakes":"The widow's children have noticed their inheritance shrinking, and have started asking where it goes"},"plotHooks":["Something they were told had been burned has turned up for sale."],"influence":"low","power":2,"presentation":{"impression":"Scarves, bangles and a low, warm voice. Calls you by a name you did not give.","disposition":"welcoming","behaviour":"Offers a reading at a small price, and learns a great deal about you during it."},"institution":{"kind":"house","key":"Charlatan fortune tellers","family":"Charlatan fortune tellers","title":"the fortune teller","veiled":false},"memberships":[],"importance":"minor","structuralRank":"unaffiliated"}],"relationships":[{"id":"tie_npc_merchant_guilds_3_8","from":"npc_merchant_guilds_3_8","to":"npc_river_ferry","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Bjorn Sigvaldsson paid Freya Ljotsson's bail eleven years ago and has never mentioned it. Freya Ljotsson mentions it to no one.","tension":"Bjorn Sigvaldsson has asked Freya Ljotsson for a vote against Freya Ljotsson's own interests. It is the first payment Bjorn Sigvaldsson has asked for.","strength":"crushing","npc1Name":"Freya Ljotsson","npc2Name":"Bjorn Sigvaldsson","npc1Role":"Burgomaster","npc2Role":"the ferryman","archetypeKey":"old_debt","proseVariant":3,"flagDriven":false},{"id":"tie_npc_barge_and_river_transport_company","from":"npc_barge_and_river_transport_company","to":"npc_veiled_e01881c4d24ae7e3","type":"patron_client","typeName":"Commercial Complicity","description":"Ulfric Snorrason's account books look clean because Jarl Asgautsson keeps certain sales out of them. Both of them grow richer for it.","tension":"A clerk has begun checking Ulfric Snorrason's ledgers against each other. Neither Ulfric Snorrason nor Jarl Asgautsson has decided what to do about it.","strength":"significant","npc1Name":"Ulfric Snorrason","npc2Name":"Jarl Asgautsson","npc1Role":"the barge master","npc2Role":"the gang boss","archetypeKey":"econ_crim_blur","proseVariant":1,"flagDriven":true},{"id":"tie_npc_craft_guilds_5_15","from":"npc_craft_guilds_5_15","to":"npc_weavers_textile_workers","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Rorik Mordsson owes Kjara Eindriðason a large sum in coin, borrowed in a bad year and repaid in small amounts ever since.","tension":"Rorik Mordsson has offered to clear what is left of the debt in one payment. Kjara Eindriðason would rather be repaid in favours.","strength":"crushing","npc1Name":"Rorik Mordsson","npc2Name":"Kjara Eindriðason","npc1Role":"the senior craft-guild master","npc2Role":"the master weaver","archetypeKey":"old_debt","proseVariant":4,"flagDriven":false},{"id":"tie_npc_veiled_e01881c4d24ae7e3","from":"npc_veiled_e01881c4d24ae7e3","to":"npc_apothecary_established","type":"respect","typeName":"Genuine Respect","description":"Jarl Asgautsson trusts Ulfhéðinn Bjornsson's word over any written contract. Ulfhéðinn Bjornsson has never given a reason to regret it.","tension":"Ulfhéðinn Bjornsson has publicly backed a plan that Jarl Asgautsson thinks will fail. Jarl Asgautsson has said so once, in private.","strength":"grudging","npc1Name":"Jarl Asgautsson","npc2Name":"Ulfhéðinn Bjornsson","npc1Role":"the gang boss","npc2Role":"the apothecary","archetypeKey":"genuine_respect","proseVariant":7,"flagDriven":false},{"id":"tie_npc_stone_quarry","from":"npc_stone_quarry","to":"npc_fighting_pits","type":"patron_client","typeName":"Silent Partnership","description":"Geira Snorrason wanted more than honest work could pay. Záleif Leidolfsson made up the difference, and now Geira Snorrason passes on whatever Záleif Leidolfsson needs to know.","tension":"Záleif Leidolfsson has asked Geira Snorrason for something Geira Snorrason cannot give without being noticed. Geira Snorrason asked for time, and Záleif Leidolfsson gave a week.","strength":"significant","npc1Name":"Geira Snorrason","npc2Name":"Záleif Leidolfsson","npc1Role":"the quarry master","npc2Role":"the pit boss","archetypeKey":"handler_partnership","proseVariant":2,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_stable_district","from":"npc_stable_district","to":"npc_alchemist_shop","type":"rival","typeName":"Professional Rivalry","description":"Ulfhéðinn Olafsson and Nanna Ragnarsson sit at the same tables and want the same things from them. Each counts the other's wins more carefully than their own.","tension":"Ulfhéðinn Olafsson has hired away Nanna Ragnarsson's best assistant. Nanna Ragnarsson has said nothing about it, to anyone.","strength":"bitter","npc1Name":"Ulfhéðinn Olafsson","npc2Name":"Nanna Ragnarsson","npc1Role":"the stable master","npc2Role":"the alchemist","archetypeKey":"peer_rivalry","proseVariant":3,"flagDriven":false},{"id":"tie_npc_beast_trainers","from":"npc_beast_trainers","to":"npc_town_granary","type":"rival","typeName":"Professional Rivalry","description":"Walpurga Ormsson and Ketil Magnusson trained together and have competed ever since. The settlement keeps score, and so do they.","tension":"A post opens at midsummer, and only Walpurga Ormsson or Ketil Magnusson can fill it.","strength":"personal","npc1Name":"Walpurga Ormsson","npc2Name":"Ketil Magnusson","npc1Role":"the beast master","npc2Role":"the granary reeve","archetypeKey":"peer_rivalry","proseVariant":4,"flagDriven":false},{"id":"tie_npc_docks_port_facilities","from":"npc_docks_port_facilities","to":"npc_inn_multiple","type":"ally","typeName":"Pragmatic Alliance","description":"Eirik Asgautsson and Drifa Andersson joined against a threat that has since passed, and each is now asking what the alliance is still for.","tension":"Eirik Asgautsson has taken a precaution against Drifa Andersson that Drifa Andersson was not meant to discover. Drifa Andersson has discovered it.","strength":"moderate","npc1Name":"Eirik Asgautsson","npc2Name":"Drifa Andersson","npc1Role":"the wharfinger","npc2Role":"the innkeeper","archetypeKey":"wary_alliance","proseVariant":2,"flagDriven":false},{"id":"tie_npc_fighting_pits","from":"npc_fighting_pits","to":"npc_veiled_e01881c4d24ae7e3","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Jarl Asgautsson kept Záleif Leidolfsson's name out of a scandal that ruined two others. Záleif Leidolfsson has voted with Jarl Asgautsson ever since.","tension":"Jarl Asgautsson has mentioned the debt aloud, at a dinner, in front of Záleif Leidolfsson's partners.","strength":"crushing","npc1Name":"Záleif Leidolfsson","npc2Name":"Jarl Asgautsson","npc1Role":"the pit boss","npc2Role":"the gang boss","archetypeKey":"old_debt","proseVariant":5,"flagDriven":false},{"id":"tie_npc_apothecary_established","from":"npc_apothecary_established","to":"npc_veiled_e01881c4d24ae7e3","type":"patron_client","typeName":"The Patron No One Names","description":"Ulfhéðinn Bjornsson owes everything to Jarl Asgautsson, and nobody who knows Ulfhéðinn Bjornsson would believe it. Jarl Asgautsson has never asked for thanks, only for loyalty.","tension":"Ulfhéðinn Bjornsson's family has begun asking where the early money came from. Jarl Asgautsson has told Ulfhéðinn Bjornsson that the questions must stop.","strength":"total dependence","npc1Name":"Ulfhéðinn Bjornsson","npc2Name":"Jarl Asgautsson","npc1Role":"the apothecary","npc2Role":"the gang boss","archetypeKey":"handler_patron","proseVariant":0,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_sawmill_commercial","from":"npc_sawmill_commercial","to":"npc_weavers_textile_workers","type":"respect","typeName":"Genuine Respect","description":"Inga Bodvarsson and Kjara Eindriðason have each watched the other do good work. They argue, but each trusts the other's judgment in their own field.","tension":"Inga Bodvarsson and Kjara Eindriðason are about to be on opposite sides of an important decision.","strength":"deep","npc1Name":"Inga Bodvarsson","npc2Name":"Kjara Eindriðason","npc1Role":"the sawyer","npc2Role":"the master weaver","archetypeKey":"genuine_respect","proseVariant":0,"flagDriven":false},{"id":"tie_npc_town_watch","from":"npc_town_watch","to":"npc_mills_2_5","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Birger Hrafnsson nursed Hildr Bodvarsson through a winter fever when no one else would come. Hildr Bodvarsson still owes the debt and still knows it.","tension":"Hildr Bodvarsson has refused Birger Hrafnsson a small favour for the first time in years.","strength":"crushing","npc1Name":"Hildr Bodvarsson","npc2Name":"Birger Hrafnsson","npc1Role":"the watch captain","npc2Role":"the miller","archetypeKey":"old_debt","proseVariant":6,"flagDriven":false},{"id":"tie_npc_salt_works","from":"npc_salt_works","to":"npc_post_relay_station","type":"rival","typeName":"Professional Rivalry","description":"Vidar Andersson wants Idun Finsson's position, and Idun Finsson wants Vidar Andersson's reputation. They are civil in public and unforgiving in private.","tension":"Idun Finsson has been telling clients that Vidar Andersson's work is slipping. Two of the clients have repeated it to Vidar Andersson.","strength":"professional","npc1Name":"Vidar Andersson","npc2Name":"Idun Finsson","npc1Role":"the salt master","npc2Role":"the postmaster","archetypeKey":"peer_rivalry","proseVariant":5,"flagDriven":false},{"id":"tie_npc_hunter_s_lodge","from":"npc_hunter_s_lodge","to":"npc_craft_guilds_5_15","type":"ally","typeName":"Pragmatic Alliance","description":"Halfdan Ulfsson and Rorik Mordsson back each other in public and check each other's work in private.","tension":"Halfdan Ulfsson wants to bring a third member into the alliance. Rorik Mordsson thinks the newcomer would take Rorik Mordsson's place.","strength":"moderate","npc1Name":"Halfdan Ulfsson","npc2Name":"Rorik Mordsson","npc1Role":"the master of the hunt","npc2Role":"the senior craft-guild master","archetypeKey":"wary_alliance","proseVariant":4,"flagDriven":false},{"id":"tie_npc_inn_multiple","from":"npc_inn_multiple","to":"npc_merchant_guilds_3_8","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Drifa Andersson borrowed Freya Ljotsson's good name to win a post. Freya Ljotsson has never asked for it back.","tension":"Freya Ljotsson has begun to count the debt Drifa Andersson owes among Freya Ljotsson's assets, and has had it written down before witnesses.","strength":"substantial","npc1Name":"Drifa Andersson","npc2Name":"Freya Ljotsson","npc1Role":"the innkeeper","npc2Role":"Burgomaster","archetypeKey":"old_debt","proseVariant":7,"flagDriven":false},{"id":"tie_npc_taverns_5_20","from":"npc_taverns_5_20","to":"npc_fighting_pits","type":"patron_client","typeName":"The Patron No One Names","description":"When Vagn Gormsson was young and had no friends, Záleif Leidolfsson paid the fees, settled the debts and found the first work. Vagn Gormsson has not said Záleif Leidolfsson's name in public since.","tension":"Someone from Vagn Gormsson's past has come back and remembers who paid the fees. Záleif Leidolfsson wants to know what Vagn Gormsson means to do about it.","strength":"nominal","npc1Name":"Vagn Gormsson","npc2Name":"Záleif Leidolfsson","npc1Role":"the tavern keeper","npc2Role":"the pit boss","archetypeKey":"handler_patron","proseVariant":1,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_coaching_inn","from":"npc_coaching_inn","to":"npc_barge_and_river_transport_company","type":"ally","typeName":"Pragmatic Alliance","description":"Auðr Snorrason brings the votes and Ulfric Snorrason brings the money. The alliance is three years old and has won every vote it needed.","tension":"Ulfric Snorrason voted against Auðr Snorrason on a small matter last week. Auðr Snorrason is waiting to see whether it was small.","strength":"weak","npc1Name":"Auðr Snorrason","npc2Name":"Ulfric Snorrason","npc1Role":"the coaching-inn keeper","npc2Role":"the barge master","archetypeKey":"wary_alliance","proseVariant":5,"flagDriven":false},{"id":"tie_npc_post_relay_station","from":"npc_post_relay_station","to":"npc_town_granary","type":"respect","typeName":"Genuine Respect","description":"Idun Finsson and Ketil Magnusson disagree often and trust completely. Each has watched the other be right at cost, and neither forgets it.","tension":"Idun Finsson is being pressed to act against Ketil Magnusson, and has not mentioned it.","strength":"grudging","npc1Name":"Idun Finsson","npc2Name":"Ketil Magnusson","npc1Role":"the postmaster","npc2Role":"the granary reeve","archetypeKey":"genuine_respect","proseVariant":1,"flagDriven":false},{"id":"tie_npc_river_ferry","from":"npc_river_ferry","to":"npc_merchant_guilds_3_8","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Freya Ljotsson owes Bjorn Sigvaldsson a great deal, and neither has ever said so aloud.","tension":"Bjorn Sigvaldsson is about to call it in.","strength":"minor","npc1Name":"Bjorn Sigvaldsson","npc2Name":"Freya Ljotsson","npc1Role":"the ferryman","npc2Role":"Burgomaster","archetypeKey":"old_debt","proseVariant":65536,"flagDriven":false},{"id":"tie_npc_town_granary","from":"npc_town_granary","to":"npc_veiled_e01881c4d24ae7e3","type":"patron_client","typeName":"Silent Partnership","description":"Jarl Asgautsson's silver bought the friends who raised Ketil Magnusson to where Ketil Magnusson stands today. Ketil Magnusson repays it in favours, quietly and on time.","tension":"Ketil Magnusson hopes to rise again this season. Jarl Asgautsson expects the favours to grow with Ketil Magnusson's standing.","strength":"significant","npc1Name":"Ketil Magnusson","npc2Name":"Jarl Asgautsson","npc1Role":"the granary reeve","npc2Role":"the gang boss","archetypeKey":"handler_partnership","proseVariant":3,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_mills_2_5","from":"npc_mills_2_5","to":"npc_tailor_s_guild","type":"political","typeName":"Mutual Leverage","description":"Birger Hrafnsson and Grettir Hrafnsson each have something to trade and nothing to give away. They meet in private, bargain hard, and keep every bargain.","tension":"The vote Grettir Hrafnsson needs from Birger Hrafnsson comes up next week, and Birger Hrafnsson has named a new price.","strength":"convenience","npc1Name":"Birger Hrafnsson","npc2Name":"Grettir Hrafnsson","npc1Role":"the miller","npc2Role":"the tailor","archetypeKey":"mutual_leverage","proseVariant":5,"flagDriven":false},{"id":"tie_npc_weavers_textile_workers","from":"npc_weavers_textile_workers","to":"npc_salt_works","type":"ally","typeName":"Pragmatic Alliance","description":"Kjara Eindriðason and Vidar Andersson signed a pact after their last quarrel cost them both. They keep to its terms exactly.","tension":"Kjara Eindriðason and Vidar Andersson both want the same office, and the alliance cannot survive one of them winning it.","strength":"strong","npc1Name":"Kjara Eindriðason","npc2Name":"Vidar Andersson","npc1Role":"the master weaver","npc2Role":"the salt master","archetypeKey":"wary_alliance","proseVariant":6,"flagDriven":false},{"id":"tie_npc_hireling_hall","from":"npc_hireling_hall","to":"npc_weavers_textile_workers","type":"rival","typeName":"Professional Rivalry","description":"Every friend Freya Asgautsson wins is one Kjara Eindriðason lost, and the reverse. The two keep a polite distance and an exact tally.","tension":"Freya Asgautsson and Kjara Eindriðason will both present proposals at the next council session. Only one will be accepted.","strength":"personal","npc1Name":"Freya Asgautsson","npc2Name":"Kjara Eindriðason","npc1Role":"the hiring master","npc2Role":"the master weaver","archetypeKey":"peer_rivalry","proseVariant":6,"flagDriven":false},{"id":"tie_npc_fish_market","from":"npc_fish_market","to":"npc_inn_multiple","type":"family","typeName":"Family Complication","description":"Drifa Andersson is Röðla Magnusson's half-sibling, raised in the same house and left out of the same will.","tension":"A family property must be sold, and Röðla Magnusson and Drifa Andersson each want the money for a different purpose.","strength":"close","npc1Name":"Röðla Magnusson","npc2Name":"Drifa Andersson","npc1Role":"the master fishmonger","npc2Role":"the innkeeper","archetypeKey":"family_complication","proseVariant":5,"flagDriven":false},{"id":"tie_npc_courthouse","from":"npc_courthouse","to":"npc_fuller","type":"enemy","typeName":"Unresolved History","description":"Knut Hrafnsson blames Torvald Gormsson for a death in Knut Hrafnsson's family. Torvald Gormsson has never denied it.","tension":"Torvald Gormsson's child has asked to apprentice with Knut Hrafnsson. Knut Hrafnsson has not refused.","strength":"serious","npc1Name":"Knut Hrafnsson","npc2Name":"Torvald Gormsson","npc1Role":"the magistrate","npc2Role":"the fuller","archetypeKey":"bitter_history","proseVariant":6,"flagDriven":false},{"id":"tie_npc_merchant_warehouses","from":"npc_merchant_warehouses","to":"npc_veiled_e01881c4d24ae7e3","type":"patron_client","typeName":"Silent Partnership","description":"Once a month Lofn Dagsson and Jarl Asgautsson meet in a back room to split what the month brought in. In the street they pass each other without a nod.","tension":"A clerk has found a payment to Lofn Dagsson that nobody can explain. Jarl Asgautsson wants to know who the clerk talks to.","strength":"nominal","npc1Name":"Lofn Dagsson","npc2Name":"Jarl Asgautsson","npc1Role":"the warehouse factor","npc2Role":"the gang boss","archetypeKey":"handler_partnership","proseVariant":4,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_river_boatyard","from":"npc_river_boatyard","to":"npc_tailor_s_guild","type":"political","typeName":"Mutual Leverage","description":"Grettir Hrafnsson needs Nori Asgautsson's seal on certain papers; Nori Asgautsson needs Grettir Hrafnsson's silence about certain others. Neither has asked for more than the other could pay.","tension":"Nori Asgautsson's secret is about to come out by other means. Once it does, Grettir Hrafnsson holds nothing over Nori Asgautsson.","strength":"stable","npc1Name":"Nori Asgautsson","npc2Name":"Grettir Hrafnsson","npc1Role":"the boatwright","npc2Role":"the tailor","archetypeKey":"mutual_leverage","proseVariant":6,"flagDriven":false},{"id":"tie_npc_tanners","from":"npc_tanners","to":"npc_fighting_pits","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Years ago Záleif Leidolfsson did Cormac Yngvarsson a favour too large to repay, and Cormac Yngvarsson has been paying it back in small ways ever since.","tension":"Cormac Yngvarsson has begun to act like someone who considers the debt paid. Záleif Leidolfsson does not.","strength":"substantial","npc1Name":"Cormac Yngvarsson","npc2Name":"Záleif Leidolfsson","npc1Role":"the tanner","npc2Role":"the pit boss","archetypeKey":"old_debt","proseVariant":1,"flagDriven":false},{"id":"tie_npc_fuller","from":"npc_fuller","to":"npc_fighting_pits","type":"patron_client","typeName":"The Patron No One Names","description":"Záleif Leidolfsson is the hand behind Torvald Gormsson's rise: the letters of introduction, the rival who withdrew, the deal that went the right way. Torvald Gormsson answers to Záleif Leidolfsson and, in truth, to nobody else.","tension":"Záleif Leidolfsson has asked Torvald Gormsson to repay the old help with one large favour, the first in years. Torvald Gormsson has not refused and does not want to agree.","strength":"nominal","npc1Name":"Torvald Gormsson","npc2Name":"Záleif Leidolfsson","npc1Role":"the fuller","npc2Role":"the pit boss","archetypeKey":"handler_patron","proseVariant":2,"flagDriven":false,"covert":true,"handler":true},{"id":"tie_npc_cobbler_s_guild","from":"npc_cobbler_s_guild","to":"npc_veiled_e01881c4d24ae7e3","type":"enemy","typeName":"Unresolved History","description":"Thordis Eriksson and Jarl Asgautsson fought a duel in their youth. Both survived, and the scar is on Jarl Asgautsson's face.","tension":"Thordis Eriksson has learned that Jarl Asgautsson is in debt and could be ruined by one call on a loan.","strength":"serious","npc1Name":"Thordis Eriksson","npc2Name":"Jarl Asgautsson","npc1Role":"the cobbler","npc2Role":"the gang boss","archetypeKey":"bitter_history","proseVariant":7,"flagDriven":false},{"id":"tie_npc_tailor_s_guild","from":"npc_tailor_s_guild","to":"npc_weavers_textile_workers","type":"rival","typeName":"Professional Rivalry","description":"Grettir Hrafnsson and Kjara Eindriðason are rivals for the same patron's favour. Each has spent the year trying to be first through the patron's door.","tension":"Grettir Hrafnsson lost the last contract to Kjara Eindriðason by a single vote, and has learned who cast it.","strength":"bitter","npc1Name":"Grettir Hrafnsson","npc2Name":"Kjara Eindriðason","npc1Role":"the tailor","npc2Role":"the master weaver","archetypeKey":"peer_rivalry","proseVariant":7,"flagDriven":false},{"id":"tie_npc_alchemist_shop","from":"npc_alchemist_shop","to":"npc_weavers_textile_workers","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Nanna Ragnarsson owes Kjara Eindriðason for an old kindness. Neither mentions it, and both know exactly how much is still owed.","tension":"Someone else has learned what favour Nanna Ragnarsson owes Kjara Eindriðason, and now has a hold on Nanna Ragnarsson too.","strength":"minor","npc1Name":"Nanna Ragnarsson","npc2Name":"Kjara Eindriðason","npc1Role":"the alchemist","npc2Role":"the master weaver","archetypeKey":"old_debt","proseVariant":2,"flagDriven":false},{"id":"tie_npc_cooper","from":"npc_cooper","to":"npc_fuller","type":"respect","typeName":"Genuine Respect","description":"There is no arrangement between Yngvi Mordsson and Torvald Gormsson, only a long record of kept words; in this settlement that makes them remarkable.","tension":"Yngvi Mordsson and Torvald Gormsson still respect each other, but what each of them wants is pulling apart, and both can see it.","strength":"deep","npc1Name":"Yngvi Mordsson","npc2Name":"Torvald Gormsson","npc1Role":"the cooper","npc2Role":"the fuller","archetypeKey":"genuine_respect","proseVariant":2,"flagDriven":false},{"id":"tie_npc_parish_churches_2_5","from":"npc_parish_churches_2_5","to":"npc_taverns_5_20","type":"debtor_creditor","typeName":"Outstanding Debt","description":"Vagn Gormsson paid Thorvald Styrkarsson's bail eleven years ago and has never mentioned it. Thorvald Styrkarsson mentions it to no one.","tension":"Vagn Gormsson has asked Thorvald Styrkarsson for a favour against Thorvald Styrkarsson's own interests. It is the first payment Vagn Gormsson has asked for.","strength":"crushing","npc1Name":"Thorvald Styrkarsson","npc2Name":"Vagn Gormsson","npc1Role":"the dean","npc2Role":"the tavern keeper","archetypeKey":"old_debt","proseVariant":3,"flagDriven":false},{"id":"tie_npc_charlatan_fortune_tellers","from":"npc_charlatan_fortune_tellers","to":"npc_salt_works","type":"ally","typeName":"Pragmatic Alliance","description":"Asger Torvaldsson and Vidar Andersson are allies with separate interests. They meet to coordinate and leave by different doors.","tension":"Vidar Andersson has asked Asger Torvaldsson to back a candidate Asger Torvaldsson distrusts. Refusing would cost the alliance its majority.","strength":"strong","npc1Name":"Asger Torvaldsson","npc2Name":"Vidar Andersson","npc1Role":"the fortune teller","npc2Role":"the salt master","archetypeKey":"wary_alliance","proseVariant":7,"flagDriven":false}],"conflicts":[{"parties":["Merchant Council","Craft Guilds"],"issue":"Military conscription of guild apprentices","stakes":"Labor control","intensity":"high","desc":"Merchant Council and Craft Guilds are in high conflict over military conscription of guild apprentices. The stakes are labor control. It reaches Merchant Guilds too, who are not a party to it.","plotHooks":["Leading members of both powers are partners in the same business, one that skirts the law, and neither side wants that said aloud during arbitration."]}],"resourceAnalysis":{"terrain":"Riverside","availableResources":["river_fish","fish","foraging_areas","honey","medicinal_herbs","hot_springs"],"resourceConditions":[{"key":"river_fish","label":"River Fisheries","type":"renewable","condition":"available","randomDepletionEligible":true,"recoveryMode":"natural","conditionDescription":null},{"key":"foraging_areas","label":"Wild Foraging Areas","type":"renewable","condition":"available","randomDepletionEligible":true,"recoveryMode":"natural","conditionDescription":null},{"key":"hot_springs","label":"Hot Springs / Healing Waters","type":"positional","condition":"available","randomDepletionEligible":false,"recoveryMode":"not_applicable","conditionDescription":null},{"key":"stone_quarry","label":"Stone quarry","type":"exhaustible","condition":"depleted","randomDepletionEligible":true,"recoveryMode":"manual","conditionDescription":"The workable quarry face is exhausted."},{"key":"hunting_grounds","label":"Hunting Grounds","type":"renewable","condition":"depleted","randomDepletionEligible":true,"recoveryMode":"natural","conditionDescription":"Game populations have fallen below sustainable hunting levels."}],"conditionNotes":["The workable quarry face is exhausted.","Game populations have fallen below sustainable hunting levels."],"resourceChains":[{"rawResource":"fish","processingTags":["food"],"processingInstitutions":["Fishmonger","Salters' guild"],"intermediateGoods":["fresh fish","salted fish"],"finalProducts":["preserved fish","fish oil"],"exportValue":"medium","dependsOn":["water access","fishing grounds"],"chainKey":"fish"}],"exploitation":{"fullyExploited":[{"rawResource":"fish","processingTags":["food"],"processingInstitutions":["Fishmonger","Salters' guild"],"intermediateGoods":["fresh fish","salted fish"],"finalProducts":["preserved fish","fish oil"],"exportValue":"medium","dependsOn":["water access","fishing grounds"],"chainKey":"fish"}],"partiallyExploited":[],"unexploited":[],"warnings":[]},"imports":{"critical":["metals","luxury goods","desert_salt