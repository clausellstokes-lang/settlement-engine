e":"the fuller","veiled":false},"memberships":[{"power":"Craft Guilds","rank":null,"share":1,"veiled":false}],"allegiance":{"power":"Thieves' Guild","house":"Street gang","vector":"forbidden_patron","via":"retainer","handler":"npc_fighting_pits","share":0.15,"veiled":true,"covert":true},"importance":"minor","structuralRank":"member"},{"id":"npc_cobbler_s_guild","name":"Thordis Eriksson","gender":"female","role":"the cobbler","title":"the cobbler","category":"other","personality":{"dominant":"loyal","flaw":"domineering","modifier":"iconoclast","tell":"addresses everyone by full name, never shortened","speech":"Addresses strangers formally and familiars by diminutives"},"physical":{"age":"early forties","build":"willowy","feature":"a network of small scars on their knuckles","clothes":"second-hand fine clothes that don't quite fit"},"goal":{"short":"Get to whatever both Craft Guilds and Merchant Guilds want this season first.","long":"Become someone Craft Guilds cannot do without.","intent":{"short":{"family":"POWER","kind":"competitive","key":"expand_influence","target":{"kind":"power","id":"Merchant Guilds"}},"long":{"family":"RANK","kind":"enter","key":"secure_office","target":{"kind":"power","id":"Craft Guilds"}}}},"secret":{"what":"Has been reading Záleif Leidolfsson's correspondence through an intermediary. Nothing damaging yet. But they keep looking","stakes":"The intermediary has recently started asking for more money"},"plotHooks":["An inheritance they did not expect has arrived from a relative they never met, along with that relative's debts."],"influence":"low","power":1,"presentation":{"impression":"Quiet and careful. The good work is kept in the back and shown only on request.","disposition":"cautious","behaviour":"Polite, but asks where you are from before taking an order for new shoes."},"institution":{"kind":"house","key":"Cobbler's guild","family":"Cobbler's guild","title":"the cobbler","veiled":false},"memberships":[{"power":"Craft Guilds","rank":nul