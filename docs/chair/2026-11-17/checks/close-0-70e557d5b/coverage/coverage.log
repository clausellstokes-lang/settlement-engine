nce"},"physical":{"age":"late forties","build":"willowy","feature":"a network of small scars on their knuckles","clothes":"work clothes patched by someone who loved them"},"goal":{"short":"Beat Merchant Guilds to the next opportunity, and win the credit for Craft Guilds.","long":"Make Yan He admit, in public, that they were wrong.","intent":{"short":{"family":"POWER","kind":"competitive","key":"expand_influence","target":{"kind":"power","id":"Merchant Guilds"}},"long":{"family":"TIES","kind":"rival_enemy","key":"settle_rivalry","target":{"kind":"npc","id":"npc_dyer"}}}},"secret":{"what":"Has been buying cheap iron and selling the work as good steel, and the blades break where it matters","stakes":"The next blade that breaks under someone's weight would be traced back to the forge"},"plotHooks":["They have seen the same unmarked cart pass their door three nights running, and have not wondered why."],"influence":"low","power":1,"presentation":{"impression":"Heavy forearms, burn scars and a leather apron. They do not stop working to talk.","disposition":"transactional","behaviour":"Quotes a price and a day without looking up; the work is good and the day is never early."},"institution":{"kind":"house","key":"Blacksmiths (3-10)","family":"Blacksmiths (3-10)","title":"the master smith","veiled":false},"memberships":[{"power":"Craft Guilds","rank":1,"share":1,"veiled":false}],"importance":"pillar","structuralRank":"head"},{"id":"npc_mine","name":"Manchu Gao","gender":"female","role":"the mine captain","title":"the mine captain","category":"economy","personality":{"dominant":null,"flaw":"vindictive","modifier":"superstitious","tell":"uses elaborate, florid greetings regardless of context","speech":"Refers to past events as though they're common knowledge"},"physical":{"age":"seventies","build":"slight: smaller than expected for the role","feature":"a ring on every finger","clothes":"clothes that once cost a fortune and now show the miles"},"goal":{"short":"Get the rights o