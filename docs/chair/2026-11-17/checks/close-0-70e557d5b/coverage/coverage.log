es"}}}},"secret":{"what":"Rents out a locked bay at night to people who never sign the books and never say what they store","stakes":"Whatever is in that bay would be laid at the factor's door, and so would the people who own it"},"plotHooks":["A rival has hired away their two best hands in one week, on wages the rival cannot afford for long."],"influence":"low","power":2,"presentation":{"impression":"Short with anyone who has not come to rent space. Their eyes are already on the next cart.","disposition":"dismissive","behaviour":"Gives directions and nothing more unless there is business to be done."},"institution":{"kind":"house","key":"Merchant warehouses","family":"Warehouse district","title":"the warehouse factor","veiled":false},"memberships":[{"power":"Merchant Guilds","rank":null,"share":1,"veiled":false}],"allegiance":{"power":"Thieves' Guild","house":"Street gang","vector":"hunger_for_status","via":"front","handler":"npc_veiled_e01881c4d24ae7e3","share":0.15,"veiled":true,"covert":true},"importance":"minor","structuralRank":"member"},{"id":"npc_river_boatyard","name":"Nori Asgautsson","gender":"male","role":"the boatwright","title":"the boatwright","category":"other","personality":{"dominant":null,"flaw":"overbearing","modifier":"perfectionist","tell":"always stands when others sit, or vice versa","speech":"Makes every point as a question they do not expect answered"},"physical":{"age":"late fifties","build":"heavyset and solid","feature":"ink-stained fingers","clothes":"weathered gear maintained past the point of economy"},"goal":{"short":"Gain ground for Craft Guilds at the expense of Merchant Guilds before the season is out.","long":"Rise in Craft Guilds far enough that their word carries weight outside it.","intent":{"short":{"family":"POWER","kind":"competitive","key":"expand_influence","target":{"kind":"power","id":"Merchant Guilds"}},"long":{"family":"RANK","kind":"enter","key":"secure_office","target":{"kind":"power","id":"Craft Guilds"}}}},"secret