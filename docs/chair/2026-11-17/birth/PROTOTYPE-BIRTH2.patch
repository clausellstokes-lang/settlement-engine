+/**
+ * PROTOTYPE (BIRTH-AUDIT, scratch only; never pushed under src/): the kind of a house by catalogue id, and the rule switch.
+ * BIRTH_RULE (environment, a comma list): R1 the reader's rule everywhere; R1p the reader's rule at print only; R2 the
+ * import written at the birth; R3a the source house gated at its draw (the draw skipped); R3b gated, the draw kept;
+ * R4 the source house read as worked out; R5 the salt works on a coast. NOOP_<site> runs the site's code and changes nothing.
+ * Import-free leaf.
+ */
+const ENV = (typeof process !== 'undefined' && process.env && process.env.BIRTH_RULE) || '';
+export const RULE = new Set(ENV.split(',').map((x) => x.trim()).filter(Boolean));
+/** (i) BUYS AND WORKS: catalogue ids (kinds.mjs). */
+export const BUYS_AND_WORKS = new Set([
+  'blacksmith', 'blacksmiths_3_10', 'resident_smith_part_time', 'specialized_metalworkers', 'smelter',
+  'brewer', 'brewery', 'maltster', 'mill', 'mills_2_5', 'bakers_5_15', 'alehouse', 'butchers_3_8',
+  'carpenter', 'carpenter_part_time', 'carpenters_5_15', 'cooper', 'woodcarver', 'shipyard', 'river_boatyard', 'bowyer_fletcher', 'thatcher',
+  'sawmill', 'sawmill_commercial',
+  'cobbler', 'cobbler_s_guild', 'tanner_established', 'tanners', 'tannery', 'furrier_s_district',
+  'fuller', 'weavers_textile_workers', 'tailor', 'tailor_s_guild', 'dyer', 'ropemaker', 'chandler',
+  'potter', 'brickmaker', 'vintner', 'glassblower', 'glassmakers', 'apothecary', 'alchemist_shop', 'luxury_goods_quarter',
+  'fish_market', 'fishmonger',
+]);
+/** (ii) IS THE SOURCE, gated at the draw by R3 (the four the census marks by a gap): id -> the grounds that give it. */
+export const SOURCE_GROUNDS = Object.freeze({
+  stone_quarry: ['stone_quarry'],
+  charcoal_burner: ['managed_forest', 'mountain_timber', 'shipbuilding_timber'],
+  dairy_farmer: ['grazing_land', 'alpine_pasture', 'fertile_floodplain', 'camel_herds'],
+  salt_works: ['salt_flats', 'desert_salt', 'fishing_grounds'],
+});
+/** R2: the imports list's own words for a chain key's good. */
+export const IMPORT_WORD = Object.freeze({
+  wool: 'Wool', alpineWool: 'Wool', timber: 'Timber', mountainTimber: 'Timber', ironOre: 'Iron ore', copperOre: 'Iron ore', preciousMetals: 'Iron ore',
+  hides: 'Raw hides and animal products', grain: 'Grain', clay: 'Clay and raw materials', grapes: 'Grapes and must',
+  livestock: 'Livestock', sand: 'Glass sand', desertGlass: 'Glass sand', herbs: 'Medicinal herbs', fish: 'Salted fish',
+});
+
+// ── BIRTH-2-COUNT (prototype): A SOURCE HOUSE ON NO GROUND, KEPT AT A SHARE WITH A STATED CAUSE ──────────────────────────
+// BIRTH_RULE 'K' turns it on; BIRTH_SHARE (0..1) the kept share; BIRTH_SITE 'gap' (the cause written at the gaps' hour) or
+// 'draw' (written after the roster is drawn, before the economy). The removed houses take their draw (chance 0, R3b).
+const ENV2 = (typeof process !== 'undefined' && process.env) || {};
+export const SHARE = Number.isFinite(Number(ENV2.BIRTH_SHARE)) ? Number(ENV2.BIRTH_SHARE) : 0;
+export const SITE = ENV2.BIRTH_SITE === 'draw' ? 'draw' : ENV2.BIRTH_SITE === 'late' ? 'late' : 'gap';
+/** The source houses on no ground the census shows (the four, the mines, the peat cutter) and their grounds. */
+export const BARREN_GROUNDS = Object.freeze({
+  ...SOURCE_GROUNDS,
+  mine: ['iron_deposits', 'precious_metals', 'gemstone_deposits', 'coal_deposits', 'stone_quarry'],
+  mine_open_cast: ['iron_deposits', 'precious_metals', 'gemstone_deposits', 'coal_deposits', 'stone_quarry'],
+  peat_cutter: ['marshlands'],
+});
+/** The causes a kind can bear: the ground written spent ('worked'), and the import that brings its material ('bought'). */
+export const CAUSES = Object.freeze({
+  stone_quarry: { worked: 'stone_quarry' },
+  mine: { worked: 'iron_deposits' }, mine_open_cast: { worked: 'iron_deposits' },
+  peat_cutter: { worked: 'marshlands' },
+  charcoal_burner: { worked: 'managed_forest', bought: 'Timber' },
+  salt_works: { worked: 'salt_flats', bought: 'Salt' },
+  dairy_farmer: { worked: 'grazing_land', bought: 'Fodder and hay', boughtMinTier: 'town' }, // 'worked': the audit's correction
+});
+/** The finished good an exhausted house's town now brings in: the ground's shortage import, but the charcoal burner's is its
+ * charcoal (its woods' shortage import, "Timber (…cleared)", is its raw material and would feed it). */
+export const finishedGood = (id, shortageImport) => (id === 'charcoal_burner' ? 'Charcoal and fuel' : shortageImport(CAUSES[id].worked));
+/** FNV-1a 32 (the kernel's own hash, `fnv1a32`, copied so this leaf stays import-free). @param {string} s */
+export function hash32(s) { let h = 0x811c9dc5; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; } return h >>> 0; }
+/** Is the barren house of this id KEPT in this town (the seed's own, no draw)? @param {unknown} seed @param {string} id */
+/** BIRTH_SHARE_BY ("id:share,…") overrides the share for a kind. */
+const SHARE_BY = Object.fromEntries(String(ENV2.BIRTH_SHARE_BY || '').split(',').filter(Boolean).map((x) => { const [k, v] = x.split(':'); return [k.trim(), Number(v)]; }));
+export const keepBarren = (seed, id) => (hash32(`${String(seed)}::birth-keep::${id}`) % 60) < Math.round((Object.prototype.hasOwnProperty.call(SHARE_BY, id) ? SHARE_BY[id] : SHARE) * 60);
+const TIERS = ['thorp', 'hamlet', 'village', 'town', 'city', 'metropolis'];
+/** The cause a kept house bears: 'bought' on a route connected in ordinary times (a siege does not count) where the kind can bear it (by the seed's hash
+ * between the two where both are open), else 'worked'. */
+export function causeOf(seed, id, tier, connected) {
+  const c = CAUSES[id]; if (!c) return null;
+  const canBuy = !!c.bought && connected && (!c.boughtMinTier || TIERS.indexOf(String(tier)) >= TIERS.indexOf(c.boughtMinTier));
+  if (!canBuy) return c.worked ? 'worked' : null;
+  if (!c.worked) return 'bought';
+  return hash32(`${String(seed)}::birth-cause::${id}`) % 2 === 0 ? 'bought' : 'worked';
+}
+
+// BIRTH-2-COUNT (prototype): THE STATED CAUSE of a kept source house on no ground. 'worked' writes its ground spent among
+// the nearby resources (and, at the gaps' hour, the shortage import the economy writes for a spent ground); 'bought' writes
+// the import. Returns the number of houses given a cause.
+export function birthWriteCauses({ institutions, config, economicState, seed, tier, site, shortageImport, connectedOf, idOf, nearbyCtx, terrainType }) {
+  let n = 0;
+  const near = Array.isArray(config.nearbyResources) ? config.nearbyResources : (config.nearbyResources = []);
+  const route = String(config.tradeRouteAccess ?? '');
+  const terrain = String(terrainType ?? config.terrainOverride ?? '');
+  // THE OWNER (2026-11-17 04:33 UTC): a cause is of ordinary times: a siege does not take "bought in" away; only an isolated route does
+  const connected = connectedOf(route);
+  for (const inst of institutions || []) {
+    if (!inst || typeof inst.name !== 'string' || inst.status === 'ruined') continue;
+    const id = String(idOf(inst) || '');
+    const g = BARREN_GROUNDS[id]; if (!g || g.some((k) => near.includes(k))) continue;
+    if (id === 'salt_works' && (route === 'port' || terrain === 'coastal')) continue;
+    const cause = causeOf(seed, id, tier, connected); if (!cause) continue;
+    const imp = Array.isArray(economicState?.primaryImports) ? economicState.primaryImports : null;
+    if (cause === 'worked' && (site === SITE)) {
+      const k = CAUSES[id].worked;
+      for (const f of ['nearbyResources', 'nearbyResourcesNative', 'nearbyResourcesDepleted', 'nearbyResourcesNativeDepleted']) {
+        if (!Array.isArray(config[f])) config[f] = [];
+        if (!config[f].includes(k)) config[f].push(k);
+      }
+      if (Array.isArray(nearbyCtx) && !nearbyCtx.includes(k)) nearbyCtx.push(k);
+      if (site === 'gap' && imp && connected) { const w = finishedGood(id, shortageImport); if (w && !imp.includes(w)) imp.push(w); }
+      n++;
+    } else if (cause === 'worked' && site === 'gap' && SITE === 'late' && imp && connected) {
+      // 'late': the import at the gaps' hour, the ground at the narratives' end (after the history reads the resources);
+      // THE OWNER (04:30): the finished good now brought in, and only where a route is open
+      const w = finishedGood(id, shortageImport); if (w && !imp.includes(w)) imp.push(w);
+      n++;
+    } else if (cause === 'bought' && site === 'gap' && imp) {
+      const w = CAUSES[id].bought; if (!imp.includes(w)) imp.push(w); n++;
+    }
+  }
+  return n;
+}
