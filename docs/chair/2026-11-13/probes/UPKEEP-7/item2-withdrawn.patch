+
+// COHERENCE-UPKEEP-7, the chair's ruling (count once, the second half): a house that stands under two named parts
+// keeps the part of its own kind. The alchemist shop and the alchemist quarter are ALCHEMISTS and leave ARCANE: the
+// arcane gate reads the magic-house flag over the roster without them (`defenseInstitutionBuckets.js ::
+// arcaneRosterOf`). A declared move of the rating; no weight changed. The review's count-once test (REVIEW-UPKEEP-2
+// claims.mjs (c)): drop each house alone, recompute the parts (never stored), and the non-rule parts whose full value
+// moves are the parts that house feeds.
+const ALCHEMIST_HOUSES = ['alchemist shop', 'alchemist quarter'];
+const RULE_PARTS = new Set(['terrain', 'size', 'danger', 'wallsUnmanned', 'sustainsHeld', 'scaleTop', 'scaleBottom', 'will', 'rounding']);
+const isRulePart = (/** @type {string} */ id) => RULE_PARTS.has(id) || id.startsWith('full:') || id.startsWith('floor:');
+/** @param {any} s @returns {Record<string, number>} */
+const fullOf = (s) => Object.fromEntries(defencePartsOf(s).filter((p) => !isRulePart(p.id)).map((p) => [p.id, p.full]));
+
+describe('count once, the second half: the alchemist houses are alchemists and leave arcane', () => {
+  test('the defence home names the two alchemist houses', () => {
+    expect([...(home.DEFENSE_ALCHEMIST_HOUSES || [])].sort()).toEqual([...ALCHEMIST_HOUSES].sort());
+  });
+
+  test('RED-FIRST: dropped alone, an alchemist house moves one part only (alchemists), never arcane beside it', () => {
+    let held = 0;
+    const bad = [];
+    for (const { seed, s } of births) {
+      const base = fullOf(s);
+      s.institutions.forEach((inst, i) => {
+        if (!ALCHEMIST_HOUSES.some((h) => lc(inst).includes(h))) return;
+        held += 1;
+        const now = fullOf({ ...s, institutions: s.institutions.filter((_, j) => j !== i) });
+        const moved = [...new Set([...Object.keys(base), ...Object.keys(now)])].filter((k) => Math.abs((base[k] ?? 0) - (now[k] ?? 0)) > 1e-9);
+        if (moved.length > 1 || moved.includes('arcane')) bad.push([seed, inst.name, moved.join('+')]);
+      });
+    }
+    expect(held, 'anchored: the corpus holds alchemist houses').toBeGreaterThan(5);
+    expect(bad).toEqual([]);
+  });
+});
