+/**
+ * COUNT ONCE, THE SECOND HALF (COHERENCE-UPKEEP-7, the chair's ruling, a declared move): a house that stands under
+ * two named parts keeps the part of its own kind. The alchemist shop and the alchemist quarter are ALCHEMISTS (the
+ * alchemy tradition above names them) and leave ARCANE, whose gate reads the magic-house flag over the roster
+ * without them (`arcaneRosterOf`). Measured first: docs/chair/2026-11-13/probes/UPKEEP-7/. No weight changed.
+ * @type {ReadonlyArray<string>}
+ */
+export const DEFENSE_ALCHEMIST_HOUSES = Object.freeze(['alchemist shop', 'alchemist quarter']);
+
+/**
+ * The roster the arcane gate reads: the roster without the alchemist houses (count once). RUIN-BLIND, as the
+ * partition. One name reading per institution. Returns the SAME array where no alchemist house stands, so a caller
+ * can tell by identity that nothing was left out.
+ * @param {unknown} institutions
+ * @returns {unknown[]}
+ */
+export function arcaneRosterOf(institutions) {
+  /** @type {unknown[]} */
+  const list = Array.isArray(institutions) ? institutions : [];
+  const kept = list.filter((inst) => {
+    const name = nativeSemanticName(inst).toLowerCase();
+    return !DEFENSE_ALCHEMIST_HOUSES.some((kw) => name.includes(kw));
+  });
+  return kept.length === list.length ? list : kept;
+}
