+++ b/src/kernel/proseHash.js
@@ -87,3 +87,21 @@ export function pickVariantMixed(pool, seed) {
   if (pool.length === 1 || !seed) return pool[0];
   return pool[mix32(fnv1a32(String(seed))) % pool.length];
 }
+
+/**
+ * D13 SCRATCH MEASURE ONLY (never committed): the rendezvous pick. The pool member with the highest
+ * `mix32(fnv1a32(seed::id))`; ties to the earlier member. Falsy seed -> index 0, as `pickVariant`.
+ * @template T
+ * @param {readonly T[]} pool @param {string | number | null | undefined} seed @param {(x: T) => string} idOf
+ * @returns {T | undefined}
+ */
+export function pickRendezvous(pool, seed, idOf) {
+  if (!Array.isArray(pool) || pool.length === 0) return undefined;
+  if (pool.length === 1 || !seed) return pool[0];
+  let best = pool[0]; let bestH = mix32(fnv1a32(`${seed}::${idOf(best)}`));
+  for (let i = 1; i < pool.length; i += 1) {
+    const h = mix32(fnv1a32(`${seed}::${idOf(pool[i])}`));
+    if (h > bestH) { best = pool[i]; bestH = h; }
+  }
+  return best;
+}
