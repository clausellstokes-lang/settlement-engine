function refinerPrompt(s) {
  const p = s.p
  const line = s.inBand
    ? " THE JOB: the pool's rows are LAWFUL at the draft commit - lawful is the floor; push every face as far toward the CEILING as one effort allows (read the draft at "
    : " THE JOB: the pool's rows are STILL UNLAWFUL after the draft phase (the gate's last feedback: " + s.feedback + "); push them toward the CEILING as far as one effort allows exactly as you would a lawful set - the law is the shape of the ceiling; where sharper and licensed conflict, licensed wins; remove failing states, never add one; there is no second pass (read the last draft at "
  return "You are the Opus REFINER (Seat: Opus 5 - Fable-unvalidated; a DIFFERENT author than the drafter, on purpose) for the REWRITE of block " + BLOCK + ", pool key '" + p.pool + "', working for the Fable chair. " + VOICE + " " + FENCES + " " + RULES + poolRowsHint() + line + PK + "/" + p.dir + "/draft-round-" + s.rounds + ".md). Refine every face once, one for one (never add or drop a face or a variant; never trim; keep every claim, add none): the sharpest licensed fact, the strongest rhythm inside the voice, the four faces as far apart as the voice allows, zero tics (no fronted-place, inversion or ledger-closer habit repeated across the pool), a citation only where the card licenses a holder, the read-aloud ear of a clerk who was there - the line LANDS when read, never made plainer. Re-read the licence card first (node scripts/prose-licence-card.mjs " + BLOCK + " '" + p.pool + "' in " + DOCK + "). Write the refined rows to " + PK + "/" + p.dir + "/refine.md in the same grammar, then under '--- NOTES' one line per face on what you changed and the law or target behind it. Return the packet path and the per-face change notes."
}
const refineSkip = !!(R && R.refineCommit)
const refined = refineSkip ? allSets.map((s) => ({ dir: s.p.dir, path: PK + '/' + s.p.dir + '/refine.md', text: 'resumed from the dead run' })) : await parallel(allSets.map((s) => () => agent(refinerPrompt(s), { label: BLOCK + ':refine:' + s.p.dir, phase: 'Refine', model: 'opus', effort: 'high' }).then((t) => ({ dir: s.p.dir, path: PK + '/' + s.p.dir + '/refine.md', text: t }))))
const bankedDirs = allSets.filter((s) => s.banked).map((s) => s.p.dir).join(', ') || 'none'
const refineGate = refineSkip ? { commit: String(R.refineCommit), pools: [] } : await agent(GATE_COMMON + " THE JOB (the refine gate; HEAD must be the draft commit " + draftCommit + "): for each packet replace that pool's rows with the refined rows verbatim, run the projector --check and the wave gate at arm A against the draft's cells (per the usage line), then apply THE KEEP-OR-REVERT RULE per pool: a pool LAWFUL at the draft keeps its refinement only if still lawful on every owned band and arm, else REVERTS; a pool BANKED at the draft (the list: " + bankedDirs + ") keeps its refinement if its count of failing owned measures FELL or held with no NEW failing measure, else REVERTS; a reverted pool goes back to the draft rows (restore them with git show " + draftCommit + ":" + ANNEX + ", never the checkout family), and the projector and the gate are re-run. Then, for EVERY pool, write the rows now standing in the annex to " + PK + "/<pool dir>/kept.md (verbatim, the variant rows only) so the refuters read the committed state. Commit as 'REWRITE 8b " + BLOCK + " refine: <kept>/<n> kept, <reverted> reverted' with the trailers; porcelain 0 after. Packets: " + refined.filter(Boolean).map((x) => x.dir + " -> " + x.path).join(' ; ') + ". Return the structured per-pool verdicts (inBand after the gate; refusals[0] = 'failures before N after M kept|reverted') and the commit sha.", { label: BLOCK + ':gate:refine', phase: 'Refine', schema: GATE_SCHEMA, model: 'opus', effort: 'high' })
if (refined.filter(Boolean).length < allSets.length) throw new Error('REFINE INCOMPLETE: ' + (allSets.length - refined.filter(Boolean).length) + ' refiner(s) returned nothing - stopped cleanly before the refine gate; resume by run id')
if (!refineGate) throw new Error('REFINE GATE returned nothing - stopped cleanly; check the dock porcelain and resume by run id')
const refineCommit = refineGate ? refineGate.commit : null
const refineTokens = budget.spent() - t0 - draftTokens

// ---------- Phase 3: REFUTE (Fable, every set; every FAIL names its cure) ----------
phase('Refute')
const REFUTE_SCHEMA = { type: 'object', required: ['dir', 'verdicts'], properties: {
  dir: { type: 'string' },
  verdicts: { type: 'array', items: { type: 'object', required: ['variant', 'face', 'verdict', 'law', 'quote', 'finding', 'cure'], properties: {
    variant: { type: 'integer' }, face: { type: 'integer' }, verdict: { type: 'string', enum: ['FAIL', 'WITHHELD', 'PASS'] }, law: { type: 'string' }, quote: { type: 'string' }, finding: { type: 'string' }, cure: { type: 'string' },
  } } },
  readAloud: { type: 'array', items: { type: 'string' } },
} }
const priorRefutes = (R && Array.isArray(R.refutes) ? R.refutes : []).filter((r) => r && r.dir && Array.isArray(r.verdicts))
const priorRefuteDirs = new Set(priorRefutes.map((r) => r.dir))
const toRefute = allSets.filter((s) => !priorRefuteDirs.has(s.p.dir))
const refutesLive = await parallel(toRefute.map((s) => () => agent("You are a Fable REFUTER (the verifier) for the REWRITE of block " + BLOCK + ", pool key '" + s.p.pool + "', working for the Fable chair. " + VOICE + " " + FENCES + " " + RULES + " THE CHAIR'S BLOCK RULINGS (read the brief's addenda whole): " + RULINGS + " The rows standing in the annex after the refinement are at " + PK + "/" + s.p.dir + "/kept.md; the lawful draft they came from is at " + PK + "/" + s.p.dir + "/draft-round-" + s.rounds + ".md; the licence card is printed by node scripts/prose-licence-card.mjs " + BLOCK + " '" + s.p.pool + "' in " + DOCK + "; the pool's OLD shipped rows (the sentences the rewrite replaces) are in git show " + refineCommit + "~" + (s.rounds + 1) + ":" + ANNEX + " (or read the block's section at the dock's first commit) - the rewrite must carry every LICENSED claim the old sentence carried and NO unlicensed one - a claim the old sentence made that the card does not license is CORRECTLY dropped, and its absence is never a finding; its presence in the rewrite IS (the card); the four faces are claim-equal to each other (A6). Ignore every '--- NOTES' section. Read the pool's LICENSED SKELETON at " + PK + "/" + s.p.dir + "/skeleton.md (the reads every variant must state; the angle stance; the shipped turns worth keeping). " + GROUNDS + " Verdict per FACE: FAIL (a breach, the law named, the face quoted at most twelve words, and the CURE named - the smallest change that makes the face lawful without adding a claim; the cure round's curer reads it), WITHHELD (unproven), PASS; default to FAIL when uncertain. As information only, one read-aloud note per variant. Write your verdicts as you reach them to " + PK + "/" + s.p.dir + "/refute-round-" + s.rounds + ".md (one line per face: variant, face, verdict, law, quote, finding, cure; then the read-aloud notes), then return the structured verdicts.", { label: BLOCK + ':refute:' + s.p.dir, phase: 'Refute', schema: REFUTE_SCHEMA, model: 'fable', effort: 'high' })
  .then((r) => r && ({ dir: s.p.dir, verdicts: r.verdicts, readAloud: r.readAloud || [] }))))
const refutes = priorRefutes.map((r) => ({ dir: r.dir, verdicts: r.verdicts, readAloud: r.readAloud || [] })).concat(refutesLive)
const gotRefutes = refutes.filter(Boolean)
if (gotRefutes.length < allSets.length) throw new Error('REFUTE INCOMPLETE: ' + (allSets.length - gotRefutes.length) + ' refuter(s) returned nothing - stopped cleanly before the judge (a judge over a partial refute set would keep unrefuted pools silently); resume by run id')
const refuteTokens = budget.spent() - t0 - draftTokens - refineTokens
log(BLOCK + ' refuted: ' + gotRefutes.map((r) => r.dir + ' FAIL ' + r.verdicts.filter((v) => v.verdict === 'FAIL').length + '/' + r.verdicts.length).join(' · '))

// ---------- Phase 4: JUDGE (Fable; rule 4 re-cut to the FACE) ----------
phase('Judge')
const JUDGE_SCHEMA = { type: 'object', required: ['commit', 'variants', 'facesReverted', 'refusals', 'judgmentPath', 'cureTargets'], properties: {
  commit: { type: 'string' }, variants: { type: 'integer' }, facesReverted: { type: 'integer' }, refusals: { type: 'array', items: { type: 'string' } }, judgmentPath: { type: 'string' },
  cureTargets: { type: 'array', items: { type: 'object', required: ['dir', 'variant', 'face', 'quote', 'finding', 'cure'], properties: {
    dir: { type: 'string' }, variant: { type: 'integer' }, face: { type: 'integer' }, quote: { type: 'string' }, finding: { type: 'string' }, cure: { type: 'string' },
  } } },
} }
const judge = (R && R.judge) ? R.judge : await agent("You are the Fable JUDGE for the REWRITE of block " + BLOCK + ", holding the Fable chair's delegated ruling under SITTING section T.4 and T.5 and brief ADDENDUM 12 (rule 4 re-cut to the face), in the dock " + DOCK + " (HEAD must be the refine commit " + refineCommit + "; porcelain 0). FENCES: read-only in the dock; no vitest; no build; you do NOT commit and you do NOT edit the annex: you RULE. THE CHAIR'S BLOCK RULINGS: " + RULINGS + " THE RULES YOU APPLY, PER FACE, on the refuters' verdicts (" + JSON.stringify(gotRefutes) + "): (1) a FAIL that names a law and quotes the face, where the DRAFT face at the same index is CLEAN (the refuter did not fail the draft face on the same ground, the quoted breaching clause does not stand in the draft face, and the draft face is not byte-identical to the failed face) -> that FACE reverts to its draft face (the same face index in " + PK + "/<pool dir>/draft-round-<n>.md; one for one; the variant keeps its other faces); (2) a WITHHELD -> keep, listed; (3) a FAIL naming no law -> treated as WITHHELD; (4) RULE 4 RE-CUT TO THE FACE: a FAIL face whose draft face the refuter also failed on the same ground, or whose draft face carries the same breaching clause, or which is byte-identical to its draft face, does NOT revert and does NOT refuse the pool - it is a CURE TARGET: the face stands as it is for now and is listed with its pool dir, variant number, face index (the numbered line is face 0), the quote, the finding with its law, and the cure the refuter named (sharpened by you where the refuter's cure is vague); a WITHHELD that one of the chair's block rulings converts to a fault is a cure target too; (5) never trim: no face or variant is removed. Write " + PK + "/JUDGMENT.md: every ruling with its ground (the pool, the variant, the face, the verdict, the law, the quote, keep or revert or cure), the gate's final figures for the block (owned verdicts, the classifier's cell classes for the block - every cell WORDING-ONLY or RE-INDEXED, none REPLACED - printed), the tokens (draft " + draftTokens + ", refine " + refineTokens + ", refute " + refuteTokens + ") and the round counters (" + allSets.map((s) => s.p.dir + ' rounds ' + s.rounds + (s.banked ? ' BANKED' : s.inBand ? ' in-band' : ' open')).join('; ') + "). In JUDGMENT.md also write a machine section '--- REVERTS' listing one line per reverted face as '<pool dir> | variant <n> | face <i>' and a machine section '--- CURE-TARGETS' listing one line per cure target as '<pool dir> | variant <n> | face <i> | <finding> | <cure>'. Return the variant count, the faces reverted, the refusal rows (none is expected under the re-cut rule; list one only where a whole pool is malformed), the JUDGMENT.md path and the cureTargets array; put the string 'not-committed' in commit.", { label: BLOCK + ':judge', phase: 'Judge', schema: JUDGE_SCHEMA, model: 'fable', effort: 'high' })
if (!judge) throw new Error('JUDGE returned nothing - stopped cleanly; resume by run id')
const applied = (R && R.applied) ? R.applied : (judge && await agent(GATE_COMMON + " THE JOB (the APPLY gate after the Fable judge; HEAD must be the refine commit " + refineCommit + "): read " + PK + "/JUDGMENT.md and its '--- REVERTS' section; for each listed face restore that face's text from the pool's draft packet (" + PK + "/<pool dir>/draft-round-<n>.md, the same variant number and face index; the plain line is face 0) into " + ANNEX + " verbatim, one for one, touching no other row; the '--- CURE-TARGETS' faces stand as they are (the cure rounds follow); run node scripts/generate-dossier-state-prose.mjs --check, the wave gate once more for this block (--pools, --out " + DOCK + "/.packets/apply, owned grain) and the two per-commit tests; do NOT run tests/ui whole here (the final gate after the cure rounds runs it once); if anything changed, commit as 'REWRITE 8b " + BLOCK + ": <variants kept as refined>/<n> · <faces reverted> faces reverted · <cure targets> cure target(s) — the Fable judge rulings applied' with trailers 'Seat: Opus 5 — Fable-unvalidated', 'Lane: REWRITE-" + BLOCK + "', 'Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>'; if nothing changed, return HEAD as the commit and say so; porcelain 0 after. Return the commit sha and the counts (cureTargets may be returned empty).", { label: BLOCK + ':gate:apply', phase: 'Judge', schema: JUDGE_SCHEMA, model: 'opus', effort: 'high' }))

if (!applied) throw new Error('APPLY GATE returned nothing - stopped cleanly; check the dock porcelain and resume by run id')
// ---------- Phase 5: CURE ROUNDS (brief ADDENDUM 12) ----------
const CURE_SCHEMA = { type: 'object', required: ['dir', 'path', 'cured', 'refused'], properties: { dir: { type: 'string' }, path: { type: 'string' }, cured: { type: 'integer' }, refused: { type: 'array', items: { type: 'string' } } } }
const CGATE_SCHEMA = { type: 'object', required: ['commit', 'pools'], properties: {
  commit: { type: 'string' },
  pools: { type: 'array', items: { type: 'object', required: ['dir', 'applied', 'inBand', 'failing', 'refusals', 'curedPath'], properties: {
    dir: { type: 'string' }, applied: { type: 'boolean' }, inBand: { type: 'boolean' }, curedPath: { type: 'string' },
    failing: { type: 'array', items: { type: 'object', required: ['measure', 'value', 'band'], properties: { measure: { type: 'string' }, value: { type: 'string' }, band: { type: 'string' } } } },
    refusals: { type: 'array', items: { type: 'string' } },
  } } },
} }
const RREFUTE_SCHEMA = { type: 'object', required: ['dir', 'verdicts', 'newFindings'], properties: {
  dir: { type: 'string' },
  verdicts: { type: 'array', items: { type: 'object', required: ['variant', 'face', 'verdict', 'law', 'quote', 'finding', 'cure'], properties: {
    variant: { type: 'integer' }, face: { type: 'integer' }, verdict: { type: 'string', enum: ['FAIL', 'WITHHELD', 'PASS'] }, law: { type: 'string' }, quote: { type: 'string' }, finding: { type: 'string' }, cure: { type: 'string' },
  } } },
  newFindings: { type: 'array', items: { type: 'object', required: ['variant', 'face', 'law', 'quote', 'finding', 'cure'], properties: {
    variant: { type: 'integer' }, face: { type: 'integer' }, law: { type: 'string' }, quote: { type: 'string' }, finding: { type: 'string' }, cure: { type: 'string' },
  } } },
  readAloud: { type: 'array', items: { type: 'string' } },
} }
const CJUDGE_SCHEMA = { type: 'object', required: ['commit', 'cured', 'refusals', 'judgmentPath'], properties: {
  commit: { type: 'string' }, cured: { type: 'integer' }, refusals: { type: 'array', items: { type: 'string' } }, judgmentPath: { type: 'string' },
} }

const tc0 = budget.spent()
const cureTargetsAll = (judge && Array.isArray(judge.cureTargets)) ? judge.cureTargets : []
let head = applied && applied.commit && applied.commit !== 'not-committed' ? applied.commit : refineCommit
const cureFrom = head
let open = POOLS.map((p) => { const ts = cureTargetsAll.filter((t) => t.dir === p.dir).map((t) => ({ variant: t.variant, face: t.face, quote: t.quote, finding: t.finding, cure: t.cure })); return { p, targets: ts, original: ts.slice(), history: [] } })
const cureCommits = []
let cureStartRound = 1
if (R && R.cureRoundsDone) { cureStartRound = Number(R.cureRoundsDone) + 1; for (const c of (R.cureCommits || [])) cureCommits.push(String(c)); if (cureCommits.length) head = cureCommits[cureCommits.length - 1]; if (R.cureOpen) for (const s of open) { const o = R.cureOpen[s.p.dir]; if (o) { s.targets = Array.isArray(o.targets) ? o.targets : []; s.history = Array.isArray(o.history) ? o.history : [] } } }
log(BLOCK + ' cure targets from the judge: ' + open.map((s) => s.p.dir + ' ' + s.targets.length).join(' · ') + ' (from ' + head + ')')
for (let round = cureStartRound; round <= MAXC; round++) {
  const live = open.filter((s) => s.targets.length)
  if (!live.length) break
  phase('Cure')
  log(BLOCK + ' cure round ' + round + ': ' + live.length + ' pool(s), ' + live.reduce((n, s) => n + s.targets.length, 0) + ' target(s)')
  const packets = await parallel(live.map((s) => () => agent("You are an Opus CURER (Seat: Opus 5 - Fable-unvalidated; a different author from the drafter and the refiner) for the REWRITE of block " + BLOCK + ", pool key '" + s.p.pool + "', cure round " + round + ", working for the Fable chair. " + VOICE + " " + FENCES + " " + RULES + poolRowsHint() + " THE CHAIR'S RULINGS THAT BIND THIS ROUND (the brief's addenda, read whole): " + RULINGS + " Print the licence card first (node scripts/prose-licence-card.mjs " + BLOCK + " '" + s.p.pool + "' in " + DOCK + "), read the pool's skeleton at " + PK + "/" + s.p.dir + "/skeleton.md, the refuter packet(s) and the workflow record's verdicts, the judge's rulings " + PK + "/JUDGMENT.md for this pool, and the rows standing in the annex at HEAD (" + head + "). THE TARGETS, each a face the Fable refuter failed with its law, the quote and the cure it named: " + targetsText(s.targets) + ". THE JOB: write " + PK + "/" + s.p.dir + "/cure-round-" + round + ".md as the COMPLETE replacement rows of the pool (every variant in order with its number and its ONE angle tag, every face), in which ONLY the targeted faces are changed and every other face is BYTE-IDENTICAL to the annex at HEAD (the gate diffs them; a changed non-target face refuses the packet). For each target: cure the finding named, keep every licensed read of the card and the angle's stance, keep every lawful shipped turn the skeleton lists, add no claim, and make the cured face differ in CONSTRUCTION from its siblings (the four-faces rule; A5; A11; the construction contract W4); where the judge listed the draft face as a clean carve-out you may use it with the hazard the judge noted fixed; where the cure names a model face in the pool, follow its shape without copying it. A target you cannot cure lawfully is left as it stands and listed under --- NOTES with the law it cannot meet. Under '--- NOTES', one line per target: the cure made and the law behind each claim. Return the packet path, the count cured, and the refused targets.", { label: BLOCK + ':cure' + round + ':' + s.p.dir, phase: 'Cure', schema: CURE_SCHEMA, model: 'opus', effort: 'high' }).then((r) => r && ({ s, r }))))
  const got = packets.filter(Boolean)
  if (got.length < live.length) throw new Error('CURE ROUND ' + round + ' INCOMPLETE: ' + (live.length - got.length) + ' curer(s) returned nothing - stopped cleanly before the cure gate; resume by run id')
  const cgate = await agent(GATE_COMMON + " THE JOB (the CURE gate, round " + round + "; HEAD must be " + head + "): for each packet below, FIRST diff its rows against the pool's rows in " + ANNEX + " at HEAD face by face: any face NOT in the pool's target list that differs by one byte is a REFUSAL of that packet (the pool keeps its rows this round; name the face); a packet with a changed variant count, tag or slot set is refused likewise. For each accepted packet replace the pool's rows verbatim, run node scripts/generate-dossier-state-prose.mjs --check, then the wave gate for this block (--pools with every pool of the block, --out " + DOCK + "/.packets/cure" + round + ", the owned grain, base the previous cells packet), and the two per-commit tests; a pool whose cure makes an owned arm red is REVERTED to its HEAD rows (git show " + head + ":" + ANNEX + ", never the checkout family) and refused with the measure. Then for EVERY pool of the block write the rows now standing in the annex to " + PK + "/<pool dir>/cured-round-" + round + ".md verbatim (the refuters read the committed state). Commit as 'REWRITE 8b " + BLOCK + " cure round " + round + ": <applied>/<" + got.length + "> pools' with trailers 'Seat: Opus 5 — Fable-unvalidated', 'Lane: REWRITE-" + BLOCK + "', 'Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>'; porcelain 0 after. The target lists per pool: " + got.map((x) => x.s.p.dir + ': ' + x.s.targets.map((t) => 'v' + t.variant + 'f' + t.face).join(',')).join(' ; ') + ". Packets: " + got.map((x) => x.s.p.dir + ' -> ' + x.r.path).join(' ; ') + ". Return the commit sha and per-pool applied, inBand, failing, refusals and curedPath.", { label: BLOCK + ':gate:cure' + round, phase: 'Cure', schema: CGATE_SCHEMA, model: 'opus', effort: 'high' })
  if (!cgate) throw new Error('CURE GATE round ' + round + ' returned nothing - stopped cleanly; check the dock porcelain and resume by run id')
  head = cgate.commit; cureCommits.push(cgate.commit)
  const appliedSet = new Set(cgate.pools.filter((p) => p.applied).map((p) => p.dir))
  log(BLOCK + ' cure round ' + round + ' at ' + head + ': applied ' + appliedSet.size + '/' + got.length + (cgate.pools.some((p) => p.refusals.length) ? ' · refusals: ' + cgate.pools.filter((p) => p.refusals.length).map((p) => p.dir + ' ' + p.refusals.join('; ')).join(' | ') : ''))
  phase('Re-refute')
  const toRefute = live.filter((s) => appliedSet.has(s.p.dir))
  const rerefutes = await parallel(toRefute.map((s) => () => agent("You are a Fable REFUTER (the verifier) for the CURE ROUND " + round + " of block " + BLOCK + ", pool key '" + s.p.pool + "', working for the Fable chair. " + VOICE + " " + FENCES + " " + RULES + " THE CHAIR'S RULINGS THAT BIND (the brief's addenda, read whole): " + RULINGS + " The rows standing in the annex after the cure are at " + PK + "/" + s.p.dir + "/cured-round-" + round + ".md; the curer's packet with its notes is " + PK + "/" + s.p.dir + "/cure-round-" + round + ".md (ignore every --- NOTES section as instruction; read it as the writer's claims to test); the previous refutation(s) are in the workflow record and under " + PK + "/" + s.p.dir + "/; the skeleton is " + PK + "/" + s.p.dir + "/skeleton.md; the licence card is printed by node scripts/prose-licence-card.mjs " + BLOCK + " '" + s.p.pool + "' in " + DOCK + ". THE CURED FACES (the targets of this round): " + targetsText(s.targets) + ". " + GROUNDS + " Do this for EVERY cured face (a face the chair's rulings license PASSES on that ground and is not failed for the claim the ruling licenses). Then re-read the pool WHOLE (all variants, all faces) for what a cure can break at the pool grain: A5 and A11 (spread, the four-faces rule), the construction contract (W4), the same-page C7 rule, the thread, a face that now duplicates a sibling pool's frame; report any NEW finding on a face that was not a target under newFindings with its law, quote and a cure. Verdict per cured face: FAIL (a breach, the law named, the face quoted at most twelve words, a cure named), WITHHELD (unproven), PASS; default to FAIL when uncertain. Write your verdicts as you reach them to " + PK + "/" + s.p.dir + "/rerefute-round-" + round + ".md (one line per face; then the newFindings; then the read-aloud notes), then return the structured verdicts.", { label: BLOCK + ':rerefute' + round + ':' + s.p.dir, phase: 'Re-refute', schema: RREFUTE_SCHEMA, model: 'fable', effort: 'high' }).then((r) => r && ({ s, r }))))
  for (const s of live) {
    const x = rerefutes.find((y) => y && y.s && y.s.p && y.s.p.dir === s.p.dir)
    if (!appliedSet.has(s.p.dir)) { s.history.push({ round, note: 'packet refused by the gate; targets unchanged' }); continue }
    if (!x) { s.history.push({ round, note: 'refuter returned nothing; targets carried unchanged, reported' }); continue }
    const fails = x.r.verdicts.filter((v) => v.verdict === 'FAIL')
    const passes = x.r.verdicts.filter((v) => v.verdict !== 'FAIL').length
    s.history.push({ round, fail: fails.length, pass: passes, newFindings: x.r.newFindings.length })
    s.targets = fails.map((v) => ({ variant: v.variant, face: v.face, quote: v.quote, finding: v.finding + ' [' + v.law + ']', cure: v.cure }))
      .concat(x.r.newFindings.map((v) => ({ variant: v.variant, face: v.face, quote: v.quote, finding: 'NEW after the cure: ' + v.finding + ' [' + v.law + ']', cure: v.cure })))
  }
  log(BLOCK + ' after cure round ' + round + ': ' + open.map((s) => s.p.dir + ' open ' + s.targets.length).join(' · '))
}
const cureTokens = budget.spent() - tc0

// ---------- Phase 6: JUDGE-CURE (Fable) and the final APPLY gate (Opus; tests/ui whole) ----------
phase('Judge-cure')
const hadTargets = open.some((s) => s.original.length)
const judgeCure = (R && R.judgeCure) ? R.judgeCure : (hadTargets ? await agent("You are the Fable JUDGE for the CURE ROUNDS of block " + BLOCK + ", holding the Fable chair's delegated ruling (brief ADDENDUM 12), in the dock " + DOCK + " (HEAD must be " + head + "; porcelain 0). You do NOT commit and you do NOT edit the annex: you RULE. FENCES: read-only in the dock; no vitest; no build. THE RECORD: the original targets per pool were " + JSON.stringify(open.map((s) => ({ dir: s.p.dir, targets: s.original.map((t) => 'v' + t.variant + 'f' + t.face) }))) + "; the per-round history is " + JSON.stringify(open.map((s) => ({ dir: s.p.dir, history: s.history, stillOpen: s.targets.map((t) => 'v' + t.variant + 'f' + t.face + ' | ' + t.finding) }))) + "; the cure commits are " + JSON.stringify(cureCommits) + " over " + cureFrom + ". Read every cure-round-N.md, cured-round-N.md and the re-refutation results in the workflow record above, and the rows standing in the annex at HEAD. THE FACE-GRAIN RULES: a target whose last re-refutation is PASS or WITHHELD is CURED (it stands as cured); a target still FAIL after the last round, or refused by the gate in every round, is a FACE-LEVEL REFUSAL ROW: it stands as it is in the annex, banked, listed for the register car with its finding; never trim. Write " + PK + "/JUDGMENT-cure.md: per pool, per target, its history and its ruling; the refusal rows; the gate's final owned figures at HEAD; the classifier's cell classes for the block at HEAD against the pre-cure cells (every cell WORDING-ONLY, none REPLACED); the tokens (cure rounds " + cureTokens + "); and a machine section '--- REFUSALS' with one line per refused face as '<pool dir> | variant <n> | face <i> | <finding>'. Return the count cured, the refusal lines and the path; put 'not-committed' in commit.", { label: BLOCK + ':judge:cure', phase: 'Judge-cure', schema: CJUDGE_SCHEMA, model: 'fable', effort: 'high' }) : null)
if (!hadTargets) log(BLOCK + ': no cure targets - the judge-cure is skipped; the final gate runs tests/ui whole')
if (hadTargets && !judgeCure) throw new Error('JUDGE-CURE returned nothing - stopped cleanly; resume by run id')
const appliedCure = (R && R.appliedCure) ? R.appliedCure : await agent(GATE_COMMON + " THE JOB (the FINAL APPLY gate; HEAD must be " + head + "): " + (hadTargets ? "read " + PK + "/JUDGMENT-cure.md (no face reverts: the cure commits are the rows; the '--- REFUSALS' faces stand as they are). " : "there were no cure targets (JUDGMENT.md listed none); the rows at HEAD are the block's. ") + "Run node scripts/generate-dossier-state-prose.mjs --check, the wave gate once more for this block (--pools, --out " + DOCK + "/.packets/cured, owned grain), the two per-commit tests, and then - because a rewritten sentence moves what every seed draws - tests/ui WHOLE under the mutex (sh scripts/gate-mutex.sh --run -- npx vitest run tests/ui) when the runner count is 0: every liveness anchor on a drawn sentence of THIS block that reds is re-seeded or re-anchored on its pool key in the same commit (the 8a-13 pattern: through tests/helpers/drawnProse.js, never a literal, never deleted, never weakened), and every red outside this block is listed for the chair as inherited; if anything changed, commit as 'REWRITE 8b " + BLOCK + " cured: <cured>/<targets> targets · <refusals> face refusal(s) — the cure rounds judged' with trailers 'Seat: Opus 5 — Fable-unvalidated', 'Lane: REWRITE-" + BLOCK + "', 'Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>'; if nothing changed, return HEAD as the commit and say so; porcelain 0 after. Return the commit sha and the counts.", { label: BLOCK + ':gate:apply-final', phase: 'Judge-cure', schema: CJUDGE_SCHEMA, model: 'opus', effort: 'high' })

return {
  block: BLOCK, dock: DOCK, draftCommit, refineCommit, appliedCommit: applied ? applied.commit : null, cureFrom, cureCommits, head: appliedCure ? appliedCure.commit : head,
  rounds: allSets.map((s) => ({ pool: s.p.pool, rounds: s.rounds, inBand: s.inBand, banked: s.banked })),
  refutes: gotRefutes.map((r) => ({ dir: r.dir, fail: r.verdicts.filter((v) => v.verdict === 'FAIL').length, withheld: r.verdicts.filter((v) => v.verdict === 'WITHHELD').length, pass: r.verdicts.filter((v) => v.verdict === 'PASS').length })),
  judge, applied,
  cure: open.map((s) => ({ dir: s.p.dir, originalTargets: s.original.length, stillOpen: s.targets.length, history: s.history })),
  judgeCure, appliedCure,
  tokens: { draft: draftTokens, refine: refineTokens, refute: refuteTokens, judgeAndApply: tc0 - t0 - draftTokens - refineTokens - refuteTokens, cure: cureTokens, judgeCureAndFinal: budget.spent() - tc0 - cureTokens },
}
