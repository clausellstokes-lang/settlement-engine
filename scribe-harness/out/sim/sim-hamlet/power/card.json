 "page": [
  {
   "kind": "town",
   "label": "town",
   "section": "header",
   "text": "Warmholz · hamlet · germanic · threat frontier · route road · terrain river · seed sim-hamlet"
  },
  {
   "kind": "roster",
   "label": "chain.power",
   "section": "chain",
   "text": "the power: Free Elder Council"
  },
  {
   "kind": "roster",
   "label": "chain.faction",
   "section": "chain",
   "text": "the faction: Free Elder Council"
  },
  {
   "kind": "machine",
   "label": "chain.absence",
   "section": "chain",
   "text": "No named seat-holder stands in the record. The chain ends, honestly, at the faction."
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "Legitimacy Crisis",
   "section": "legitimacy",
   "text": "Almost nothing the Free Elder Council asks of Warmholz arrives. The rolls are still kept, out of form rather than expectation, and the clerks who keep them have stopped chasing what is missing.",
   "vid": 1
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "governanceFractured true",
   "section": "legitimacy",
   "text": "A stranger at Warmholz is sent to the Free Elder Council and gets nothing done, then sent to somebody with no title at all and has it settled the same afternoon.",
   "vid": 1
  },
  {
   "kind": "badge",
   "label": "powerStructure.stability",
   "section": "stability",
   "text": "Tense (monster pressure from surrounding region)"
  },
  {
   "kind": "roster",
   "label": "governingName",
   "section": "stability",
   "text": "Free Elder Council"
  },
  {
   "kind": "machine",
   "label": "recentConflict",
   "section": "stability",
   "text": "A farmstead a short walk from here was destroyed last night. The family is gone. No one is going to look for them."
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "no token matched: unclassified (the plain-description floor)",
   "section": "stability",
   "text": "Free Elder Council holds the hall at Warmholz and the town's affairs run through it.",
   "vid": 0
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "governing faction holds a DOMINANT share",
   "section": "stability",
   "text": "Free Elder Council does not merely govern Warmholz, it outweighs everything else in the town put together; the other houses are consulted as a courtesy and know it.",
   "vid": 0
  },
  {
   "block": "DS-POW-6",
   "face": 0,
   "kind": "composed",
   "mount": "power.criminalUnderside",
   "pool": "capture pressure ADVANCING (weak security, poor prosperity)",
   "section": "underside",
   "text": "The criminal interest at Warmholz is gaining ground inside the hall rather than outside it; a poorly-paid, poorly-policed town is cheap to buy into and this one is both.",
   "vid": 0
  },
  {
   "block": "DS-POW-7",
   "face": 0,
   "kind": "composed",
   "mount": "power.blocs",
   "pool": "layer DORMANT (no ledger materialized)",
   "section": "blocs",
   "text": "There are interests at Warmholz and there are no camps; a question is answered by whoever cares about that question.",
   "vid": 1
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "council",
   "section": "structure",
   "text": "Decisions at Warmholz are averaged before they are made and stick once they are; the Free Elder Council moves slowly and does not readily move back.",
   "vid": 0
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "governing body name: a SLOT, never a baked noun",
   "section": "structure",
   "text": "A stranger who addresses the Free Elder Council at Warmholz by any other title is corrected, politely and immediately.",
   "vid": 1
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "riskLabel: Contested",
   "section": "succession",
   "text": "Warmholz is no longer certain the hall belongs to Free Elder Council, and neither, from the way it governs, is Free Elder Council.",
   "vid": 1
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "legitimacyHold: public rejection is breaking the hold",
   "section": "succession",
   "text": "What the Free Elder Council has lost at Warmholz it has lost to the town rather than to a rival, and no rival was required.",
   "vid": 2
  }
 ],
