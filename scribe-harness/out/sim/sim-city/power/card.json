 "page": [
  {
   "kind": "town",
   "label": "town",
   "section": "header",
   "text": "Rundgate · city · germanic · threat frontier · route road · terrain river · seed sim-city"
  },
  {
   "kind": "roster",
   "label": "chain.power",
   "section": "chain",
   "text": "the power: City Council"
  },
  {
   "kind": "roster",
   "label": "chain.faction",
   "section": "chain",
   "text": "the faction: City Council"
  },
  {
   "kind": "roster",
   "label": "chain.npc",
   "section": "chain",
   "text": "the seat: Theodor Lenz · Mayor"
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "Approved",
   "section": "legitimacy",
   "text": "The City Council at Rundgate governs with a modest edge in its favour; where it asks it is generally given, and the exceptions are few enough that the clerks can name them.",
   "vid": 1
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "breakdown dominated by PROSPERITY, favourable",
   "section": "legitimacy",
   "text": "Rundgate credits the City Council with the good years whether or not the City Council earned them; the prosperity is the whole of the argument in its favour.",
   "vid": 1
  },
  {
   "kind": "badge",
   "label": "powerStructure.stability",
   "section": "stability",
   "text": "Stable"
  },
  {
   "kind": "roster",
   "label": "governingName",
   "section": "stability",
   "text": "City Council"
  },
  {
   "kind": "machine",
   "label": "recentConflict",
   "section": "stability",
   "text": "City Council has been debating market levies for three months. The merchants have stopped attending the sessions. Both sides are now acting as if the other has already lost."
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "stable matched",
   "section": "stability",
   "text": "What is settled at Rundgate is the hall and only the hall; the town's steadiness is a statement about who answers, and not about what the answers will be.",
   "vid": 3
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "recentConflict present",
   "section": "stability",
   "text": "Nobody at Rundgate needs the trouble explained to them; it is recent enough that the town simply refers to it and moves on.",
   "vid": 2
  },
  {
   "block": "DS-POW-6",
   "face": 0,
   "kind": "composed",
   "mount": "power.criminalUnderside",
   "pool": "operation role criminal revenue stream (unclassified)",
   "section": "underside",
   "text": "There is criminal infrastructure at Rundgate with local weight, territorial or economic, and no clearer description of it than that.",
   "vid": 0
  },
  {
   "block": "DS-POW-7",
   "face": 0,
   "kind": "composed",
   "mount": "power.blocs",
   "pool": "layer DORMANT (no ledger materialized)",
   "section": "blocs",
   "text": "The hall at Rundgate is not organized into sides. The factions sit as factions, and nothing binds any two of them into anything larger.",
   "vid": 0
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "council",
   "section": "structure",
   "text": "What the City Council at Rundgate watches for is the town's own temper. A council falls to unrest rather than to a rival, and it knows it.",
   "vid": 2
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "governing body name: a SLOT, never a baked noun",
   "section": "structure",
   "text": "A stranger who addresses the City Council at Rundgate by any other title is corrected, politely and immediately.",
   "vid": 1
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "riskLabel: Holding",
   "section": "succession",
   "text": "City Council outweighs everyone who wants the City Council at Rundgate, and the wanting is on the record. The hold is real and it is not comfortable.",
   "vid": 0
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "legitimacyHold: public backing hardens the hold",
   "section": "succession",
   "text": "Public backing at Rundgate is hardening the City Council's grip; what would be a contest elsewhere is an inconvenience here.",
   "vid": 1
  }
 ],
