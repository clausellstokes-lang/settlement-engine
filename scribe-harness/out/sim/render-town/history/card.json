 "page": [
  {
   "kind": "town",
   "label": "town",
   "section": "header",
   "text": "Spitzplatz · town · germanic · threat frontier · route road · terrain river · seed render-town"
  },
  {
   "block": "DS-GEN-14",
   "face": 0,
   "kind": "composed",
   "mount": "history.founded",
   "pool": "FOUNDED-OLD",
   "section": "founding",
   "text": "The town's first reason is on record and its present shape is the record of everything since; Spitzplatz is the argument and all its revisions at once.",
   "vid": 1
  },
  {
   "block": "DS-GEN-16",
   "face": 0,
   "kind": "composed",
   "mount": "history.record",
   "pool": "LAYERED-ANCHORED",
   "section": "founding",
   "text": "Spitzplatz's record is a stack of hard seasons survived in order, and the record still marks each of them as bearing on the town.",
   "vid": 0
  },
  {
   "block": "DS-GEN-9",
   "face": 0,
   "kind": "composed",
   "mount": "history.identity",
   "pool": "founding",
   "section": "identity",
   "text": "The oldest part of Spitzplatz still shows what the town was for when it started, which is not always what it is for now.",
   "vid": 3
  },
  {
   "block": "DS-GEN-9",
   "face": 0,
   "kind": "composed",
   "mount": "history.identity",
   "pool": "historicalCharacter",
   "section": "identity",
   "text": "What Spitzplatz is like takes a stranger a day to notice and a season to believe.",
   "vid": 2
  },
  {
   "block": "DS-GEN-9",
   "face": 0,
   "kind": "composed",
   "mount": "history.identity",
   "pool": "event type: magical",
   "section": "identity",
   "text": "Spitzplatz still keeps rules written after The Arcane Incident, and the rules are specific in a way that suggests they were written by people who were there.",
   "vid": 1
  },
  {
   "block": "DS-GEN-9",
   "face": 0,
   "kind": "composed",
   "mount": "history.identity",
   "pool": "recency framing: Living memory",
   "section": "identity",
   "text": "There are people in Spitzplatz who were there, and their account is not quite the town's account.",
   "vid": 0
  },
  {
   "kind": "machine",
   "label": "The Flood",
   "section": "record",
   "text": "Waters rose with little warning and reshaped the mill and lumber district, drowning livelihoods and redrawing who owned what"
  },
  {
   "kind": "machine",
   "label": "The Trade Collapse",
   "section": "record",
   "text": "The overland trade that had made the settlement what it was collapsed, and the prosperity it once brought bled away over a handful of lean years"
  },
  {
   "kind": "machine",
   "label": "The Economic Divide",
   "section": "record",
   "text": "Growing wealth gap between merchant class and common laborers creates resentment"
  },
  {
   "kind": "machine",
   "label": "The Occupation",
   "section": "record",
   "text": "An occupation had ended years before, yet those who collaborated and those who resisted still lived as neighbours, the reckoning never made"
  },
  {
   "kind": "machine",
   "label": "The Purge",
   "section": "record",
   "text": "Fear of hidden infiltrators (not always unfounded) bred denunciations and a climate of mistrust"
  },
  {
   "kind": "machine",
   "label": "The Migration",
   "section": "record",
   "text": "A recently arrived group and the established population fell into sustained, low-level conflict"
  },
  {
   "kind": "machine",
   "label": "The Arcane Incident",
   "section": "record",
   "text": "Debate over the role and regulation of magic divided the community"
  }
 ],
