  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "Approved",
   "section": "legitimacy",
   "text": "The Guild Council's standing at Spitzplatz is good and is doing work. The margin is what lets it spend goodwill on the decisions the town would otherwise refuse it.",
   "vid": 3
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "breakdown dominated by PROSPERITY, favourable",
   "section": "legitimacy",
   "text": "The Guild Council's standing at Spitzplatz rests on the town's prosperity, which makes it exactly as durable as the prosperity is and no more.",
   "vid": 2
  },
  {
   "kind": "badge",
   "label": "powerStructure.stability",
   "section": "stability",
   "text": "Stable"
  },
  {
   "kind": "roster",
   "label": "governingName",
   "section": "stability",
   "text": "Guild Council"
  },
  {
   "kind": "machine",
   "label": "recentConflict",
   "section": "stability",
   "text": "Guild Council has been debating market levies for three months. The merchants have stopped attending the sessions. Both sides are now acting as if the other has already lost."
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "stable matched",
   "section": "stability",
   "text": "A stranger doing business at Spitzplatz needs one name and gets one answer, and can plan a season ahead on the strength of it.",
   "vid": 2
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "recentConflict present",
   "section": "stability",
   "text": "Nobody at Spitzplatz needs the trouble explained to them; it is recent enough that the town simply refers to it and moves on.",
   "vid": 2
  },
  {
   "block": "DS-POW-6",
   "face": 0,
   "kind": "composed",
   "mount": "power.criminalUnderside",
   "pool": "operation role money laundering",
   "section": "underside",
   "text": "The books of several houses at Spitzplatz are impeccable, and the impeccability is the service being purchased.",
   "vid": 2
  },
  {
   "block": "DS-POW-7",
   "face": 0,
   "kind": "composed",
   "mount": "power.blocs",
   "pool": "layer DORMANT (no ledger materialized)",
   "section": "blocs",
   "text": "There are interests at Spitzplatz and there are no camps; a question is answered by whoever cares about that question.",
   "vid": 1
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "mixed",
   "section": "structure",
   "text": "The town cannot say in one word what kind of place it is governed as, and neither can the hall.",
   "vid": 1
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "governing body name: a SLOT, never a baked noun",
   "section": "structure",
   "text": "The town at Spitzplatz calls the hall by its proper title in public and something shorter everywhere else, and both usages are precise.",
   "vid": 2
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "riskLabel: Holding",
   "section": "succession",
   "text": "The Guild Council at Spitzplatz holds because Guild Council is still the heavier of the two, and the weighing is done again every season.",
   "vid": 2
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "legitimacyHold: public backing hardens the hold",
   "section": "succession",
   "text": "There are people at Spitzplatz who would move on the Guild Council and do not, because moving on a ruler the town is behind costs more than the seat is worth.",
   "vid": 2
  }
 ],
