 "page": [
  {
   "kind": "town",
   "label": "town",
   "section": "header",
   "text": "Hochhausen · village · germanic · threat frontier · route road · terrain river · seed sim-village"
  },
  {
   "kind": "roster",
   "label": "chain.power",
   "section": "chain",
   "text": "the power: Elected Reeve"
  },
  {
   "kind": "roster",
   "label": "chain.faction",
   "section": "chain",
   "text": "the faction: Elected Reeve"
  },
  {
   "kind": "roster",
   "label": "chain.npc",
   "section": "chain",
   "text": "the seat: Ivo Werner · Mayor"
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "Tolerated",
   "section": "legitimacy",
   "text": "The Elected Reeve at Hochhausen has neither the town's backing nor its hostility, so it can rule but it cannot spend. A hard decision here would have to be paid for out of an empty purse.",
   "vid": 3
  },
  {
   "block": "DS-POW-1",
   "face": 0,
   "kind": "composed",
   "mount": "power.legitimacyBanner",
   "pool": "breakdown dominated by PROSPERITY, favourable",
   "section": "legitimacy",
   "text": "The Elected Reeve at Hochhausen is well thought of and the reason is in the accounts: the town is doing well, and a town doing well rarely looks hard at who is arranging it.",
   "vid": 0
  },
  {
   "kind": "badge",
   "label": "powerStructure.stability",
   "section": "stability",
   "text": "Stable"
  },
  {
   "kind": "roster",
   "label": "governingName",
   "section": "stability",
   "text": "Elected Reeve"
  },
  {
   "kind": "machine",
   "label": "recentConflict",
   "section": "stability",
   "text": "Elected Reeve has been debating market levies for three months. The merchants have stopped attending the sessions. Both sides are now acting as if the other has already lost."
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "stable matched",
   "section": "stability",
   "text": "The hall at Hochhausen is settled. Elected Reeve holds it, the town expects Elected Reeve to go on holding it, and business is conducted on that expectation.",
   "vid": 0
  },
  {
   "block": "DS-POW-2",
   "face": 0,
   "kind": "composed",
   "mount": "power.stabilityHeader",
   "pool": "governing faction holds a NARROW plurality",
   "section": "stability",
   "text": "Elected Reeve holds the hall at Hochhausen because it is first and not because it is large; the town treats the arrangement as current rather than settled.",
   "vid": 1
  },
  {
   "block": "DS-POW-7",
   "face": 0,
   "kind": "composed",
   "mount": "power.blocs",
   "pool": "layer DORMANT (no ledger materialized)",
   "section": "blocs",
   "text": "There are interests at Hochhausen and there are no camps; a question is answered by whoever cares about that question.",
   "vid": 1
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "mixed",
   "section": "structure",
   "text": "Nothing at Hochhausen governs cleanly. The Elected Reeve is an arrangement between kinds of power, and it decides at the pace of whichever of them is least willing.",
   "vid": 0
  },
  {
   "block": "DS-POW-5",
   "face": 0,
   "kind": "composed",
   "mount": "power.rulingStructure",
   "pool": "governing body name: a SLOT, never a baked noun",
   "section": "structure",
   "text": "What governs Hochhausen calls itself the Elected Reeve, and the name is precise about the town's size and pretensions in a way outsiders routinely mistake.",
   "vid": 0
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "riskLabel: Holding",
   "section": "succession",
   "text": "Hochhausen has people who would take the hall if they could, and they cannot, and everybody involved understands the arrangement precisely.",
   "vid": 1
  },
  {
   "block": "DS-POW-4",
   "face": 0,
   "kind": "composed",
   "mount": "power.succession",
   "pool": "legitimacyHold: public opinion neither helps nor hurts",
   "section": "succession",
   "text": "Hochhausen neither backs the Elected Reeve nor moves against it, and the Elected Reeve governs on its own strength alone.",
   "vid": 1
  }
 ],
