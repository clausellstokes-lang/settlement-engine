 "page": [
  {
   "kind": "town",
   "label": "town",
   "section": "header",
   "text": "Hochhausen · village · germanic · threat frontier · route road · terrain river · seed sim-village"
  },
  {
   "kind": "badge",
   "label": "readiness",
   "section": "posture",
   "text": "Lightly Defended"
  },
  {
   "kind": "machine",
   "label": "guardEffectivenessDesc",
   "section": "posture",
   "text": "A mercenary company provides enforcement: professional and effective, but loyal to the contract, not the community. When the coin stops, so does the protection. Without courts or prison, enforcement relies entirely on fines, exile, or summary violence."
  },
  {
   "block": "DS-DEF-1",
   "face": 0,
   "kind": "composed",
   "mount": "defense.postureHeader",
   "pool": "readiness WEAK",
   "section": "posture",
   "text": "The defensive arrangements at Hochhausen are thin. Something is in place against most pressures and nothing is in place in depth.",
   "vid": 0
  },
  {
   "block": "DS-DEF-2",
   "face": 4,
   "kind": "composed",
   "mount": "defense.threatAssessment",
   "pool": "Invasion & War: neither walls nor force",
   "section": "threat",
   "text": "At the tavern anybody can name the houses that would come out if anything happened, the naming being where it has always stopped.",
   "vid": 2
  },
  {
   "block": "DS-DEF-2",
   "face": 4,
   "kind": "composed",
   "mount": "defense.threatAssessment",
   "pool": "Internal Security: no legal infrastructure",
   "section": "threat",
   "text": "Whoever digs the ground holds that it takes a stranger on the same terms as anyone, whatever was or was not agreed about him.",
   "vid": 2
  },
  {
   "block": "DS-DEF-2",
   "face": 7,
   "kind": "composed",
   "mount": "defense.threatAssessment",
   "pool": "Economic Survival: WEAK",
   "section": "threat",
   "text": "At the market they say the place takes from whoever can be found, and there is nothing easier to find than a stall.",
   "vid": 1
  },
  {
   "block": "DS-DEF-2",
   "face": 1,
   "kind": "composed",
   "mount": "defense.threatAssessment",
   "pool": "Disasters & Famine: NO reserves, NO medical provision",
   "section": "threat",
   "text": "By a carter's reckoning the sacks that leave a house for the stone are counted going and not counted coming back.",
   "vid": 2
  },
  {
   "kind": "row",
   "label": "Beasts & Monsters",
   "section": "threat",
   "text": "Beasts & Monsters — WEAK"
  },
  {
   "kind": "machine",
   "label": "Beasts & Monsters.assess",
   "section": "threat",
   "text": "Active frontier with no organized defense. Vulnerable to any monster of moderate capability."
  },
  {
   "kind": "row",
   "label": "Invasion & War",
   "section": "threat",
   "text": "Invasion & War — ADEQUATE"
  },
  {
   "kind": "machine",
   "label": "Invasion & War.assess",
   "section": "threat",
   "text": "No walls or garrison. Cannot resist organized military aggression. Survival depends entirely on distance, diplomacy, or irrelevance to the attacker."
  },
  {
   "kind": "row",
   "label": "Internal Security",
   "section": "threat",
   "text": "Internal Security — WEAK"
  },
  {
   "kind": "machine",
   "label": "Internal Security.assess",
   "section": "threat",
   "text": "Internal security: Moderate. No legal infrastructure: order relies on force alone."
  },
  {
   "kind": "row",
   "label": "Economic Survival",
   "section": "threat",
   "text": "Economic Survival — WEAK"
  },
  {
   "kind": "machine",
   "label": "Economic Survival.assess",
   "section": "threat",
   "text": "Chronic underfunding limits emergency response. A sustained crisis will exhaust reserves and undermine garrison morale."
  },
  {
   "kind": "row",
   "label": "Disasters & Famine",
   "section": "threat",
   "text": "Disasters & Famine — STRONG"
  },
  {
   "kind": "machine",
   "label": "Disasters & Famine.assess",
   "section": "threat",
   "text": "No food reserves. A crop failure or supply disruption causes immediate hardship. Parish clergy provide basic wound care: better than nothing, worse than a hospital."
  },
  {
   "kind": "badge",
   "label": "safetyLabel",
   "section": "order",
   "text": "Moderate"
  },
  {
   "kind": "machine",
   "label": "safetyDesc",
   "section": "order",
   "text": "A mix of safer and more exposed areas. Locals watch over the main paths; quieter spots after dark carry genuine risk. Residents know which corners to avoid."
  },
  {
   "block": "DS-DEF-3",
   "face": 0,
   "kind": "composed",
   "mount": "defense.publicOrder",
   "pool": "Moderate",
   "section": "order",
   "text": "Enforcement and criminal presence at Hochhausen sit close enough that the town's condition is a matter of which way the next few seasons go.",
   "vid": 1
  },
  {
   "block": "DS-DEF-3",
   "face": 0,
   "kind": "composed",
   "mount": "defense.publicOrder",
   "pool": "First-Survey qualification (the reading is a first look)",
   "section": "order",
   "text": "The safety reading for Hochhausen is an initial one. It is honest about what has been seen and says nothing about what has not.",
   "vid": 1
  },
  {
   "block": "DS-DEF-4",
   "face": 0,
   "kind": "composed",
   "mount": "defense.criminalStructure",
   "pool": "structure null (nothing organized recognized)",
   "section": "order",
   "text": "A stranger asking after the arrangements at Hochhausen is met with genuine incomprehension, which is either the truth or an unusually good performance of it.",
   "vid": 2
  },
  {
   "block": "DS-DEF-4",
   "face": 0,
   "kind": "composed",
   "mount": "defense.criminalStructure",
   "pool": "capture none",
   "section": "order",
   "text": "Whatever is being run at Hochhausen is being run outside the hall, and the town's dealings with the hall are the town's dealings with the hall.",
   "vid": 2
  },
  {
   "block": "DS-DEF-5",
   "face": 0,
   "kind": "composed",
   "mount": "defense.armedForces",
   "pool": "walls ABSENT",
   "section": "forces",
   "text": "The town has an edge rather than a boundary at Hochhausen, and the edge is wherever the last building happens to be.",
   "vid": 2
  },
  {
   "block": "DS-DEF-5",
   "face": 0,
   "kind": "composed",
   "mount": "defense.armedForces",
   "pool": "charter hall PRESENT (specialist monster response)",
   "section": "forces",
   "text": "A stranger at Hochhausen finds a hall whose business is the sort of trouble a garrison is the wrong instrument for, and finds it busy.",
   "vid": 2
  },
  {
   "block": "DS-DEF-5",
   "face": 0,
   "kind": "composed",
   "mount": "defense.armedForces",
   "pool": "arcane defense ABSENT",
   "section": "forces",
   "text": "The town has no answer to anything it cannot see, and is unprepared rather than protected in that respect.",
   "vid": 1
  },
  {
   "block": "DS-DEF-11",
   "face": 0,
   "kind": "composed",
   "mount": "defense.wallRationale",
   "pool": "UNWALLED-SMALL",
   "section": "forces",
   "text": "No wall marks where Hochhausen ends; at this size the country and the town simply agree to differ.",
   "vid": 1
  },
  {
   "kind": "roster",
   "label": "charter",
   "section": "forces",
   "text": "charter: Adventurers' charter hall"
  },
  {
   "block": "DS-DEF-6",
   "face": 0,
   "kind": "composed",
   "mount": "defense.supportingCapabilities",
   "pool": "Logistics & Supply: No reserves, landlocked",
   "section": "supporting",
   "text": "The town eats what arrives, and has nothing put by against a season when nothing does.",
   "vid": 1
  },
  {
   "kind": "machine",
   "label": "Economic Backing",
   "section": "supporting",
   "text": "Economic Backing: Underfunded — Irregular pay, worn equipment, morale risk."
  },
  {
   "kind": "machine",
   "label": "Magical Capability",
   "section": "supporting",
   "text": "Magical Capability: None — Conventional defense only. Invisible threats go undetected and unanswered."
  },
  {
   "kind": "machine",
   "label": "Legal Infrastructure",
   "section": "supporting",
   "text": "Legal Infrastructure: None — No deterrence beyond force."
  },
  {
   "kind": "machine",
   "label": "Medical Readiness",
   "section": "supporting",
   "text": "Medical Readiness: Clergy care — Parish care. Basic wound and disease management."
  },
  {
   "kind": "machine",
   "label": "Logistics & Supply",
   "section": "supporting",
   "text": "Logistics & Supply: No reserves — No food buffer. Any supply disruption becomes a survival crisis within days."
  }
 ],
