import { SIMULATION_RULE_PRESETS, DEFAULT_SIMULATION_RULES, RULE_COMPARISON_KEYS, DEFAULT_SIMULATION_PRESET_ID, normalizeSimulationRules } from './src/domain/worldPulse/simulationRules.js';
const rr = SIMULATION_RULE_PRESETS[DEFAULT_SIMULATION_PRESET_ID].rules;
const full = SIMULATION_RULE_PRESETS.full_simulation.rules;
const defKeys = new Set(Object.keys(DEFAULT_SIMULATION_RULES));
const cmp = new Set(RULE_COMPARISON_KEYS);
// the keys realistic_regional carries that are NOT in DEFAULT_SIMULATION_RULES (i.e. the lit virtual keys)
const virt = Object.keys(rr).filter(k => k !== 'presetId' && !defKeys.has(k));
console.log('DEFAULT_SIMULATION_PRESET_ID =', DEFAULT_SIMULATION_PRESET_ID);
console.log('realistic_regional total keys =', Object.keys(rr).length);
console.log('VIRTUAL keys on realistic_regional =', virt.length);
console.log(JSON.stringify(virt, null, 1));
console.log('any of them in DEFAULT_SIMULATION_RULES?', virt.filter(k=>defKeys.has(k)));
console.log('any of them in RULE_COMPARISON_KEYS?', virt.filter(k=>cmp.has(k)));
console.log('RULE_COMPARISON_KEYS count =', RULE_COMPARISON_KEYS.length);
console.log('all virt values true?', virt.every(k=>rr[k]===true));
console.log('all virt also lit in full_simulation?', virt.filter(k=>full[k]!==true));
// identity
const keyless = { ...rr }; delete keyless.presetId;
console.log('IDENTITY keyless re-infers =', normalizeSimulationRules(keyless).presetId);
console.log('IDENTITY legacy-save (empty) infers =', normalizeSimulationRules({}).presetId);
// a legacy realistic_regional save: DEFAULT surface only, no virtual keys
const legacy = { ...DEFAULT_SIMULATION_RULES, narrativeTempo: 'realistic_regional' };
console.log('IDENTITY legacy RR save (no virtual keys) infers =', normalizeSimulationRules(legacy).presetId);
// leak-under-overlay arithmetic
const fullKeys = Object.keys(full);
const rows = Object.fromEntries(Object.keys(SIMULATION_RULE_PRESETS).map(id => {
  const own = new Set(Object.keys(SIMULATION_RULE_PRESETS[id].rules));
  return [id, fullKeys.filter(k=>!own.has(k)).length];
}));
console.log('leakedUnderOverlay =', JSON.stringify(rows));
