# ── Supabase (required for cloud saves and auth) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── Azgaar FMG (required for production World Map isolation) ──────────────────
# Production is deliberately pinned to this CSP-approved, separate origin.
# Local Vite development may omit it and use /map/index.html on localhost.
VITE_FMG_URL=https://map.settlementforge.com/map/index.html

# ── Analytics provider (optional — pick ONE) ──────────────────────────────────
# Tier 8.8 funnel events fire to window.__sf_analytics_provider; setting one of
# these env vars installs a provider that bridges to a real dashboard.
#
# Plausible (privacy-first, no cookies, no consent banner needed for EU):
# VITE_PLAUSIBLE_DOMAIN=settlementforge.com
# VITE_PLAUSIBLE_API=https://plausible.io        # only for self-hosted Plausible
#
# PostHog (full product analytics; requires posthog-js + a consent gate):
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://app.posthog.com

# ── Client error reporting (optional) ─────────────────────────────────────────
# The client error reporter (src/lib/errorReporter.js) ALWAYS logs render
# crashes + unhandled rejections locally. It only forwards a compact, PII-light
# JSON payload over the network when this is set, so it is a no-op (network-wise)
# until you point it at a sink. Use any HTTPS endpoint: a Supabase edge function,
# a Sentry tunnel, Logflare, etc.
# VITE_ERROR_REPORT_URL=https://your-sink.example.com/errors

# ── Supabase Edge Function secrets (set in Supabase dashboard, not here) ──────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# ── Stripe price ids: ACTIVE catalog ─────────────────────────────────────────
# One line per key in ACTIVE_CHECKOUT_SKUS (src/config/pricing.js); a walker in
# tests/config/pricing.test.js keeps the two in step in both directions. An unset
# price id resolves to '' and the product is simply unpurchasable — deliberate,
# but silent, so set every SKU you intend to sell. The canonical operator list
# with its per-secret notes is docs/DEPLOY.md.
# STRIPE_PRICE_CREDITS_25=price_...
# STRIPE_PRICE_CREDITS_60=price_...
# STRIPE_PRICE_CREDITS_150=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_SINGLE_DOSSIER=price_...
# STRIPE_PRICE_SURVEYOR=price_...
# STRIPE_PRICE_PREMIUM_ANNUAL=price_...   # registered behind ANNUAL_FACTOR; consumed from WEB-10
#
# ── Stripe price ids: LEGACY — refund/replay only, never sold ────────────────
# Kept resolvable so refunds and webhook replays of historical sessions still
# land (create-checkout's PRICE_MAP legacy block). Do not add these to the
# active block above.
# STRIPE_PRICE_CREDITS_10=price_...
# STRIPE_PRICE_CREDITS_50=price_...
#
# ANTHROPIC_API_KEY=sk-ant-...
# CLIENT_URL=https://yourapp.com
# RESEND_API_KEY=re_...                              # Tier 8.5 — lifecycle emails
# RESEND_FROM_EMAIL="SettlementForge <hello@settlementforge.com>"
# ACCOUNT_DELETION_CRON_SECRET=<random-high-entropy-value> # migration 175 pg_net worker
# PAYMENT_REFUND_CRON_SECRET=<random-high-entropy-value>   # migration 180 refund worker

# ── Attended release verification (operator shell only; never Vite/Vercel) ────
# Keep credential-bearing values in a private shell/secret manager, not this file.
# REHEARSAL_DATABASE_URL=postgresql://...?...sslmode=verify-full
# SF_MIGRATION_REHEARSAL_ALLOWED_HOSTS=clone.release.internal
# SF_PRODUCTION_DATABASE_HOST=db.production-ref.supabase.co
# POST_DEPLOY_DATABASE_URL=postgresql://release_verifier:...@...?sslmode=verify-full
