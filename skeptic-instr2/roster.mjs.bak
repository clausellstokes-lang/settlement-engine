import { FACTION_ROLES } from './src/generators/factionRoles.js';
import * as ROLE_CATALOG from './src/generators/npc/factionRoleCatalog.js';
import { POWER_ROLES_BY_CATEGORY } from './src/data/historyData.js';
import { ROLE_CATEGORY_KEYWORDS } from './src/generators/roleCategory.js';
import { OFFICE_NOUN_CANDIDATES } from './src/domain/prose/entryLexicons.js';

const narrow = new Set();
for (const list of Object.values(FACTION_ROLES)) for (const row of list) if (row.role) narrow.add(row.role);
for (const value of Object.values(ROLE_CATALOG)) { if (!Array.isArray(value)) continue; for (const row of value) { if (row?.role) narrow.add(row.role); if (row?.title) narrow.add(row.title); } }
const wide = new Set(narrow);
const fromPower = new Set(); const fromKeywords = new Set();
for (const rows of Object.values(POWER_ROLES_BY_CATEGORY)) { if (!Array.isArray(rows)) continue; for (const row of rows) { if (row?.role) { wide.add(row.role); fromPower.add(row.role); } if (row?.title) { wide.add(row.title); fromPower.add(row.title); } } }
for (const list of Object.values(ROLE_CATEGORY_KEYWORDS)) for (const k of list) { wide.add(k); fromKeywords.add(k); }
console.log('narrow(35?)', narrow.size, 'wide(249?)', wide.size);
console.log('fromPower', fromPower.size, 'fromKeywords', fromKeywords.size);
console.log('OFFICE_NOUN_CANDIDATES', OFFICE_NOUN_CANDIDATES.length);
const low = (s)=>String(s).toLowerCase();
const wl = new Set([...wide].map(low)); const nl = new Set([...narrow].map(low));
const absNarrow = OFFICE_NOUN_CANDIDATES.filter(n=>!nl.has(low(n)));
const absWide = OFFICE_NOUN_CANDIDATES.filter(n=>!wl.has(low(n)));
console.log('candidates', OFFICE_NOUN_CANDIDATES.length, 'absent narrow', absNarrow.length, 'absent wide', absWide.length);
console.log('absent wide list:', absWide.join(' · '));
console.log('reeve in narrow?', nl.has('reeve'), 'in wide?', wl.has('reeve'));
console.log('bailiff in wide?', wl.has('bailiff'));
console.log('KEYWORDS sample:', JSON.stringify(Object.fromEntries(Object.entries(ROLE_CATEGORY_KEYWORDS).map(([k,v])=>[k,v.length]))));
