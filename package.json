{
  "name": "settlementforge",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "validate:data": "node scripts/find-duplicate-keys.js",
    "validate:migration-head": "node scripts/check-migration-head.mjs",
    "validate:edge": "node scripts/validate-edge-functions.mjs",
    "validate:map": "node scripts/validate-map-fork.mjs",
    "fix:data": "node scripts/fix-duplicate-keys.js",
    "build:edge-shared": "node scripts/build-edge-shared.mjs",
    "gen:analytics-dictionary": "node scripts/generate-analytics-dictionary.mjs",
    "gen:glossary": "node scripts/generate-glossary.mjs",
    "tuning:weekly": "node scripts/tuning-weekly.mjs",
    "optimize:backgrounds": "node scripts/optimize-backgrounds.mjs",
    "optimize:landing-backgrounds": "node scripts/optimize-landing-backgrounds.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.full.json",
    "typecheck:domain": "tsc --noEmit",
    "typecheck:domain:strict": "node scripts/check-domain-strict.mjs",
    "typecheck:domain:strict:update": "node scripts/check-domain-strict.mjs --update",
    "lint": "eslint src/ tests/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:floors": "vitest run --coverage --coverage.reporter=text --coverage.include=src/lib/stripe.js --coverage.include=src/lib/creditLedger.js --coverage.include=src/lib/checkoutReconcile.js --coverage.include=src/lib/pendingDossier.js --coverage.include=src/lib/saves.js --coverage.include=src/store/aiSlice.js --coverage.include=src/store/creditsSlice.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "verify:dist": "VERIFY_DIST=1 vitest run tests/build/",
    "check": "npm run validate:data && npm run validate:migration-head && npm run validate:edge && npm run validate:map && npm run typecheck && npm run typecheck:domain:strict && npm run lint && npm run test && npm run build && npm run verify:dist",
    "check:quick": "npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "dompurify": "^3.4.8",
    "immer": "^11.1.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.383.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "seedrandom": "^3.0.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
