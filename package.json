{
  "name": "settlementforge",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender-routes.mjs",
    "validate:data": "node scripts/find-duplicate-keys.js && node scripts/generate-institution-service-keys.mjs --check",
    "gen:institution-service-keys": "node scripts/generate-institution-service-keys.mjs",
    "gen:custom-content-manifest": "node scripts/generate-custom-content-manifest.mjs",
    "validate:custom-content-manifest": "node scripts/generate-custom-content-manifest.mjs --check",
    "validate:migration-head": "node scripts/check-migration-head.mjs",
    "validate:edge": "node scripts/validate-edge-functions.mjs",
    "validate:map": "node scripts/validate-map-fork.mjs",
    "validate:tuning-bands": "node scripts/check-tuning-bands.mjs",
    "validate:foundry-module": "node scripts/validate-foundry-module.mjs",
    "validate:mcp-server": "node scripts/validate-mcp-server.mjs",
    "fix:data": "node scripts/fix-duplicate-keys.js",
    "build:edge-shared": "node scripts/build-edge-shared.mjs",
    "gen:analytics-dictionary": "node scripts/generate-analytics-dictionary.mjs",
    "gen:atlas-samples": "node scripts/gen-atlas-samples.mjs",
    "gen:glossary": "node scripts/generate-glossary.mjs",
    "gen:compendium-data": "node scripts/generate-compendium-data.mjs",
    "gen:dossier-prose": "node scripts/generate-dossier-state-prose.mjs",
    "tuning:weekly": "node scripts/tuning-weekly.mjs",
    "optimize:backgrounds": "node scripts/optimize-backgrounds.mjs",
    "optimize:landing-backgrounds": "node scripts/optimize-landing-backgrounds.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.full.json",
    "typecheck:domain": "tsc --noEmit",
    "typecheck:domain:strict": "node scripts/check-domain-strict.mjs",
    "typecheck:domain:strict:update": "node scripts/check-domain-strict.mjs --update",
    "typecheck:ui-boundaries": "tsc --noEmit -p tsconfig.ui-boundaries.json",
    "lint": "eslint src/ tests/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:floors": "vitest run --coverage --coverage.reporter=text --coverage.include=src/lib/stripe.js --coverage.include=src/lib/creditLedger.js --coverage.include=src/lib/checkoutReconcile.js --coverage.include=src/lib/pendingDossier.js --coverage.include=src/lib/saves.js --coverage.include=src/store/aiSlice.js --coverage.include=src/store/creditsSlice.js",
    "test:e2e": "playwright test",
    "test:e2e:performance": "npm run build -- --mode e2e && playwright test --config playwright.perf.config.js",
    "test:e2e:install": "playwright install",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "verify:dist": "VERIFY_DIST=1 vitest run tests/build/",
    "smoke:boot": "node --max-old-space-size=6144 scripts/boot-smoke.mjs",
    "check": "npm run validate:data && npm run validate:custom-content-manifest && npm run validate:migration-head && npm run validate:edge && npm run validate:map && npm run validate:tuning-bands && npm run validate:foundry-module && npm run validate:mcp-server && npm run typecheck && npm run typecheck:domain:strict && npm run lint && npm run test && npm run build && npm run verify:dist",
    "check:quick": "npm run lint && npm run test",
    "check:tail": "sh scripts/gate-tail.sh npm run check",
    "check:edge-behavior": "node scripts/check-edge-behavior.mjs",
    "ops:obligations": "node scripts/ops/obligation-probe.mjs",
    "ops:worktrees": "node scripts/ops/worktree-inventory.mjs",
    "ops:migrations:rehearse": "node scripts/ops/migration-rehearsal.mjs",
    "ops:post-deploy": "node scripts/ops/post-deploy-verify.mjs",
    "certify:generation": "node scripts/audit/generation-certification-soak.mjs",
    "certify:subsystems": "node scripts/audit/certify-subsystems.mjs",
    "soak:smoke": "node scripts/audit/realm-scale-certification.mjs --profile smoke",
    "soak:weekly": "node scripts/audit/realm-scale-certification.mjs --profile weekly",
    "soak:release": "node scripts/audit/realm-scale-certification.mjs --profile release",
    "soak:research": "node scripts/audit/realm-scale-certification.mjs --profile research",
    "audit:bound-book": "node scripts/audit/bound-book-report.mjs",
    "audit:town-scene:local-matrix": "node scripts/audit/town-scene-local-matrix.mjs",
    "certify:town-scene": "node scripts/audit/town-scene-certification.mjs",
    "check:full": "npm run check && npm run check:edge-behavior",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "dompurify": "^3.4.8",
    "immer": "^11.1.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.383.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "seedrandom": "^3.0.5",
    "three": "0.185.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.6.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "pg": "^8.22.0",
    "postcss": "^8.5.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
