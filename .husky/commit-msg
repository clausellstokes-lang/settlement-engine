#!/bin/sh
# commit-msg — THE SEAT GATE, second channel (ODQ §687.3).
#
# §685 requires every ledger act to name the seat that made it. chair-commit.sh enforces
# that on the private-index path, but `git commit-tree` runs no hooks and a chair using
# plain `git commit` bypassed the check entirely — the defect the §687 critic found in
# §685.4's own cure. This hook closes the plain-git path.
#
# SCOPE, DELIBERATELY NARROW: it fires only when the commit touches the ledger file.
# Lanes commit constantly and must never be blocked by a chair-governance rule, so the
# predicate is the ledger path, not "any commit". Widening it to other judgment-bearing
# paths is chartered, not assumed (§687.3).
MSG_FILE="$1"
if git diff --cached --name-only | grep -qx 'docs/OWNER_DECISION_QUEUE.md'; then
  N=$(grep -c '^Seat: \(Fable 5 — validated\|Opus 5 — Fable-unvalidated\)$' "$MSG_FILE" || true)
  if [ "$N" -ne 1 ]; then
    echo "REFUSED: a commit touching docs/OWNER_DECISION_QUEUE.md must carry exactly one" >&2
    echo "seat trailer (found $N). ODQ §685 requires one of:" >&2
    echo "  Seat: Fable 5 — validated" >&2
    echo "  Seat: Opus 5 — Fable-unvalidated" >&2
    echo "An Opus-seat act must also land its row in docs/FABLE_RETROVALIDATION_QUEUE.md" >&2
    echo "in the same commit — see chair-tools/chair-commit.sh, which enforces both." >&2
    exit 1
  fi
fi
exit 0
