{"name": "leguin", "triage": true, "claims": [{"index": 541, "feature": "place and institution description", "claim": "Adam Roberts writes that the Earthsea books take care to render their world as a believable, lived-in space.", "source": "Adam Roberts, \"Ursula Le Guin, 'A Wizard of Earthsea' (1968)\", Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "a believable, lived-in space"}, {"index": 542, "feature": "point of view and distance", "claim": "Adam Roberts attributes the compelling quality of Le Guin's rendering of Earthsea to a seriousness and an absolute belief in the way she renders the world.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "There is a seriousness, an absolute belief"}, {"index": 543, "feature": "place and institution description", "claim": "Adam Roberts characterises the detail in Earthsea as anthropological as much as mythographic, and linguistic as much as geographical.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "as much anthropological"}, {"index": 546, "feature": "concrete sensory noun", "claim": "Adam Roberts observes that Le Guin has a fondness for low walls as boundaries.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "Le Guin has a fondness for low walls as boundaries"}, {"index": 548, "feature": "naming and forms of address", "claim": "Adam Roberts reads the hero's three names, Duny, Ged and Sparrowhawk, as covering three of the four elements, earth, water and air.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "three names covering three of the four elements"}, {"index": 551, "feature": "plainness and economy", "claim": "Sean Guynes says Le Guin's language is at its finest and most artful in The Tombs of Atuan.", "source": "Sean Guynes, \"The Tombs of Atuan: Power, Ideology, and Becoming Uneaten\", Reactor, 29 April 2020", "url": "https://reactormag.com/the-tombs-of-atuan-power-ideology-and-becoming-uneaten/", "quote": "language is at its finest, its most artful"}, {"index": 552, "feature": "concrete sensory noun", "claim": "Sean Guynes locates Le Guin's finest sentences in The Tombs of Atuan in the plainclothes description of thistle and juniper and frozen reeds by a desert river in midwinter.", "source": "Sean Guynes, Reactor, 29 April 2020", "url": "https://reactormag.com/the-tombs-of-atuan-power-ideology-and-becoming-uneaten/", "quote": "her sentences luxuriate in the plainclothes description of thistle and juniper"}, {"index": 555, "feature": "register modulation", "claim": "Richard D. Erlich judges that Le Guin's style has become more colloquial and lower-flown, comparing the language of Tehanu with that of the earlier Earthsea trilogy.", "source": "Richard D. Erlich, Coyote's Song: The Teaching Stories of Ursula K. Le Guin, Conclusion (SFRA, (c)2000)", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/conclusion.htm", "quote": "Her style has gotten more colloquial, lower-flown"}, {"index": 556, "feature": "cadence and rhythm", "claim": "Le Guin, in her Response to the 1975 Le Guin issue of Science-Fiction Studies as quoted by Erlich, said the ideas of the Earthsea trilogy are less detachable from the sounds, rests and rhythms than those of her other work of that time.", "source": "Ursula K. Le Guin, \"Response\", Science-Fiction Studies (1975), p. 45, quoted in Richard D. Erlich, Coyote's Song, Conclusion ((c)2000)", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/conclusion.htm", "quote": "less detachable from the sounds, rests, and rhythms"}, {"index": 558, "feature": "plainness and economy", "claim": "Richard D. Erlich credits Le Guin's 1961 story 'An die Musik' with a genius for handling complex issues in a lucid, simple style at the very beginning of her career.", "source": "Richard D. Erlich, Coyote's Song, Early Works ((c)2000)", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/earlyworks.htm", "quote": "a genius for handling complex issues in a lucid, simple style"}, {"index": 561, "feature": "cadence and rhythm", "claim": "Le Guin opens Steering the Craft by stating that the sound of the language is where it all begins.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, published at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The sound of the language is where it all begins"}, {"index": 562, "feature": "cadence and rhythm", "claim": "Le Guin gives as the test of a sentence whether it sounds right.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The test of a sentence is, Does it sound right?"}, {"index": 563, "feature": "sentence length variation", "claim": "Le Guin states that the chief duty of a narrative sentence is to lead to the next sentence, so as to keep the story going.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The chief duty of a narrative sentence is to lead"}, {"index": 564, "feature": "diction (native vs latinate)", "claim": "Le Guin says of her Hurston and Molly Gloss examples that the vocabulary is simple and familiar and that it is above all the rhythm that is powerful and effective.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the vocabulary is simple and familiar"}, {"index": 565, "feature": "plainness and economy", "claim": "Le Guin describes Molly Gloss's prose as quiet and subtle, its power and beauty coming from the perfect placement and timing of the words.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the perfect placement and timing of the words"}, {"index": 566, "feature": "naming and forms of address", "claim": "Le Guin says the sound of characters' and places' names, and the echo-allusions hidden in them, can be intensely expressive.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the echo-allusions hidden in them, can be intensely expressive"}, {"index": 567, "feature": "archaism", "claim": "Le Guin poses as an open question for discussion whether a novelist who visibly strives for poetical prose using unusual or archaic words intensifies what is being said or distracts from it.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "using unusual or archaic words"}, {"index": 568, "feature": "adjective and adverb discipline", "claim": "Le Guin writes that adjectives and adverbs are rich and good and nourishing, and cause obesity in prose only when used lazily or overused.", "source": "Ursula K. Le Guin, Steering the Craft, quoted in Nicole Bianchi, '3 Powerful Writing Exercises from Steering the Craft' (2021)", "url": "https://nicolebianchi.com/ursula-k-le-guin-steering-the-craft/", "quote": "They cause obesity in prose only when used lazily or overused"}, {"index": 569, "feature": "adjective and adverb discipline", "claim": "Le Guin advises that when the quality an adverb indicates can be put in the verb itself, or an adjective's quality in the noun itself, the prose will be cleaner, more intense and more vivid.", "source": "Ursula K. Le Guin, Steering the Craft, quoted in Nicole Bianchi (2021)", "url": "https://nicolebianchi.com/ursula-k-le-guin-steering-the-craft/", "quote": "the prose will be cleaner, more intense, more vivid"}, {"index": 570, "feature": "adjective and adverb discipline", "claim": "Le Guin names Somehow a super-weasel, a word that betrays that the author did not want to bother thinking out the story.", "source": "Ursula K. Le Guin, Steering the Craft, quoted in Nicole Bianchi (2021)", "url": "https://nicolebianchi.com/ursula-k-le-guin-steering-the-craft/", "quote": "Somehow is a super-weasel"}, {"index": 571, "feature": "adjective and adverb discipline", "claim": "Le Guin's exercise asks for a paragraph to a page of 200-350 words of descriptive narrative prose written without adjectives or adverbs, using only verbs, nouns, pronouns and articles.", "source": "Ursula K. Le Guin, Steering the Craft, exercise quoted in Nicole Bianchi (2021)", "url": "https://nicolebianchi.com/ursula-k-le-guin-steering-the-craft/", "quote": "(200-350 words) of descriptive narrative prose without adjectives"}, {"index": 572, "feature": "archaism", "claim": "Michael Swanwick lists archaicisms, false feeling, fake grammar and journalistic prose as the ways Le Guin says language should not be used in fantasy.", "source": "Michael Swanwick, 'Revisiting Poughkeepsie, Part 2: The Language of the Night', Flogging Babel, 14 October 2010", "url": "http://floggingbabel.blogspot.com/2010/10/revisiting-poughkeepsie-part-2-language.html", "quote": "Archaicisms, false feeling, fake grammar, journalistic prose"}, {"index": 575, "feature": "plainness and economy", "claim": "Stephanie Burt distinguishes Earthsea from most fantasy by its clear, patient prose.", "source": "Stephanie Burt, review of John Plotz's Ursula Le Guin's Earthsea, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "in its clear, patient prose"}, {"index": 576, "feature": "omission as information", "claim": "John Plotz, quoted by Stephanie Burt, calls Le Guin's prose the antithesis of the well-rendered verisimilitude of a high-end video game.", "source": "John Plotz, Ursula Le Guin's Earthsea, p. 48, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the antithesis of the well-rendered verisimilitude of a high-end video game"}, {"index": 577, "feature": "omission as information", "claim": "Stephanie Burt says Le Guin leaves blank spaces for readers to fill in, inviting the reader in and holding them back so that they become co-creators as if listening to an oral tale.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Leaving blank spaces for readers to see how well"}, {"index": 578, "feature": "plainness and economy", "claim": "Stephanie Burt reports that Le Guin's clear, spare prose reminds John Plotz of Willa Cather's, and says she agrees.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Her clear, spare prose reminds Plotz"}, {"index": 579, "feature": "omission as information", "claim": "Stephanie Burt locates Le Guin's technique of letting the reader fill in the details of a strongly outlined world at the level of the sentence in the first Earthsea trilogy.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "letting us fill in the details of her strongly outlined world"}, {"index": 580, "feature": "place and institution description", "claim": "Stephanie Burt endorses Plotz's distinction between the prose of Earthsea and the no-detail-left-unturned, purposefully slow-moving prose of The Lord of the Rings.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the no-detail-left-unturned, purposefully-slow-moving Lord of the Rings"}, {"index": 582, "feature": "edition and house style", "claim": "The Ursula K. Le Guin Foundation records that From Elfland to Poughkeepsie was a speech given at the Second Annual Science Fiction Writers' Workshop in 1972 and first published by Pendragon Press in 1973 in a limited run of 776 copies, with reprints of 1006 copies in December 1975 and 2000 copies in April 1978.", "source": "The Ursula K. Le Guin Foundation, ursulakleguin.com bibliography page", "url": "https://www.ursulakleguin.com/from-elfland-to-poughkeepsie", "quote": "a limited run of 776 copies"}, {"index": 583, "feature": "register modulation", "claim": "Erin Ramsay writes that the mythic and fundamental register of A Wizard of Earthsea gives way to the realistic and mundane in The Tombs of Atuan.", "source": "Erin Ramsay, 'Earthsea: A Sharpening of Scale', The Lighthouse (Substack), 16 April 2024", "url": "https://erinramsay.substack.com/p/earthsea-a-sharpening-of-scale", "quote": "The mythic and fundamental in A Wizard of Earthsea gives way"}, {"index": 584, "feature": "register modulation", "claim": "Erin Ramsay says the reassuring sense of fable that pervades A Wizard of Earthsea is lost in The Farthest Shore.", "source": "Erin Ramsay, The Lighthouse (Substack), 16 April 2024", "url": "https://erinramsay.substack.com/p/earthsea-a-sharpening-of-scale", "quote": "the reassuring sense of fable which pervades"}, {"index": 587, "feature": "repetition and refrain", "claim": "Alessandro Amenta identifies repetitions, paired synonyms and redundancies as typical traits of Le Guin's writing, which the Polish translator tends to remove by periphrasis and by substituting one word for two.", "source": "Alessandro Amenta, Kwartalnik Neofilologiczny LXX 2/2023, p. 282", "url": "http://journals.pan.pl/Content/128312/PDF/2023-02-KNEO-06.pdf", "quote": "which are typical traits of Le Guin's writing"}, {"index": 588, "feature": "cadence and rhythm", "claim": "Alessandro Amenta says the Polish translation generally maintains the high, solemn tone of some of Le Guin's sentences.", "source": "Alessandro Amenta, Kwartalnik Neofilologiczny LXX 2/2023, p. 283", "url": "http://journals.pan.pl/Content/128312/PDF/2023-02-KNEO-06.pdf", "quote": "maintains the high, solemn tone of some Le Guin's"}, {"index": 590, "feature": "diction (native vs latinate)", "claim": "James Marino says the impression of simplicity in A Wizard of Earthsea comes from Le Guin using simple words that are themselves almost always very old.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "simple words words that are themselves almost always very old"}, {"index": 591, "feature": "diction (native vs latinate)", "claim": "James Marino states that Le Guin does not use technical terms and does not use jargon.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "She doesn't use technical terms, she doesn't use jargon"}, {"index": 592, "feature": "place and institution description", "claim": "James Marino contrasts Le Guin's naming of built things with an elaborate alternative, saying she will not say crenellation but will talk about houses and say roof and tower.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "She's not going to say crenellation"}, {"index": 593, "feature": "diction (native vs latinate)", "claim": "James Marino formulates Le Guin's lexical rule as: the more technical and the more limited a word is, the less likely she is to use it.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "The more technical the more limited a word the less likely"}, {"index": 594, "feature": "diction (native vs latinate)", "claim": "James Marino says Le Guin chooses common ordinary words because they have picked up a lot of associations in their travels, not for simplicity's own sake.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "associations in their travels"}, {"index": 595, "feature": "sentence length variation", "claim": "James Marino observes that Le Guin's sentences in the Nemmerle death passage are fairly long and complex and that she saves the shortest sentence, the three-word 'He lay dying', for the highest impact.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "She saves the shortest sentence for the highest impact"}, {"index": 596, "feature": "adjective and adverb discipline", "claim": "James Marino notes that Le Guin writes that the Archmage is cold, very cold, rather than reaching for frigid or subzero, leaving simple words for the reader to fill in with emotional associations.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "Simple words for you to fill in with emotional associations"}, {"index": 597, "feature": "archaism", "claim": "James Marino says fantasists who use elaborate vocabulary are trying to create distance, and that Le Guin finds that effect distracting and fakey.", "source": "James Marino, 'Le Guin's Style' (video), 16 May 2026", "url": "https://www.youtube.com/watch?v=m5oHYOrS0No", "quote": "She finds that effect distracting and and fakey"}, {"index": 598, "feature": "archaism", "claim": "Philip Chase reports that Le Guin's essay holds that good fantasy prose does not have to be archaic and does not even have to be elevated, but must not be journalistic.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "good fantasy pros does not have to be archaic"}, {"index": 599, "feature": "archaism", "claim": "Philip Chase disagrees with Le Guin's use of E. R. Eddison as an example of exemplary fantasy prose, saying he would not hold it up for fantasy writers today.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "this is an example that i personally would disagree with today"}, {"index": 600, "feature": "archaism", "claim": "Philip Chase argues that the tightrope Le Guin describes between over-archaic and journalistic prose moves with time, so that Eddison's prose reads as more overdone now than it did in 1973.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "the tightrope might actually move with time"}, {"index": 604, "feature": "plainness and economy", "claim": "The reviewer on A Novel Review calls Le Guin's Earthsea prose really simple prose that ferries the reader along.", "source": "A Novel Review - Book Podcast (video), 11 August 2025", "url": "https://www.youtube.com/watch?v=P48Xg6ZNi88", "quote": "It's really simple prose, but very ferries you along"}, {"index": 605, "feature": "concrete sensory noun", "claim": "The reviewer on A Novel Review says he could picture almost every scene completely and calls the book incredibly picturesque, which he attributes to Le Guin's writing style.", "source": "A Novel Review - Book Podcast (video), 11 August 2025", "url": "https://www.youtube.com/watch?v=P48Xg6ZNi88", "quote": "this was incredibly picturesque"}, {"index": 606, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Kate Nepveu from 'Rhythmic Pattern in The Lord of the Rings', describes the rhythm shaping Tolkien's narrative as very strong and very simple, as simple as a rhythm can be: two beats.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (Meditations on Middle-earth, 2001; reprinted in The Wave in the Mind), quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "very strong and very simple, as simple as a rhythm can be"}, {"index": 607, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Kate Nepveu, glosses that two-beat rhythm as stress and release, inbreath and outbreath, a heartbeat, a walking gait.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings', quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "Stress, release. Inbreath, outbreath. A heartbeat."}, {"index": 608, "feature": "plainness and economy", "claim": "Le Guin, quoted by Kate Nepveu, says of the closing lines of Tolkien's barrow-downs chapter that the tone is quiet, the language simple, and the emotions evoked quiet, simple and common.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings', quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "Yet the tone is quiet, the language simple"}, {"index": 610, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Erik Mueller-Harder, wrote that even when Tolkien's sentences are long their flow is perfectly clear and follows the breath, punctuation comes just where you need to pause, and the cadences are graceful and inevitable.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (2001), quoted in Erik D. Mueller-Harder, Vermont Softworks, 28 September 2023", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Even when the sentences are long, their flow is perfectly clear"}, {"index": 611, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Erik Mueller-Harder, wrote that Tolkien must have heard what he wrote.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (2001), quoted in Erik D. Mueller-Harder, Vermont Softworks, 28 September 2023", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Tolkien must have heard what he wrote"}, {"index": 613, "feature": "adjective and adverb discipline", "claim": "Mary Anne Mohanraj notes that Le Guin's self-revisions descend to a single word, instancing her bracketed instruction to strike the word probably and replace it with certainly.", "source": "Mary Anne Mohanraj, Reactor, 1 November 2018, quoting Le Guin's 'Is Gender Necessary? Redux'", "url": "https://reactormag.com/write-critique-revise-repeat-on-le-guin-and-asking-the-hard-questions-of-ourselves/", "quote": "Strike the word 'probably' and replace it with 'certainly.'"}, {"index": 614, "feature": "place and institution description", "claim": "David Bratman describes Le Guin's essay 'Living in a Work of Art' as a description of the Berkeley house she grew up in, which she presents as beautiful but eminently livable.", "source": "David Bratman, Kalimac's corner, 6 September 2020", "url": "http://kalimac.blogspot.com/2020/09/a-work-of-art-for-living-in.html", "quote": "beautiful but eminently livable"}, {"index": 615, "feature": "plainness and economy", "claim": "A reader commenting on Sean Guynes's Tehanu essay ranks the crystalline prose and storytelling of A Wizard of Earthsea above Tehanu.", "source": "Reader comment by 'S' on Sean Guynes, 'Tehanu: Le Guin's Return to Earthsea', Reactor, 24 February 2021", "url": "https://reactormag.com/tehanu-le-guins-return-to-earthsea-and-her-best-novel/", "quote": "the crystalline prose and storytelling of"}, {"index": 616, "feature": "plainness and economy", "claim": "A reader commenting on Jo Walton's The Other Wind essay says the book is worth reading because one should never turn down a chance at Le Guin's prose.", "source": "Reader comment on Jo Walton, 'Revising death and dragons: Ursula K. Le Guin's The Other Wind', Reactor, 8 November 2011", "url": "https://reactormag.com/revising-death-and-dragons-ursula-k-le-guins-lemgthe-other-windlemg/", "quote": "one should never turn down a chance at Le Guin's prose"}, {"index": 617, "feature": "diction (native vs latinate)", "claim": "Hari Kunzru describes Le Guin's prose as clear and clean and never tainted by inkhorn medievalism or technological jargon.", "source": "Hari Kunzru, 'Ursula Le Guin: Wizardry is artistry', The Guardian, 20 November 2014", "url": "https://www.theguardian.com/books/2014/nov/20/ursula-le-guin-wizardry-is-artistry-interview-national-book-awards", "quote": "a clear, clean prose that is never tainted by inkhorn medievalism"}, {"index": 618, "feature": "omission as information", "claim": "Le Guin told Paul Morton that much of fantasy and science fiction is just the art of suggestion.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "fantasy and science fiction is just the art of suggestion"}, {"index": 619, "feature": "omission as information", "claim": "Le Guin told Paul Morton that a writer does not really tell people that much, but they think you have because they imagine it.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "You don't really tell people that much, but they think you have"}, {"index": 621, "feature": "plainness and economy", "claim": "Le Guin told Paul Morton that what she has learned as a writer is that you do as little as possible, part of which is leaving a lot of it up to the reader.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "leaving a lot of it up to the reader"}, {"index": 622, "feature": "plainness and economy", "claim": "Le Guin said her writing has tended to be shorter and more allusive than it used to be.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "my writing has tended to be shorter and more allusive"}, {"index": 624, "feature": "cadence and rhythm", "claim": "Le Guin told Paul Morton that she loves the sound of language and plays with word sounds in her head.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "I love language, I love the sound of language."}, {"index": 626, "feature": "diction (native vs latinate)", "claim": "Le Guin told Jonathan White that the language of politicians is empty of everything but rather brutal signals and is something a writer has to get as far away from as possible.", "source": "Ursula K. Le Guin, interviewed by Jonathan White, 'Coming Back From the Silence'", "url": "https://peterschmidt.domains.swarthmore.edu/engl5H/leguin.interv.html", "quote": "empty of everything but rather brutal signals"}, {"index": 631, "feature": "place and institution description", "claim": "Jason P. Vest attributes the conviction of Le Guin's invented worlds to her weaving each place's contradictions, tensions, mores and rites into satisfyingly detailed portraits of its society.", "source": "Jason P. Vest, 'The Re-Possessed', The Common Reader (Washington University), 30 May 2021", "url": "https://commonreader.wustl.edu/c/the-re-possessed/", "quote": "weaving each place's contradictions, tensions, mores, and rites"}, {"index": 632, "feature": "place and institution description", "claim": "Jason P. Vest says Le Guin's fiction swiftly convinces its readers that the worlds she invents are real places rife with complex histories, cultures and characters.", "source": "Jason P. Vest, The Common Reader, 30 May 2021", "url": "https://commonreader.wustl.edu/c/the-re-possessed/", "quote": "real places rife with complex histories, cultures, and characters"}, {"index": 634, "feature": "cadence and rhythm", "claim": "Cummins attributes Le Guin's style to her sensitivity to sound and syntax.", "source": "Elizabeth Cummins, Understanding Ursula K. Le Guin (Univ. of South Carolina Press, 1990)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aunderstandingurs0000cumm%20AND%20%22results%20from%20her%20sensitivity%20to%20sound%20and%20syntax%22", "quote": "results from her sensitivity to sound and syntax"}, {"index": 635, "feature": "civic record register", "claim": "Cummins says Always Coming Home lacks the objective tone of most anthropological writing.", "source": "Elizabeth Cummins, Understanding Ursula K. Le Guin (1990)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aunderstandingurs0000cumm%20AND%20%22it%20lacks%20the%20objective%20tone%20of%20most%20anthropological%20writing%22", "quote": "it lacks the objective tone of most anthropological writing"}, {"index": 636, "feature": "civic record register", "claim": "Cummins says Le Guin's way of presenting a culture is to use the textual model of the ethnograph.", "source": "Elizabeth Cummins, Understanding Ursula K. Le Guin (1990)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aunderstandingurs0000cumm%20AND%20%22use%20the%20textual%20model%20of%20the%20ethnograph%22", "quote": "use the textual model of the ethnograph"}, {"index": 637, "feature": "civic record register", "claim": "Cummins says the ethnograph model admits both the voices of the anthropologist and of the people being studied.", "source": "Elizabeth Cummins, Understanding Ursula K. Le Guin (1990)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aunderstandingurs0000cumm%20AND%20%22both%20the%20voices%20of%20the%20anthropologist%22", "quote": "both the voices of the anthropologist"}, {"index": 638, "feature": "point of view and distance", "claim": "Cummins says Le Guin uses an omniscient point of view for the section covering ages seven to nineteen.", "source": "Elizabeth Cummins, Understanding Ursula K. Le Guin (1990)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aunderstandingurs0000cumm%20AND%20%22Le%20Guin%20uses%20an%20omniscient%20point%20of%20view%22", "quote": "Le Guin uses an omniscient point of view"}, {"index": 641, "feature": "archaism", "claim": "Bittner says the word 'tale' carries an archaic, distant tone that the word 'story' lacks.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (UMI Research Press, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22The%20very%20word%20tale%20has%20an%20archaic%2C%20distant%20tone%22", "quote": "The very word tale has an archaic, distant tone"}, {"index": 642, "feature": "civic record register", "claim": "Bittner says fantastic narratives include 'documents' to create an air of factuality.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22to%20create%20an%20air%20of%20factuality%22", "quote": "to create an air of factuality"}, {"index": 643, "feature": "annalist voice and deep time", "claim": "Bittner describes the narrator of 'Winter's King' as a historian telling a familiar story.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22The%20narrator%20is%20a%20historian%2C%20telling%20a%20familiar%20story%22", "quote": "The narrator is a historian, telling a familiar story"}, {"index": 644, "feature": "civic record register", "claim": "Bittner reports that the documents following Estraven's death include a hearth-tale from the archives of the College of Historians in Erhenrang.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22archives%20of%20the%20College%20of%20Historians%20in%20Erhenrang%22", "quote": "archives of the College of Historians in Erhenrang"}, {"index": 645, "feature": "place and institution description", "claim": "Bittner says the novel interleaves extracts from Estraven's journal with an anthropological report and Gethenian legends.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22an%20anthropological%20report%2C%20and%20Gethenian%20legends%22", "quote": "an anthropological report, and Gethenian legends"}, {"index": 646, "feature": "adjective and adverb discipline", "claim": "Bittner treats a guidebook title carrying many telling adjectives as a reason not to trust its user.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22a%20guidebook%20with%20so%20many%20telling%20adjectives%20in%20its%20title%22", "quote": "a guidebook with so many telling adjectives in its title"}, {"index": 647, "feature": "place and institution description", "claim": "Slusser says the landscape of one of Le Guin's worlds is quite ordinary by earth standards.", "source": "George Edgar Slusser, The Farthest Shores of Ursula K. Le Guin (Borgo Press, 1976)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Afarthestshoresof0000slus%20AND%20%22The%20landscape%20is%20quite%20ordinary%20by%20earth%20standards%22", "quote": "The landscape is quite ordinary by earth standards"}, {"index": 648, "feature": "civic record register", "claim": "Slusser describes a narrative framework intermingled with interpolated tales, documents and diaries.", "source": "George Edgar Slusser, The Farthest Shores of Ursula K. Le Guin (1976)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Afarthestshoresof0000slus%20AND%20%22intermingled%20with%20interpolated%20tales%2C%20documents%2C%20diaries%22", "quote": "intermingled with interpolated tales, documents, diaries"}, {"index": 649, "feature": "plainness and economy", "claim": "An essay in Bloom's volume says Le Guin's style has evolved towards simplicity.", "source": "An essay in Harold Bloom, ed., Ursula K. Le Guin: Modern Critical Views (Chelsea House, 1986) — contributor not resolvable from the snippet window", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00bloo%20AND%20%22Le%20Guin%27s%20style%20has%20evolved%20towards%20simplicity%22", "quote": "Le Guin's style has evolved towards simplicity"}, {"index": 650, "feature": "cadence and rhythm", "claim": "That essay credits Le Guin with a skillful use of cadence and sound patterns.", "source": "An essay in Harold Bloom, ed., Ursula K. Le Guin: Modern Critical Views (1986)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00bloo%20AND%20%22a%20skillful%20use%20of%20cadence%20and%20sound%20patterns%22", "quote": "a skillful use of cadence and sound patterns"}, {"index": 652, "feature": "civic record register", "claim": "Bloom says the narrator of that chapter is a field investigator of the Ekumen wryly cataloging a weird matter.", "source": "Harold Bloom, introduction to Ursula K. Le Guin: Modern Critical Views (Chelsea House, 1986)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00bloo%20AND%20%22wryly%20cataloging%20a%20weird%20matter%22", "quote": "wryly cataloging a weird matter"}, {"index": 653, "feature": "omission as information", "claim": "An essay in Bloom's volume says three chapters and the Appendix are documents separate from the actual narrative.", "source": "An essay in Harold Bloom, ed., Ursula K. Le Guin: Modern Critical Views (1986)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00bloo%20AND%20%22are%20documents%20separate%20from%20the%20actual%20narrative%22", "quote": "are documents separate from the actual narrative"}, {"index": 655, "feature": "civic record register", "claim": "Bloom says the investigator's field notes add a number of sharper observations.", "source": "Harold Bloom, introduction to Ursula K. Le Guin's The Left Hand of Darkness (Chelsea House, 1987)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinsle0000unse%20AND%20%22Her%20field%20notes%20add%20a%20number%20of%20sharper%20observations%22", "quote": "Her field notes add a number of sharper observations"}, {"index": 656, "feature": "point of view and distance", "claim": "Cadden says much of Le Guin's short fiction shows a steady use of free indirect discourse.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre: Fiction for Children and Adults (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22a%20steady%20use%20of%20free%20indirect%20discourse%22", "quote": "a steady use of free indirect discourse"}, {"index": 658, "feature": "civic record register", "claim": "Cadden calls 'A Description of Earthsea' a text that is neither story nor afterword.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22a%20text%20that%20is%20neither%20story%20nor%20afterword%22", "quote": "a text that is neither story nor afterword"}, {"index": 659, "feature": "place and institution description", "claim": "Cadden says 'A Description of Earthsea' runs to almost thirty pages of Earthsea lore and history.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22almost%20thirty%20pages%20of%20Earthsea%20lore%20and%20history%22", "quote": "almost thirty pages of Earthsea lore and history"}, {"index": 660, "feature": "point of view and distance", "claim": "Cadden says 'A Description of Earthsea' is told from outside the world of Earthsea.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22is%20told%20from%20outside%20the%20world%20of%20Earthsea%22", "quote": "is told from outside the world of Earthsea"}, {"index": 661, "feature": "annalist voice and deep time", "claim": "Cadden says the book is true to the voice of the anthropologist examining the ways of the Kesh.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22the%20voice%20of%20the%20anthropologist%20examining%20the%20ways%22", "quote": "the voice of the anthropologist examining the ways"}, {"index": 662, "feature": "point of view and distance", "claim": "Cadden says the book does not rely on any one narrating voice in the presentation of this anthropological text.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22in%20the%20presentation%20of%20this%20anthropological%20text%22", "quote": "in the presentation of this anthropological text"}, {"index": 663, "feature": "plainness and economy", "claim": "Cadden puts it to Le Guin that Leese Webster is very spare.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22Leese%20Webster%20is%20very%20spare%22", "quote": "Leese Webster is very spare"}, {"index": 664, "feature": "plainness and economy", "claim": "Le Guin replies that Leese Webster is austere and that this fit the illustrator's talent.", "source": "Ursula K. Le Guin, in interview with Mike Cadden, printed in Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22It%E2%80%99s%20austere%2C%20and%20that%20fit%20Jim%E2%80%99s%20talent%22", "quote": "It’s austere, and that fit Jim’s talent"}, {"index": 667, "feature": "plainness and economy", "claim": "An essay in Olander and Greenberg's volume says Le Guin's straightforward stories deal in strong colors and plain fabrics.", "source": "An essay in Joseph D. Olander and Martin Harry Greenberg, eds., Ursula K. Le Guin (Taplinger, 1979) — contributor not resolvable from the snippet window", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00olan%20AND%20%22strong%20colors%20and%20plain%20fabrics%22", "quote": "strong colors and plain fabrics"}, {"index": 668, "feature": "concrete sensory noun", "claim": "An essay in that volume notes that Ai sees each keystone in the city of Erhenrang joined by red cement.", "source": "An essay in Olander and Greenberg, eds., Ursula K. Le Guin (Taplinger, 1979)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00olan%20AND%20%22each%20keystone%20he%20sees%20in%20the%20city%20of%20Erhenrang%22", "quote": "each keystone he sees in the city of Erhenrang"}, {"index": 669, "feature": "register modulation", "claim": "Spivack says the style of A Wizard of Earthsea is suitable to its subject.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22The%20style%20of%20A%20Wizard%20of%20Earthsea%20is%20suitable%22", "quote": "The style of A Wizard of Earthsea is suitable"}, {"index": 670, "feature": "diction (native vs latinate)", "claim": "Spivack says the language of A Wizard of Earthsea is largely Anglo-Saxon in diction.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22Saxon%20in%20diction%2C%20strongly%20alliterative%22", "quote": "Saxon in diction, strongly alliterative"}, {"index": 671, "feature": "cadence and rhythm", "claim": "Spivack says the alliteration in A Wizard of Earthsea is pervasive, recalling the oral tradition.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22The%20alliteration%20is%20pervasive%2C%20recalling%20the%20oral%20tradition%22", "quote": "The alliteration is pervasive, recalling the oral tradition"}, {"index": 672, "feature": "place and institution description", "claim": "Spivack says Le Guin draws on her anthropological background to create cultural concepts for her imaginary worlds.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22Drawing%20on%20her%20anthropological%20background%2C%20Le%20Guin%20is%20able%22", "quote": "Drawing on her anthropological background, Le Guin is able"}, {"index": 673, "feature": "diction (native vs latinate)", "claim": "Spivack says the vocabulary of Le Guin's poems is straightforward, with a diction austerely avoiding the Latinate or the ornate.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22a%20diction%20austerely%20avoiding%20the%20Latinate%20or%20the%20ornate%22", "quote": "a diction austerely avoiding the Latinate or the ornate"}, {"index": 674, "feature": "diction (native vs latinate)", "claim": "Spivack calls the diction of those poems homely and reminiscent of Robert Frost.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22The%20homely%20diction%20is%20reminiscent%20of%20Robert%20Frost%22", "quote": "The homely diction is reminiscent of Robert Frost"}, {"index": 675, "feature": "omission as information", "claim": "Spivack calls those monologues richly suggestive, leaving much unsaid.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22richly%20suggestive%2C%20leaving%20much%20unsaid%22", "quote": "richly suggestive, leaving much unsaid"}, {"index": 676, "feature": "plainness and economy", "claim": "Bucknall says what Le Guin says of Tolkien's style is to a certain extent true of the way she writes herself.", "source": "Barbara J. Bucknall, Ursula K. Le Guin (Frederick Ungar, 1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22is%20to%20a%20certain%20extent%20true%20of%20the%20way%20she%22", "quote": "is to a certain extent true of the way she"}, {"index": 677, "feature": "register modulation", "claim": "Bucknall says Le Guin's style varies from book to book and from character to character.", "source": "Barbara J. Bucknall, Ursula K. Le Guin (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22which%20varies%20from%20book%20to%20book%20and%20from%20character%22", "quote": "which varies from book to book and from character"}, {"index": 678, "feature": "adjective and adverb discipline", "claim": "Bucknall praises Le Guin for writing poetically while resisting the temptation to overwrite.", "source": "Barbara J. Bucknall, Ursula K. Le Guin (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22while%20resisting%20the%20temptation%20to%20overwrite%22", "quote": "while resisting the temptation to overwrite"}, {"index": 679, "feature": "register modulation", "claim": "Bucknall says Le Guin's style does not have the stately and heroic tone of The Lord of the Rings.", "source": "Barbara J. Bucknall, Ursula K. Le Guin (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22does%20not%20have%20the%20stately%20and%20heroic%20tone%22", "quote": "does not have the stately and heroic tone"}, {"index": 680, "feature": "plainness and economy", "claim": "Le Guin writes that a plain language is the noblest of all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Barbara J. Bucknall, Ursula K. Le Guin (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22A%20plain%20language%20is%20the%20noblest%20of%20all%22", "quote": "A plain language is the noblest of all"}, {"index": 681, "feature": "plainness and economy", "claim": "Le Guin adds that plain language is also the most difficult.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22It%20is%20also%20the%20most%20difficult%22", "quote": "It is also the most difficult"}, {"index": 682, "feature": "plainness and economy", "claim": "Le Guin writes that clarity and simplicity are permanent virtues in a narrative.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22Clarity%20and%20simplicity%20are%20permanent%20virtues%20in%20a%20narrative%22", "quote": "Clarity and simplicity are permanent virtues in a narrative"}, {"index": 683, "feature": "diction (native vs latinate)", "claim": "Le Guin writes that Tolkien writes a plain, clear English.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22Tolkien%20writes%20a%20plain%2C%20clear%20English%22", "quote": "Tolkien writes a plain, clear English"}, {"index": 684, "feature": "diction (native vs latinate)", "claim": "Le Guin writes that Tolkien's vocabulary is not striking.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22Tolkien%E2%80%99s%20vocabulary%20is%20not%20striking%22", "quote": "Tolkien’s vocabulary is not striking"}, {"index": 686, "feature": "plainness and economy", "claim": "Woodcock calls Le Guin's a style of crystalline clarity and functional flexibility.", "source": "George Woodcock, quoted by John R. Pfeiffer in Joe De Bolt, ed., Ursula K. Le Guin: Voyager to Inner Lands and to Outer Space (Kennikat Press, 1979)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinvoy0000unse%20AND%20%22a%20style%20of%20crystalline%20clarity%20and%20functional%20flexibility%22", "quote": "a style of crystalline clarity and functional flexibility"}, {"index": 687, "feature": "cadence and rhythm", "claim": "Pfeiffer calls the oral elements of the style of A Wizard of Earthsea a superb vehicle.", "source": "John R. Pfeiffer, in Joe De Bolt, ed., Ursula K. Le Guin: Voyager to Inner Lands and to Outer Space (1979)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinvoy0000unse%20AND%20%22The%20oral%20elements%20of%20the%20style%20of%20WOE%22", "quote": "The oral elements of the style of WOE"}, {"index": 688, "feature": "sentence length variation", "claim": "Dirda says the sentences of A Wizard of Earthsea are formal, clear, and exact.", "source": "Michael Dirda, Ursula K. Le Guin's A Wizard of Earthsea teacher's guide, NEA Big Read (National Endowment for the Arts, 2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22The%20sentences%20are%20formal%2C%20clear%2C%20and%20exact%22", "quote": "The sentences are formal, clear, and exact"}, {"index": 689, "feature": "cadence and rhythm", "claim": "Dirda says those sentences carry the musical cadence of an oral storyteller.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22with%20the%20musical%20cadence%20of%20an%20oral%20storyteller%22", "quote": "with the musical cadence of an oral storyteller"}, {"index": 690, "feature": "cadence and rhythm", "claim": "Dirda says Le Guin gives music and richness to her prose through the rhythm of her sentences.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22music%20and%20richness%20to%20her%20prose%20through%20the%20rhythm%22", "quote": "music and richness to her prose through the rhythm"}, {"index": 691, "feature": "cadence and rhythm", "claim": "Dirda says Le Guin gives her prose music occasionally through the use of alliteration and assonance.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22through%20the%20use%20of%20alliteration%20and%20assonance%22", "quote": "through the use of alliteration and assonance"}, {"index": 692, "feature": "register modulation", "claim": "Dirda says heroic or high fantasy demands a slightly formal, elevated style.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22a%20slightly%20formal%2C%20elevated%20style%22", "quote": "a slightly formal, elevated style"}, {"index": 693, "feature": "point of view and distance", "claim": "Dirda says the omniscient narrator confides in the reader like a friend.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22The%20omniscient%20narrator%20confides%20in%20the%20reader%20like%20a%20friend%22", "quote": "The omniscient narrator confides in the reader like a friend"}, {"index": 694, "feature": "annalist voice and deep time", "claim": "Dirda says the narrator conveys the real story behind the legends of the Archmage Ged.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22the%20real%20story%20behind%20the%20legends%20of%20the%20Archmage%20Ged%22", "quote": "the real story behind the legends of the Archmage Ged"}, {"index": 696, "feature": "plainness and economy", "claim": "A review of Tehanu reprinted in Children's Literature Review says Le Guin's style is as pellucid as ever.", "source": "An unsigned review of Tehanu, reprinted in Children's Literature Review vol. 28 (Gale, 1992)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Achildrensliterat28gera%20AND%20%22Le%20Guin%27s%20style%20is%20as%20pellucid%20as%20ever%22", "quote": "Le Guin's style is as pellucid as ever"}, {"index": 697, "feature": "register modulation", "claim": "Cogell's bibliography records a review calling Le Guin's style in one book different from her preceding works.", "source": "Elizabeth Cummins Cogell, Ursula K. Le Guin: A Primary and Secondary Bibliography (G. K. Hall, 1983)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinpri0000coge%20AND%20%22Le%20Guin%27s%20style%20is%20different%20from%20her%20preceding%20works%22", "quote": "Le Guin's style is different from her preceding works"}, {"index": 698, "feature": "plainness and economy", "claim": "Burt calls the prose of Earthsea clear and patient.", "source": "Stephanie Burt, review of John Plotz's Ursula Le Guin's Earthsea, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "its clear, patient prose"}, {"index": 699, "feature": "omission as information", "claim": "Plotz calls Le Guin's prose the antithesis of the well-rendered verisimilitude of a high-end video game.", "source": "John Plotz, Ursula Le Guin's Earthsea (Oxford Univ. Press, 2023), p. 48, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the antithesis of the well-rendered verisimilitude"}, {"index": 700, "feature": "plainness and economy", "claim": "Burt reports that Le Guin's clear, spare prose reminds Plotz of Willa Cather's.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Her clear, spare prose reminds Plotz"}, {"index": 701, "feature": "omission as information", "claim": "Burt says Le Guin works at the level of the sentence, letting readers fill in the details of her strongly outlined world.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "letting us fill in the details of her strongly outlined world"}, {"index": 702, "feature": "place and institution description", "claim": "Plotz says Le Guin trains a spotlight on all the things that we make up and then treat as real.", "source": "John Plotz, Ursula Le Guin's Earthsea (2023), p. 34, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "trains a spotlight on all the things that we make up"}, {"index": 703, "feature": "point of view and distance", "claim": "Burt says Le Guin invites the reader in and holds the reader back.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "invites us in and holds us back"}, {"index": 704, "feature": "naming and forms of address", "claim": "Le Guin says names come first with her.", "source": "Ursula K. Le Guin, 2015 interview with John Plotz, transcribed in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "Names come first with me"}, {"index": 705, "feature": "naming and forms of address", "claim": "Le Guin says she drew a map of islands she knew nothing about and named them happily.", "source": "Ursula K. Le Guin, 2015 interview with John Plotz, transcribed in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "But I named them happily"}, {"index": 706, "feature": "omission as information", "claim": "Plotz quotes Le Guin's essay as saying fantasy offers only a construct built in a void with every joint and seam and nail exposed.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted by John Plotz in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "a construct built in a void"}, {"index": 712, "feature": "civic record register", "claim": "Juliette Wade observes that the archival header opening The Left Hand of Darkness contains no verbs at all.", "source": "Juliette Wade, 'Genly Ai: A Ridiculously Close Look', TalkToYoUniverse blog, 2008", "url": "http://talktoyouniverse.blogspot.com/2008/10/genly-ai-ridiculously-close-look.html", "quote": "Notice that there are no verbs in this excerpt"}, {"index": 713, "feature": "point of view and distance", "claim": "Wade argues that the verbless archival header removes every actor and leaves what she calls a sourceless truth.", "source": "Juliette Wade, 'Genly Ai: A Ridiculously Close Look', TalkToYoUniverse blog, 2008", "url": "http://talktoyouniverse.blogspot.com/2008/10/genly-ai-ridiculously-close-look.html", "quote": "leaving us with a sourceless truth"}, {"index": 714, "feature": "opening sentence", "claim": "Wade identifies the register of the novel's archival header as that of the notes heading a scientific report.", "source": "Juliette Wade, 'Genly Ai: A Ridiculously Close Look', TalkToYoUniverse blog, 2008", "url": "http://talktoyouniverse.blogspot.com/2008/10/genly-ai-ridiculously-close-look.html", "quote": "the notes that would head a scientific report"}, {"index": 715, "feature": "annalist voice and deep time", "claim": "Wade reads the header's dating line as showing that the institution keeps its own measurement of time.", "source": "Juliette Wade, 'Genly Ai: A Ridiculously Close Look', TalkToYoUniverse blog, 2008", "url": "http://talktoyouniverse.blogspot.com/2008/10/genly-ai-ridiculously-close-look.html", "quote": "it also dictates its own measurement of time"}, {"index": 716, "feature": "register modulation", "claim": "Wade counts three distinct voices in the opening page of The Left Hand of Darkness, of which the archival header is the second.", "source": "Juliette Wade, 'Genly Ai: A Ridiculously Close Look', TalkToYoUniverse blog, 2008", "url": "http://talktoyouniverse.blogspot.com/2008/10/genly-ai-ridiculously-close-look.html", "quote": "This is a voice of ultimate authority"}, {"index": 717, "feature": "opening sentence", "claim": "The Left Hand of Darkness opens with a filing header that names an archive and a document number before any sentence with a verb.", "source": "Ursula K. Le Guin, The Left Hand of Darkness, ch. 1 opening, reproduced in Books on GIF review #280", "url": "https://booksongif.substack.com/p/left-hand-of-darkness-ursula-le-guin", "quote": "From the Archives of Hain. Transcript of Ansible Document"}, {"index": 718, "feature": "civic record register", "claim": "Genly Ai's first sentence names the document he is writing as a report before it narrates anything.", "source": "Ursula K. Le Guin, The Left Hand of Darkness, ch. 1 opening, reproduced in Books on GIF review #280", "url": "https://booksongif.substack.com/p/left-hand-of-darkness-ursula-le-guin", "quote": "I’ll make my report as if I told a story"}, {"index": 719, "feature": "withheld information and inference", "claim": "The report's opening concedes that its account is neither wholly the reporter's nor told by him alone.", "source": "Ursula K. Le Guin, The Left Hand of Darkness, ch. 1 opening, reproduced in Books on GIF review #280", "url": "https://booksongif.substack.com/p/left-hand-of-darkness-ursula-le-guin", "quote": "The story is not all mine, nor told by me alone"}, {"index": 720, "feature": "annalist voice and deep time", "claim": "The report fixes its starting point by an ordinal day of a numbered year before naming any person or place.", "source": "Ursula K. Le Guin, The Left Hand of Darkness, ch. 1 opening, reproduced in Books on GIF review #280", "url": "https://booksongif.substack.com/p/left-hand-of-darkness-ursula-le-guin", "quote": "It starts on the 44th diurnal of the Year 1491"}, {"index": 721, "feature": "civic record register", "claim": "A local timekeeping custom is stated as a bare present-tense sentence of seven ordinary words.", "source": "Ursula K. Le Guin, The Left Hand of Darkness, ch. 1 opening, reproduced in Books on GIF review #280", "url": "https://booksongif.substack.com/p/left-hand-of-darkness-ursula-le-guin", "quote": "It is always the Year One here"}, {"index": 722, "feature": "civic record register", "claim": "Mazin Saleem notes that Le Guin repeatedly uses the modal 'may' when the book describes a Kesh custom.", "source": "Mazin Saleem, Strange Horizons, 2018", "url": "https://strangehorizons.com/wordpress/non-fiction/articles/i-never-did-like-smart-ass-utopians-on-always-coming-home-by-ursula-k-le-guin/", "quote": "Again and again, Le Guin used the word"}, {"index": 723, "feature": "place and institution description", "claim": "Saleem quotes a Kesh description of a ritual song whose permitted repetitions are given as an open list ending in the option of not at all.", "source": "Mazin Saleem quoting Always Coming Home, Strange Horizons, 2018", "url": "https://strangehorizons.com/wordpress/non-fiction/articles/i-never-did-like-smart-ass-utopians-on-always-coming-home-by-ursula-k-le-guin/", "quote": "it may be sung four times, or five times, or nine times"}, {"index": 724, "feature": "omission as information", "claim": "Saleem reports that the book's own note offers two competing readings of a disputed Kesh text rather than a verdict.", "source": "Mazin Saleem quoting Always Coming Home, Strange Horizons, 2018", "url": "https://strangehorizons.com/wordpress/non-fiction/articles/i-never-did-like-smart-ass-utopians-on-always-coming-home-by-ursula-k-le-guin/", "quote": "a vengeful biography pretending to be autobiography"}, {"index": 726, "feature": "point of view and distance", "claim": "Saleem describes a gloss attached to a Kesh story as spoken by a commentator on that story in the present tense.", "source": "Mazin Saleem, Strange Horizons, 2018", "url": "https://strangehorizons.com/wordpress/non-fiction/articles/i-never-did-like-smart-ass-utopians-on-always-coming-home-by-ursula-k-le-guin/", "quote": "writes a commentator on the story"}, {"index": 727, "feature": "edition and house style", "claim": "Saleem gives the length of Always Coming Home as 525 pages and lists field notes first among its contents.", "source": "Mazin Saleem, Strange Horizons, 2018", "url": "https://strangehorizons.com/wordpress/non-fiction/articles/i-never-did-like-smart-ass-utopians-on-always-coming-home-by-ursula-k-le-guin/", "quote": "At 525 pages, including field notes, stories, maps, charts"}, {"index": 729, "feature": "place and institution description", "claim": "Garlick and King describe the Back of the Book as encyclopaedia-like appendices holding the novel's practical information.", "source": "Ben Garlick and Liesl King, cultural geographies, 2022", "url": "https://ray.yorksj.ac.uk/id/eprint/6566/8/14744740221126984.pdf", "quote": "appendices referred to as ‘The Back of the Book’"}, {"index": 730, "feature": "point of view and distance", "claim": "Garlick and King characterise Pandora as an implicit translator or reporter rather than a character with a stake in the events.", "source": "Ben Garlick and Liesl King, cultural geographies, 2022", "url": "https://ray.yorksj.ac.uk/id/eprint/6566/8/14744740221126984.pdf", "quote": "narrator or else implicit translator/reporter"}, {"index": 731, "feature": "civic record register", "claim": "A Kesh social fact is stated in Always Coming Home as a rule of the language's grammar.", "source": "Le Guin, Always Coming Home, quoted in Garlick and King, cultural geographies, 2022", "url": "https://ray.yorksj.ac.uk/id/eprint/6566/8/14744740221126984.pdf", "quote": "Kesh grammar makes no provision for a relation of ownership"}, {"index": 732, "feature": "civic record register", "claim": "Kesh social disapproval is reported in Always Coming Home as an agentless past passive listing three disapproved things.", "source": "Le Guin, Always Coming Home, quoted in Garlick and King, cultural geographies, 2022", "url": "https://ray.yorksj.ac.uk/id/eprint/6566/8/14744740221126984.pdf", "quote": "a competitive attitude were all socially disapproved"}, {"index": 733, "feature": "place and institution description", "claim": "Garlick and King report the Kesh life expectancy from the novel as a range of thirty to forty years.", "source": "Ben Garlick and Liesl King, cultural geographies, 2022", "url": "https://ray.yorksj.ac.uk/id/eprint/6566/8/14744740221126984.pdf", "quote": "short life expectancies (30–40 years)"}, {"index": 734, "feature": "place and institution description", "claim": "Danny Yee describes the Back of the Book as presenting the Kesh in a more traditional ethnographic form than the rest of the volume.", "source": "Danny Yee, review of Always Coming Home, 1995", "url": "https://dannyreviews.com/h/Always_Coming_Home.html", "quote": "contains additional information about the Kesh in more traditional ethnographic form"}, {"index": 739, "feature": "civic record register", "claim": "The Ekumen field notes in The Left Hand of Darkness state a biological rule in the present tense with a generic plural subject.", "source": "Le Guin, The Left Hand of Darkness ch. 7, quoted in Nick Hubble's BSFA Review notice", "url": "https://vector-bsfa.com/2020/12/24/review-the-left-hand-of-darkness-by-ursula-k-le-guin/", "quote": "Normal individuals have no predisposition to either sexual role in kemmer"}, {"index": 740, "feature": "withheld information and inference", "claim": "The same field notes mark the limit of the observer's own experience in a first-person parenthesis.", "source": "Le Guin, The Left Hand of Darkness ch. 7, quoted in Nick Hubble's BSFA Review notice", "url": "https://vector-bsfa.com/2020/12/24/review-the-left-hand-of-darkness-by-ursula-k-le-guin/", "quote": "I haven’t seen this done in rural Karhide"}, {"index": 741, "feature": "place and institution description", "claim": "The field notes cite a second named observer inside a parenthesis before qualifying his report.", "source": "Le Guin, The Left Hand of Darkness ch. 7, quoted in Nick Hubble's BSFA Review notice", "url": "https://vector-bsfa.com/2020/12/24/review-the-left-hand-of-darkness-by-ursula-k-le-guin/", "quote": "Otie Nim wrote that in the Orgoreyn region the use"}, {"index": 743, "feature": "plainness and economy", "claim": "The field notes close the ambisexuality section with a twelve-word sentence built entirely of common kinship nouns.", "source": "Le Guin, The Left Hand of Darkness ch. 7, quoted in Nick Hubble's BSFA Review notice", "url": "https://vector-bsfa.com/2020/12/24/review-the-left-hand-of-darkness-by-ursula-k-le-guin/", "quote": "the mother of several children may be the father of several more"}, {"index": 744, "feature": "place and institution description", "claim": "Hubble notes that the field notes are held by the envoy, giving the document a stated chain of custody.", "source": "Nick Hubble, The BSFA Review, 2020", "url": "https://vector-bsfa.com/2020/12/24/review-the-left-hand-of-darkness-by-ursula-k-le-guin/", "quote": "These notes are in the possession of Genly Ai"}, {"index": 745, "feature": "place and institution description", "claim": "The Back of the Book runs to about a fifth of the pages of Always Coming Home and presents cultural lore.", "source": "Wikipedia relaying Le Guin, Always Coming Home (1985)", "url": "https://en.wikipedia.org/wiki/Always_Coming_Home", "quote": "about a fifth of the number of pages, presents cultural lore"}, {"index": 746, "feature": "civic record register", "claim": "The Back of the Book is described as carrying the attributions or annotations an ethnographic fieldworker would make.", "source": "Wikipedia relaying Le Guin, Always Coming Home (1985)", "url": "https://en.wikipedia.org/wiki/Always_Coming_Home", "quote": "attributions or annotations that an ethnographic fieldworker might make"}, {"index": 747, "feature": "place and institution description", "claim": "Each attributed Kesh text carries a provenance line naming the teller, her town and the recipient.", "source": "Le Guin, Always Coming Home (1985), item headings relayed by Wikipedia", "url": "https://en.wikipedia.org/wiki/Always_Coming_Home", "quote": "As told by Little Bear Woman of Sinshan to the Editor"}, {"index": 748, "feature": "place and institution description", "claim": "A map inside Always Coming Home is captioned with the person who gave it to the Editor.", "source": "Le Guin, Always Coming Home (1985), item heading relayed by Wikipedia", "url": "https://en.wikipedia.org/wiki/Always_Coming_Home", "quote": "given to the Editor by Little Bear Woman of Sinshan"}, {"index": 749, "feature": "plainness and economy", "claim": "Pandora states the Kesh population as a seven-word sentence containing no number.", "source": "Le Guin, Always Coming Home (1985), quoted by Wikipedia with a citation", "url": "https://en.wikipedia.org/wiki/Always_Coming_Home", "quote": "There are not too many of them"}, {"index": 753, "feature": "civic record register", "claim": "A student reader observes that the field-notes chapter could have been written as straightforward declarative sentences but is not.", "source": "Tori Koontz, comment on Michael Newbury's Science Fiction course blog, Middlebury College, 2019", "url": "https://sites.middlebury.edu/sciencefiction2017/2019/10/09/le-guin/", "quote": "which could just as easily be written in straight-forward, declarative sentences"}, {"index": 754, "feature": "place and institution description", "claim": "A student reader describes the field-notes chapter as proceeding outward from the individual to the interpersonal to the social.", "source": "Cole Easton, comment on Michael Newbury's Science Fiction course blog, Middlebury College, 2019", "url": "https://sites.middlebury.edu/sciencefiction2017/2019/10/09/le-guin/", "quote": "from the individual level, to the pairing level/interpersonal level, to the social"}, {"index": 755, "feature": "place and institution description", "claim": "Kathy Weissman lists the topics of the Earthsea appendix as history, language, royal dynasties and dragons.", "source": "Kathy Weissman, review of Tales from Earthsea, Bookreporter.com, 2001", "url": "https://www.bookreporter.com/reviews/tales-from-earthsea-the-earthsea-cycle-book-5", "quote": "covers topics such as history, language, royal dynasties, and dragons"}, {"index": 757, "feature": "civic record register", "claim": "Le Guin describes 'The Matter of Seggri' as a compendium of reports on the society of one world.", "source": "Ursula K. Le Guin, Foreword to The Birthday of the World (2001)", "url": "https://www.ursulakleguin.com/foreword-the-birthday-of-the-world", "quote": "is a compendium of reports on the society of a world"}, {"index": 758, "feature": "place and institution description", "claim": "Le Guin places the Seggri documents in the archives of the Historians of Hain.", "source": "Ursula K. Le Guin, Foreword to The Birthday of the World (2001)", "url": "https://www.ursulakleguin.com/foreword-the-birthday-of-the-world", "quote": "These documents are from the archives of the Historians of Hain"}, {"index": 760, "feature": "point of view and distance", "claim": "Le Guin identifies the first voice of The Left Hand of Darkness as a Mobile of the Ekumen making a report.", "source": "Ursula K. Le Guin, Foreword to The Birthday of the World (2001)", "url": "https://www.ursulakleguin.com/foreword-the-birthday-of-the-world", "quote": "the first voice is that of a Mobile of the Ekumen"}, {"index": 761, "feature": "naming and forms of address", "claim": "Le Guin defines the Ekumen in six words as a non-directive, information-gathering consortium of worlds.", "source": "Ursula K. Le Guin, Foreword to The Birthday of the World (2001)", "url": "https://www.ursulakleguin.com/foreword-the-birthday-of-the-world", "quote": "a non-directive, information-gathering consortium of worlds"}, {"index": 762, "feature": "annalist voice and deep time", "claim": "Le Guin's Hainish historians are described as knowing that events keep happening and will happen again.", "source": "Ursula K. Le Guin, Foreword to The Birthday of the World (2001)", "url": "https://www.ursulakleguin.com/foreword-the-birthday-of-the-world", "quote": "know that it keeps happening and will happen again"}, {"index": 764, "feature": "place and institution description", "claim": "The introduction to 'Unchosen Love' is signed with an address chain running from farmhold through village and watershed to the planet.", "source": "Ursula K. Le Guin, 'Unchosen Love' introduction, excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "of Inanan Farmhold of Tag Village on the Southwest Watershed"}, {"index": 766, "feature": "civic record register", "claim": "The headnote defines a social institution in a present-tense passive sentence of ordinary words.", "source": "Ursula K. Le Guin, 'Mountain Ways' headnote, excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "Ki'O society is divided into two halves or moieties, called"}, {"index": 768, "feature": "omission as information", "claim": "The headnote records that the forbidden relationships have no name at all except sacrilege.", "source": "Ursula K. Le Guin, 'Mountain Ways' headnote, excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "they aren't called anything, except sacrilege"}, {"index": 769, "feature": "place and institution description", "claim": "'Mountain Ways' opens on a present-tense sentence that places settlements in a named upland and states their density.", "source": "Ursula K. Le Guin, 'Mountain Ways', excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "In the stony uplands of the Deka Mountains the farmholds are few"}, {"index": 770, "feature": "place and institution description", "claim": "A settlement is identified by a present-tense copula sentence that nests farm inside village inside watershed inside river inside continent inside planet.", "source": "Ursula K. Le Guin, 'Mountain Ways', excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "Danro is the farthest farm of Oro Village in the High Watershed"}, {"index": 771, "feature": "plainness and economy", "claim": "An economic relation between a people and their herds is stated as a plain two-clause sentence that reverses itself.", "source": "Ursula K. Le Guin, 'Mountain Ways', excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "The farmers are dependent on the ariu; the ariu are not"}, {"index": 772, "feature": "opening sentence", "claim": "'Solitude' opens with a header declaring the text an addition to a named, numbered prior report on a planet.", "source": "Ursula K. Le Guin, 'Solitude', excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "An addition to \"POVERTY: The Second Report on Eleven-Soro\""}, {"index": 773, "feature": "point of view and distance", "claim": "The narrator of 'Solitude' names her mother's profession in a bare apposition before saying anything about her.", "source": "Ursula K. Le Guin, 'Solitude', excerpted on the author's official site", "url": "https://www.ursulakleguin.com/the-birthday-of-the-world-1", "quote": "My mother, a field ethnologist, took the difficulty of learning anything"}, {"index": 775, "feature": "place and institution description", "claim": "Rocannon's World opens with a gazetteer heading that gives a galactic area number, an entry number and the planet name.", "source": "Le Guin, Rocannon's World (1966), opening handbook entry, quoted in full by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "Galactic Area 8, No. 62: FOMALHAUT II"}, {"index": 776, "feature": "place and institution description", "claim": "A people is described in the handbook by a verbless string of adjectives closing on a height range in centimetres.", "source": "Le Guin, Rocannon's World (1966), opening handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "Highly intelligent, fully hominoid nocturnal troglodytes, 120-135 cm. in height"}, {"index": 777, "feature": "civic record register", "claim": "An intervention by the institution is recorded as a verbless clause with a grade and a date range and no actor.", "source": "Le Guin, Rocannon's World (1966), opening handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "Technology enhanced to Industrial, Point C, during League Mission of 252-254"}, {"index": 779, "feature": "withheld information and inference", "claim": "The handbook grades the strength of its own evidence by saying that brief contacts only indicated what it reports.", "source": "Le Guin, Rocannon's World (1966), opening handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "indicated village and nomadic communal societies"}, {"index": 780, "feature": "plainness and economy", "claim": "The handbook delivers a fiscal verdict on a whole people in a two-word sentence.", "source": "Le Guin, Rocannon's World (1966), opening handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "Currently untaxable"}, {"index": 782, "feature": "place and institution description", "claim": "The planetary entry states landmass coverage as a percentage of the planet's surface.", "source": "Le Guin, Rocannon's World (1966), second handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "Four major landmasses, Northwest, Southwest, East and Antarctic Continents, occupy 38%"}, {"index": 785, "feature": "annalist voice and deep time", "claim": "The handbook's history is a labelled section whose first sentence is a dated passive naming the expedition.", "source": "Le Guin, Rocannon's World (1966), second handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "History: The planet was charted by the Elieson Expedition in 202"}, {"index": 786, "feature": "civic record register", "claim": "A survey is recorded as a verbless line of label, year and named director.", "source": "Le Guin, Rocannon's World (1966), second handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "First Ethnographic Survey, 321, Director: G. Rocannon"}, {"index": 787, "feature": "civic record register", "claim": "A prohibition is recorded as a dated passive naming the authority that imposed it and the reason it stands.", "source": "Le Guin, Rocannon's World (1966), second handbook entry, quoted by Books & Boots", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "the planet was placed under Interdict by the Allworld HILF Authority"}, {"index": 789, "feature": "register modulation", "claim": "The blogger contrasts the folk-tale style of the novel's opening story with the more factual style of the rest.", "source": "Books & Boots (astrofella), review of Rocannon's World, 2019", "url": "https://astrofella.wordpress.com/2019/12/05/rocannons-world-ursula-le-guin/", "quote": "cast in much more factual, sci fi style"}, {"index": 791, "feature": "opening sentence", "claim": "Anand Pandian describes Rocannon's World as opening with the ethnographer's survey of hominoid species on one world.", "source": "Anand Pandian, anthro{dendum}, 2018", "url": "http://anthrodendum.org/2018/01/26/ursula-ak-le-guin-interplanetary-anthropologist-2/", "quote": "opening with his survey of “hominoid” species on the world"}, {"index": 792, "feature": "plainness and economy", "claim": "Le Guin states that a plain language is the noblest of all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (speech 1972; Pendragon Press booklet 1973; in The Language of the Night, 1979)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "A plain language is the noblest of all."}, {"index": 793, "feature": "plainness and economy", "claim": "Le Guin calls clarity and simplicity permanent virtues in a narrative.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (speech 1972; booklet 1973; in The Language of the Night, 1979)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "Clarity and simplicity are permanent virtues in a narrative."}, {"index": 794, "feature": "plainness and economy", "claim": "Le Guin says that plain language is also the most difficult kind to write.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It is also the most difficult."}, {"index": 795, "feature": "diction (native vs latinate)", "claim": "Le Guin describes Tolkien's vocabulary as unstriking and everything in it as direct, concrete and simple.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "everything is direct, concrete, and simple"}, {"index": 796, "feature": "register modulation", "claim": "Le Guin says the outstanding virtue of Tolkien's plain English is its flexibility, ranging easily from the commonplace to the stately.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It ranges easily from the commonplace to the stately"}, {"index": 797, "feature": "plainness and economy", "claim": "Le Guin distinguishes a fake plainness that is not really simple but flat from genuine plain style.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It is not really simple, but flat."}, {"index": 798, "feature": "concrete sensory noun", "claim": "Le Guin faults the flat fantasy style because its rocks, wind and trees are not there and not felt.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the rocks, the wind, the trees are not there"}, {"index": 802, "feature": "archaism", "claim": "Le Guin calls the archaic manner a trap into which almost all very young fantasy writers walk, and says she did herself.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "a trap into which almost all very young fantasy writers walk"}, {"index": 803, "feature": "archaism", "claim": "Le Guin grants that the archaic manner is a perfect distancer but says it must be done perfectly.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "The archaic manner is indeed a perfect distancer"}, {"index": 804, "feature": "archaism", "claim": "Le Guin names ichor as the infallible touchstone of the seventh-rate among fantasy's fancy words.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the infallible touchstone of the seventh-rate: Ichor"}, {"index": 805, "feature": "archaism", "claim": "Le Guin concludes that archaisms are not essential to fantasy.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "After all, archaisms are not essential."}, {"index": 813, "feature": "place and institution description", "claim": "Le Guin says a secondary world is a construct built in a void with every joint and seam and nail exposed, because there is no borrowed reality to hide behind.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "with every joint and seam and nail exposed"}, {"index": 814, "feature": "plainness and economy", "claim": "Le Guin ends her account of the secondary world with the sentence that every word counts.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "And every word counts."}, {"index": 815, "feature": "cadence and rhythm", "claim": "Le Guin defines the musical dimension of prose as the sound of the words, the movement of the syntax and the rhythm of the sentences.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the movement of the syntax, and the rhythm of the sentences"}, {"index": 816, "feature": "archaism", "claim": "Le Guin praises Eddison's archaic prose as exact, clear and powerful despite or because of its archaisms.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "exact, clear, powerful"}, {"index": 817, "feature": "register modulation", "claim": "Le Guin criticises Leiber and Zelazny for alternating a colloquial American style with old formal usages within one work.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "they alternate the two styles"}, {"index": 819, "feature": "archaism", "claim": "Le Guin says Jack Vance's achieved style contains no archaisms at all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "it contains no archaisms at all"}, {"index": 820, "feature": "place and institution description", "claim": "Le Guin says Tolkien's references to places, people and events outside the immediate story give the reader a conviction of the reality of the immediate scene.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005), ursulakleguin.com", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "a conviction of the reality of the immediate scene"}, {"index": 821, "feature": "concrete sensory noun", "claim": "Le Guin says exact and vivid words make an exact and vivid world.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "Exact and vivid words make an exact and vivid world."}, {"index": 824, "feature": "withheld information and inference", "claim": "Le Guin says she has often mentioned events and places in her fantasies that she did not yet know anything about, which were merely words when she wrote them.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "These were, when I wrote them, merely words"}, {"index": 827, "feature": "concrete sensory noun", "claim": "Le Guin says realistic detail is used in fantasy only in lesser matters, to ground the story and prevent an overload of the improbable.", "source": "Ursula K. Le Guin, \"Plausibility Revisited\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-revisited", "quote": "Only in lesser matters is realistic detail used to ground the story"}, {"index": 828, "feature": "place and institution description", "claim": "Le Guin says that a fantasy world resembling preindustrial mediaeval Europe is not thereby justified in having no economics and no social justice.", "source": "Ursula K. Le Guin, \"Some Assumptions about Fantasy\", speech at the Children's Literature Breakfast, BookExpo America, Chicago, 4 June 2004", "url": "https://www.ursulakleguin.com/some-assumptions-about-fantasy", "quote": "no economics and no social justice"}, {"index": 829, "feature": "place and institution description", "claim": "Le Guin says she feels like setting off fireworks whenever she finds a fantasy set in a genuinely imagined society and culture.", "source": "Ursula K. Le Guin, \"Some Assumptions about Fantasy\" (BookExpo America, 4 June 2004)", "url": "https://www.ursulakleguin.com/some-assumptions-about-fantasy", "quote": "set in a genuinely imagined society and culture"}, {"index": 832, "feature": "plainness and economy", "claim": "Le Guin says that with the most ordinary ingredients, naming everyday language among them, and care and skill in using them, a writer can make something extremely good.", "source": "Ursula K. Le Guin, \"Navigation Q1: How do you make something good?\", Book View Cafe, 27 July 2015 (text at ursulakleguin.com)", "url": "https://www.ursulakleguin.com/bvc-navigation-q1", "quote": "potatoes, everyday language, commonplace characters"}, {"index": 834, "feature": "cadence and rhythm", "claim": "Le Guin says prose rhythms are regular, if at all, only on a very much larger and longer scale than metrical feet.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "only on a very much larger, longer scale"}, {"index": 835, "feature": "cadence and rhythm", "claim": "Le Guin says prose rhythms are hard to talk about because we have no vocabulary for them.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "we have no vocabulary for them"}, {"index": 836, "feature": "cadence and rhythm", "claim": "Le Guin says that whether composing or rewriting she does not think consciously about the rhythmic factors in a story.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "I don’t think consciously about the rhythmic factors in a story"}, {"index": 837, "feature": "cadence and rhythm", "claim": "Le Guin says reading aloud makes you aware of a word or phrase that tangles up the pace and needs to be moved or removed.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "a word or a phrase that tangles up the pace"}, {"index": 838, "feature": "cadence and rhythm", "claim": "Le Guin says a hesitation while reading your own prose aloud may reveal a fault in the rhythm.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "Wherever you hesitate in your reading aloud may reveal a fault"}, {"index": 839, "feature": "omission as information", "claim": "Le Guin says pity and terror are achieved more often through brevity, a few telling details and a great deal left unsaid than through wallowing in a bloodbath.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "brevity, a few telling details, a great left unsaid"}, {"index": 840, "feature": "omission as information", "claim": "Le Guin praises a Patrick O'Brian scene of a ship going down with five hundred men aboard as one that could not be shorter, more silent, or more shocking.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "could not be shorter, more silent, or more shocking"}, {"index": 844, "feature": "concrete sensory noun", "claim": "Le Guin advises describing just enough of a character's appearance to give the noticing reader a clear clue, saying one physical detail will often do it.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "Often one physical detail will do it"}, {"index": 845, "feature": "place and institution description", "claim": "Le Guin says her own specimen general description of an invented town, placing Horb on the coast of the southernmost of nine continents, implies very little.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "This general description implies very little"}, {"index": 846, "feature": "place and institution description", "claim": "Le Guin says her second specimen sentence about Horb lets the reader learn that the place has a long-established trading economy without stating it.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "it has a long-established trading economy"}, {"index": 847, "feature": "concrete sensory noun", "claim": "Le Guin says the difference between her two specimen descriptions is specificity, and prescribes packing sentences with specifics, not with generalities.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "packing your sentences with specifics, not with generalities"}, {"index": 849, "feature": "withheld information and inference", "claim": "Le Guin says a reader will learn what an unexplained invented term means but may have to wait a while, and that lazy readers find waiting uncomfortable.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "The reader will learn what it is"}, {"index": 850, "feature": "omission as information", "claim": "Le Guin says a writer can fake quite a lot or leave it unsaid so long as the invented world looks and smells and tastes real.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "so long as your world looks and smells and tastes real"}, {"index": 853, "feature": "concrete sensory noun", "claim": "Le Guin says of her own practice that she is very strong on accuracy and exactitude.", "source": "Ursula K. Le Guin interviewed by John Plotz, \"The Story's Where I Go\", Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "I’m very strong on accuracy and exactitude."}, {"index": 854, "feature": "place and institution description", "claim": "Le Guin says that with an invented world you have to describe more than a realist does.", "source": "Ursula K. Le Guin interviewed by John Plotz, Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "you have to describe more than a realist does"}, {"index": 855, "feature": "omission as information", "claim": "Le Guin says that in describing an invented world the leaving-out is half the art, and the reader fills the white spaces.", "source": "Ursula K. Le Guin interviewed by John Plotz, Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "the leaving-out is half the art"}, {"index": 856, "feature": "plainness and economy", "claim": "Le Guin says you cannot describe everything because that would be very boring.", "source": "Ursula K. Le Guin interviewed by John Plotz, Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "You can’t describe everything"}, {"index": 857, "feature": "plainness and economy", "claim": "Le Guin says she has learned to stop fiddling and twiddling because fiction needs a certain roughness.", "source": "Ursula K. Le Guin, interview excerpts, \"A Return to Earthsea\", Locus Magazine, September 2001 (Locus Online excerpts page)", "url": "https://www.locusmag.com/2001/Issue09/LeGuin.html", "quote": "Fiction needs a certain roughness."}, {"index": 858, "feature": "plainness and economy", "claim": "Le Guin says she has read overpolished fiction and found it kind of a bore.", "source": "Ursula K. Le Guin, \"A Return to Earthsea\", Locus Magazine, September 2001", "url": "https://www.locusmag.com/2001/Issue09/LeGuin.html", "quote": "I’ve read overpolished fiction, and it’s kind of a bore."}, {"index": 860, "feature": "annalist voice and deep time", "claim": "Le Guin describes researching the history of Earthsea as going into the archives, which are all in her head.", "source": "Ursula K. Le Guin, \"A Return to Earthsea\", Locus Magazine, September 2001", "url": "https://www.locusmag.com/2001/Issue09/LeGuin.html", "quote": "I went into the archives"}, {"index": 863, "feature": "point of view and distance", "claim": "Le Guin says that to write Tehanu all she had to do was describe Earthsea from the point of view of the powerless and disempowered.", "source": "Ursula K. Le Guin, \"Chronicles of Earthsea\" reader Q&A, The Guardian, 9 February 2004", "url": "http://books.guardian.co.uk/departments/sciencefiction/story/0,6000,1144428,00.html", "quote": "describe it from the point of view of the powerless"}, {"index": 866, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, says that even when Tolkien's sentences are long their flow is clear and punctuation comes just where you need to pause.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (Meditations on Middle-earth, 2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "punctuation comes just where you need to pause"}, {"index": 867, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, calls the cadences of Tolkien's prose graceful and inevitable.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "the cadences are graceful and inevitable"}, {"index": 868, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, concludes that Tolkien must have heard what he wrote.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Tolkien must have heard what he wrote"}, {"index": 871, "feature": "point of view and distance", "claim": "Le Guin says the present tense, used by some writers to make the telling more actual, actually distances the story.", "source": "Ursula K. Le Guin, \"Some Thoughts on Narrative\" (1980), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "actually distances the story"}, {"index": 873, "feature": "point of view and distance", "claim": "Le Guin says narrative locates itself in the past in order to allow itself forward movement.", "source": "Ursula K. Le Guin, \"Some Thoughts on Narrative\" (1980), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "It locates itself in the past"}, {"index": 876, "feature": "civic record register", "claim": "Le Guin presents a single line of runes carved in Carlisle Cathedral, reading that Tolfink carved these runes in this stone, as a whole story.", "source": "Ursula K. Le Guin, \"It Was a Dark and Stormy Night; or, Why Are We Huddling about the Campfire?\" (1979), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "Tolfink carved these runes in this stone."}, {"index": 877, "feature": "annalist voice and deep time", "claim": "Le Guin says that runic inscription is pretty close to Barbara Herrnstein Smith's earliest form of historiography, notch-cutting.", "source": "Ursula K. Le Guin, \"It Was a Dark and Stormy Night\" (1979), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "Barbara Herrnstein Smith’s earliest form of historiography"}, {"index": 878, "feature": "civic record register", "claim": "Le Guin says the inscription does not really meet the requirement of Minimal Connexity and has little beginning or end.", "source": "Ursula K. Le Guin, \"It Was a Dark and Stormy Night\" (1979), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "it does not really meet the requirement of Minimal Connexity"}, {"index": 879, "feature": "civic record register", "claim": "Le Guin nonetheless judges the carver of that inscription a reliable narrator who bore witness to his own existence.", "source": "Ursula K. Le Guin, \"It Was a Dark and Stormy Night\" (1979), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "Tolfink was a reliable narrator"}, {"index": 880, "feature": "omission as information", "claim": "Le Guin explains the extreme brevity of the runic record by saying the material was obdurate and life is short.", "source": "Ursula K. Le Guin, \"It Was a Dark and Stormy Night\" (1979), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "The material was obdurate, and life is short."}, {"index": 881, "feature": "place and institution description", "claim": "Le Guin says what artists do is make a particularly skillful selection of fragments of cosmos, chosen and arranged to give an illusion of coherence and duration.", "source": "Ursula K. Le Guin, \"World-Making\" (1981), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "a particularly skillful selection of fragments of cosmos"}, {"index": 882, "feature": "place and institution description", "claim": "Le Guin says that all a work of art is, is an explorer's sketch-map.", "source": "Ursula K. Le Guin, \"World-Making\" (1981), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "all it is is an explorer’s sketch-map"}, {"index": 883, "feature": "civic record register", "claim": "Le Guin reproduces a sentence from her father's Handbook of the Indians of California declaring a people extinct so far as all practical purposes are concerned.", "source": "Ursula K. Le Guin, \"World-Making\" (1981), in Dancing at the Edge of the World (1989), quoting A. L. Kroeber, Handbook of the Indians of California (1918)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "so far as all practical purposes are concerned"}, {"index": 884, "feature": "place and institution description", "claim": "Le Guin's own travel piece renders a stretch of country as bare noun phrases with a repeated frame, writing that sagebrush is at its intervals and power poles at their intervals.", "source": "Ursula K. Le Guin, \"Places Names\" (1981), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "Sagebrush at its intervals. Power poles at their intervals."}, {"index": 886, "feature": "cadence and rhythm", "claim": "Le Guin says the job of composition is getting the right words in the right order and getting the measure right.", "source": "Ursula K. Le Guin, \"Reciprocity of Prose and Poetry\" (1983), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "the right order, getting the measure right, is the same"}, {"index": 887, "feature": "cadence and rhythm", "claim": "Le Guin says prose could have its own proper, looser rhythms and measures, distinct from metre.", "source": "Ursula K. Le Guin, \"Reciprocity of Prose and Poetry\" (1983), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "prose could have its own proper, looser rhythms and measures"}, {"index": 888, "feature": "cadence and rhythm", "claim": "Le Guin says a novel gains its power less from the sound of any single sentence than from the pacing and rhythm of paragraphs and chapters.", "source": "Ursula K. Le Guin, \"Reciprocity of Prose and Poetry\" (1983), in Dancing at the Edge of the World (1989)", "url": "https://ebin.pub/dancing-at-the-edge-of-the-world-thoughts-on-words-women-places-9780802135292.html", "quote": "the pacing and rhythm of paragraphs and chapters"}, {"index": 890, "feature": "plainness and economy", "claim": "Le Guin says what she has learned as a writer, as she has gone on, is that you do as little as possible.", "source": "Ursula K. Le Guin interviewed by Paul Morton, \"Getting Away with Murder: The Millions Interviews Ursula K. Le Guin\", The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "you do as little as possible"}, {"index": 891, "feature": "withheld information and inference", "claim": "Le Guin says part of doing as little as possible is leaving a lot of it up to the reader.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "leaving a lot of it up to the reader"}, {"index": 892, "feature": "plainness and economy", "claim": "Le Guin says her writing has tended to become shorter and more allusive than it used to be.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "shorter and more allusive than it used to be"}, {"index": 894, "feature": "cadence and rhythm", "claim": "Le Guin says she loves the sound of language and plays with word sounds in her head.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "I love language, I love the sound of language."}, {"index": 895, "feature": "naming and forms of address", "claim": "Le Guin gives pronunciation guidelines for her invented names because how a name is said affects the sound and rhythm of a sentence.", "source": "Ursula K. Le Guin, \"Ursula on Ursula\" (pronunciation guide and reader notes), ursulakleguin.com", "url": "https://www.ursulakleguin.com/ursula-on-ursula", "quote": "this does affect the sound and rhythm of a sentence"}, {"index": 897, "feature": "plainness and economy", "claim": "Le Guin praises a book she admires by calling its prose of unobtrusive excellence.", "source": "Ursula K. Le Guin, blog 51, \"The Narrative Gift as a Moral Conundrum\", 2011", "url": "https://www.ursulakleguin.com/blog/51-the-narrative-gift-as-a-moral-conundrum", "quote": "The prose is of unobtrusive excellence."}, {"index": 900, "feature": "cadence and rhythm", "claim": "Le Guin says the sound and rhythm of prose is so different from poetry, being in a way much coarser.", "source": "Ursula K. Le Guin in conversation with David Naimon, excerpted from Ursula K. Le Guin: Conversations on Writing (Tin House, 2018), published at Literary Hub", "url": "https://lithub.com/ursula-k-le-guin-dictators-are-always-afraid-of-poets/", "quote": "the sound in the rhythm of prose, it is so different from poetry"}, {"index": 901, "feature": "cadence and rhythm", "claim": "Le Guin says the rhythms of a prose work are a very long beat.", "source": "Ursula K. Le Guin in conversation with David Naimon, Conversations on Writing (Tin House, 2018), excerpt at Literary Hub", "url": "https://lithub.com/ursula-k-le-guin-dictators-are-always-afraid-of-poets/", "quote": "long beat, the rhythms of a prose work"}, {"index": 902, "feature": "cadence and rhythm", "claim": "Le Guin says that, besides the long beat of the whole work, the sentence has its rhythms too.", "source": "Ursula K. Le Guin in conversation with David Naimon, Conversations on Writing (Tin House, 2018), excerpt at Literary Hub", "url": "https://lithub.com/ursula-k-le-guin-dictators-are-always-afraid-of-poets/", "quote": "Of course, the sentence has its rhythms too."}, {"index": 903, "feature": "cadence and rhythm", "claim": "Le Guin says the deeper meaning that poetry shares with music is carried by the rhythm and the beat, the music of the sound.", "source": "Ursula K. Le Guin in conversation with David Naimon, Conversations on Writing (Tin House, 2018), excerpt at Literary Hub", "url": "https://lithub.com/ursula-k-le-guin-dictators-are-always-afraid-of-poets/", "quote": "it is the rhythm and the beat, the music of the sound that carries it"}, {"index": 904, "feature": "cadence and rhythm", "claim": "Le Guin says she does not think syllabically but rhythmically.", "source": "Ursula K. Le Guin in conversation with David Naimon, Conversations on Writing (Tin House, 2018), excerpt at Literary Hub", "url": "https://lithub.com/ursula-k-le-guin-dictators-are-always-afraid-of-poets/", "quote": "I don’t think syllabically, I think rhythmically."}, {"index": 905, "feature": "register modulation", "claim": "Maslen argues that recording a diversity of understandings and ways of speaking inside a text written in a single language is the principal problem confronting Le Guin as a writer.", "source": "Rob Maslen, \"Towards an Archaeology of the Future: Theodora Kroeber and Ursula K Le Guin\", Foundation: The Review of Science Fiction No. 67 (Summer 1996), text at The Anarchist Library", "url": "https://theanarchistlibrary.org/library/rob-maslen-towards-an-archaeology-of-the-future-theodora-kroeber-and-ursula-k-le-guin", "quote": "recording a diversity of different understandings and ways of speaking"}, {"index": 906, "feature": "civic record register", "claim": "Le Guin describes Annals of the Parish as the annual records of a parish minister, kept and dated year by year for 50 years, from 1760 to 1810.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "kept and dated year by year for 50 years"}, {"index": 907, "feature": "point of view and distance", "claim": "Le Guin calls the annalist narrator of that book a very old-fashioned narrator, and therefore reliable.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "a very old-fashioned narrator, and therefore reliable"}, {"index": 909, "feature": "omission as information", "claim": "Le Guin says that in these annals violence is witnessed without participation.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "Violence is witnessed without participation"}, {"index": 910, "feature": "withheld information and inference", "claim": "Le Guin says the annalist leaves it up to the reader to hear what is being told, to imagine it and to feel it.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "It’s left up to us to hear what’s being told"}, {"index": 911, "feature": "plainness and economy", "claim": "Le Guin says all the material the reader needs to hear, imagine and feel the scene is in those few words, in their choice and in their cadence.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "in those few words, in their choice and in their cadence"}, {"index": 912, "feature": "plainness and economy", "claim": "Le Guin says Galt's prose works like poetry because every word tells.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "Galt’s prose works like poetry: every word tells"}, {"index": 915, "feature": "place and institution description", "claim": "Le Guin says intimate knowledge of one small community may yield psychological and anthropological insights of universal value.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "may yield psychological and anthropological insights of universal value"}, {"index": 917, "feature": "place and institution description", "claim": "Le Guin says small-town novels are intensely grounded and rich in satire, humour and character.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "small-town novels are intensely grounded"}, {"index": 918, "feature": "point of view and distance", "claim": "Le Guin says of the annalist narrator that he will not and cannot mislead the reader, and that he is transparent.", "source": "Ursula K. Le Guin, \"B-Sides: John Galt's Annals of the Parish\", Public Books, 23 January 2017", "url": "https://www.publicbooks.org/b-sides-john-galts-annals-parish/", "quote": "He will not, he cannot, mislead you. He is transparent."}, {"index": 920, "feature": "place and institution description", "claim": "Le Guin says Woolf's Orlando gave her the authentic thrill of being taken absolutely elsewhere.", "source": "Ursula K. Le Guin, contribution on Virginia Woolf, The Guardian, 14 May 2011", "url": "https://www.theguardian.com/books/2011/may/14/science-fiction-authors-choice", "quote": "the authentic thrill of being taken absolutely elsewhere"}, {"index": 921, "feature": "plainness and economy", "claim": "Kim Stanley Robinson says Le Guin's language is clear and clean.", "source": "Kim Stanley Robinson, contribution on The Left Hand of Darkness to \"The stars of modern SF pick the best science fiction\", The Guardian, 14 May 2011", "url": "https://www.theguardian.com/books/2011/may/14/science-fiction-authors-choice", "quote": "Le Guin's language is clear and clean"}], "verdicts": [{"index": 541, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 542, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 543, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 546, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 548, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 551, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 552, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 555, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 556, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"ind