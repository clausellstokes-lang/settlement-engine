  {
   "feature": "homogenisation",
   "claim": "Chiang argues that when an LLM fills in the choices a prompt did not make by averaging the choices other writers made, that average amounts to the least interesting choices available, which is why AI-generated text is often bland.",
   "source": "Ted Chiang, essayist and SF writer, The New Yorker, 2024",
   "url": "https://www.newyorker.com/culture/the-weekend-essay/why-ai-isnt-going-to-make-art",
   "quote": "that average is equivalent to the least interesting choices possible",
   "page": "para. beginning \"If an A.I. generates a ten-thousand-word story\"",
   "kind": "analysis",
   "polarity": "asserts",
   "date": "2024-08-31",
