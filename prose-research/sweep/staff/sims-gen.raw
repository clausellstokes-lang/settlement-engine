	<header id="masthead" class="site-header" role="banner">
		<div class="site-branding">
									<h1 class="site-title"><a href="https://chrisssims.wordpress.com/" rel="home">Chris S. Sims</a></h1>
			<h2 class="site-description">Thoughts on games, fiction, writing, life.</h2>
		</div><!-- .site-branding -->
