lcomePage\":false,\"pendingInviteForActiveLiveStream\":null,\"isEligibleForLiveStreamCreation\":true,\"webviewPlatform\":null,\"noIndex\":false,\"post\":{\"audience\":\"everyone\",\"audience_before_archived\":null,\"canonical_url\":\"https://50yearsinthedungeon.substack.com/p/honoring-kim-mohan\",\"default_comment_sort\":null,\"editor_v2\":false,\"exempt_from_archive_paywall\":false,\"free_unlock_required\":false,\"id\":164289343,\"podcast_art_url\":null,\"podcast_duration\":null,\"podcast_preview_upload_id\":null,\"podcast_upload_id\":null,\"podcast_url\":null,\"post_date\":\"2025-05-24T16:01:21.827Z\",\"updated_at\":\"2025-07-22T01:48:55.261Z\",\"publication_id\":2285221,\"search_engine_description\":null,\"search_engine_title\":null,\"section_id\":null,\"should_send_free_preview\":false,\"show_guest_bios\":true,\"slug\":\"honoring-kim-mohan\",\"social_title\":null,\"subtitle\":\"Let's help get Kim Mohan inducted into the Sci-Fi Hall of Fame\",\"teaser_post_eligible\":true,\"title\":\"Honoring Kim Mohan\",\"type\":\"newsletter\",\"video_upload_id\":null,\"write_comment_permissions\":\"everyone\",\"meter_type\":\"none\",\"live_stream_id\":null,\"is_published\":true,\"restacks\":2,\"reactions\":{\"\u2764\":3},\"top_exclusions\":[],\"pins\":[],\"section_pins\":[],\"has_shareable_clips\":false,\"previous_post_slug\":\"remembering-james-m-ward\",\"next_post_slug\":\"everyone-needs-a-break-sometimes\",\"cover_image\":\"https://substackcdn.com/image/fetch/$s_!sUHq!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg\",\"cover_image_is_square\":false,\"cover_image_is_explicit\":false,\"videoUpload\":null,\"podcastFields\":{\"post_id\":164289343,\"podcast_episode_number\":null,\"podcast_season_number\":null,\"podcast_episode_type\":null,\"should_syndicate_to_other_feed\":null,\"syndicate_to_section_id\":null,\"hide_from_feed\":false,\"free_podcast_url\":null,\"free_podcast_duration\":null,\"preview_contains_ad\":false,\"was_imported_self_serve_sync\":false,\"draft_free_podcast_url\":null,\"draft_free_podcast_duration\":null},\"podcastUpload\":null,\"podcastPreviewUpload\":null,\"voiceover_upload_id\":null,\"voiceoverUpload\":null,\"has_voiceover\":false,\"description\":\"Let's help get Kim Mohan inducted into the Sci-Fi Hall of Fame\",\"body_html\":\"<p>I\u2019m occasionally asked if there\u2019s anyone I wish I could get to come on the show as a guest. And while there\u2019s definitely a \u201Cwish list\u201D of folks I\u2019d like to get on, there\u2019s also a list of folks it\u2019s who are sadly no longer available\u2014folks like Gygax and Arneson. But right there at the top my list is also Kim Mohan.</p><p>Kim is one of those people who was so influential, it\u2019s doubtful that the hobby of TTRPGs or the world of modern sci-fi/fantasy fiction would be the same without him \u2026 but he\u2019s also a name that most casual fans (and even many devotees) are unfamiliar with. That\u2019s because Kim was an editor \u2026 and editors almost never step up and take a bow. </p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!sUHq!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!sUHq!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 424w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 848w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!sUHq!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg\\\" width=\\\"401\\\" height=\\\"500\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/e03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:500,&quot;width&quot;:401,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:64956,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:true,&quot;internalRedirect&quot;:&quot;https://50yearsinthedungeon.substack.com/i/164289343?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!sUHq!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 424w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 848w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!sUHq!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe03a0082-db43-4ca4-ae77-f2a5700ae2ce_401x500.jpeg 1456w\\\" sizes=\\\"100vw\\\" fetchpriority=\\\"high\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div><p>As an editor, Kim worked on EVERY edition of D&amp;D from the original hardcovers to 5E supplements. For a good portion of that time he served as Editor in Chief\u2014or Managing Editor or Senior Editor, the title changed, but the responsibilities were always to set the editorial tone and mentor the staff. </p><p>Over the years he also was editor on <em>Dragon Magazine, Dungeon Magazine, Star Wars Insider,</em> and <em>Amazing Stories</em> (yes, THAT <em>Amazing Stories</em>). There isn\u2019t a person who has worked on any of those properties in the past half-century that doesn\u2019t owe a debt of gratitude to Kim Mohan. I got to work with Kim for about ten years \u2026 and I can\u2019t express how grateful I am for his insight, his wisdom, his kindness, and his friendship. </p><p>Sadly, Kim passed away in December of 2022. I\u2019d always hoped and often encouraged him to write a memoir about his time at TSR. But he\u2019d chuckle and say, \u201CNo one would want to read that.\u201D And I could never convince him how wrong he was. When I first put the idea for <em>50 Years in the Dungeon</em> together, one of my first thoughts was that I wished I\u2019d thought of it sooner so that I could have had Kim as a guest.</p><p>The Museum of Pop Culture here in Seattle is home to the Science Fiction and Fantasy Hall of Fame. They are currently taking nominations from the public for 2025 Hall of Fame inductees. There\u2019s a groundswell among those of us who knew Kim well to get his work recognized and enshrined in the hall. (They already have his papers as part of their permanent collection.) </p><p>Nominations are open to the public. And I\u2019d encourage anyone who has ever been touched by Kim\u2019s work (and I think that\u2019s probably EVERYONE reading this post) to submit his name for nomination. It\u2019s <a href=\\\"https://forms.office.com/pages/responsepage.aspx?id=s7I4YOuPuE2vrdwftDSQbMoVEtMz-1FOqqX2IrKSdUpURVRRT1JNSzZXWDFESFBOOERQNEM1TkhTOS4u&amp;route=shorturl&amp;fbclid=IwY2xjawKeUmxleHRuA2FlbQIxMABicmlkETFtQ0NRb0ZycFB2Y0NWTkxEAR6QmQx8z3pdaPXllsvGcE-LBI5tu5ePmvCVmzq_J8jHZ85HWhBcJXW73TxDXg_aem_pZuQqFWkTXz8Jj_bGrPj1Q\\\">a very simple form you can find here</a>. Just write in EDITOR: KIM MOHAN (Amazing Stories, Dungeons &amp; Dragons) under Creator.</p><p>Let\u2019s see if we can get Kim\u2019s name out of the shadows and into the spotlight he so richly deserves.</p>\",\"has_dynamic_content\":false,\"truncated_body_text\":\"I\u2019m occasionally asked if there\u2019s anyone I wish I could get to come on the show as a guest. And while there\u2019s definitely a \u201Cwish list\u201D of folks I\u2019d like to get on, there\u2019s also a list of folks it\u2019s who are sadly no longer available\u2014folks like Gygax and Arneson. But right there at the top my list is also Kim Mohan.\",\"wordcount\":480,\"post_preview_limit\":null,\"language\":\"en\",\"postTags\":[{\"id\":\"a7106c78-709a-4d72-8261-261567e64d60\",\"publication_id\":2285221,\"name\":\"News\",\"slug\":\"news\",\"hidden\":false}],\"postCountryBlocks\":[],\"headlineTest\":null,\"coverImagePalette\":{\"Vibrant\":{\"rgb\":[226,146,108],\"population\":288},\"DarkVibrant\":{\"rgb\":[103,54,48],\"population\":228},\"LightVibrant\":{\"rgb\":[251,235,202],\"population\":537},\"Muted\":{\"rgb\":[155,132,106],\"population\":564},\"DarkMuted\":{\"rgb\":[89,68,44],\"population\":3},\"LightMuted\":{\"rgb\":[221,203,190],\"population\":44}},\"publishedBylines\":[{\"id\":10793811,\"name\":\"Stan!\",\"handle\":\"stannex\",\"previous_name\":null,\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/90f58d01-d8e4-4e06-835e-b7c9feb8c1cc_577x600.jpeg\",\"bio\":\"Cartoonist, Game Designer, Author, and Raconteur Par Excellence ... also Sumolier to the world.\",\"profile_set_up_at\":\"2023-09-12T20:46:22.836Z\",\"reader_installed_at\":\"2024-03-05T21:25:54.730Z\",\"publicationUsers\":[{\"id\":2303849,\"user_id\":10793811,\"publication_id\":2285221,\"role\":\"admin\",\"public\":true,\"is_primary\":true,\"publication\":{\"id\":2285221,\"name\":\"50 Years in the Dungeon\",\"subdomain\":\"50yearsinthedungeon\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"This is the official substack for \\\"50 Years in the Dungeon\\\" a livestream show celebrating a half-century of tabletop roleplaying games. Hosted by award-winning cartoonist and game designer Stan!\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/0703f695-a6dd-48e8-a9ef-196cc9554089_1280x1280.png\",\"author_id\":10793811,\"primary_user_id\":10793811,\"theme_var_background_pop\":\"#6B26FF\",\"created_at\":\"2024-01-24T01:31:31.921Z\",\"email_from_name\":null,\"copyright\":\"Stan!\",\"founding_plan_name\":\"Art Collector\",\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"enabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"newspaper\",\"is_personal_mode\":false,\"logo_url_wide\":null}},{\"id\":1937328,\"user_id\":10793811,\"publication_id\":1946234,\"role\":\"admin\",\"public\":true,\"is_primary\":false,\"publication\":{\"id\":1946234,\"name\":\"Stan!'s Substack\",\"subdomain\":\"stannex\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"Stan!'s personal substack\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/90f58d01-d8e4-4e06-835e-b7c9feb8c1cc_577x600.jpeg\",\"author_id\":10793811,\"primary_user_id\":null,\"theme_var_background_pop\":\"#FF6B00\",\"created_at\":\"2023-09-12T20:51:17.694Z\",\"email_from_name\":null,\"copyright\":\"Stan!\",\"founding_plan_name\":null,\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"disabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"newspaper\",\"is_personal_mode\":false,\"logo_url_wide\":null}},{\"id\":3128661,\"user_id\":10793811,\"publication_id\":3074320,\"role\":\"admin\",\"public\":true,\"is_primary\":false,\"publication\":{\"id\":3074320,\"name\":\"Stickers by Stan! Substack\",\"subdomain\":\"stickersbystan\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"A newsletter for StickersByStan.com and the Sticker of the Week!\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/90f58d01-d8e4-4e06-835e-b7c9feb8c1cc_577x600.jpeg\",\"author_id\":10793811,\"primary_user_id\":null,\"theme_var_background_pop\":\"#FF6719\",\"created_at\":\"2024-09-24T22:48:16.341Z\",\"email_from_name\":null,\"copyright\":\"Stan!\",\"founding_plan_name\":null,\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"disabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"newspaper\",\"is_personal_mode\":false,\"logo_url_wide\":null}}],\"is_guest\":false,\"bestseller_tier\":null,\"status\":{\"bestsellerTier\":null,\"subscriberTier\":null,\"leaderboard\":null,\"vip\":false,\"badge\":null,\"subscriber\":null}}],\"reaction\":null,\"reaction_count\":3,\"comment_count\":1,\"child_comment_count\":1,\"audio_items\":[{\"post_id\":164289343,\"voice_id\":\"en-US-NovaTurboMultilingualNeural\",\"audio_url\":\"https://substack-video.s3.amazonaws.com/video_upload/post/164289343/tts/a6138faa-fa16-4046-8685-179ee4bb68cd/en-US-NovaTurboMultilingualNeural.mp3\",\"type\":\"tts\",\"status\":\"completed\"}],\"is_geoblocked\":false,\"hasCashtag\":false},\"comments\":[{\"id\":119849479,\"body\":\"You've mentioned that you'd like to have a couple panel episodes, and I think he would make a wonderful focus for one.\",\"body_json\":{\"type\":\"doc\",\"attrs\":{\"schemaVersion\":\"v1\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You've mentioned that you'd like to have a couple panel episodes, and I think he would make a wonderful focus for on