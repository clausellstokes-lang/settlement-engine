{"name": "ai", "triage": true, "claims": [{"index": 571, "feature": "tidy endings", "claim": "Sudowrite's own marketing names a preference for happy endings as a defect of general-purpose models.", "source": "Sudowrite, Muse product page (vendor marketing copy)", "url": "https://www.sudowrite.com/muse", "quote": "Basic AI loves happy endings"}, {"index": 591, "feature": "reflexive antithesis", "claim": "Hern names the tendency to offer both sides of an argument in a single response as one of the less noticeable tells of generated text.", "source": "Alex Hern, TechScape newsletter, The Guardian, 16 April 2024", "url": "https://www.theguardian.com/technology/2024/apr/16/techscape-ai-gadgest-humane-ai-pin-chatgpt", "quote": "A tendency to offer both sides of an argument in"}, {"index": 661, "feature": "reflexive antithesis", "claim": "Coagulopath, quoted by nostalgebraist, lists R1's endless not-thing-x-but-thing-y parallelisms among the model's recognisable repetitive habits.", "source": "Coagulopath, commenter, quoted verbatim by nostalgebraist on Tumblr, March 2025", "url": "https://www.tumblr.com/nostalgebraist/778041178124926976/hydrogen-jukeboxes", "quote": "not thing x, but thing y"}, {"index": 670, "feature": "reflexive antithesis", "claim": "Guo argues that the it's-not-X-it's-Y parallelism is a legitimate rhetorical device but that AI uses it constantly and reflexively in situations where it adds nothing.", "source": "Charlie Guo, Artificial Ignorance newsletter, 22 October 2025", "url": "https://www.ignorance.ai/p/the-field-guide-to-ai-slop", "quote": "AI uses it constantly, reflexively, in situations where it adds nothing"}, {"index": 817, "feature": "tidy endings", "claim": "The Dramatica Co. asserts the danger is competent AI fiction sharing one underlying shape it names as tidy, explicit, causally legible, emotionally annotated and thematically over-secured.", "source": "The Dramatica Co., Dramatica Blog, 2026", "url": "https://dramatica.com/blog/the-ai-tells-are-in-the-story", "quote": "tidy, explicit, causally legible, emotionally annotated, and thematically over-secured"}, {"index": 832, "feature": "tidy endings", "claim": "StoryScope measured protagonist-driven resolutions in 69% of AI stories against 46% of human stories.", "source": "Russell, Rajendhran, Pham, Iyyer and Wieting, StoryScope, arXiv:2604.03136v6", "url": "https://arxiv.org/html/2604.03136v6", "quote": "more protagonist-driven resolutions (69% vs. 46%)"}, {"index": 842, "feature": "tidy endings", "claim": "StoryScope's per-model fingerprints record Gemini as producing the tidiest endings and extended denouements.", "source": "Russell, Rajendhran, Pham, Iyyer and Wieting, StoryScope, arXiv:2604.03136v6", "url": "https://arxiv.org/html/2604.03136v6", "quote": "Gemini produces the tidiest endings, extended denouements"}, {"index": 881, "feature": "tidy endings", "claim": "The WikiProject names as a tell that many LLM-generated Wikipedia articles include a Challenges section built on a rigid formula and ending in a vaguely positive assessment.", "source": "WikiProject AI Cleanup, Wikipedia:Signs of AI writing, version of 6 September 2026", "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing", "quote": "Many LLM-generated Wikipedia articles include a \"Challenges\" section"}, {"index": 890, "feature": "reflexive antithesis", "claim": "The WikiProject names as a tell parallel constructions involving not, but or however, such as not only X but also Y and it is not just X, it's Y.", "source": "WikiProject AI Cleanup, Wikipedia:Signs of AI writing, version of 6 September 2026", "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing", "quote": "It is common for LLMs to use parallel constructions involving"}, {"index": 891, "feature": "reflexive antithesis", "claim": "The WikiProject records the reversed form X rather than Y as particularly common in Grok output.", "source": "WikiProject AI Cleanup, Wikipedia:Signs of AI writing, version of 6 September 2026", "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing", "quote": "Grok output is particularly idiosyncratic"}], "verdicts": [{"index": 571, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 591, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 661, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 670, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 817, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 832, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 842, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 881, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 890, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 891, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}]}