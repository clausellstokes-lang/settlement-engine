{"name": "leguin", "triage": true, "claims": [{"index": 542, "feature": "point of view and distance", "claim": "Adam Roberts attributes the compelling quality of Le Guin's rendering of Earthsea to a seriousness and an absolute belief in the way she renders the world.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "There is a seriousness, an absolute belief"}, {"index": 548, "feature": "naming and forms of address", "claim": "Adam Roberts reads the hero's three names, Duny, Ged and Sparrowhawk, as covering three of the four elements, earth, water and air.", "source": "Adam Roberts, Adam's Notebook (Medium), 5 February 2023", "url": "https://medium.com/adams-notebook/ursula-le-guin-a-wizard-of-earthsea-1968-c51a9a61881f", "quote": "three names covering three of the four elements"}, {"index": 551, "feature": "plainness and economy", "claim": "Sean Guynes says Le Guin's language is at its finest and most artful in The Tombs of Atuan.", "source": "Sean Guynes, \"The Tombs of Atuan: Power, Ideology, and Becoming Uneaten\", Reactor, 29 April 2020", "url": "https://reactormag.com/the-tombs-of-atuan-power-ideology-and-becoming-uneaten/", "quote": "language is at its finest, its most artful"}, {"index": 552, "feature": "concrete sensory noun", "claim": "Sean Guynes locates Le Guin's finest sentences in The Tombs of Atuan in the plainclothes description of thistle and juniper and frozen reeds by a desert river in midwinter.", "source": "Sean Guynes, Reactor, 29 April 2020", "url": "https://reactormag.com/the-tombs-of-atuan-power-ideology-and-becoming-uneaten/", "quote": "her sentences luxuriate in the plainclothes description of thistle and juniper"}, {"index": 561, "feature": "cadence and rhythm", "claim": "Le Guin opens Steering the Craft by stating that the sound of the language is where it all begins.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, published at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The sound of the language is where it all begins"}, {"index": 562, "feature": "cadence and rhythm", "claim": "Le Guin gives as the test of a sentence whether it sounds right.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The test of a sentence is, Does it sound right?"}, {"index": 563, "feature": "sentence length variation", "claim": "Le Guin states that the chief duty of a narrative sentence is to lead to the next sentence, so as to keep the story going.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "The chief duty of a narrative sentence is to lead"}, {"index": 564, "feature": "diction (native vs latinate)", "claim": "Le Guin says of her Hurston and Molly Gloss examples that the vocabulary is simple and familiar and that it is above all the rhythm that is powerful and effective.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the vocabulary is simple and familiar"}, {"index": 565, "feature": "plainness and economy", "claim": "Le Guin describes Molly Gloss's prose as quiet and subtle, its power and beauty coming from the perfect placement and timing of the words.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the perfect placement and timing of the words"}, {"index": 566, "feature": "naming and forms of address", "claim": "Le Guin says the sound of characters' and places' names, and the echo-allusions hidden in them, can be intensely expressive.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "the echo-allusions hidden in them, can be intensely expressive"}, {"index": 567, "feature": "archaism", "claim": "Le Guin poses as an open question for discussion whether a novelist who visibly strives for poetical prose using unusual or archaic words intensifies what is being said or distracts from it.", "source": "Ursula K. Le Guin, Steering the Craft (2015 revised edition), chapter 1, at Literary Hub", "url": "https://lithub.com/a-writing-lesson-from-ursula-k-leguin/", "quote": "using unusual or archaic words"}, {"index": 575, "feature": "plainness and economy", "claim": "Stephanie Burt distinguishes Earthsea from most fantasy by its clear, patient prose.", "source": "Stephanie Burt, review of John Plotz's Ursula Le Guin's Earthsea, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "in its clear, patient prose"}, {"index": 576, "feature": "omission as information", "claim": "John Plotz, quoted by Stephanie Burt, calls Le Guin's prose the antithesis of the well-rendered verisimilitude of a high-end video game.", "source": "John Plotz, Ursula Le Guin's Earthsea, p. 48, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the antithesis of the well-rendered verisimilitude of a high-end video game"}, {"index": 577, "feature": "omission as information", "claim": "Stephanie Burt says Le Guin leaves blank spaces for readers to fill in, inviting the reader in and holding them back so that they become co-creators as if listening to an oral tale.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Leaving blank spaces for readers to see how well"}, {"index": 578, "feature": "plainness and economy", "claim": "Stephanie Burt reports that Le Guin's clear, spare prose reminds John Plotz of Willa Cather's, and says she agrees.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Her clear, spare prose reminds Plotz"}, {"index": 579, "feature": "omission as information", "claim": "Stephanie Burt locates Le Guin's technique of letting the reader fill in the details of a strongly outlined world at the level of the sentence in the first Earthsea trilogy.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "letting us fill in the details of her strongly outlined world"}, {"index": 580, "feature": "place and institution description", "claim": "Stephanie Burt endorses Plotz's distinction between the prose of Earthsea and the no-detail-left-unturned, purposefully slow-moving prose of The Lord of the Rings.", "source": "Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the no-detail-left-unturned, purposefully-slow-moving Lord of the Rings"}, {"index": 582, "feature": "edition and house style", "claim": "The Ursula K. Le Guin Foundation records that From Elfland to Poughkeepsie was a speech given at the Second Annual Science Fiction Writers' Workshop in 1972 and first published by Pendragon Press in 1973 in a limited run of 776 copies, with reprints of 1006 copies in December 1975 and 2000 copies in April 1978.", "source": "The Ursula K. Le Guin Foundation, ursulakleguin.com bibliography page", "url": "https://www.ursulakleguin.com/from-elfland-to-poughkeepsie", "quote": "a limited run of 776 copies"}, {"index": 583, "feature": "register modulation", "claim": "Erin Ramsay writes that the mythic and fundamental register of A Wizard of Earthsea gives way to the realistic and mundane in The Tombs of Atuan.", "source": "Erin Ramsay, 'Earthsea: A Sharpening of Scale', The Lighthouse (Substack), 16 April 2024", "url": "https://erinramsay.substack.com/p/earthsea-a-sharpening-of-scale", "quote": "The mythic and fundamental in A Wizard of Earthsea gives way"}, {"index": 584, "feature": "register modulation", "claim": "Erin Ramsay says the reassuring sense of fable that pervades A Wizard of Earthsea is lost in The Farthest Shore.", "source": "Erin Ramsay, The Lighthouse (Substack), 16 April 2024", "url": "https://erinramsay.substack.com/p/earthsea-a-sharpening-of-scale", "quote": "the reassuring sense of fable which pervades"}, {"index": 587, "feature": "repetition and refrain", "claim": "Alessandro Amenta identifies repetitions, paired synonyms and redundancies as typical traits of Le Guin's writing, which the Polish translator tends to remove by periphrasis and by substituting one word for two.", "source": "Alessandro Amenta, Kwartalnik Neofilologiczny LXX 2/2023, p. 282", "url": "http://journals.pan.pl/Content/128312/PDF/2023-02-KNEO-06.pdf", "quote": "which are typical traits of Le Guin's writing"}, {"index": 598, "feature": "archaism", "claim": "Philip Chase reports that Le Guin's essay holds that good fantasy prose does not have to be archaic and does not even have to be elevated, but must not be journalistic.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "good fantasy pros does not have to be archaic"}, {"index": 599, "feature": "archaism", "claim": "Philip Chase disagrees with Le Guin's use of E. R. Eddison as an example of exemplary fantasy prose, saying he would not hold it up for fantasy writers today.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "this is an example that i personally would disagree with today"}, {"index": 600, "feature": "archaism", "claim": "Philip Chase argues that the tightrope Le Guin describes between over-archaic and journalistic prose moves with time, so that Eddison's prose reads as more overdone now than it did in 1973.", "source": "Philip Chase, 'What is good fantasy prose?' (video), 16 November 2021", "url": "https://www.youtube.com/watch?v=5lDA8VyeLx0", "quote": "the tightrope might actually move with time"}, {"index": 604, "feature": "plainness and economy", "claim": "The reviewer on A Novel Review calls Le Guin's Earthsea prose really simple prose that ferries the reader along.", "source": "A Novel Review - Book Podcast (video), 11 August 2025", "url": "https://www.youtube.com/watch?v=P48Xg6ZNi88", "quote": "It's really simple prose, but very ferries you along"}, {"index": 605, "feature": "concrete sensory noun", "claim": "The reviewer on A Novel Review says he could picture almost every scene completely and calls the book incredibly picturesque, which he attributes to Le Guin's writing style.", "source": "A Novel Review - Book Podcast (video), 11 August 2025", "url": "https://www.youtube.com/watch?v=P48Xg6ZNi88", "quote": "this was incredibly picturesque"}, {"index": 606, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Kate Nepveu from 'Rhythmic Pattern in The Lord of the Rings', describes the rhythm shaping Tolkien's narrative as very strong and very simple, as simple as a rhythm can be: two beats.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (Meditations on Middle-earth, 2001; reprinted in The Wave in the Mind), quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "very strong and very simple, as simple as a rhythm can be"}, {"index": 607, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Kate Nepveu, glosses that two-beat rhythm as stress and release, inbreath and outbreath, a heartbeat, a walking gait.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings', quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "Stress, release. Inbreath, outbreath. A heartbeat."}, {"index": 608, "feature": "plainness and economy", "claim": "Le Guin, quoted by Kate Nepveu, says of the closing lines of Tolkien's barrow-downs chapter that the tone is quiet, the language simple, and the emotions evoked quiet, simple and common.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings', quoted in Kate Nepveu, LiveJournal, 4 June 2006", "url": "https://kate-nepveu.livejournal.com/180011.html", "quote": "Yet the tone is quiet, the language simple"}, {"index": 610, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Erik Mueller-Harder, wrote that even when Tolkien's sentences are long their flow is perfectly clear and follows the breath, punctuation comes just where you need to pause, and the cadences are graceful and inevitable.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (2001), quoted in Erik D. Mueller-Harder, Vermont Softworks, 28 September 2023", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Even when the sentences are long, their flow is perfectly clear"}, {"index": 611, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Erik Mueller-Harder, wrote that Tolkien must have heard what he wrote.", "source": "Ursula K. Le Guin, 'Rhythmic Pattern in The Lord of the Rings' (2001), quoted in Erik D. Mueller-Harder, Vermont Softworks, 28 September 2023", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Tolkien must have heard what he wrote"}, {"index": 613, "feature": "adjective and adverb discipline", "claim": "Mary Anne Mohanraj notes that Le Guin's self-revisions descend to a single word, instancing her bracketed instruction to strike the word probably and replace it with certainly.", "source": "Mary Anne Mohanraj, Reactor, 1 November 2018, quoting Le Guin's 'Is Gender Necessary? Redux'", "url": "https://reactormag.com/write-critique-revise-repeat-on-le-guin-and-asking-the-hard-questions-of-ourselves/", "quote": "Strike the word 'probably' and replace it with 'certainly.'"}, {"index": 614, "feature": "place and institution description", "claim": "David Bratman describes Le Guin's essay 'Living in a Work of Art' as a description of the Berkeley house she grew up in, which she presents as beautiful but eminently livable.", "source": "David Bratman, Kalimac's corner, 6 September 2020", "url": "http://kalimac.blogspot.com/2020/09/a-work-of-art-for-living-in.html", "quote": "beautiful but eminently livable"}, {"index": 615, "feature": "plainness and economy", "claim": "A reader commenting on Sean Guynes's Tehanu essay ranks the crystalline prose and storytelling of A Wizard of Earthsea above Tehanu.", "source": "Reader comment by 'S' on Sean Guynes, 'Tehanu: Le Guin's Return to Earthsea', Reactor, 24 February 2021", "url": "https://reactormag.com/tehanu-le-guins-return-to-earthsea-and-her-best-novel/", "quote": "the crystalline prose and storytelling of"}, {"index": 616, "feature": "plainness and economy", "claim": "A reader commenting on Jo Walton's The Other Wind essay says the book is worth reading because one should never turn down a chance at Le Guin's prose.", "source": "Reader comment on Jo Walton, 'Revising death and dragons: Ursula K. Le Guin's The Other Wind', Reactor, 8 November 2011", "url": "https://reactormag.com/revising-death-and-dragons-ursula-k-le-guins-lemgthe-other-windlemg/", "quote": "one should never turn down a chance at Le Guin's prose"}, {"index": 618, "feature": "omission as information", "claim": "Le Guin told Paul Morton that much of fantasy and science fiction is just the art of suggestion.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "fantasy and science fiction is just the art of suggestion"}, {"index": 619, "feature": "omission as information", "claim": "Le Guin told Paul Morton that a writer does not really tell people that much, but they think you have because they imagine it.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "You don't really tell people that much, but they think you have"}, {"index": 621, "feature": "plainness and economy", "claim": "Le Guin told Paul Morton that what she has learned as a writer is that you do as little as possible, part of which is leaving a lot of it up to the reader.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "leaving a lot of it up to the reader"}, {"index": 622, "feature": "plainness and economy", "claim": "Le Guin said her writing has tended to be shorter and more allusive than it used to be.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "my writing has tended to be shorter and more allusive"}, {"index": 624, "feature": "cadence and rhythm", "claim": "Le Guin told Paul Morton that she loves the sound of language and plays with word sounds in her head.", "source": "Ursula K. Le Guin, interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "I love language, I love the sound of language."}, {"index": 626, "feature": "diction (native vs latinate)", "claim": "Le Guin told Jonathan White that the language of politicians is empty of everything but rather brutal signals and is something a writer has to get as far away from as possible.", "source": "Ursula K. Le Guin, interviewed by Jonathan White, 'Coming Back From the Silence'", "url": "https://peterschmidt.domains.swarthmore.edu/engl5H/leguin.interv.html", "quote": "empty of everything but rather brutal signals"}, {"index": 641, "feature": "archaism", "claim": "Bittner says the word 'tale' carries an archaic, distant tone that the word 'story' lacks.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (UMI Research Press, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22The%20very%20word%20tale%20has%20an%20archaic%2C%20distant%20tone%22", "quote": "The very word tale has an archaic, distant tone"}, {"index": 646, "feature": "adjective and adverb discipline", "claim": "Bittner treats a guidebook title carrying many telling adjectives as a reason not to trust its user.", "source": "James W. Bittner, Approaches to the Fiction of Ursula K. Le Guin (1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aapproachestofict0000bitt%20AND%20%22a%20guidebook%20with%20so%20many%20telling%20adjectives%20in%20its%20title%22", "quote": "a guidebook with so many telling adjectives in its title"}, {"index": 650, "feature": "cadence and rhythm", "claim": "That essay credits Le Guin with a skillful use of cadence and sound patterns.", "source": "An essay in Harold Bloom, ed., Ursula K. Le Guin: Modern Critical Views (1986)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00bloo%20AND%20%22a%20skillful%20use%20of%20cadence%20and%20sound%20patterns%22", "quote": "a skillful use of cadence and sound patterns"}, {"index": 663, "feature": "plainness and economy", "claim": "Cadden puts it to Le Guin that Leese Webster is very spare.", "source": "Mike Cadden, Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22Leese%20Webster%20is%20very%20spare%22", "quote": "Leese Webster is very spare"}, {"index": 664, "feature": "plainness and economy", "claim": "Le Guin replies that Leese Webster is austere and that this fit the illustrator's talent.", "source": "Ursula K. Le Guin, in interview with Mike Cadden, printed in Ursula K. Le Guin Beyond Genre (Routledge, 2005)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinbey0000cadd%20AND%20%22It%E2%80%99s%20austere%2C%20and%20that%20fit%20Jim%E2%80%99s%20talent%22", "quote": "It’s austere, and that fit Jim’s talent"}, {"index": 667, "feature": "plainness and economy", "claim": "An essay in Olander and Greenberg's volume says Le Guin's straightforward stories deal in strong colors and plain fabrics.", "source": "An essay in Joseph D. Olander and Martin Harry Greenberg, eds., Ursula K. Le Guin (Taplinger, 1979) — contributor not resolvable from the snippet window", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00olan%20AND%20%22strong%20colors%20and%20plain%20fabrics%22", "quote": "strong colors and plain fabrics"}, {"index": 669, "feature": "register modulation", "claim": "Spivack says the style of A Wizard of Earthsea is suitable to its subject.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22The%20style%20of%20A%20Wizard%20of%20Earthsea%20is%20suitable%22", "quote": "The style of A Wizard of Earthsea is suitable"}, {"index": 675, "feature": "omission as information", "claim": "Spivack calls those monologues richly suggestive, leaving much unsaid.", "source": "Charlotte Spivack, Ursula K. Le Guin (Twayne, 1984)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin0453spiv%20AND%20%22richly%20suggestive%2C%20leaving%20much%20unsaid%22", "quote": "richly suggestive, leaving much unsaid"}, {"index": 680, "feature": "plainness and economy", "claim": "Le Guin writes that a plain language is the noblest of all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Barbara J. Bucknall, Ursula K. Le Guin (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22A%20plain%20language%20is%20the%20noblest%20of%20all%22", "quote": "A plain language is the noblest of all"}, {"index": 681, "feature": "plainness and economy", "claim": "Le Guin adds that plain language is also the most difficult.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22It%20is%20also%20the%20most%20difficult%22", "quote": "It is also the most difficult"}, {"index": 682, "feature": "plainness and economy", "claim": "Le Guin writes that clarity and simplicity are permanent virtues in a narrative.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted in Bucknall (1981)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguin00buck%20AND%20%22Clarity%20and%20simplicity%20are%20permanent%20virtues%20in%20a%20narrative%22", "quote": "Clarity and simplicity are permanent virtues in a narrative"}, {"index": 688, "feature": "sentence length variation", "claim": "Dirda says the sentences of A Wizard of Earthsea are formal, clear, and exact.", "source": "Michael Dirda, Ursula K. Le Guin's A Wizard of Earthsea teacher's guide, NEA Big Read (National Endowment for the Arts, 2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22The%20sentences%20are%20formal%2C%20clear%2C%20and%20exact%22", "quote": "The sentences are formal, clear, and exact"}, {"index": 689, "feature": "cadence and rhythm", "claim": "Dirda says those sentences carry the musical cadence of an oral storyteller.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22with%20the%20musical%20cadence%20of%20an%20oral%20storyteller%22", "quote": "with the musical cadence of an oral storyteller"}, {"index": 690, "feature": "cadence and rhythm", "claim": "Dirda says Le Guin gives music and richness to her prose through the rhythm of her sentences.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22music%20and%20richness%20to%20her%20prose%20through%20the%20rhythm%22", "quote": "music and richness to her prose through the rhythm"}, {"index": 692, "feature": "register modulation", "claim": "Dirda says heroic or high fantasy demands a slightly formal, elevated style.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22a%20slightly%20formal%2C%20elevated%20style%22", "quote": "a slightly formal, elevated style"}, {"index": 693, "feature": "point of view and distance", "claim": "Dirda says the omniscient narrator confides in the reader like a friend.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22The%20omniscient%20narrator%20confides%20in%20the%20reader%20like%20a%20friend%22", "quote": "The omniscient narrator confides in the reader like a friend"}, {"index": 694, "feature": "annalist voice and deep time", "claim": "Dirda says the narrator conveys the real story behind the legends of the Archmage Ged.", "source": "Michael Dirda, NEA Big Read teacher's guide to A Wizard of Earthsea (2008)", "url": "https://openlibrary.org/search/inside.json?q=identifier%3Aursulakleguinswi00dird%20AND%20%22the%20real%20story%20behind%20the%20legends%20of%20the%20Archmage%20Ged%22", "quote": "the real story behind the legends of the Archmage Ged"}, {"index": 698, "feature": "plainness and economy", "claim": "Burt calls the prose of Earthsea clear and patient.", "source": "Stephanie Burt, review of John Plotz's Ursula Le Guin's Earthsea, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "its clear, patient prose"}, {"index": 699, "feature": "omission as information", "claim": "Plotz calls Le Guin's prose the antithesis of the well-rendered verisimilitude of a high-end video game.", "source": "John Plotz, Ursula Le Guin's Earthsea (Oxford Univ. Press, 2023), p. 48, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "the antithesis of the well-rendered verisimilitude"}, {"index": 700, "feature": "plainness and economy", "claim": "Burt reports that Le Guin's clear, spare prose reminds Plotz of Willa Cather's.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "Her clear, spare prose reminds Plotz"}, {"index": 701, "feature": "omission as information", "claim": "Burt says Le Guin works at the level of the sentence, letting readers fill in the details of her strongly outlined world.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "letting us fill in the details of her strongly outlined world"}, {"index": 702, "feature": "place and institution description", "claim": "Plotz says Le Guin trains a spotlight on all the things that we make up and then treat as real.", "source": "John Plotz, Ursula Le Guin's Earthsea (2023), p. 34, quoted in Stephanie Burt, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "trains a spotlight on all the things that we make up"}, {"index": 703, "feature": "point of view and distance", "claim": "Burt says Le Guin invites the reader in and holds the reader back.", "source": "Stephanie Burt, review of Plotz, Strange Horizons, 6 November 2023", "url": "https://strangehorizons.com/wordpress/non-fiction/ursula-le-guins-earthsea-by-john-plotz/", "quote": "invites us in and holds us back"}, {"index": 704, "feature": "naming and forms of address", "claim": "Le Guin says names come first with her.", "source": "Ursula K. Le Guin, 2015 interview with John Plotz, transcribed in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "Names come first with me"}, {"index": 705, "feature": "naming and forms of address", "claim": "Le Guin says she drew a map of islands she knew nothing about and named them happily.", "source": "Ursula K. Le Guin, 2015 interview with John Plotz, transcribed in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "But I named them happily"}, {"index": 706, "feature": "omission as information", "claim": "Plotz quotes Le Guin's essay as saying fantasy offers only a construct built in a void with every joint and seam and nail exposed.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973), quoted by John Plotz in Public Books, 21 February 2024", "url": "https://www.publicbooks.org/john-plotz-on-earthsea-anarchism-and-ursula-k-le-guin/", "quote": "a construct built in a void"}, {"index": 792, "feature": "plainness and economy", "claim": "Le Guin states that a plain language is the noblest of all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (speech 1972; Pendragon Press booklet 1973; in The Language of the Night, 1979)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "A plain language is the noblest of all."}, {"index": 793, "feature": "plainness and economy", "claim": "Le Guin calls clarity and simplicity permanent virtues in a narrative.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (speech 1972; booklet 1973; in The Language of the Night, 1979)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "Clarity and simplicity are permanent virtues in a narrative."}, {"index": 794, "feature": "plainness and economy", "claim": "Le Guin says that plain language is also the most difficult kind to write.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It is also the most difficult."}, {"index": 796, "feature": "register modulation", "claim": "Le Guin says the outstanding virtue of Tolkien's plain English is its flexibility, ranging easily from the commonplace to the stately.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It ranges easily from the commonplace to the stately"}, {"index": 797, "feature": "plainness and economy", "claim": "Le Guin distinguishes a fake plainness that is not really simple but flat from genuine plain style.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "It is not really simple, but flat."}, {"index": 798, "feature": "concrete sensory noun", "claim": "Le Guin faults the flat fantasy style because its rocks, wind and trees are not there and not felt.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the rocks, the wind, the trees are not there"}, {"index": 802, "feature": "archaism", "claim": "Le Guin calls the archaic manner a trap into which almost all very young fantasy writers walk, and says she did herself.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "a trap into which almost all very young fantasy writers walk"}, {"index": 803, "feature": "archaism", "claim": "Le Guin grants that the archaic manner is a perfect distancer but says it must be done perfectly.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "The archaic manner is indeed a perfect distancer"}, {"index": 804, "feature": "archaism", "claim": "Le Guin names ichor as the infallible touchstone of the seventh-rate among fantasy's fancy words.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the infallible touchstone of the seventh-rate: Ichor"}, {"index": 805, "feature": "archaism", "claim": "Le Guin concludes that archaisms are not essential to fantasy.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "After all, archaisms are not essential."}, {"index": 813, "feature": "place and institution description", "claim": "Le Guin says a secondary world is a construct built in a void with every joint and seam and nail exposed, because there is no borrowed reality to hide behind.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "with every joint and seam and nail exposed"}, {"index": 814, "feature": "plainness and economy", "claim": "Le Guin ends her account of the secondary world with the sentence that every word counts.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "And every word counts."}, {"index": 815, "feature": "cadence and rhythm", "claim": "Le Guin defines the musical dimension of prose as the sound of the words, the movement of the syntax and the rhythm of the sentences.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "the movement of the syntax, and the rhythm of the sentences"}, {"index": 816, "feature": "archaism", "claim": "Le Guin praises Eddison's archaic prose as exact, clear and powerful despite or because of its archaisms.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "exact, clear, powerful"}, {"index": 817, "feature": "register modulation", "claim": "Le Guin criticises Leiber and Zelazny for alternating a colloquial American style with old formal usages within one work.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "they alternate the two styles"}, {"index": 819, "feature": "archaism", "claim": "Le Guin says Jack Vance's achieved style contains no archaisms at all.", "source": "Ursula K. Le Guin, \"From Elfland to Poughkeepsie\" (1973)", "url": "https://digginganddeepening.com/texts/ESSAYS/U%20K%20LeGuin/1973_FromElflandtoPoughkeepsie_1.pdf", "quote": "it contains no archaisms at all"}, {"index": 820, "feature": "place and institution description", "claim": "Le Guin says Tolkien's references to places, people and events outside the immediate story give the reader a conviction of the reality of the immediate scene.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005), ursulakleguin.com", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "a conviction of the reality of the immediate scene"}, {"index": 821, "feature": "concrete sensory noun", "claim": "Le Guin says exact and vivid words make an exact and vivid world.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "Exact and vivid words make an exact and vivid world."}, {"index": 824, "feature": "withheld information and inference", "claim": "Le Guin says she has often mentioned events and places in her fantasies that she did not yet know anything about, which were merely words when she wrote them.", "source": "Ursula K. Le Guin, \"Plausibility in Fantasy: an open letter to Alexei Mutovkin\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-in-fantasy-an-open-letter", "quote": "These were, when I wrote them, merely words"}, {"index": 827, "feature": "concrete sensory noun", "claim": "Le Guin says realistic detail is used in fantasy only in lesser matters, to ground the story and prevent an overload of the improbable.", "source": "Ursula K. Le Guin, \"Plausibility Revisited\" (2005)", "url": "https://www.ursulakleguin.com/plausibility-revisited", "quote": "Only in lesser matters is realistic detail used to ground the story"}, {"index": 828, "feature": "place and institution description", "claim": "Le Guin says that a fantasy world resembling preindustrial mediaeval Europe is not thereby justified in having no economics and no social justice.", "source": "Ursula K. Le Guin, \"Some Assumptions about Fantasy\", speech at the Children's Literature Breakfast, BookExpo America, Chicago, 4 June 2004", "url": "https://www.ursulakleguin.com/some-assumptions-about-fantasy", "quote": "no economics and no social justice"}, {"index": 829, "feature": "place and institution description", "claim": "Le Guin says she feels like setting off fireworks whenever she finds a fantasy set in a genuinely imagined society and culture.", "source": "Ursula K. Le Guin, \"Some Assumptions about Fantasy\" (BookExpo America, 4 June 2004)", "url": "https://www.ursulakleguin.com/some-assumptions-about-fantasy", "quote": "set in a genuinely imagined society and culture"}, {"index": 832, "feature": "plainness and economy", "claim": "Le Guin says that with the most ordinary ingredients, naming everyday language among them, and care and skill in using them, a writer can make something extremely good.", "source": "Ursula K. Le Guin, \"Navigation Q1: How do you make something good?\", Book View Cafe, 27 July 2015 (text at ursulakleguin.com)", "url": "https://www.ursulakleguin.com/bvc-navigation-q1", "quote": "potatoes, everyday language, commonplace characters"}, {"index": 839, "feature": "omission as information", "claim": "Le Guin says pity and terror are achieved more often through brevity, a few telling details and a great deal left unsaid than through wallowing in a bloodbath.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "brevity, a few telling details, a great left unsaid"}, {"index": 840, "feature": "omission as information", "claim": "Le Guin praises a Patrick O'Brian scene of a ship going down with five hundred men aboard as one that could not be shorter, more silent, or more shocking.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "could not be shorter, more silent, or more shocking"}, {"index": 844, "feature": "concrete sensory noun", "claim": "Le Guin advises describing just enough of a character's appearance to give the noticing reader a clear clue, saying one physical detail will often do it.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2, Round 1\", Book View Cafe, 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-round-1", "quote": "Often one physical detail will do it"}, {"index": 849, "feature": "withheld information and inference", "claim": "Le Guin says a reader will learn what an unexplained invented term means but may have to wait a while, and that lazy readers find waiting uncomfortable.", "source": "Ursula K. Le Guin, \"Navigating the Ocean of Story: Session 2 — Three New Questions\", Book View Cafe, 21 March 2016", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-2-three-new-questions", "quote": "The reader will learn what it is"}, {"index": 853, "feature": "concrete sensory noun", "claim": "Le Guin says of her own practice that she is very strong on accuracy and exactitude.", "source": "Ursula K. Le Guin interviewed by John Plotz, \"The Story's Where I Go\", Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "I’m very strong on accuracy and exactitude."}, {"index": 855, "feature": "omission as information", "claim": "Le Guin says that in describing an invented world the leaving-out is half the art, and the reader fills the white spaces.", "source": "Ursula K. Le Guin interviewed by John Plotz, Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "the leaving-out is half the art"}, {"index": 856, "feature": "plainness and economy", "claim": "Le Guin says you cannot describe everything because that would be very boring.", "source": "Ursula K. Le Guin interviewed by John Plotz, Public Books, 15 June 2015", "url": "https://www.publicbooks.org/the-storys-where-i-go-an-interview-with-ursula-k-le-guin/", "quote": "You can’t describe everything"}, {"index": 863, "feature": "point of view and distance", "claim": "Le Guin says that to write Tehanu all she had to do was describe Earthsea from the point of view of the powerless and disempowered.", "source": "Ursula K. Le Guin, \"Chronicles of Earthsea\" reader Q&A, The Guardian, 9 February 2004", "url": "http://books.guardian.co.uk/departments/sciencefiction/story/0,6000,1144428,00.html", "quote": "describe it from the point of view of the powerless"}, {"index": 866, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, says that even when Tolkien's sentences are long their flow is clear and punctuation comes just where you need to pause.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (Meditations on Middle-earth, 2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "punctuation comes just where you need to pause"}, {"index": 867, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, calls the cadences of Tolkien's prose graceful and inevitable.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "the cadences are graceful and inevitable"}, {"index": 868, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by a blogger, concludes that Tolkien must have heard what he wrote.", "source": "Erik D. Mueller-Harder, Vermont Softworks blog, 28 September 2023, quoting Le Guin, \"Rhythmic Pattern in The Lord of the Rings\" (2001)", "url": "https://vermontsoftworks.com/post/2023/leguin-rhythmic-pattern-in-lotr/", "quote": "Tolkien must have heard what he wrote"}, {"index": 890, "feature": "plainness and economy", "claim": "Le Guin says what she has learned as a writer, as she has gone on, is that you do as little as possible.", "source": "Ursula K. Le Guin interviewed by Paul Morton, \"Getting Away with Murder: The Millions Interviews Ursula K. Le Guin\", The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "you do as little as possible"}, {"index": 891, "feature": "withheld information and inference", "claim": "Le Guin says part of doing as little as possible is leaving a lot of it up to the reader.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "leaving a lot of it up to the reader"}, {"index": 892, "feature": "plainness and economy", "claim": "Le Guin says her writing has tended to become shorter and more allusive than it used to be.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "shorter and more allusive than it used to be"}, {"index": 894, "feature": "cadence and rhythm", "claim": "Le Guin says she loves the sound of language and plays with word sounds in her head.", "source": "Ursula K. Le Guin interviewed by Paul Morton, The Millions, 31 January 2013", "url": "https://themillions.com/2013/01/getting-away-with-murder-the-millions-interviews-ursula-k-le-guin.html", "quote": "I love language, I love the sound of language."}, {"index": 895, "feature": "naming and forms of address", "claim": "Le Guin gives pronunciation guidelines for her invented names because how a name is said affects the sound and rhythm of a sentence.", "source": "Ursula K. Le Guin, \"Ursula on Ursula\" (pronunciation guide and reader notes), ursulakleguin.com", "url": "https://www.ursulakleguin.com/ursula-on-ursula", "quote": "this does affect the sound and rhythm of a sentence"}, {"index": 920, "feature": "place and institution description", "claim": "Le Guin says Woolf's Orlando gave her the authentic thrill of being taken absolutely elsewhere.", "source": "Ursula K. Le Guin, contribution on Virginia Woolf, The Guardian, 14 May 2011", "url": "https://www.theguardian.com/books/2011/may/14/science-fiction-authors-choice", "quote": "the authentic thrill of being taken absolutely elsewhere"}], "verdicts": [{"index": 542, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 548, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 551, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 552, "verdict": "SKIPPED_T