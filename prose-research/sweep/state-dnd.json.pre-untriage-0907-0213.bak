  "756": {
   "index": 756,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "Austere. Uncurtained windows let the gloomy light",
   "note": "Raw page fetched (HTTP 200). 'Bullet Points vs Prose', March 23, 2023, Luke Gearing. HTML confirms the layout: each room heading is followed by a <p> prose version and then a <ul> bullet version. Room '10) Study' prose opens with the one-word sentence 'Austere.' before the desk, dust and papers; the bullet twin instead opens 'Study - austere and spartan...'. One-word-first and before-inventory limbs both hold.",
   "fromFile": "verdicts-dnd-i724-795.json"
  },
  "757": {
   "index": 757,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
