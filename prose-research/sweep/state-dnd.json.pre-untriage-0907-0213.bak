  "1070": {
   "index": 1070,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "issues like structure, plot, playability, how things would fit",
   "note": "Live expositionbreak.com fetched 200 (raw HTML). In Ray Vallese's answer to the question on what an RPG editor does: his job was editing the words and game stats but also considering larger issues of that list, plus fitting in the layout. All limbs supported; attribution to Vallese correct.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1071": {
   "index": 1071,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "The other primary Planescape editor of that era was Michele",
   "note": "Same raw page, same fetch. Parenthetical inside Ray Vallese's answer on how roles were decided; continues 'Carter, who deserves just as much credit as any of us.' Named by Vallese, as claimed.",
