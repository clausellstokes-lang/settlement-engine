  },
  "531": {
   "index": 531,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "But the NPCs have motivations and character traits",
   "note": "Verbatim, inside the comment signed 'PrinceofNothing says: January 27, 2019 at 10:50 am', in his bracketed rebuttal under '[Mike Mearls review]' to summarised point '1. NPCs don't have names in Keep therefore the module is bad.' Author and comment-section location both confirmed.",
   "fromFile": "verdicts-dnd-i529-543.json"
