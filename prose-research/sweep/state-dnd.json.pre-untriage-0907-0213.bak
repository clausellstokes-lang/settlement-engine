  "1056": {
   "index": 1056,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "as a reporter for the Lake Geneva Regional News",
   "note": "Live mopop.org fetched 200 (raw HTML, curl, browser UA). Inductee bio body: begins career as reporter there, then Beloit Daily News as sports editor and then state editor, 'before joining TSR in 1979'. Every limb supported. Page header confirms 'Kim Mohan | SFFHOF Inductee', 'Induction Year 2025'.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1057": {
   "index": 1057,
   "verdict": "SKIPPED_TRIAGE",
