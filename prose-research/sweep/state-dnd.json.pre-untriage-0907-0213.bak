   "feature": "rewrite the weak",
   "claim": "Greenwood's advice: never think your words are perfect; rewrite anything weak or awkward.",
   "source": "Author Interview: Ed Greenwood (Paizo Blog, 2013-06-20)",
   "url": "https://paizo.com/blog/author-interview-ed-greenwood",
   "quote": "Never think your words are perfect",
   "page": "interview",
   "angle": "voice"
  },
  {
   "feature": "text stands on its own (RAW)",
   "claim": "Crawford reads a rule first as written, in context and without regard to intent, because the published text must stand on its own.",
   "source": "Sage Advice Compendium (Jeremy Crawford, Wizards of the Coast, v2.7 2021)",
   "url": "https://media.wizards.com/2020/dnd/downloads/SA-Compendium.pdf",
   "quote": "The text is forced to stand on its own.",
   "page": "official rules document (designer's own words)",
   "angle": "voice"
  },
  {
   "feature": "rules as foundation, DM as bridge",
   "claim": "5e's rules deliberately lay a foundation for the DM to build on rather than trying to cover every contingency.",
   "source": "Sage Advice Compendium (Jeremy Crawford, Wizards of the Coast, v2.7 2021)",
   "url": "https://media.wizards.com/2020/dnd/downloads/SA-Compendium.pdf",
   "quote": "no set of rules could reasonably account for every contingency",
   "page": "official rules document (designer's own words)",
   "angle": "voice"
  },
  {
   "feature": "public statements are not rulings",
   "claim": "Only the compendium is official; designers' tweets and public statements are advice.",
   "source": "Sage Advice Compendium (Jeremy Crawford, Wizards of the Coast, v2.7 2021)",
   "url": "https://media.wizards.com/2020/dnd/downloads/SA-Compendium.pdf",
   "quote": "are not official rulings; they are advice",
   "page": "official rules document (designer's own words)",
   "angle": "voice"
  },
  {
   "feature": "glossary and taught key terms",
   "claim": "The 2024 PHB teaches key terms (D20 Test, Magic action) in an opening play guide with examples of play and sidebars, and summarizes rules terminology in a glossary appendix.",
   "source": "What's New in the 2024 Player's Handbook? (Michael Galvis, D&D Beyond, 2024-09-17)",
   "url": "https://www.dndbeyond.com/posts/1745-whats-new-in-the-2024-players-handbook",
   "quote": "key terms of the game, like what a D20 Test",
   "page": "official article",
   "angle": "voice"
  },
  {
   "feature": "updated terminology table",
   "claim": "The 2024 PHB renames terms via an Updated Terminology Table: Race to Species, Cast a Spell action to Magic action, Ki to Monk's Focus.",
   "source": "Updates in the Player's Handbook (2024) (D&D Beyond staff, 2024-09-03)",
   "url": "https://www.dndbeyond.com/posts/1810-updates-in-the-players-handbook-2024",
   "quote": "uses some new terms, as shown in the Updated Terminology Table",
   "page": "official article",
   "angle": "voice"
  },
  {
   "feature": "headers and bullets for the DM's eye",
   "claim": "Merwin: use headers, subheaders and bullets to draw the DM's eye to the right information at the right time.",
   "source": "Let's Design an Adventure: Thinking Like a Designer (Shawn Merwin, D&D Beyond, 2020-03-25)",
   "url": "https://www.dndbeyond.com/posts/753-lets-design-an-adventure-thinking-like-a-designer",
   "quote": "Use headers and subheaders to call out breaks in information",
   "page": "official column (AL veteran designer)",
   "angle": "voice"
  },
  {
   "feature": "short, evocative, helpful",
   "claim": "Goodman Games designer Burnside (2025) says boxed text must be short, evocative and helpful, and that his 2018 boxes carried too many distractions.",
   "source": "Read aloud text in modules: What are folks opinions, page 10 (EN World, 2025)",
   "url": "https://www.enworld.org/threads/read-aloud-text-in-modules-what-are-folks-opinions-about-read-aloud-content.712737/page-10",
   "quote": "short, evocative, and helpful to the DM and players",
   "page": "forum (posts by a Goodman Games designer)",
   "angle": "voice"
  },
  {
   "feature": "self-contained lore nuggets",
   "claim": "Crawford: the 2025 core books are filled with lore nuggets because WotC will not assume readers own the old books.",
   "source": "D&D's Jeremy Crawford on the 2025 Monster Manual, The New Starter Set, and High Level Gameplay (CBR, 2025-02-05)",
   "url": "https://www.cbr.com/jeremy-crawford-interview-dnd-5e-monster-manual-2025/",
   "quote": "fill them with lore nuggets",
   "page": "interview",
   "angle": "voice"
  },
  {
   "feature": "house style exists",
   "claim": "Mearls (2025) credits a collaborator with making sure a third-party manuscript matched the D&D house style, confirming an internal style exists even where none is published.",
   "source": "Grognardia: Interview: Mike Mearls (2025-08-27)",
   "url": "http://grognardia.blogspot.com/2025/08/interview-mike-mearls.html",
   "quote": "everything matched the D&D house style",
   "page": "interview",
   "angle": "voice"
  },
  {
   "feature": "style foundation (Chicago + Merriam-Webster)",
   "claim": "The 2019 guide (v1.08a) rests on the Chicago Manual of Style 17th edition and Merriam-Webster's Collegiate 11th edition, and covers only D&D-specific departures from them.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Merriam-Webster’s Collegiate Dictionary, 11th edition",
   "page": "p.1",
   "angle": "house-style-2019"
  },
  {
   "feature": "scope across product types",
   "claim": "The general rules bind every D&D product, not just rulebooks.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "whether RPG books, board games, novels, or something else",
   "page": "p.1",
   "angle": "house-style-2019"
  },
  {
   "feature": "edition naming",
   "claim": "Editions are spelled out and lowercased ('fifth edition'), with 4E/5E abbreviations confined to tables, conversion documents, or informal text.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We write “fifth edition,” for instance, not “5th Edition.”",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "source discipline for setting facts",
   "claim": "Writers are told not to rely on internet searches, wikis, or prior-edition products for setting facts.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Don’t rely on Internet searches",
   "page": "p.1",
   "angle": "house-style-2019"
  },
  {
   "feature": "register: high-fantasy tone gate",
   "claim": "Tone is gated by a Lord of the Rings / Game of Thrones plausibility test; humor and tragedy are allowed only if they do not overtake the general tone.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "ring wraiths aren’t used for gags",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "register: party over lone hero",
   "claim": "D&D's brand voice frames adventure as a team's story rather than a lone knight's.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Teamwork and friendship are a huge part",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "gender neutrality (2019 rule)",
   "claim": "Gender-neutral wording is expected whenever a person's gender is unknown or irrelevant, and the reader's gender is not assumed.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "gender neutrality whenever the gender of a person is unknown",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "second person in rules text",
   "claim": "Rules text achieves gender neutrality chiefly by being written in the second person.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "writing in the second person whenever possible",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "singular they (2019: allowed but rationed)",
   "claim": "v1.08a newly permits singular 'they/their' but tells writers to reach for it only when no other pleasing alternative exists.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "but don’t abuse this liberty",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "pronoun devices to avoid",
   "claim": "'He or she' is to be used sparingly; 'he/she' and 's/he' are banned; alternating he and she for inclusivity is banned.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "avoid “he/she” and “s/he” altogether",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "gender and fantasy races (2019 rule)",
   "claim": "In 2019 'man' and 'woman' were reserved for humans only, so a dwarf is a 'male dwarf', never a 'dwarf man'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "we write “male dwarf,” not “dwarf man”",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "dialogue exemption from editorial style",
   "claim": "Editorial rules such as the man/woman restriction may be broken in dialogue and first-person narrative, because a character need not follow house style.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "This rule can be broken in dialogue and first-person narrative",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "gender-specific suffixes",
   "claim": "Gendered suffixes are avoided ('priest', 'actor'); 'priestess'/'actress' survive only inside an in-world title or organization name.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Avoid gender-specific suffixes whenever possible",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "'god' as ungendered noun",
   "claim": "Deities are called 'god' regardless of gender in editorial voice; 'goddess' is reserved for in-world usage.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "use “god” whether the deity is male or female",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "heading hierarchy",
   "claim": "Headings descend Chapter Title > Heading 1 > 2 > 3 > Inline Subhead without skipping, and exist for structure, never aesthetics.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Use a heading for a structural reason, not an aesthetic one",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "inline subhead punctuation",
   "claim": "The inline subhead (heading 4) is set in bold italics and ends with a period, exclamation point, or question mark, not a colon.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "should be followed by terminal punctuation, not a colon",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "emphasis discipline",
   "claim": "Bold is the only emphasis device, and a term already in the section heading gets no emphasis in running text.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Use bold for such emphasis",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "sidebars",
   "claim": "Sidebars are rationed; any sidebar that must follow a specific passage to make sense should be folded into body text instead.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "The best sidebars can appear anywhere on a page",
   "page": "p.3",
   "angle": "house-style-2019"
  },
  {
   "feature": "American spelling and punctuation",
   "claim": "American spelling and punctuation are house style, with Merriam-Webster's first-listed variant winning (toward, backward).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "we use “toward,” not “towards,”",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "serial comma",
   "claim": "The serial (Oxford) comma is mandatory.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We require the serial comma",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "contractions",
   "claim": "Negative contractions (don't, can't, wasn't) are encouraged; other contractions are used with care where they could be misread.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We encourage the use of contractions formed with “not,”",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "hyphenation of 'non-'",
   "claim": "'Non-' is hyphenated before fantasy races (non-elf, non-drow) but closed for 'nonhuman', and numeral-plus-abbreviation compounds are never hyphenated (100 gp treasure).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "non-elf, non-dwarf",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "possessives",
   "claim": "Possessives follow Chicago 17th edition (7.16–29), including names ending in an unpronounced s.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We follow the approach in the seventeenth edition",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "words used as words / foreign words",
   "claim": "English words used as words go in quotation marks; a non-English word, real or invented, is italicized when used as a word.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "is italicized when used as a word",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "bulleted lists",
   "claim": "Vertical lists are introduced by a complete sentence ending in a colon, items start with a capital, and closing punctuation appears only if items are full sentences.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "introduce it with a complete sentence ending with a colon",
   "page": "p.4",
   "angle": "house-style-2019"
  },
  {
   "feature": "numerals versus words",
   "claim": "Whole numbers zero through one hundred are spelled out in prose (Chicago 9.2), with the usual exceptions for units, parts of a book, dates, and times.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "we spell out whole numbers from zero to one hundred",
   "page": "p.5",
   "angle": "house-style-2019"
  },
  {
   "feature": "percent",
   "claim": "'Percent' is written as a word except in tables or tight lists; percentile dice are 'd100', never 'd%'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Use the word “percent,” rather than the symbol %",
   "page": "p.5",
   "angle": "house-style-2019"
  },
  {
   "feature": "cross-references",
   "claim": "Cross-references are used judiciously; chapters are cited by number, subsections and sidebars by quoted title, tables by unquoted title.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Use cross-references judiciously",
   "page": "p.5",
   "angle": "house-style-2019"
  },
  {
   "feature": "appendix references",
   "claim": "Appendices are lettered, not numbered, and cited like chapters ('see appendix A').",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We use letters, not numbers, for appendices",
   "page": "p.5",
   "angle": "house-style-2019"
  },
  {
   "feature": "page references",
   "claim": "Page references are avoided because they are hand-added at galley and break across reprints; cross-product page references are especially discouraged.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We avoid page references as much as possible",
   "page": "p.5",
   "angle": "house-style-2019"
  },
  {
   "feature": "unspoken discourse (thoughts, telepathy)",
   "claim": "In D&D fiction, thoughts and psionic speech may be set in italics, quotes, or plain type at the author's discretion, a reversal of the older policy.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Aesthetics and clarity should dictate appropriate usage",
   "page": "p.6",
   "angle": "house-style-2019"
  },
  {
   "feature": "planar prepositions",
   "claim": "A character is 'on' a plane of existence but 'in' a plane named without the word 'plane' (in Elysium).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "“She is in Elysium.”",
   "page": "p.6",
   "angle": "house-style-2019"
  },
  {
   "feature": "game-term typography: capitalization",
   "claim": "Ability scores, action names, class features, feats, skills, languages, planes, and race/monster traits are capitalized as proper game terms.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Action names {the Attack action, the Dash action}",
   "page": "p.6",
   "angle": "house-style-2019"
  },
  {
   "feature": "game-term typography: italics",
   "claim": "Spells, magic items, and artifacts are italicized and treated as titles, and the effect a spell creates is not italicized.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Spells {magic missile}",
   "page": "p.6",
   "angle": "house-style-2019"
  },
  {
   "feature": "game-term typography: bold stat-block names",
   "claim": "A stat block name is bolded in running text only at its first appearance in an encounter area, and nothing may sit between the number and the name.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "write “four goblins,” not “four loud goblins”",
   "page": "p.6",
   "angle": "house-style-2019"
  },
  {
   "feature": "numerals in rules text",
   "claim": "Rules prose uses numerals for points, damage, durations of game effects, and tactical distances, but spells out narrative quantities (six hours, fifty miles).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "The two cities are fifty miles apart.",
   "page": "p.7",
   "angle": "house-style-2019"
  },
  {
   "feature": "canonical verb collocations",
   "claim": "The guide fixes verb-noun pairings: you cast a spell, take damage, make a saving throw, finish a rest, score a critical hit.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "You take damage.",
   "page": "p.7",
   "angle": "house-style-2019"
  },
  {
   "feature": "succeed vs make a check",
   "claim": "Rules must say 'succeed on a DC 15 check', not 'make a DC 15 check', unless the outcomes follow immediately.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "“You must succeed on a DC 15 Strength check",
   "page": "p.7",
   "angle": "house-style-2019"
  },
  {
   "feature": "'save' as synonym",
   "claim": "'Save' for 'saving throw' is used sparingly, mainly in stat blocks; the 4E sense of 'save' as a successful saving throw is abandoned.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "use it sparingly, preferably only in a stat block",
   "page": "p.7",
   "angle": "house-style-2019"
  },
  {
   "feature": "'result' vs number rolled",
   "claim": "'Result' no longer means the number on the die; it means the die roll plus modifiers, and 'total' is often preferred.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We often prefer the word “total”",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "magic vs magical",
   "claim": "'Magic' is the adjective for objects (magic item, magic sword); 'magical' for other things; 'magical item' is forbidden.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "“magic item” and its variants should never be “magical item.”",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "points of damage",
   "claim": "Damage is written as '10 fire damage', never '10 points of fire damage'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Avoid referring to points of damage",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "extra damage phrasing",
   "claim": "The die expression stays with the damage type: 'an extra 1d4 fire damage'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "We write “an extra 1d4 fire damage,”",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "proficiency prepositions",
   "claim": "One is proficient 'in' a skill, language, or activity but 'with' a tool, weapon, or armor.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "proficient in Elvish and Arcana",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "'Dungeon Master' is a noun",
   "claim": "'Dungeon Master' is never a verb except in conversational web writing.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "This term is a noun, not a verb",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "weeks and months banned in rules",
   "claim": "Because week and month lengths vary by world (a Realms week is a tenday), rules durations are given in days or years, never weeks or months.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "say a game effect lasts for 7 days, not 1 week",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "'human' vs 'mortal'; 'humanoid' as type",
   "claim": "'Human' is not a synonym for 'mortal', and 'humanoid' is used cautiously because it names a creature type.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "Beware of using “human” as a synonym for “mortal.”",
   "page": "p.8",
   "angle": "house-style-2019"
  },
  {
   "feature": "house word list",
   "claim": "A word list fixes spellings and plurals: dwarves not dwarfs, mithral not mithril, staffs, war band, drow/kenku/yuan-ti unchanged in plural.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "mithral (not mithril)",
   "page": "p.9",
   "angle": "house-style-2019"
  },
  {
   "feature": "Forgotten Realms terms in the general guide",
   "claim": "The general guide carries a short Realms list: Goodman/Goodwoman capped, 'goodsir' lowercased, 'godsforsaken' as the Realms form of godforsaken, and 'the Realms' only after 'the Forgotten Realms'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "goodsir (a form of address, not capped)",
   "page": "p.9",
   "angle": "house-style-2019"
  },
  {
   "feature": "'godsforsaken' rationale",
   "claim": "'Godsforsaken' is the established Realms form but is not required in other polytheistic settings, since 'godforsaken' has no necessary monotheistic sense.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "godsforsaken (established in the Realms",
   "page": "p.9",
   "angle": "house-style-2019"
  },
  {
   "feature": "adventuring party vocabulary",
   "claim": "'Fellowship' is avoided for a party because of its Tolkien association and because D&D parties are often fractious or mercenary; 'party', 'group', 'band', or 'company' are preferred.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "use “group,” “band,” “company,” or, especially, “party.”",
   "page": "p.9",
   "angle": "house-style-2019"
  },
  {
   "feature": "abbreviation set",
   "claim": "Standard abbreviations are fixed (PH, DMG, MM, gp, d100, AC, DC, DM, XP, HD, hp, NPC).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.08a (2018; 'updated January 2019')",
   "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf",
   "quote": "NPC nonplayer character",
   "page": "p.10",
   "angle": "house-style-2019"
  },
  {
   "feature": "singular they (2013 rule)",
   "claim": "The superseded 2013 guide banned singular they outside informal contexts like dialogue.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.04a (2013)",
   "url": "https://adventurersleague.files.wordpress.com/2018/10/1765690-dnd_house_style_guide.pdf",
   "quote": "Don’t use “they” or “their” as singular pronouns",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "readership assumption (2013)",
   "claim": "The 2013 guide framed gender neutrality as assuming a readership of both men and women, a framing dropped in 2019 for 'we don't assume a gender identity'.",
   "source": "D&D Style Guide: Writing and Editing, Version 1.04a (2013)",
   "url": "https://adventurersleague.files.wordpress.com/2018/10/1765690-dnd_house_style_guide.pdf",
   "quote": "readership includes both men and women",
   "page": "p.2",
   "angle": "house-style-2019"
  },
  {
   "feature": "sections new in 2019 vs 2013",
   "claim": "Sections absent from v1.04a and present in v1.08a include Gender-Specific Suffixes, Headings, Sidebars, Bulleted Lists, Appendix References, and Adventuring Parties (verified by heading presence in both texts).",
   "source": "D&D Style Guide: Writing and Editing, Version 1.04a (2013)",
   "url": "https://adventurersleague.files.wordpress.com/2018/10/1765690-dnd_house_style_guide.pdf",
   "quote": "",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "existence of a post-2019 house style guide",
   "claim": "A Word version of the house style guide, authored by Kim Mohan and last modified by Judy Bauer on 2021-07-06 at Wizards of the Coast, ships inside the Dungeoncraft Pack (2023-12-04) and postdates the public v1.08a PDF.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "",
   "page": "docProps/core.xml",
   "angle": "house-style-2019"
  },
  {
   "feature": "dictionary reference updated",
   "claim": "The 2021 docx cites merriam-webster.com rather than the printed 11th edition Collegiate.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "merriam-webster.com",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "gender and fantasy races (2021 reversal)",
   "claim": "The 2021 docx reverses the 2019 rule: 'man' and 'woman' may now describe the gender of any people, so 'dwarf man' and 'gnome woman' are fine.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "we can write “dwarf man” or “gnome woman.”",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "singular they (2021: unrationed)",
   "claim": "The 2021 docx allows they/their/them/themself for a person of unknown gender without the 2019 'don't abuse this liberty' caveat, requiring only a clear antecedent.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "you must ensure that the pronoun’s antecedent is clear",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "pronoun preference for people",
   "claim": "In running text a person's preferred pronoun (he, she, or they) is used; in rules text 'it' is used.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "In rules text, use “it.”",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "pronouns for generic creatures (descriptive text)",
   "claim": "Descriptive text uses they/them for Humanoids and other sapient creatures of unknown gender (including vampires), and 'it' for animals, cosmic horrors, and extraplanar creatures.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "A beholder never keeps its promises.",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "pronoun ambiguity rule",
   "claim": "Where 'they' would be ambiguous the sentence is reworded to avoid pronouns, e.g. by switching to the plural.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "reword to avoid using pronouns",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "'it' for dehumanizing effect is an exception",
   "claim": "Using 'it' for a sapient monster to emphasize inhumanity is allowed only as a rare deliberate effect.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "Such exceptions should be rare.",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "canon pronouns for named characters",
   "claim": "Established characters keep their canonical pronouns regardless of species or type (Baphomet and Strahd he/him; Lolth and Tasha she/her).",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "He/Him: Baphomet, Strahd",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "creature type capitalization (post-2019)",
   "claim": "The 2021 docx adds creature types (Humanoid, Fey, Undead) to the capitalized game terms, a convention the 2019 PDF lacks.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "Creature type (Humanoid, Fey, Undead)",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "bold marks a game object",
   "claim": "Bold stat-block names are explained functionally: bold signals that the term is a game object to be looked up, so 'Strahd likes to make vampire spawn' stays roman.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "this indicates the term is a game object",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "attack vs attack roll",
   "claim": "Effects triggered by hitting must say 'attack roll', because readers read 'attack' in its English sense and think fireball 'hits'.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "The word “attack” confuses many of our readers",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "'within X feet' precision",
   "claim": "'Within X feet' literally reaches through total cover, so writers must add a sight/hearing/cover condition or use an official area of effect.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "use one of our official areas of effect",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "'stat block' not 'statistics'",
   "claim": "The box of game information is called a stat block; 'statistics' is reserved for the crunch in the abstract.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "call it a stat block",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "letter-by-letter alphabetization",
   "claim": "Lists, spells, and bestiary stat blocks are ordered letter-by-letter, ignoring spaces, with a warning that Word sorts word-by-word.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "We use letter-by-letter alphabetization.",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "word list additions post-2019",
   "claim": "The 2021 word list adds aasimar, blood red (contra Merriam-Webster), cyclopes, gold vs golden, insectile not insectoid, parlay vs parley, tabaxi, tenant vs tenet.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "insectile (not insectoid)",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "lowercase 'hit points' persists in the 2021 docx",
   "claim": "The 2021 docx still writes 'hit points' lowercase in its examples, whereas the 2024 rules glossary capitalizes 'Hit Points', so even the internal 2021 guide predates 2024 house style.",
   "source": "DnD House Style Guide.docx (Wizards of the Coast; created Kim Mohan 2016-03-07, last modified Judy Bauer 2021-07-06) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "Anyone who touches the orb regains 3 hit points.",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "boxed text: rationing",
   "claim": "The AL adventure format prescribes boxed text only for a particularly important event, never for rooms or normalcy.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "Boxed text should be used very sparingly",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "boxed text: length",
   "claim": "Boxed text is capped at one or two brief descriptive sentences.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "no more than one or two brief and descriptive sentences",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "boxed text: function",
   "claim": "Boxed text narrates exciting events only; the substance of an encounter lives under the headings beneath it.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "only provide a narrative for exciting events",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "boxed text: worked example",
   "claim": "The template's own sample boxed text is two descriptive sentences plus a one-line spoken tag ('Go away!'), with sensory and comic detail carried by concrete nouns.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "“Go away!” the puppet snaps.",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "background keywords in caps and bold",
   "claim": "In the Background section, keywords are capitalized and bolded at first appearance to flag the adventure's important elements for the DM.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "Keywords should be CAPITALIZED and BOLDED the FIRST time",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "backstory restraint",
   "claim": "Background must not bloat with backstory that is not ultimately important; the line between too little and too much exposition is explicit.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
   "url": "https://media.dndbeyond.com/compendium-images/ddal/reference-docs/03-2024/dungeoncraft-pack-2023-12dec04.zip",
   "quote": "doesn’t bloat the background with backstory that isn’t ultimately important",
   "page": "",
   "angle": "house-style-2019"
  },
  {
   "feature": "overview granularity",
   "claim": "Each part of an adventure gets a one-to-two-sentence overview entry tied to a Story Objective.",
   "source": "DC Adventure Format v1.3.docx (Claire Hoffman / Ma'at Crook, 2023-11) in the Dungeoncraft Pack 2023-12-04",
