   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
   "fromFile": "verdicts-dnd-triage-r6.json"
  },
  "759": {
   "index": 759,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "Use your outline (that is, your headings) to build a skeleton",
   "note": "Raw page fetched (HTTP 200). 'Techniques to Write Adventures', September 14, 2021, Luke Gearing, under the heading 'Outline To Fuck'. The same sentence continues that your words, the details, are the meat; the following paragraph describes typing headings first in Markdown. Skeleton-first and words-as-meat limbs both supported.",
   "fromFile": "verdicts-dnd-i724-795.json"
  },
