  "921": {
   "index": 921,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "nearly every location has a meaningful quest or event attached",
   "note": "Raw page, section 'Setting'. HTML splits the word across a styled span ('n' + '<span>early'), so the text reads 'nearly'; the claim's 'nearly every' is correct.",
