  "1101": {
   "index": 1101,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "a rough average for a single encounter's word count",
   "note": "PDF fetched 200 and text-extracted with pdftotext -layout (6 pages). Quote is the parenthetical in the APPENDIX II bullet telling writers to multiply encounter count by 500. Section matches. Nuance not contradicting the claim: the same bullet adds that higher-level encounter areas run wordier, averaging 750 or 1,000.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1102": {
   "index": 1102,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "sidebars in your adventure to a minimum, and to no",
   "note": "Same PDF text. APPENDIX II bullet: keep the number of sidebars to a minimum and to no more than 300 words in length. Both limbs (the 300-word cap and the minimise instruction) supported in one sentence. Later sections repeat the 300-word cap for the Scaling and Adapting sidebars.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1103": {
   "index": 1103,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
   "fromFile": "verdicts-dnd-triage-r10.json"
  },
  "1104": {
   "index": 1104,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
   "fromFile": "verdicts-dnd-triage-r10.json"
  },
  "1105": {
   "index": 1105,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "write a 25-word personal bio",
   "note": "Same PDF text. Section 'The Manuscript', numbered rule 4, exactly as cited: at the end of your manuscript write it, with the parenthetical restricting it to adventure and backdrop manuscript submissions. All limbs supported; page calls it a personal bio, and Appendix II has a matching mandatory Author Bio section.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1106": {
   "index": 1106,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
   "fromFile": "verdicts-dnd-triage-r10.json"
  },
  "1107": {
   "index": 1107,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
   "fromFile": "verdicts-dnd-triage-r10.json"
  },
  "1108": {
   "index": 1108,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "A full page of text in Dragon contains about 750 words.",
   "note": "Live paizo.com/writersguidelines/dragon.html fetched 200 (raw HTML). Sentence stands alone under the 'Format and Style' heading, exactly as cited. Eleven words, within the twelve-word cap.",
   "fromFile": "verdicts-dnd-i1056-1130.json"
  },
  "1109": {
   "index": 1109,
   "verdict": "SKIPPED_TRIAGE",
   "trueWording": "",
   "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round",
