  "539": {
   "index": 539,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "The most valuable part... is the detailed gazetteer describing the neighborhoods and prominent locations",
   "note": "Verbatim; article title confirms the subject is 'D&D 5e's 2024 Dungeon Master's Guide'.",
   "fromFile": "verdicts-dnd-i529-543.json"
  },
  "540": {
   "index": 540,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "The location descriptions are full of flavorful NPCs, background hooks",
