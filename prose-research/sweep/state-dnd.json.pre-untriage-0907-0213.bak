  "789": {
   "index": 789,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "They still signpost traps and treasure with bold italics",
   "note": "Raw page fetched (HTTP 200). 'Designing Layout and Information in Adventures', Welcome to the Deathtrap, Sunday August 29, 2021 (Brian C. Rideout), section 'The Evolution of Dungeons & Dragons' Information Design'. Full page sentence continues 'at the start of the appropriate paragraph'. Subject 'They' is Wizards of the Coast, reached via his copy of D&D5e's Candlekeep Mysteries, so the 5th-Edition limb is the page's own referent; the sentence ends by noting it is still a wall of text with boxed description.",
   "fromFile": "verdicts-dnd-i724-795.json"
  },
  "790": {
   "index": 790,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "clearly signposted monsters, treasure, traps, and tactics using indentation and icons",
   "note": "Raw page fetched (HTTP 200). Same post and section. The page continues 'and presented in a specific order', plus Encounter Level at the start of each encounter, so the specific-order limb is on the page and the attribution to 3rd edition's structure is explicit.",
   "fromFile": "verdicts-dnd-i724-795.json"
  },
