   "fromFile": "verdicts-dnd-i529-543.json"
  },
  "533": {
   "index": 533,
   "verdict": "VERIFIED_VERBATIM",
   "trueWording": "It covers what it looks like as an everyday resident",
   "note": "Verbatim. Sentence before: 'The next section is a deep dive into the \"feel\" of Ptolus and what it is like to live there.'",
