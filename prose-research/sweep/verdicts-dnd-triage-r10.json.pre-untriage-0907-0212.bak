{"name": "dnd", "triage": true, "claims": [{"index": 1052, "feature": "withheld information and inference", "claim": "Kim Mohan, D&D's longest-serving editor, praises Ed Greenwood's prose for leaving the reader feeling that fifty words are held back behind every word given.", "source": "Kim Mohan, quoted by Ramanan Sivaranjan reporting the D&D podcast interview, 2013", "url": "https://save.vs.totalpartykill.ca/blog/kim-mohan/", "quote": "you feel like he’s holding fifty in reserve"}, {"index": 1053, "feature": "plainness and economy", "claim": "Mohan says that of every ten words Ed Greenwood supplies, three or four could probably have been kept back.", "source": "Kim Mohan, quoted by Ramanan Sivaranjan reporting the D&D podcast interview, 2013", "url": "https://save.vs.totalpartykill.ca/blog/kim-mohan/", "quote": "for every ten that he gives you he probably could"}, {"index": 1054, "feature": "edition and house style", "claim": "Stan!, who worked with Mohan for about ten years, says Mohan's job under whatever title was to set the editorial tone and mentor the staff.", "source": "Stan! (Steven Brown), 50 Years in the Dungeon, 2025", "url": "https://50yearsinthedungeon.substack.com/p/honoring-kim-mohan", "quote": "always to set the editorial tone and mentor the staff"}, {"index": 1055, "feature": "edition and house style", "claim": "Stan! states that Mohan edited every edition of D&D from the original hardcovers to fifth-edition supplements.", "source": "Stan! (Steven Brown), 50 Years in the Dungeon, 2025", "url": "https://50yearsinthedungeon.substack.com/p/honoring-kim-mohan", "quote": "worked on EVERY edition of D&D from the original hardcovers"}, {"index": 1057, "feature": "edition and house style", "claim": "The D&D house style guide circulated to Guild creators is numbered version 1.08a and carries a 2018 Wizards of the Coast copyright line.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "Version 1.08a ©2018 Wizards of the Coast"}, {"index": 1058, "feature": "edition and house style", "claim": "Version 1.08a takes the Chicago Manual of Style, 17th edition as one of its two foundations.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "The Chicago Manual of Style, 17th edition"}, {"index": 1059, "feature": "edition and house style", "claim": "The earlier version 1.04a of the same guide took the Chicago Manual of Style, 16th edition as its foundation, so the house authority moved one Chicago edition between the two releases.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.04a", "url": "https://adventurersleague.files.wordpress.com/2018/10/1765690-dnd_house_style_guide.pdf", "quote": "The Chicago Manual of Style, 16th edition"}, {"index": 1060, "feature": "edition and house style", "claim": "The superseded version of the guide is numbered 1.04a and carries a 2013 copyright line.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.04a", "url": "https://adventurersleague.files.wordpress.com/2018/10/1765690-dnd_house_style_guide.pdf", "quote": "Version 1.04a ©2013 Wizards of the Coast"}, {"index": 1061, "feature": "edition and house style", "claim": "Neither released version of the D&D style guide names an author, editor or compiler anywhere in its pages; the only attribution is the corporate copyright line.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a (11 pages) and v1.04a (9 pages)", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": ""}, {"index": 1062, "feature": "dm-facing sentence", "claim": "The house style guide states that in rules text the D&D editors prefer to achieve gender neutrality by writing in the second person wherever possible.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Achieving Gender Neutrality", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "neutrality by writing in the second person"}, {"index": 1063, "feature": "terminology consistency", "claim": "The house style guide instructs writers to avoid page references as much as possible.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Page References", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "We avoid page references as much as possible."}, {"index": 1064, "feature": "terminology consistency", "claim": "The guide's stated reason for avoiding page references is that they are labor-intensive, having to be added by hand during galley review.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Page References", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "They are labor-intensive (they must be added by"}, {"index": 1065, "feature": "terminology consistency", "claim": "The guide tells writers to use cross-references judiciously because they are easily overused.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Cross-References", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "Use cross-references judiciously."}, {"index": 1066, "feature": "terminology consistency", "claim": "The guide sets a monster's name in bold only on its first appearance in an encounter area or subsection, not on every mention.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Terms to Set in Bold", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "Set a monster’s name in bold only the first time"}, {"index": 1067, "feature": "terminology consistency", "claim": "The guide forbids any word coming between the number of monsters appearing and the name of the stat block.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Terms to Set in Bold", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "Make sure no text gets between the number of"}, {"index": 1068, "feature": "terminology consistency", "claim": "The guide treats italicized spell and magic item names as titles rather than as descriptions of the thing they create.", "source": "Wizards of the Coast, D&D Style Guide: Writing and Editing v1.08a, Terms to Italicize", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/dnd_house_style_guide_updated_january_2019.pdf", "quote": "The italicized terms are treated as titles"}, {"index": 1069, "feature": "register modulation", "claim": "Ray Vallese, the Planescape line's editor, says the products were often written in a wry, overly clever voice that smirked at the setting's ignorant outsiders.", "source": "Ray Vallese, TSR Planescape editor, interviewed at Exposition Break, 2022", "url": "https://www.expositionbreak.com/a-walk-through-the-planes-an-interview-with-monte-cook-ray-vallese-and-colin-mccomb/", "quote": "written in a wry, overly clever voice that smirked"}, {"index": 1072, "feature": "diction (native vs latinate)", "claim": "Monte Cook recalls that WotC president Peter Adkison did not want a line whose characters used slang he could not understand to discuss philosophy.", "source": "Monte Cook, Planescape designer, interviewed at Exposition Break, 2022", "url": "https://www.expositionbreak.com/a-walk-through-the-planes-an-interview-with-monte-cook-ray-vallese-and-colin-mccomb/", "quote": "not people using slang he didn’t understand to discuss philosophy"}, {"index": 1073, "feature": "plainness and economy", "claim": "Christopher Perkins states as a working practice that he keeps his descriptions spare.", "source": "Christopher Perkins, The Dungeon Master Experience: T'wit, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "I keep my descriptions spare."}, {"index": 1074, "feature": "adjective and adverb discipline", "claim": "Perkins says he keeps his NPC descriptions brief as well.", "source": "Christopher Perkins, The Dungeon Master Experience: T'wit, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "I keep my NPC descriptions brief as well."}, {"index": 1075, "feature": "concrete sensory noun", "claim": "Perkins gives an NPC one distinguishing characteristic and then moves on.", "source": "Christopher Perkins, The Dungeon Master Experience: T'wit, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "I generally like to give an NPC one"}, {"index": 1076, "feature": "omission as information", "claim": "Perkins says he does not frontload information but lets it trickle out.", "source": "Christopher Perkins, The Dungeon Master Experience: T'wit, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "I don’t frontload information."}, {"index": 1077, "feature": "place and institution description", "claim": "Perkins says that whenever the characters arrive in a new village, town or city he gives them local rumours, some true and some false.", "source": "Christopher Perkins, The Dungeon Master Experience: Lies My DM Told Me, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "new village, town, or city, I pepper them with local"}, {"index": 1078, "feature": "withheld information and inference", "claim": "Perkins advises that when in doubt the DM should tell the players things that are true, noting that old D&D adventures carried more true rumours than false ones.", "source": "Christopher Perkins, The Dungeon Master Experience: Lies My DM Told Me, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "When in doubt, tell the players things that are true."}, {"index": 1079, "feature": "naming and forms of address", "claim": "Perkins says the trick with human names is finding names that sound human yet seem grounded in a world of fantasy rather than reality.", "source": "Christopher Perkins, The Dungeon Master Experience: What's in a Name?, Dungeon 197, 2011", "url": "https://web.archive.org/web/20201112024903if_/http://www.wizards.com/dnd/files/DM_Experience_2011.pdf", "quote": "names that sound human but seem grounded in a"}, {"index": 1080, "feature": "plainness and economy", "claim": "Ray Winninger's First Rule of Dungeoncraft is never to force yourself to create more than you must.", "source": "Ray Winninger, Dungeoncraft, Dragon 256 (later WotC's D&D executive producer)", "url": "https://textual.ru/rpg/dungeoncraft.pdf", "quote": "Never force yourself to create more than"}, {"index": 1081, "feature": "withheld information and inference", "claim": "Winninger's Second Rule of Dungeoncraft is that every major piece of the campaign world filled in must be given at least one secret related to it.", "source": "Ray Winninger, Dungeoncraft, Dragon 257", "url": "https://textual.ru/rpg/dungeoncraft.pdf", "quote": "Whenever you fill in a major piece of the"}, {"index": 1082, "feature": "place and institution description", "claim": "Winninger populates a fantasy city's government with functional bureaucrats such as a Master of the Docks who authorises all cargo in and out of the city.", "source": "Ray Winninger, Dungeoncraft, Dragon 257, Home Base", "url": "https://textual.ru/rpg/dungeoncraft.pdf", "quote": "Master of the Docks who authorizes all cargo that"}, {"index": 1083, "feature": "place and institution description", "claim": "Winninger tells the DM to give the home settlement a rumour mill, a place where adventurers gather to swap boasts, rumours and legends.", "source": "Ray Winninger, Dungeoncraft, Dragon 261, The Rumor Mill", "url": "https://textual.ru/rpg/dungeoncraft.pdf", "quote": "a place where adventurers gather to"}, {"index": 1084, "feature": "place and institution description", "claim": "Winninger sets the minimum population of a home base at two interesting NPCs, arguing it is better to develop two really good ideas than four or five mediocre ones.", "source": "Ray Winninger, Dungeoncraft, Dragon 261, Interesting NPCs", "url": "https://textual.ru/rpg/dungeoncraft.pdf", "quote": "better to develop two really good ideas than four"}, {"index": 1085, "feature": "boxed text form", "claim": "The DUNGEON staff's writers' guidelines state that read-aloud text makes no reference to the viewer.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Read-Aloud Text section", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "does not make any reference to the viewer"}, {"index": 1086, "feature": "boxed text form", "claim": "The DUNGEON guidelines tell writers to avoid phrases such as \"you see\" and \"as you enter the room\" in read-aloud text because they assume player action.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Read-Aloud Text section", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "Avoid phrases such as “you see,” “as you enter the"}, {"index": 1087, "feature": "boxed text form", "claim": "The DUNGEON guidelines cap read-aloud text: it should only rarely run more than a few sentences.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Read-Aloud Text section", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "should only rarely run more than a few sentences"}, {"index": 1088, "feature": "boxed text form", "claim": "The DUNGEON guidelines say long sections of read-aloud text are better served as player handouts.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Read-Aloud Text section", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "are better served as player handouts"}, {"index": 1089, "feature": "boxed text form", "claim": "The DUNGEON guidelines tell writers to keep descriptions of creatures out of read-aloud text, because a creature's position and activity depend on circumstances.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Read-Aloud Text section", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "descriptions of any creatures in the room"}, {"index": 1090, "feature": "omission as information", "claim": "The DUNGEON editors say they greatly dislike printing the words \"This room is empty\" in the magazine.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, The Adventure's Encounters", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "printing the words “This room is empty”"}, {"index": 1091, "feature": "dm-facing sentence", "claim": "The DUNGEON guidelines rule that if a writer has nothing to say under any of the encounter's headings, the area is not an encounter and takes no number.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, The Adventure's Encounters", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "the area is not an encounter and should not be"}, {"index": 1092, "feature": "edition and house style", "claim": "The DUNGEON staff list failure to present information in the proper D&D style among the standard reasons an article is rejected.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Rejection", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "failure to present information in the proper D&D style"}, {"index": 1093, "feature": "place and institution description", "claim": "The DUNGEON staff say the key to designing a compelling fantasy city is presenting a strong sense of place.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Appendix 1: Cities of Adventure", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "compelling fantasy city is presenting a strong “sense of place.”"}, {"index": 1094, "feature": "place and institution description", "claim": "The DUNGEON staff set a writer thirty questions about a city before writing it, opening with who rules the city and how the ruler maintains power.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Appendix 1: Cities of Adventure", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "THIRTY QUESTIONS ABOUT YOUR CITY"}, {"index": 1095, "feature": "concrete sensory noun", "claim": "Among the thirty questions the DUNGEON staff require a city writer to answer is what the city smells like.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Appendix 1, question 24", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "What does the city smell like?"}, {"index": 1096, "feature": "place and institution description", "claim": "The last of the DUNGEON staff's thirty city questions, and the only one set in capitals, asks why adventurers come to the city.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Appendix 1, question 30", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "WHY DO ADVENTURERS COME TO YOUR CITY?"}, {"index": 1097, "feature": "place and institution description", "claim": "A DUNGEON \"Cities of Adventure\" article runs from 8,000 to 10,000 words.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Features", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "Cities of Adventure articles range in length from"}, {"index": 1098, "feature": "place and institution description", "claim": "A DUNGEON city article must carry a brief appendix with up to five complete stat blocks for personages important to the city.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Features", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "stat blocks for personages important to the city"}, {"index": 1099, "feature": "place and institution description", "claim": "A DUNGEON Backdrop, the magazine's locale feature, may range in scope from a demiplane down to a single city location such as a tavern or temple.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Features", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "from a demiplane to a single city location"}, {"index": 1100, "feature": "plainness and economy", "claim": "The DUNGEON staff hold that a background that cannot be presented in 500 words is probably too complex and should be simplified.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Adventure Background", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "present an adventure background in 500 words, it’s probably"}, {"index": 1103, "feature": "withheld information and inference", "claim": "The DUNGEON guidelines require surprises and plot twists to be outlined in the synopsis for the DM rather than sprung during the adventure text.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, Adventure Synopsis", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "Outline surprises and plot"}, {"index": 1104, "feature": "place and institution description", "claim": "The DUNGEON guidelines list rumours, researchable background and town statistics among the sections a writer may place before an adventure's encounters.", "source": "The DUNGEON Staff, DUNGEON Submission Guidelines, The Adventure's Encounters", "url": "https://paizo.com/writersguidelines/dungeon_writer_guidelines.pdf", "quote": "background information the players can uncover in research"}, {"index": 1106, "feature": "point of view and distance", "claim": "The Dragon editorial staff state that they will not publish an article written in the first person.", "source": "Dragon Writers Guidelines (Dragon editorial staff), Format and Style", "url": "https://paizo.com/writersguidelines/dragon.html", "quote": "we will not publish an article written in the first person"}, {"index": 1107, "feature": "opening sentence", "claim": "The Dragon guidelines cap an article's opening narrative vignette or example dialogue at 200 words.", "source": "Dragon Writers Guidelines (Dragon editorial staff), Format and Style", "url": "https://paizo.com/writersguidelines/dragon.html", "quote": "no more than 200 words long"}, {"index": 1109, "feature": "terminology consistency", "claim": "The Dragon guidelines require article manuscripts to use the current style of D&D game products, italicising magic item and spell names and capitalising feat names.", "source": "Dragon Writers Guidelines (Dragon editorial staff), Format and Style", "url": "https://paizo.com/writersguidelines/dragon.html", "quote": "should use the current style of D&D game"}, {"index": 1110, "feature": "adjective and adverb discipline", "claim": "Chris Sims, a D&D editor at Wizards of the Coast, says that as an editor he cuts weasel words without mercy.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "As an editor, I cut weasel words without mercy."}, {"index": 1111, "feature": "adjective and adverb discipline", "claim": "Sims names generally and typically among the weasel words he objects to.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "words such as generally, typically, and similar weasels"}, {"index": 1112, "feature": "adjective and adverb discipline", "claim": "Sims says he has yet to see a superlative that was necessary for the fiction or mechanic in which it appeared.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "yet to see a superlative that was necessary for the"}, {"index": 1115, "feature": "concrete sensory noun", "claim": "Sims holds that more examples are better than hedged generalizations when writing a species or culture for a game.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "more examples are better than hedged generalizations"}, {"index": 1116, "feature": "edition and house style", "claim": "Sims cites the 5e Player's Handbook half-orc passage as superlatives hedged into words doing little work.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "leaving a lot of words doing little work"}, {"index": 1117, "feature": "edition and house style", "claim": "Sims names Kim Mohan among the mentors who taught him about generalizations, hedging and superlatives.", "source": "Chris S. Sims, Writing: Generalizations and Absolutes, 2020", "url": "https://chrisssims.wordpress.com/2020/07/14/writing-generalizations-and-absolutes/", "quote": "Among them is the great Kim Mohan"}, {"index": 1118, "feature": "boxed text form", "claim": "Teos Abadia records that Season 8 of the D&D Adventurers League moved away from boxed text and separated the information into specific headings.", "source": "Teos Abadia (Alphastream), The Best and Worst of Adventure Formats at Winter Fantasy 2020", "url": "https://alphastream.org/index.php/2020/02/20/the-best-and-worst-of-adventure-formats-at-winter-fantasy-2020/", "quote": "moving away from boxed text and separating information into specific"}, {"index": 1119, "feature": "dm-facing sentence", "claim": "Abadia records that Season 8 required its authors to use the heading-based format.", "source": "Teos Abadia (Alphastream), The Best and Worst of Adventure Formats at Winter Fantasy 2020", "url": "https://alphastream.org/index.php/2020/02/20/the-best-and-worst-of-adventure-formats-at-winter-fantasy-2020/", "quote": "Season 8 required that authors use the format."}, {"index": 1120, "feature": "place and institution description", "claim": "Abadia argues the Season 8 format broke a single place description across several headings so that the door's appearance had to be assembled from two sections.", "source": "Teos Abadia (Alphastream), The Best and Worst of Adventure Formats at Winter Fantasy 2020", "url": "https://alphastream.org/index.php/2020/02/20/the-best-and-worst-of-adventure-formats-at-winter-fantasy-2020/", "quote": "The information is spread out."}, {"index": 1121, "feature": "dm-facing sentence", "claim": "Abadia's verdict is that the Season 8 format actively obfuscates the content and makes the adventure harder to run at the table.", "source": "Teos Abadia (Alphastream), The Best and Worst of Adventure Formats at Winter Fantasy 2020", "url": "https://alphastream.org/index.php/2020/02/20/the-best-and-worst-of-adventure-formats-at-winter-fantasy-2020/", "quote": "actively obfuscates the content and makes the adventure harder to"}, {"index": 1122, "feature": "boxed text form", "claim": "Abadia praises a rival format's equivalent of boxed text not for being boxed but because it gathers all of the information in one place.", "source": "Teos Abadia (Alphastream), The Best and Worst of Adventure Formats at Winter Fantasy 2020", "url": "https://alphastream.org/index.php/2020/02/20/the-best-and-worst-of-adventure-formats-at-winter-fantasy-2020/", "quote": "eschews the format and actually gathers all of the information"}, {"index": 1123, "feature": "register modulation", "claim": "Christopher Perkins, then editor of DUNGEON Adventures, says Warriors of Heaven does not embrace the narrative style of most Planescape products because it is a core AD&D product.", "source": "Christopher Perkins, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-chris-perkins-designer-of-warriors-of-heaven/", "quote": "does not embrace the narrative style of most PLANESCAPE"}, {"index": 1125, "feature": "plainness and economy", "claim": "Perkins says that anyone who has edited his work knows he almost always overwrites.", "source": "Christopher Perkins, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-chris-perkins-designer-of-warriors-of-heaven/", "quote": "I almost always overwrite"}, {"index": 1126, "feature": "place and institution description", "claim": "Perkins says an adventure set in Sigil has an entirely different feel from one set in the Abyss, and that he values describing places that could exist nowhere else.", "source": "Christopher Perkins, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-chris-perkins-designer-of-warriors-of-heaven/", "quote": "an adventure set in Sigil has an entirely different"}, {"index": 1127, "feature": "register modulation", "claim": "Perkins says the voice and design of the Planescape campaign setting were daring and striking in their originality.", "source": "Christopher Perkins, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-chris-perkins-designer-of-warriors-of-heaven/", "quote": "The voice and design of the campaign setting was daring"}, {"index": 1128, "feature": "plainness and economy", "claim": "Steve Winter, TSR's first hire with professional editing experience, says that in games as in journalism the language needs to be direct and clear.", "source": "Steve Winter, TSR editor, interviewed at Grognardia, 2009", "url": "http://grognardia.blogspot.com/2009/08/interview-steve-winter.html", "quote": "the language needs to be direct and clear"}, {"index": 1129, "feature": "adjective and adverb discipline", "claim": "Winter says flowery phrases and clever wordplay are things journalists avoid, and that the same holds in games.", "source": "Steve Winter, TSR editor, interviewed at Grognardia, 2009", "url": "http://grognardia.blogspot.com/2009/08/interview-steve-winter.html", "quote": "Flowery phrases and clever wordplay are things to avoid"}, {"index": 1131, "feature": "edition and house style", "claim": "Waterdeep: Dragon Heist, the 2018 city adventure, credits Michele Carter, Scott Fitzgerald Gray and Kim Mohan as its editors.", "source": "Waterdeep: Dragon Heist (Wizards of the Coast, 2018), credits page, read through the Internet Archive's OCR text", "url": "https://archive.org/stream/wheaton_Wdh/Waterdeep%20-%20%20Dragon%20Heist_djvu.txt", "quote": "Editors: Michele Carter Scott Fitzgerald Cray, Kim Mohan"}, {"index": 1132, "feature": "edition and house style", "claim": "Jeremy Crawford is credited as managing editor of Waterdeep: Dragon Heist.", "source": "Waterdeep: Dragon Heist (Wizards of the Coast, 2018), credits page, read through the Internet Archive's OCR text", "url": "https://archive.org/stream/wheaton_Wdh/Waterdeep%20-%20%20Dragon%20Heist_djvu.txt", "quote": "Managing Editor: Jeremy Crawford"}, {"index": 1133, "feature": "edition and house style", "claim": "The DMs Guild describes the style-guide package as PDF documents distributed by Wizards of the Coast to official play writers.", "source": "Dungeon Masters Guild, DMs Guild Creator Resource - Style Guide Resources product page", "url": "http://web.archive.org/web/20240423102657id_/https://www.dmsguild.com/product/267467/", "quote": "distributed by Wizards of the Coast to official play writers"}, {"index": 1134, "feature": "edition and house style", "claim": "The DMs Guild product page dates the House Style Guide's update to January 2019.", "source": "Dungeon Masters Guild, DMs Guild Creator Resource - Style Guide Resources product page", "url": "http://web.archive.org/web/20240423102657id_/https://www.dmsguild.com/product/267467/", "quote": "The House Style Guide has been updated January 2019."}, {"index": 1135, "feature": "edition and house style", "claim": "The DMs Guild page credits the package's adventure-design tips to Chris Perkins and Greg Bilsland.", "source": "Dungeon Masters Guild, DMs Guild Creator Resource - Style Guide Resources product page", "url": "http://web.archive.org/web/20240423102657id_/https://www.dmsguild.com/product/267467/", "quote": "tips for adventure design from Chris Perkins and Greg"}, {"index": 1136, "feature": "edition and house style", "claim": "The DMs Guild states that following the style guides is not required to publish on the platform.", "source": "Dungeon Masters Guild, DMs Guild Creator Resource - Style Guide Resources product page", "url": "http://web.archive.org/web/20240423102657id_/https://www.dmsguild.com/product/267467/", "quote": "Following these style guides is not required to publish on"}, {"index": 1137, "feature": "edition and house style", "claim": "The D&D adventure design guide distributed with the house style guide is bylined Chris Perkins and Greg Bilsland.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures (D&D Adventure Design Guide)", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "By Chris Perkins & Greg Bilsland"}, {"index": 1138, "feature": "plainness and economy", "claim": "Perkins and Bilsland tell adventure writers to present information as concisely as possible to ease the burden on the DM.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 7", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "present information as concisely as possible, to ease the burden"}, {"index": 1139, "feature": "concrete sensory noun", "claim": "Perkins and Bilsland name NPCs, dungeon dressings and treasure hoards as the elements that deserve descriptive text despite the concision rule.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 7", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "namely NPCs, dungeon dressings, and treasure hoards"}, {"index": 1140, "feature": "naming and forms of address", "claim": "Perkins and Bilsland say character is added to an NPC by describing distinctive physical features, mannerisms and quirks.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 7", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "distinctive physical features, mannerisms, and quirks"}, {"index": 1141, "feature": "withheld information and inference", "claim": "Perkins and Bilsland rule that the text must not keep the DM in suspense, and must not conceal or bury information the DM needs.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 6", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "The goal isn’t to keep the DM in suspense"}, {"index": 1142, "feature": "dm-facing sentence", "claim": "Perkins and Bilsland require that an NPC be properly introduced before the text mentions that NPC by name in passing.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 6", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "make sure that an NPC is properly introduced before casually"}, {"index": 1143, "feature": "annalist voice and deep time", "claim": "Perkins and Bilsland hold that an adventure is about the here and now, and that the less history it carries the better.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, General Principles 4", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "An adventure is about the here and now."}, {"index": 1144, "feature": "edition and house style", "claim": "The Perkins and Bilsland guide sends writers to the Chicago Manual of Style, 16th edition, and to the D&D House Style Guide for grammar and punctuation.", "source": "Chris Perkins and Greg Bilsland, Writing Adventures, closing line", "url": "https://cyborgsandmages.wordpress.com/wp-content/uploads/2019/11/adventure_design_guide.pdf", "quote": "The Chicago Manual of Style (16th edition) and the"}, {"index": 1145, "feature": "plainness and economy", "claim": "Ray Vallese says RPG supplements are supposed to focus on communicating the basic information rather than dazzling the audience with clever prose.", "source": "Ray Vallese, TSR Planescape editor, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-ray-and-val-vallese/", "quote": "communicating the basic info and less on dazzling the audience"}, {"index": 1146, "feature": "register modulation", "claim": "Vallese qualifies that rule for the Planescape line, saying many people have remarked they bought Planescape products just to read them.", "source": "Ray Vallese, TSR Planescape editor, interviewed at Planescape: I am the Mimir, 1999", "url": "https://mimir.net/chant/an-interview-with-ray-and-val-vallese/", "quote": "purchased PS products just to read them"}, {"index": 1147, "feature": "edition and house style", "claim": "Wizards of the Coast describes the SRD as containing the base game rules, naming the rules glossary, weapon mastery properties and exploration mechanics as its content.", "source": "Wizards of the Coast / DND Staff, \"You Can Now Publish Your Own Creations Using the New Core Rules\", D&D Beyond", "url": "https://www.dndbeyond.com/posts/1949-you-can-now-publish-your-own-creations-using-the", "quote": "such as the rules glossary, weapon mastery properties, and exploration mechanics"}, {"index": 1148, "feature": "boxed text form", "claim": "James Wyatt says the 2024 Dungeon Master’s Guide now defines boxed text, so published adventures need not keep doing so.", "source": "James Wyatt, quoted by Ben Brosofsky, ScreenRant interview with Christopher Perkins and James Wyatt", "url": "https://screenrant.com/dnd-2024-dungeon-master-guide-interview-perkins-wyatt/", "quote": "Now the DMG tells you what boxed text is"}, {"index": 1149, "feature": "boxed text form", "claim": "Dungeon Master’s Workshop dates the introduction of boxed text to the 1979 module The Hidden Shrine of Tamoachan, written so that competing tables received identical room descriptions.", "source": "The Archmage, \"Dungeon Mastering 101: Mastering the Boxed Text\", Dungeon Master’s Workshop", "url": "https://dmsworkshop.com/2019/09/27/dm-101-boxed-text-mastering/", "quote": "ever since boxed text was introduced in The Hidden Shrine of Tamoachan"}, {"index": 1150, "feature": "terminology consistency", "claim": "Shawn Merwin tells adventure writers to avoid using D&D’s mechanical terms in their ordinary senses inside boxed text.", "source": "Shawn Merwin, \"Let’s Design an Adventure: Boxed Text\", D&D Beyond", "url": "https://www.dndbeyond.com/posts/625-lets-design-an-adventure-boxed-text", "quote": "Avoid game mechanical terms used in a non-mechanical way"}, {"index": 1151, "feature": "edition and house style", "claim": "A reader on the official D&D Beyond forum states that the planes-of-existence section has been removed from SRD 5.2 while the plane names survive inside the rules.", "source": "Forum user SteelfistBrave1, \"Official SRD 5.2 Discussion Thread\", D&D Beyond forums", "url": "https://www.dndbeyond.com/forums/d-d-beyond-general/general-discussion/219273-official-srd-5-2-discussion-thread-srd-5-2-1-now?page=3", "quote": "the section about the planes of existence has been removed"}, {"index": 1152, "feature": "stylometry", "claim": "The independent Creative Commons rendering of SRD 5.1 at 5thsrd.org carries the planes-appendix sentences word for word as extracted from the PDF, confirming the extraction the figures rest on.", "source": "5thSRD, \"The Planes of Existence\" (community CC-BY rendering of SRD 5.1)", "url": "https://5thsrd.org/adventuring/planes_of_existence/", "quote": "It is a great, silvery sea, the same above and below"}], "verdicts": [{"index": 1052, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 1053, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 1054, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 1055, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 1057, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"i