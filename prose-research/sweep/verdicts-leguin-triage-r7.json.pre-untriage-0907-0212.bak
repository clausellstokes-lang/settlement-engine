{"name": "leguin", "triage": true, "claims": [{"index": 384, "feature": "cadence and rhythm", "claim": "George Slusser asserts that Le Guin's writing gives the reader precise prose rhythms, in contrast to SF identified by its icons.", "source": "George Slusser, 'Le Guin and the Future of SF Criticism', Science Fiction Studies #53 (March 1991)", "url": "https://web.archive.org/web/20250524105632id_/https://www.depauw.edu/sfs/review_essays/sluss53.htm", "quote": "Le Guin gives us precise prose rhythms."}, {"index": 388, "feature": "register modulation", "claim": "Fredric Jameson argues that The Left Hand of Darkness is built from heterogeneous narrative modes superposed into what amounts to an anthology of narrative strands.", "source": "Fredric Jameson, 'World Reduction in Le Guin: The Emergence of Utopian Narrative', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20250607182307id_/https://www.depauw.edu/sfs/backissues/7/jameson7art.htm", "quote": "a virtual anthology of narrative strands of different kinds"}, {"index": 389, "feature": "omission as information", "claim": "Jameson names Le Guin's world-building technique world-reduction, a deliberate thinning of reality by radical abstraction and simplification.", "source": "Fredric Jameson, 'World Reduction in Le Guin', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20250607182307id_/https://www.depauw.edu/sfs/backissues/7/jameson7art.htm", "quote": "an operation of radical abstraction and simplification"}, {"index": 390, "feature": "omission as information", "claim": "Jameson's abstract states that in world reduction omission functions as utopian exclusion.", "source": "Fredric Jameson, 'World Reduction in Le Guin', Science Fiction Studies #7 (November 1975), abstract", "url": "https://web.archive.org/web/20250607182307id_/https://www.depauw.edu/sfs/backissues/7/jameson7art.htm", "quote": "omission functions as utopian exclusion"}, {"index": 391, "feature": "place and institution description", "claim": "Jameson says readers are struck by descriptive details such as the cornerstone ceremony and the spring caravan, in which contradictory elements of the real world are recombined into piquant montages.", "source": "Fredric Jameson, 'World Reduction in Le Guin', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20250607182307id_/https://www.depauw.edu/sfs/backissues/7/jameson7art.htm", "quote": "juxtaposed and recombined into piquant montages"}, {"index": 392, "feature": "annalist voice and deep time", "claim": "Jameson attributes the effect of Karhide to the immense time span involved and the great antiquity of its science and technology.", "source": "Fredric Jameson, 'World Reduction in Le Guin', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20250607182307id_/https://www.depauw.edu/sfs/backissues/7/jameson7art.htm", "quote": "the immense time span involved, and the great antiquity"}, {"index": 393, "feature": "plainness and economy", "claim": "Darko Suvin calls Le Guin a classical writer whose energy is strictly controlled within a taut and spare architectural system of narrative cells.", "source": "Darko Suvin, 'Parables of De-Alienation: Le Guin's Widdershins Dance', Science Fiction Studies #7 (November 1975), abstract as printed on the SFS page", "url": "https://web.archive.org/web/20260206193435id_/https://www.depauw.edu/sfs/backissues/7/suvin7art.htm", "quote": "a taut and spare architectural system of narrative cells"}, {"index": 395, "feature": "plainness and economy", "claim": "Suvin judges the Earthsea trilogy Le Guin's best work up to The Dispossessed when seen from a purely formal viewpoint of internal consistency and stylistic clarity.", "source": "Darko Suvin, 'Parables of De-Alienation', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20260206193435id_/https://www.depauw.edu/sfs/backissues/7/suvin7art.htm", "quote": "internal consistency and stylistic clarity, that trilogy is"}, {"index": 398, "feature": "plainness and economy", "claim": "Suvin describes Le Guin as austerely, almost puritanically, operating a retrenchment throughout her work.", "source": "Darko Suvin, 'Parables of De-Alienation', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20260206193435id_/https://www.depauw.edu/sfs/backissues/7/suvin7art.htm", "quote": "the retrenchment she austerely"}, {"index": 400, "feature": "civic record register", "claim": "Donald F. Theall argues that because LHD's narrator is a professional cultural analyst concerned with a thorough account of the culture, the novel takes on the characteristic features of an anthropological report.", "source": "Donald F. Theall, 'The Art of Social-Science Fiction', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "the characteristic features of an anthropological report"}, {"index": 401, "feature": "point of view and distance", "claim": "Theall argues that the outsider's separateness makes him observer as well as participant and so allows Le Guin a particularly descriptive approach.", "source": "Donald F. Theall, 'The Art of Social-Science Fiction', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "allows for the particularly descriptive approach"}, {"index": 402, "feature": "concrete sensory noun", "claim": "Theall says the sensory experience and subjective response of Le Guin's outsiders validates the carefully chosen and believable details that compose her accounts of her worlds.", "source": "Donald F. Theall, 'The Art of Social-Science Fiction', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "the carefully chosen and believable details"}, {"index": 403, "feature": "place and institution description", "claim": "Theall lists physical geography, sexual customs, cultural evolution, ideology and life-style as the categories of detail through which readers learn Le Guin's two worlds in The Dispossessed.", "source": "Donald F. Theall, 'The Art of Social-Science Fiction', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "details of physical geography, sexual customs, cultural evolution, ideology"}, {"index": 404, "feature": "civic record register", "claim": "Theall quotes LHD's narrator declaring that he will make his report as if he told a story.", "source": "Donald F. Theall quoting The Left Hand of Darkness §1, in Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "I'll make my report as if I told a story"}, {"index": 405, "feature": "place and institution description", "claim": "Theall links a Puritan or Yankee tradition to Le Guin's sensibility as it shows in descriptions of the rigors of Karhide and the asceticism of Anarres.", "source": "Donald F. Theall, 'The Art of Social-Science Fiction', Science Fiction Studies #7 (November 1975), note 1", "url": "https://web.archive.org/web/20251222093314id_/https://www.depauw.edu/sfs/backissues/7/theall7art.htm", "quote": "the rigors of Karhide or the asceticism of Anarres"}, {"index": 407, "feature": "plainness and economy", "claim": "Bierman disputes that Le Guin is a plain storyteller, saying she is rarely a simple, straightforward one.", "source": "Judah Bierman, 'Ambiguity in Utopia: The Dispossessed', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20251219192652id_/https://www.depauw.edu/sfs/backissues/7/bierman7art.htm", "quote": "Le Guin is rarely a simple, straightforward storyteller"}, {"index": 408, "feature": "place and institution description", "claim": "John Huntington says Karhide's feudal monarchy is realised with a care for the way politics works in that archaic system which is new to Le Guin.", "source": "John Huntington, 'Public and Private Imperatives in Le Guin's Novels', Science Fiction Studies #7 (November 1975)", "url": "https://web.archive.org/web/20250317044239id_/https://www.depauw.edu/sfs/backissues/7/huntington7art.htm", "quote": "a care for the way politics works in this"}, {"index": 417, "feature": "register modulation", "claim": "David Mitchell states that Le Guin avoids wide variations of tone or register in A Wizard of Earthsea.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "Le Guin eschews wide variations of tone or register"}, {"index": 419, "feature": "cadence and rhythm", "claim": "David Mitchell characterises the narrating voice of Ged’s story as having the calm authority of an age-old Icelandic saga.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "the calm authority of an age-old Icelandic saga"}, {"index": 420, "feature": "annalist voice and deep time", "claim": "David Mitchell states that the cumulative effect of Le Guin’s stylistic restraint is that A Wizard of Earthsea reads like a tale handed down through generations of storytellers.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "reads like the retelling of a tale first told centuries"}, {"index": 421, "feature": "place and institution description", "claim": "David Mitchell states that a quoted passage describing an East Reach woman’s customary greeting gesture persuades precisely because its detail seems too particular to have been invented.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "Such specificity is persuasive because it sounds too detailed"}, {"index": 422, "feature": "plainness and economy", "claim": "David Mitchell names a studied neutrality of style as one of the two failure modes fantasy prose falls into, the other being a cod-historic narratorial voice.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "a studied neutrality of style tastes like clingfilm"}, {"index": 423, "feature": "archaism", "claim": "David Mitchell states that a cod-historic narratorial voice in a fantasy novel feels like being locked inside a medieval theme park.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "A cod-historic narratorial voice in a fantasy novel"}, {"index": 424, "feature": "place and institution description", "claim": "David Mitchell states that descriptions of people and places in A Wizard of Earthsea are frugal enough to leave the reader’s imagination room to collaborate.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "rich enough to nourish the reader’s imagination, but frugal enough"}, {"index": 425, "feature": "point of view and distance", "claim": "David Mitchell states that Le Guin gives minor characters who appear only briefly the psychological depth of oil paintings.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "thumbnail sketches contain the psychological depth of oil paintings"}, {"index": 426, "feature": "place and institution description", "claim": "David Mitchell lists trade-routes, local politics, class hierarchies, infant mortality, abuse, addiction and slavery as the mundane institutional furniture that makes Earthsea’s fantastical elements feel quotidian.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "trade-routes, local politics, class hierarchies, infant mortality, abuse, addiction and slavery"}, {"index": 427, "feature": "withheld information and inference", "claim": "David Mitchell states that A Wizard of Earthsea contains moments of foreshadowing and authorial omniscience but no tricks.", "source": "David Mitchell, \"David Mitchell on Earthsea: a rival to Tolkien and George RR Martin\", The Guardian, 23 October 2015", "url": "https://www.theguardian.com/books/2015/oct/23/david-mitchell-wizard-of-earthsea-tolkien-george-rr-martin", "quote": "moments of foreshadowing and authorial omniscience but no tricks"}, {"index": 428, "feature": "plainness and economy", "claim": "Margaret Atwood names graceful prose first among the qualities that earned Le Guin her awards.", "source": "Margaret Atwood, \"The Queen of Quinkdom\", The New York Review of Books, 26 September 2002 issue", "url": "https://www.nybooks.com/articles/2002/09/26/the-queen-of-quinkdom/", "quote": "her graceful prose, carefully thought-through premises, psychological insight"}, {"index": 429, "feature": "civic record register", "claim": "Margaret Atwood describes the task of Le Guin’s Ekumen envoys as non-invasive, non-directive understanding and recording of the societies they visit.", "source": "Margaret Atwood, \"The Queen of Quinkdom\", The New York Review of Books, 26 September 2002 issue", "url": "https://www.nybooks.com/articles/2002/09/26/the-queen-of-quinkdom/", "quote": "non-directive understanding and recording are the functions required"}, {"index": 430, "feature": "register modulation", "claim": "Margaret Atwood states that Le Guin, though at times a movingly lyrical writer, has never avoided writing gore when the story required it.", "source": "Margaret Atwood, \"The Queen of Quinkdom\", The New York Review of Books, 26 September 2002 issue", "url": "https://www.nybooks.com/articles/2002/09/26/the-queen-of-quinkdom/", "quote": "at times a movingly lyrical writer"}, {"index": 433, "feature": "plainness and economy", "claim": "The unsigned Kirkus review of Tehanu calls the novel’s prose flawless and poetic and says even young readers will be beguiled by it.", "source": "Kirkus Reviews, unsigned review of Tehanu, 1 February 1990", "url": "https://www.kirkusreviews.com/book-reviews/ursula-k-le-guin/tehanu/", "quote": "beguiled by the flawless, poetic prose"}, {"index": 435, "feature": "annalist voice and deep time", "claim": "The unsigned Kirkus review of Tehanu says Le Guin weaves contemporary concerns into a tale carrying the universality and dignity of legend.", "source": "Kirkus Reviews, unsigned review of Tehanu, 1 February 1990", "url": "https://www.kirkusreviews.com/book-reviews/ursula-k-le-guin/tehanu/", "quote": "a tale with the universality and dignity of legend"}, {"index": 437, "feature": "sentence length variation", "claim": "Zadie Smith, in the Library of America tribute page, calls Le Guin’s sentences as elegant and beautiful as any written in the twentieth century.", "source": "Zadie Smith, in \"Fellow writers remember Ursula K. Le Guin, 1929–2018\", Library of America, January 2018", "url": "https://www.loa.org/news-and-views/1375-fellow-writers-remember-ursula-k-le-guin-1929-2018/", "quote": "her sentences, as elegant and beautiful as any written"}, {"index": 438, "feature": "plainness and economy", "claim": "Harold Bloom, in the Library of America tribute page, calls Le Guin an exquisite stylist.", "source": "Harold Bloom, in \"Fellow writers remember Ursula K. Le Guin, 1929–2018\", Library of America, January 2018", "url": "https://www.loa.org/news-and-views/1375-fellow-writers-remember-ursula-k-le-guin-1929-2018/", "quote": "Ursula was an exquisite stylist"}, {"index": 439, "feature": "cadence and rhythm", "claim": "Harold Bloom, in the Library of America tribute page, states that in Le Guin every word was exactly in place and every sentence or line had resonance.", "source": "Harold Bloom, in \"Fellow writers remember Ursula K. Le Guin, 1929–2018\", Library of America, January 2018", "url": "https://www.loa.org/news-and-views/1375-fellow-writers-remember-ursula-k-le-guin-1929-2018/", "quote": "Every word was exactly in place"}, {"index": 440, "feature": "annalist voice and deep time", "claim": "Amanda Craig states that Earthsea gains the mysterious depths of Tolkien’s world without Tolkien’s back-stories and verse.", "source": "Amanda Craig, \"Classic of the month: A Wizard of Earthsea\", The Guardian, 24 September 2003", "url": "https://www.theguardian.com/books/2003/sep/24/buildingachildrenslibrary.booksforchildrenandteenagers", "quote": "the mysterious depths of Tolkien’s, but without his tiresome back-stories"}, {"index": 441, "feature": "withheld information and inference", "claim": "Amanda Craig states that A Wizard of Earthsea contains allusions to fragmented legends about the tragedies of heroes and heroines.", "source": "Amanda Craig, \"Classic of the month: A Wizard of Earthsea\", The Guardian, 24 September 2003", "url": "https://www.theguardian.com/books/2003/sep/24/buildingachildrenslibrary.booksforchildrenandteenagers", "quote": "allusions to fragmented legends about the tragedies of heroes"}, {"index": 442, "feature": "cadence and rhythm", "claim": "Jo Walton states that Tehanu reads aloud beautifully, as she found while reading it aloud to a baby.", "source": "Jo Walton, \"A Woman on Gont: Ursula K. Le Guin’s Tehanu\", Tor.com/Reactor, 25 October 2011", "url": "https://reactormag.com/a-woman-on-gont-ursula-k-le-guins-tehanu/", "quote": "It reads aloud beautifully"}, {"index": 445, "feature": "register modulation", "claim": "Jo Walton states that The Tombs of Atuan is beautifully written but, unlike A Wizard of Earthsea, is not told like a legend.", "source": "Jo Walton, \"Let her be eaten: Ursula K. Le Guin’s The Tombs of Atuan\", Tor.com/Reactor, 2011", "url": "https://reactormag.com/let-her-be-eaten-ursula-k-le-guins-the-tombs-of-atuan/", "quote": "beautifully written, but it isn’t told like a legend"}, {"index": 446, "feature": "point of view and distance", "claim": "Jo Walton states that The Tombs of Atuan keeps the reader straightforwardly behind Tenar’s shoulder for the whole book.", "source": "Jo Walton, \"Let her be eaten: Ursula K. Le Guin’s The Tombs of Atuan\", Tor.com/Reactor, 2011", "url": "https://reactormag.com/let-her-be-eaten-ursula-k-le-guins-the-tombs-of-atuan/", "quote": "straightforwardly right behind Tenar’s shoulder the entire time"}, {"index": 448, "feature": "omission as information", "claim": "Jo Walton states that a lesser writer would have ended The Tombs of Atuan with the earthquake and the triumphant escape, and that Le Guin instead carries on into the escape through the mountains.", "source": "Jo Walton, \"Let her be eaten: Ursula K. Le Guin’s The Tombs of Atuan\", Tor.com/Reactor, 2011", "url": "https://reactormag.com/let-her-be-eaten-ursula-k-le-guins-the-tombs-of-atuan/", "quote": "a lesser writer would have finished the book with the earthquake"}, {"index": 449, "feature": "place and institution description", "claim": "Julie Phillips reports that Le Guin learned from Thomas Hardy to handle strong feeling by pouring it into landscape so the setting carries part of the emotional charge.", "source": "Julie Phillips, \"The Fantastic Ursula K. Le Guin\", The New Yorker, 17 October 2016", "url": "https://www.newyorker.com/magazine/2016/10/17/the-fantastic-ursula-k-le-guin", "quote": "letting the settings carry part of the emotional charge"}, {"index": 450, "feature": "place and institution description", "claim": "Le Guin, quoted by Julie Phillips, rejects the term \"pathetic fallacy\" for letting a landscape carry feeling and calls the technique art.", "source": "Ursula K. Le Guin, in interview with Julie Phillips, The New Yorker, 17 October 2016", "url": "https://www.newyorker.com/magazine/2016/10/17/the-fantastic-ursula-k-le-guin", "quote": "It’s not a fallacy; it’s art"}, {"index": 453, "feature": "omission as information", "claim": "Richard D. Erlich identifies a point in Tehanu where how Therru knows Tenar has lied is hinted at but never explained, and calls it a gap left for readers to fill.", "source": "Richard D. Erlich, Coyote’s Song: The Teaching Stories of Ursula K. Le Guin (SFRA digital book, 2009 revision), chapter \"Earthsea Revisited: Tehanu\"", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/earthsea.htm", "quote": "a significant gap to be left or filled in by readers"}, {"index": 455, "feature": "register modulation", "claim": "Richard D. Erlich states that Tehanu gains a different style from the Earthsea trilogy, which he calls a welcome variation from the high-fantastic.", "source": "Richard D. Erlich, Coyote’s Song: The Teaching Stories of Ursula K. Le Guin (SFRA digital book, 2009 revision), chapter \"Earthsea Revisited: Tehanu\"", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/earthsea.htm", "quote": "a welcomed variation from the high-fantastic"}, {"index": 456, "feature": "opening sentence", "claim": "Richard D. Erlich, with a linguist colleague, describes the opening sentence of Always Coming Home as past conditional, semi-conditional and emphatic past perfect, implying futurity.", "source": "Richard D. Erlich, Coyote’s Song: The Teaching Stories of Ursula K. Le Guin (SFRA digital book, 2009 revision), chapter \"Always Coming Home: Future Ethnography\", endnote 29", "url": "https://web.archive.org/web/20151107114510id_/http://sfra.org/Coyote/alwayshome.htm", "quote": "emphatic past perfect, implying futurity"}, {"index": 457, "feature": "civic record register", "claim": "Michael Dirda states that the narrating voice of the first three Earthsea books is that of a chronicler or mythmaker.", "source": "Michael Dirda, \"The Twilight of an Age of Magic\" (review of Tehanu), The Washington Post, 25 February 1990", "url": "https://www.washingtonpost.com/archive/entertainment/books/1990/02/25/the-twilight-of-an-age-of-magic/34d58490-4114-430b-890e-dc3dc3a3680a/", "quote": "the voice that of the chronicler or mythmaker"}, {"index": 458, "feature": "diction (native vs latinate)", "claim": "Michael Dirda characterises the prose of the Earthsea trilogy as grave and elevated, a style of moral seriousness.", "source": "Michael Dirda, \"The Twilight of an Age of Magic\" (review of Tehanu), The Washington Post, 25 February 1990", "url": "https://www.washingtonpost.com/archive/entertainment/books/1990/02/25/the-twilight-of-an-age-of-magic/34d58490-4114-430b-890e-dc3dc3a3680a/", "quote": "The prose is grave and elevated, a style of moral seriousness"}, {"index": 459, "feature": "register modulation", "claim": "Michael Dirda states that Tehanu is consequently meditative, somber, even talky, in contrast to the journeying of the earlier books.", "source": "Michael Dirda, \"The Twilight of an Age of Magic\" (review of Tehanu), The Washington Post, 25 February 1990", "url": "https://www.washingtonpost.com/archive/entertainment/books/1990/02/25/the-twilight-of-an-age-of-magic/34d58490-4114-430b-890e-dc3dc3a3680a/", "quote": "It is consequently meditative, somber, even talky"}, {"index": 461, "feature": "sentence length variation", "claim": "Michael Dirda states that Le Guin can still stand your hair on end with her sentences, and introduces a quoted Tehanu passage as the demonstration.", "source": "Michael Dirda, \"The Twilight of an Age of Magic\" (review of Tehanu), The Washington Post, 25 February 1990", "url": "https://www.washingtonpost.com/archive/entertainment/books/1990/02/25/the-twilight-of-an-age-of-magic/34d58490-4114-430b-890e-dc3dc3a3680a/", "quote": "stand your hair on end with her sentences"}, {"index": 462, "feature": "opening sentence", "claim": "Michael Dirda opens his review by quoting the first sentence of A Wizard of Earthsea, which names the island of Gont, its mile-high peak, its towns in high valleys and its ports on dark narrow bays before naming any person.", "source": "Michael Dirda, \"The Twilight of an Age of Magic\" (review of Tehanu), The Washington Post, 25 February 1990", "url": "https://www.washingtonpost.com/archive/entertainment/books/1990/02/25/the-twilight-of-an-age-of-magic/34d58490-4114-430b-890e-dc3dc3a3680a/", "quote": "a single mountain that lifts its peak a mile above"}, {"index": 463, "feature": "plainness and economy", "claim": "Gerald Jonas, in the New York Times obituary, describes Le Guin’s fiction as combining compelling stories and rigorous narrative logic with a lean but lyrical style.", "source": "Gerald Jonas, obituary of Ursula K. Le Guin, The New York Times, 23 January 2018", "url": "https://www.nytimes.com/2018/01/23/obituaries/ursula-k-le-guin-acclaimed-for-her-fantasy-fiction-is-dead-at-88.html", "quote": "a lean but lyrical style"}, {"index": 464, "feature": "register modulation", "claim": "Gerald Jonas states that the first three Earthsea books, written for young adults at the publisher’s request, show no trace of writing down to their audience in scale or style.", "source": "Gerald Jonas, obituary of Ursula K. Le Guin, The New York Times, 23 January 2018", "url": "https://www.nytimes.com/2018/01/23/obituaries/ursula-k-le-guin-acclaimed-for-her-fantasy-fiction-is-dead-at-88.html", "quote": "elevated style betray no trace of writing down to an audience"}, {"index": 465, "feature": "naming and forms of address", "claim": "Le Guin, quoted in her New York Times obituary, said she must find the right name for a character before she can get on with the story.", "source": "Ursula K. Le Guin, quoted by Gerald Jonas, The New York Times obituary, 23 January 2018", "url": "https://www.nytimes.com/2018/01/23/obituaries/ursula-k-le-guin-acclaimed-for-her-fantasy-fiction-is-dead-at-88.html", "quote": "I must find the right name or I cannot get on"}, {"index": 467, "feature": "register modulation", "claim": "Sean Guynes states that the tone of Le Guin’s writing in A Wizard of Earthsea is simpler and sparser than in The Left Hand of Darkness or The Dispossessed.", "source": "Sean Guynes, \"A Wizard of Earthsea: The Unsung Song of the Shadow\", The Ursula K. Le Guin Reread, Tor.com, 8 April 2020", "url": "https://reactormag.com/a-wizard-of-earthsea-the-unsung-song-of-the-shadow/", "quote": "simpler and sparser than in The Left Hand of Darkness"}, {"index": 468, "feature": "plainness and economy", "claim": "A reader commenting under Sean Guynes’s reread of A Wizard of Earthsea describes the novel’s language as managing to be both semi-sparse and beautiful.", "source": "AeronaGreenjoy, reader comment under Sean Guynes’s Le Guin Reread instalment on A Wizard of Earthsea, Tor.com, 2020", "url": "https://reactormag.com/a-wizard-of-earthsea-the-unsung-song-of-the-shadow/", "quote": "both semi-sparse and beautiful"}, {"index": 469, "feature": "cadence and rhythm", "claim": "Sylvia Kelso states that rhythm, as opposed to scansion, eludes most contemporary critical frames and is not susceptible to ideological analysis.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "Rhythm, as opposed to scansion, eludes most contemporary critical frames"}, {"index": 470, "feature": "cadence and rhythm", "claim": "Sylvia Kelso analyses the opening sentence of The Lathe of Heaven as four opposing blocks — two compound adjectives and two clauses — that echo the rhythm of ocean on beach.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "four opposing blocks, two compound adjectives, two clauses"}, {"index": 471, "feature": "cadence and rhythm", "claim": "Sylvia Kelso judges the quoted opening paragraph of Always Coming Home to contain no rhythmic superfluities.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "Here there are no rhythmic superfluities"}, {"index": 472, "feature": "sentence length variation", "claim": "Sylvia Kelso analyses the Always Coming Home opening as a long opening clause that checks into shortening phrases and brakes to a heavy pause at a colon.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "The long opening clause checks into the shortening phrases"}, {"index": 473, "feature": "plainness and economy", "claim": "Sylvia Kelso states that Le Guin, like Yeats, seems to move toward simplicity or at least austerity in the rhythm and content of her later work.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "Le Guin does seem to move toward simplicity"}, {"index": 474, "feature": "plainness and economy", "claim": "Sylvia Kelso states that Tehanu shows the skill of experience making less do more rather than more do more.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "making less do more, rather than more do more"}, {"index": 476, "feature": "repetition and refrain", "claim": "Sylvia Kelso states that the repeated splitting of rushes in the Tenar and Moss scene operates as a suite of variations marking pause and emphasis.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "a suite of variations to indicate pause and emphasis"}, {"index": 478, "feature": "cadence and rhythm", "claim": "Le Guin, quoted by Sylvia Kelso from \"Collectors, Rhymesters and Drummers\", said that if she could hold to the rhythms of the dragon’s flight the story told itself.", "source": "Ursula K. Le Guin, \"Collectors, Rhymesters and Drummers\" (in The Wave in the Mind, 2004), pp. 183-84, quoted by Sylvia Kelso in Paradoxa 21", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "If I could hold to the rhythms of the dragon’s flight"}, {"index": 479, "feature": "sentence length variation", "claim": "Sylvia Kelso describes the rhythm of the Kalessin arrival passage in Tehanu as almost somnambulistically smooth, with an extraordinarily long second sentence whose commas weight the critical words.", "source": "Sylvia A. Kelso, \"Boldly to Re-Venture: New Writing on the Works of Ursula K. Le Guin\", Paradoxa 21 (2009), pp. 7-22", "url": "https://paradoxa.com/wp-content/uploads/2020/07/1-Boldly-to-Re-Venture-New-Writing-on-the-Works-of-Ursula-K.-Le-Guin-Kelso-pp-7-22.pdf", "quote": "almost somnambulistically smooth, the second sentence extraordinarily long"}, {"index": 480, "feature": "civic record register", "claim": "The frame narrator of 'The Matter of Seggri' opens the story in the past tense with a dated archival event rather than a scene.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "The first recorded contact with Seggri was in year 242"}, {"index": 481, "feature": "omission as information", "claim": "The Seggri frame records the killing of an observer by naming exactly what the record does not contain.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "disclosed the fact, but not the circumstances"}, {"index": 482, "feature": "withheld information and inference", "claim": "The Seggri frame marks a gap in the archive with a present-tense statement that no record exists.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "There is no record of further contact with Seggri until"}, {"index": 483, "feature": "point of view and distance", "claim": "The Seggri compiler uses a first-person-plural editorial voice that states the limit of its holding before excerpting a document.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "We have only her report, from which three excerpts follow."}, {"index": 484, "feature": "civic record register", "claim": "A policy decision in the Seggri frame is reported as an agentless passive with the number written out in words.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "A limit of two hundred visitors from off world was set."}, {"index": 486, "feature": "place and institution description", "claim": "Each document in 'The Matter of Seggri' is introduced by a provenance line naming the kind of document, its recipient and its date.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "The following is a memoir given to Ambassador Eritho te Ves"}, {"index": 488, "feature": "plainness and economy", "claim": "An observer's institutional advice is compressed in the Seggri frame into a nominalisation and two bare verbs.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "Her recommendation was to observe and avoid."}, {"index": 489, "feature": "civic record register", "claim": "The Seggri frame reports a demographic figure in the present tense as a hedged ratio, giving the balance as about 12:1.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "the gender balance now stands at about 12:1"}, {"index": 490, "feature": "civic record register", "claim": "A generalisation about Seggri's literary institutions is written as an agentless past passive inside the report.", "source": "Ursula K. Le Guin, 'The Matter of Seggri' (1994), full text transcription, sfsfss.com", "url": "https://www.sfsfss.com/stories2/Le%20Guin,%20Ursula%20K.%20-%20The%20Matter%20of%20Seggri.html", "quote": "Small value was placed on preserving a \"true\" text"}, {"index": 496, "feature": "omission as information", "claim": "Le Guin's editorial note on the Kesh novella records its damage in transit and its lost pages in the flat voice of a catalogue entry.", "source": "Ursula K. Le Guin, editorial note in Always Coming Home, quoted by Brian Attebery in a Library of America interview", "url": "https://www.loa.org/news-and-views/1491-always-coming-home-the-ursula-k-le-guin-book-that-breaks-the-novel-form-8220wide-open8221/", "quote": "was damaged in transit, and the rest of the third chapter"}, {"index": 497, "feature": "withheld information and inference", "claim": "The same editorial note states the extent of the loss as a hedged range of pages rather than an exact figure.", "source": "Ursula K. Le Guin, editorial note in Always Coming Home, quoted by Brian Attebery in a Library of America interview", "url": "https://www.loa.org/news-and-views/1491-always-coming-home-the-ursula-k-le-guin-book-that-breaks-the-novel-form-8220wide-open8221/", "quote": "the last ten or twenty pages of the novel, are lost"}, {"index": 499, "feature": "place and institution description", "claim": "Attebery presents the Back of the Book as a section a reader may begin with for its world-building rather than as an appendix.", "source": "Brian Attebery, interviewed by Library of America", "url": "https://www.loa.org/news-and-views/1491-always-coming-home-the-ursula-k-le-guin-book-that-breaks-the-novel-form-8220wide-open8221/", "quote": "you can start with “The Back of the Book” and relish"}, {"index": 500, "feature": "place and institution description", "claim": "Matthew Keeley argues that the scholarly and cultural notes that would be appendices elsewhere are the main text of Always Coming Home.", "source": "Matthew Keeley, Reactor (Tor.com) review, 2019", "url": "https://reactormag.com/book-reviews-the-new-edition-of-ursula-k-le-guins-always-coming-home/", "quote": "are here the core of the text"}, {"index": 502, "feature": "place and institution description", "claim": "Matthew Keeley describes Always Coming Home as a book whose ambition is to become a place.", "source": "Matthew Keeley, Reactor (Tor.com) review, 2019", "url": "https://reactormag.com/book-reviews-the-new-edition-of-ursula-k-le-guins-always-coming-home/", "quote": "This is a book that aspires to placehood."}, {"index": 504, "feature": "point of view and distance", "claim": "A CSU Expository Reading and Writing Course module teaches The Left Hand of Darkness as a report addressed by Genly Ai to an official of the Ekumen.", "source": "CSU Expository Reading and Writing Course, The Left Hand of Darkness module, Student Version", "url": "https://rivercity.wusd.k12.ca.us/subsites/Brandon-Duff/documents/Expository-Reading-and-Writing-Course/Modules/The-Left-Hand-of-Darkness/Student%20Version.pdf", "quote": "this novel is presented as a report from Genly Ai"}, {"index": 505, "feature": "civic record register", "claim": "The same module names the in-world genre of the novel's frame as an ansible document.", "source": "CSU Expository Reading and Writing Course, The Left Hand of Darkness module, Student Version", "url": "https://rivercity.wusd.k12.ca.us/subsites/Brandon-Duff/documents/Expository-Reading-and-Writing-Course/Modules/The-Left-Hand-of-Darkness/Student%20Version.pdf", "quote": "It is called an ansible document."}, {"index": 506, "feature": "cadence and rhythm", "claim": "Le Guin says the rhythm of a story, however complicated and subtle, is what carries the reader.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "that’s what’s going to carry the reader"}, {"index": 507, "feature": "plainness and economy", "claim": "Le Guin praises old painters for getting simple in their means because they know they have not got time.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "Just so plain and simple. Because they know they haven’t got time."}, {"index": 508, "feature": "plainness and economy", "claim": "Le Guin distinguishes the economy she means from minimalism, which she calls a self-conscious mannerist style she cannot write.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "I’m not talking minimalism"}, {"index": 509, "feature": "diction (native vs latinate)", "claim": "Le Guin says that in departing from the heroic fantasy tradition she found a less formal vocabulary and a cadence better suited to what she had to say.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "I found a less formal vocabulary and a cadence better suited"}, {"index": 510, "feature": "register modulation", "claim": "Le Guin describes her own career-long change as easing up on the formality of her prose.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "I’ve eased up on the formality of the prose"}, {"index": 511, "feature": "archaism", "claim": "Le Guin names Tolkien, Dunsany, Eddison, MacDonald and Malory as the earlier-generation styles that the language of serious fantasy still rested on in the sixties and seventies.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": ""}, {"index": 512, "feature": "plainness and economy", "claim": "Le Guin compares an aging writer's language to old shoes or kitchen gear that no longer needs fancy stuff.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "your language gets like your shoes or your kitchen gear"}, {"index": 514, "feature": "plainness and economy", "claim": "Le Guin characterises genre writers of her early period as deliberately cultivating an attempt to be styleless, which she treats as a fault rather than a model.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "genre writers deliberately cultivated an attempt to be styleless"}, {"index": 515, "feature": "place and institution description", "claim": "Le Guin says that when she creates another world with a society on it she tries to hint at the complexity of that society instead of just referring to an empire.", "source": "Ursula K. Le Guin, interviewed by John Wray, The Paris Review, Art of Fiction No. 221 (2013)", "url": "https://web.archive.org/web/20140118190325id_/http://www.theparisreview.org/interviews/6253/the-art-of-fiction-no-221-ursula-k-le-guin", "quote": "I try to hint at the complexity of the society I’m creating"}, {"index": 516, "feature": "place and institution description", "claim": "Le Guin complains that writers taught 'show don't tell' are afraid to describe the world they have invented.", "source": "Ursula K. Le Guin, 'On Rules of Writing, or, Riffing on Rechy' (Los Angeles Times, 2003), ursulakleguin.com", "url": "https://www.ursulakleguin.com/on-rules-of-writing", "quote": "They’re afraid to describe the world they’ve invented."}, {"index": 517, "feature": "point of view and distance", "claim": "Le Guin argues the narrator's voice, often called omniscient, is the most intimate voice of all rather than a distancing one.", "source": "Ursula K. Le Guin, 'On Rules of Writing, or, Riffing on Rechy' (Los Angeles Times, 2003), ursulakleguin.com", "url": "https://www.ursulakleguin.com/on-rules-of-writing", "quote": "it’s the most intimate voice of all"}, {"index": 518, "feature": "point of view and distance", "claim": "Le Guin defends narrative distance with the phrase that distance lends enchantment.", "source": "Ursula K. Le Guin, 'On Rules of Writing, or, Riffing on Rechy' (Los Angeles Times, 2003), ursulakleguin.com", "url": "https://www.ursulakleguin.com/on-rules-of-writing", "quote": "But distance lends enchantment"}, {"index": 519, "feature": "point of view and distance", "claim": "Le Guin criticises writers for abandoning the narrative past tense for what she calls the tight-focused, inflexible present tense.", "source": "Ursula K. Le Guin, 'On Rules of Writing, or, Riffing on Rechy' (Los Angeles Times, 2003), ursulakleguin.com", "url": "https://www.ursulakleguin.com/on-rules-of-writing", "quote": ""}, {"index": 520, "feature": "omission as information", "claim": "Le Guin states flatly that stories are not shown but told.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1", "quote": "stories are not shown, but told"}, {"index": 522, "feature": "sentence length variation", "claim": "Le Guin's remedy for over-relied-on sentence structures is to vary the pattern and read the sentences aloud.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1", "quote": "play around with the order of words, the connections of sentences"}, {"index": 523, "feature": "point of view and distance", "claim": "Le Guin tells writers to distrust anybody who says fiction must use only limited third person.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1", "quote": "Distrust anybody"}, {"index": 524, "feature": "point of view and distance", "claim": "Le Guin says the currently practiced limited third person gives a brilliant, narrow, simplifying intensity of vision, like a flashlight beam.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1", "quote": "a brilliant, narrow, simplifying intensity of vision"}, {"index": 525, "feature": "place and institution description", "claim": "Le Guin tells a world-building questioner that event requires location and that where we are affects who we are.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story: Session 1, Continued' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-continued", "quote": "Event requires location. Where we are affects who we are"}, {"index": 526, "feature": "withheld information and inference", "claim": "Le Guin recommends giving secondary-world information indirectly, by hint and suggestion, rather than as an expository lump.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story: Session 1, Continued' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-continued", "quote": "Giving information indirectly, by hint and suggestion, can be fun to write."}, {"index": 529, "feature": "sentence length variation", "claim": "Le Guin coins the term Macho Staccato for the contemporary avoidance of complex sentences.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1, Part 3' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-part-3", "quote": "avoid complex sentences and write what I call Macho Staccato"}, {"index": 530, "feature": "sentence length variation", "claim": "Le Guin says the ideal is flexibility, a balance of different sentence lengths depending on what each sentence does.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1, Part 3' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-part-3", "quote": "The ideal is flexibility, a balance of different sentence lengths"}, {"index": 533, "feature": "sentence length variation", "claim": "Le Guin states there are no rules concerning sentence length.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1, Part 5' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-part-5", "quote": "There are no rules concerning sentence length."}, {"index": 534, "feature": "sentence length variation", "claim": "Le Guin's replacement for a sentence-length rule is variety and appropriateness, each sentence's length suited to what it has to say.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1, Part 5' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-part-5", "quote": "I suggest that you try for both variety and appropriateness"}, {"index": 535, "feature": "concrete sensory noun", "claim": "Le Guin prescribes passages that describe what the world looks like, smells like and sounds like as the relief that paces an idea-crammed story.", "source": "Ursula K. Le Guin, 'Navigating the Ocean of Story - Session 1, Part 5' (Book View Cafe, 2015)", "url": "https://www.ursulakleguin.com/bvc-navigating-the-ocean-of-story-session-1-part-5", "quote": "describe what the world looks like, smells like, sounds like"}, {"index": 536, "feature": "cadence and rhythm", "claim": "Le Guin grounds prose rhythm in the body, saying art depends on rhythms and body rhythms are what writers use.", "source": "Ursula K. Le Guin, 'What Makes a Story' (c. 2007), ursulakleguin.com", "url": "https://www.ursulakleguin.com/what-makes-a-story", "quote": "art depends on rhythms, and body rhythms are what writers use"}, {"index": 537, "feature": "cadence and rhythm", "claim": "Le Guin says words are bodily, made with the body and the breath, so the rhythms of words are bodily rhythms.", "source": "Ursula K. Le Guin, 'What Makes a Story' (c. 2007), ursulakleguin.com", "url": "https://www.ursulakleguin.com/what-makes-a-story", "quote": "the rhythms of words are bodily rhythms"}], "verdicts": [{"index": 384, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 388, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 389, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 390, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 391, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 392, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 393, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 395, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 398, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not 