{"name": "dnd", "triage": true, "claims": [{"index": 731, "feature": "place and institution description", "claim": "Justin Alexander rejects replacing borrowed material with generic versions, saying generic lacks identity.", "source": "Justin Alexander, 'Ptolus: Running the Campaign - From Table to Page', The Alexandrian, 2018", "url": "https://thealexandrian.net/wordpress/39322/roleplaying-games/ptolus-running-the-campaign-from-table-to-page", "quote": "“Generic” isn’t good. Generic lacks identity."}, {"index": 734, "feature": "place and institution description", "claim": "Bryce Lynch praises a keying pattern in which each room opens with a short vibe overview before its bulleted details.", "source": "Bryce Lynch, review of 'The Lions of Tell Arn Part 2', tenfootpole.org, 2026", "url": "https://tenfootpole.org/ironspike/?p=10550", "quote": "The rooms start with a kind of vibe overview."}, {"index": 736, "feature": "place and institution description", "claim": "Bryce Lynch's test of a good room description is that it reads as if the writer had lived the room and got the mental image onto paper.", "source": "Bryce Lynch, review of 'The Lions of Tell Arn Part 2', tenfootpole.org, 2026", "url": "https://tenfootpole.org/ironspike/?p=10550", "quote": "someone called up a mental image in their head"}, {"index": 738, "feature": "edition and house style", "claim": "Bryce Lynch praises bolding and italics used sparingly to draw the eye rather than overused.", "source": "Bryce Lynch, review of 'The Lions of Tell Arn Part 2', tenfootpole.org, 2026", "url": "https://tenfootpole.org/ironspike/?p=10550", "quote": "Bolding and italics are used to effect to draw the eye"}, {"index": 739, "feature": "plainness and economy", "claim": "Bryce Lynch praises treasure descriptions that stay terse while being more interesting than a plus-one sword.", "source": "Bryce Lynch, review of 'The Lions of Tell Arn Part 2', tenfootpole.org, 2026", "url": "https://tenfootpole.org/ironspike/?p=10550", "quote": "terse but much more interesting than a Sword, +1"}, {"index": 747, "feature": "adjective and adverb discipline", "claim": "David Hartlage tells writers to keep the evocative details out from under lavish description of pallets and rubbish.", "source": "David Hartlage, 'How much description should a dungeon key include?', DMDavid, 2016", "url": "https://dmdavid.com/tag/how-much-description-should-a-dungeon-key-include/", "quote": "Don’t bury the evocative bits in lavish descriptions"}, {"index": 748, "feature": "concrete sensory noun", "claim": "David Hartlage says descriptions should carry telling details and information he can use in play.", "source": "David Hartlage, 'How much description should a dungeon key include?', DMDavid, 2016", "url": "https://dmdavid.com/tag/how-much-description-should-a-dungeon-key-include/", "quote": "Descriptions should focus on telling details and plot-critical information"}, {"index": 750, "feature": "boxed text form", "claim": "David Hartlage grants that the boxed descriptions in Curse of Strahd are evocative while faulting their use in every empty room.", "source": "David Hartlage, 'How much description should a dungeon key include?', DMDavid, 2016", "url": "https://dmdavid.com/tag/how-much-description-should-a-dungeon-key-include/", "quote": "The descriptions are evocative"}, {"index": 752, "feature": "plainness and economy", "claim": "David Hartlage quotes Michael Curtis describing the Stonehell style as the minimum information needed to run the dungeon.", "source": "Michael Curtis, quoted by David Hartlage, DMDavid, 2016", "url": "https://dmdavid.com/tag/how-much-description-should-a-dungeon-key-include/", "quote": "the minimum amount of information needed to run the dungeon"}, {"index": 765, "feature": "terminology consistency", "claim": "TSR's published Basic Set changed Holmes's manuscript phrase 'one or more assistants' to 'one or more men-at-arms'.", "source": "Zach Howard (Zenopus Archives), 'Part 46', 2015", "url": "https://zenopusarchives.blogspot.com/2015/02/part-46-zenopus-built-tower.html", "quote": "changes \"one or more assistants\" to \"one or more men-at-arms\""}, {"index": 766, "feature": "dm-facing sentence", "claim": "TSR moved a sentence of Holmes's introduction to the end of its paragraph so it sat immediately before the room descriptions.", "source": "Zach Howard (Zenopus Archives), 'Part 46', 2015", "url": "https://zenopusarchives.blogspot.com/2015/02/part-46-zenopus-built-tower.html", "quote": "it places it right before the room descriptions"}, {"index": 767, "feature": "edition and house style", "claim": "Howard reports that TSR made only minor changes to Holmes's sample dungeon between manuscript and published rulebook.", "source": "Zach Howard (Zenopus Archives), 'Part 46', 2015", "url": "https://zenopusarchives.blogspot.com/2015/02/part-46-zenopus-built-tower.html", "quote": "only minor changes by TSR in the published version"}, {"index": 769, "feature": "boxed text form", "claim": "In the 1982 Lost Caverns of Tsojcanth the dungeon areas carry boxed text while the wilderness areas do not.", "source": "Delta (Daniel R. Collins), 'Early Evolution of Encounter Text', 2021", "url": "https://deltasdnd.blogspot.com/2021/10/early-evolution-of-encounter-text.html", "quote": "while the dungeon areas use boxed text, the wilderness does not"}, {"index": 779, "feature": "boxed text form", "claim": "Delta says boxing his own sensory lead-in would imply reading it verbatim, which he calls a bad idea for a volatile situation.", "source": "Delta (Daniel R. Collins), comment reply on 'Early Evolution of Encounter Text', 2021", "url": "https://deltasdnd.blogspot.com/2021/10/early-evolution-of-encounter-text.html", "quote": "that seems to imply the need to read it verbatim"}, {"index": 780, "feature": "boxed text form", "claim": "A reader argues boxed text is linear and assumes the characters approach a room from one specific direction.", "source": "Warren D., reader comment on Delta's D&D Hotspot, 2021", "url": "https://deltasdnd.blogspot.com/2021/10/early-evolution-of-encounter-text.html", "quote": "because it is linear, it often assumes PCs are approaching the room"}, {"index": 792, "feature": "place and institution description", "claim": "Appelcline calls the Village of Hommlet Greyhawk's first described locale that was not just a dungeon or adventuring point.", "source": "Shannon Appelcline, 'Designers & Dragons: The Column #24', RPGnet, 2013", "url": "https://www.rpg.net/columns/designers-and-dragons/designers-and-dragons24.phtml", "quote": "first described locale that wasn't just some dungeon or adventuring point"}, {"index": 793, "feature": "edition and house style", "claim": "Appelcline says the TSR UK Saltmarsh adventures differ markedly from the staid dungeon crawls US authors were then writing.", "source": "Shannon Appelcline, 'Designers & Dragons: The Column #24', RPGnet, 2013", "url": "https://www.rpg.net/columns/designers-and-dragons/designers-and-dragons24.phtml", "quote": "how much they differ from the staid dungeon crawls then being"}, {"index": 797, "feature": "edition and house style", "claim": "Merwin judges the way The Village of Hommlet hands over its hook and opening not very exciting or particularly nutritious.", "source": "Shawn Merwin, 'Let's Design an Adventure: Adventure Hooks and Opening Scenes', D&D Beyond, 2019", "url": "https://www.dndbeyond.com/posts/624-lets-design-an-adventure-adventure-hooks-and", "quote": "It’s not very exciting or particularly nutritious"}, {"index": 798, "feature": "boxed text form", "claim": "Merwin says an encounter's opening information is probably delivered in the form of boxed text.", "source": "Shawn Merwin, 'Let's Design an Adventure: Encounter Basics', D&D Beyond, 2019", "url": "https://www.dndbeyond.com/posts/626-lets-design-an-adventure-encounter-basics", "quote": "probably in the form of boxed text or some other vehicle"}, {"index": 799, "feature": "withheld information and inference", "claim": "Merwin locates drama in the dissonance between what characters know entering an encounter and what they learn inside it.", "source": "Shawn Merwin, 'Let's Design an Adventure: Encounter Basics', D&D Beyond, 2019", "url": "https://www.dndbeyond.com/posts/626-lets-design-an-adventure-encounter-basics", "quote": "There is drama and tension in the dissonance between the information"}, {"index": 804, "feature": "terminology consistency", "claim": "Peterson notes Arneson still wrote armour class values in Roman numerals in his 1977 tournament documents.", "source": "Jon Peterson, 'Dave Arneson's Origins 1977 Tournament', Playing at the World, 2020", "url": "https://playingattheworld.blogspot.com/2020/04/dave-arnesons-origins-1977-tournament.html", "quote": "Arneson still wrote armor class values with Roman numerals"}, {"index": 819, "feature": "withheld information and inference", "claim": "A D&D Beyond article credits Carl Sargent with implying terrifying things through a few carefully chosen words in Iuz the Evil.", "source": "John Roy, 'Greyhawk Returns in the 2024 Dungeon Master's Guide', D&D Beyond, 2024", "url": "https://www.dndbeyond.com/posts/1834-greyhawk-returns-in-the-2024-dungeon-masters-guide", "quote": "implying terrifying things with a few carefully chosen words"}, {"index": 822, "feature": "place and institution description", "claim": "The 2024 Dungeon Master's Guide gazetteer highlights dozens of locations across the Flanaess.", "source": "John Roy, 'Greyhawk Returns in the 2024 Dungeon Master's Guide', D&D Beyond, 2024", "url": "https://www.dndbeyond.com/posts/1834-greyhawk-returns-in-the-2024-dungeon-masters-guide", "quote": "highlights dozens of locations across the Flanaess"}, {"index": 823, "feature": "dm-facing sentence", "claim": "The article tells DMs to emphasise in their descriptions that Oerth is a world much like our own late Middle Ages.", "source": "John Roy, 'Greyhawk Returns in the 2024 Dungeon Master's Guide', D&D Beyond, 2024", "url": "https://www.dndbeyond.com/posts/1834-greyhawk-returns-in-the-2024-dungeon-masters-guide", "quote": "emphasize that this is a world much like our own"}, {"index": 824, "feature": "place and institution description", "claim": "A reviewer says the 2024 DMG's Greyhawk material serves as a prime example of what a setting can look like.", "source": "brimmels, 'In-Depth Review of the 2024 Dungeon Master's Guide', EN World, 2024", "url": "https://www.enworld.org/threads/in-depth-review-of-the-2024-dungeon-masters-guide.707861/", "quote": "it's a prime example of what a setting can look like"}, {"index": 837, "feature": "omission as information", "claim": "The reviewer reads the Kobold Guide as telling setting designers they need not create all the details necessary for play.", "source": "Gnome Stew review of the Kobold Guide to Worldbuilding", "url": "https://gnomestew.com/review-the-kobold-guide-to-plots-and-campaigns-and-the-kobold-guide-to-worldbuilding/", "quote": "we don’t have to create all of the details necessary"}, {"index": 838, "feature": "omission as information", "claim": "The reviewer says the book advises leaving the finer mechanics to the GMs and players who pick up the work.", "source": "Gnome Stew review of the Kobold Guide to Worldbuilding", "url": "https://gnomestew.com/review-the-kobold-guide-to-plots-and-campaigns-and-the-kobold-guide-to-worldbuilding/", "quote": "it is better to leave the finer mechanics to the GMs and players"}, {"index": 841, "feature": "point of view and distance", "claim": "Mizer holds that a cosmographer is not so much a worldbuilder as a world-hopper.", "source": "Nicholas J. Mizer, 'The Role of the Cosmographer', International Journal of Role-playing 18, 2025", "url": "https://journals.uu.se/IJRP/article/download/1197/1052/4802", "quote": "so much a worldbuilder as a world-hopper"}, {"index": 863, "feature": "point of view and distance", "claim": "Dyson faults boxed text for predicting the future for the party instead of leaving that to the players.", "source": "Dyson Logos, 'The Dreaded Boxed Text', Dyson's Dodecahedron, 2013", "url": "https://dysonlogos.blog/2013/09/29/the-dreaded-boxed-text/", "quote": "it predicts the future for the party"}, {"index": 864, "feature": "boxed text form", "claim": "Dyson urges writers to replace boxed text with a point-form list of things seen in the room.", "source": "Dyson Logos, 'The Dreaded Boxed Text', Dyson's Dodecahedron, 2013", "url": "https://dysonlogos.blog/2013/09/29/the-dreaded-boxed-text/", "quote": "replace it with a point-form list of things seen in the room"}], "verdicts": [{"index": 731, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 734, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 736, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 738, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 739, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 747, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 748, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified independent sources; not verified this round"}, {"index": 750, "verdict": "SKIPPED_TRIAGE", "trueWording": "", "note": "S-BOUND: the feature already has three or more verified