    <script src="/Bundels/scripts?v=I-idw280gzqPdeIsVjp7TF7EarYWaci7Ab_8bqzkwos1"></script>

    
    <script src="/Lib/plugins/parsleyjs/parsley.min.js"></script>
    <script src="/Lib/plugins/jQueryConfirm/jquery-confirm.min.js"></script>
    <script src="/Lib/plugins/jQueryConfirm/jcFunctions.js"></script>
    <script>
        $(document).ready(function () {
            $('#btnRefreshCaptcha').on('click', function (e) {
                e.preventDefault();
                $('#imgLoginCaptcha').removeAttr('src');
                $('#imgLoginCaptcha').removeAttr('value');

                $('#imgLoginCaptcha').attr('src', '/Captcha/GetCaptchaImage?' + new Date().getTime());
                $('#imgLoginCaptcha').attr('value', '');
            });

            $('#btnSave').on('click', function (e) {
                e.preventDefault();
                var frm = $('#frm');
                var frmParsley = frm.parsley();
                frmParsley.validate();
                if (!frm.parsley().isValid()) {
                    return false;
                }
                var btn = $(this);
                if (btn.hasClass('disabled')) {
                    return false;
                }
                btn.text('Processing.....');
                btn.attr('disabled', true);
                btn.addClass('disabled');
                $.ajax({
                    method: 'POST',
                    url: $('#hdfBaseUrl').val() + 'Publication/Save_EjournalDownload',
                    data: frm.serialize() 
                }).done(function (data) {
                    if (data['c'] == 'success') {
                        SuccessMessageCallBack(data['m'], function () {
                            btn.text('Save');
                            btn.removeAttr('disabled');
                            btn.removeClass('disabled');
                            window.location.href = $('#hdfBaseUrl').val() + 'Publication/PaymentRequest?Id=' + data['Id']
                        });
                    } else if (data['c'] == 'sessionexpired') {
                        ErrorMessage(data['m']);
                        btn.text('Save');
                        btn.removeAttr('disabled');
                        btn.removeClass('disabled');
                    } else if (data['c'] == 'servererror') {
                        ErrorMessage(data['m']);
                        btn.text('Save');
                        btn.removeAttr('disabled');
                        btn.removeClass('disabled');
                    }
                }).error(function () {
                    ErrorMessage('Processing error. Kindly refresh page and try again!');
                    btn.text('Save');
                    btn.removeAttr('disabled');
                    btn.removeClass('disabled');
                });
            });
        });
    </script>

