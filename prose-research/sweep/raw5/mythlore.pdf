<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>403 Error</title>
<style>
  :root {
    --dc-blue: #174e9f;
    --ink: #2c3239;
    --muted: #5f6a76;
    --rule: #c8d4e6;
    --condensed: "Roboto Condensed", "Arial Narrow", Arial, Helvetica, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2.5rem 1.25rem 4rem;
    background: #ffffff;
    color: var(--ink);
    font-family: var(--condensed);
    -webkit-font-smoothing: antialiased;
  }
  /* Artwork sits behind the message. 'contain' scales the whole image to fit
     the box, so it is never cropped at any zoom level or viewport size. If the
     image is unavailable the box simply renders without it. */
  .hero {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 0 3rem;
    background-image: url("data:image/jpeg;base64,");
    background-repeat: no-repeat;
    background-position: center center;
    background-size: contain;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  h1, .message, .details { position: relative; z-index: 1; }
  h1 {
    font-weight: bold;
    font-size: calc(32px + .875vw);
    line-height: 1em;
    color: var(--dc-blue);
    width: 94%;
    margin: 0 auto .75em;
  }
  .message {
    font-weight: bold;
    font-size: calc(14px + .385vw);
    line-height: 1.45;
    color: var(--dc-blue);
    width: 94%;
    margin: 0 auto;
  }
  a { color: var(--dc-blue); text-underline-offset: 2px; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--dc-blue); outline-offset: 3px; }

  /* Solid panel so the Ray ID stays legible over the artwork. */
  .details {
    width: 94%;
    margin: 1.75rem auto 0;
    text-align: left;
    background: #ffffff;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--dc-blue);
    padding: 1.25rem 1.5rem;
  }
  .details h2 {
    font-size: 1rem;
    font-weight: bold;
    color: var(--muted);
    margin: 0 0 .85rem;
  }
  .ray {
    font: bold clamp(1.25rem, 4.5vw, 1.6rem)/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--ink);
    word-break: break-all;
    user-select: all;
    margin: 0 0 .75rem;
  }
  button {
    margin-top: 1.25rem;
    font-family: var(--condensed);
    font-size: .95rem;
    font-weight: bold;
    color: var(--dc-blue);
    background: #ffffff;
    border: 1px solid var(--rule);
    padding: .4rem .85rem;
    cursor: pointer;
  }
  button:hover { border-color: var(--dc-blue); }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: .5rem 1.5rem;
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: .95rem;
  }
  dt { color: var(--muted); }
  dd {
    margin: 0;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    word-break: break-all;
  }
</style>
</head>
<body>
<div class="hero">
  <h1>This request was blocked.</h1>

  <p class="message">Our security filters stopped this request before it reached the site. Please try refreshing the page. If this error persists, please note the details of the error and report it to a Digital Commons Consulting Services representative at <a href="/cdn-cgi/l/email-protection#7014135d030500001f020430151c0315061915025e131f1d"><span class="__cf_email__" data-cfemail="34505719474144445b46407451584751425d51461a575b59">[email&#160;protected]</span></a></p>

  <div class="details">
    <h2>Details to include in your report</h2>
    <p class="ray" id="ray">a36c9433f86b31bb</p>
    <dl>
      <dt>Page requested</dt>
      <dd id="uri">Not available</dd>
      <dt>Your IP address</dt>
      <dd>98.204.52.68</dd>
    </dl>
    <button type="button" id="copy" data-label="Copy details">Copy details</button>
  </div>
</div>

<script data-cfasync="false"></script><script>
(function () {
  var ray = document.getElementById('ray');
  var uri = document.getElementById('uri');
  var btn = document.getElementById('copy');

  // textContent, never innerHTML: the URL is visitor-controlled input.
  if (uri) {
    var href = window.location.href;
    uri.textContent = href.length > 300 ? href.slice(0, 300) + '\u2026' : href;
  }

  if (!btn || !ray || !navigator.clipboard) {
    if (btn) { btn.hidden = true; }
    return;
  }

  btn.addEventListener('click', function () {
    var lines = ['Ray ID: ' + ray.textContent.trim()];
    var terms = document.querySelectorAll('.details dl dt');
    var defs = document.querySelectorAll('.details dl dd');
    for (var i = 0; i < terms.length; i++) {
      lines.push(terms[i].textContent.trim() + ': ' + defs[i].textContent.trim());
    }
    navigator.clipboard.writeText(lines.join('\n')).then(function () {
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = btn.dataset.label; }, 2000);
    });
  });
})();
</script>
<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a36c9433f86b31bb',t:'MTc4ODY4ODMyNQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>
</html>

