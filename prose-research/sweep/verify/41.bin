<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox writer &lt;!-- for more information see [[:Template:Infobox writer/doc]] -->\n","href":"./Template:Infobox_writer"},"params":{"name":{"wt":"Gene Wolfe"},"image":{"wt":"Gene Wolfe, 2005.png"},"image_size":{"wt":""},"caption":{"wt":"Wolfe at the 2005 [[Nebula Award]]s"},"pen_name":{"wt":""},"birth_name":{"wt":"Gene Rodman Wolfe"},"birth_date":{"wt":"{{Birth date|1931|5|7|mf=y}}"},"birth_place":{"wt":"[[New York City]], U.S."},"death_date":{"wt":"{{Death date and age|2019|4|14|1931|5|7|mf=y}}"},"death_place":{"wt":"[[Peoria, Illinois|Peoria]], [[Illinois]], U.S."},"occupation":{"wt":"Novelist, short story writer"},"period":{"wt":"{{circa|1966}} – 2019"},"genre":{"wt":"{{hlist|[[Fantasy literature|Fantasy]]|[[science fiction]]}}"},"notable_works":{"wt":"{{ubl|&apos;&apos;[[The Book of the New Sun]]&apos;&apos;|&apos;&apos;Solar Cycle&apos;&apos;&lt;ref name=\"isfdb-cycle\" />|&apos;&apos;[[Soldier of Sidon]]&apos;&apos;}}"},"education":{"wt":"{{ubl|[[Texas A&amp;M University]]|[[University of Houston]]}}"},"spouse":{"wt":"{{marriage|Rosemary Wolfe|1952|2013|reason=d}}"},"awards":{"wt":"[[Gene Wolfe#Awards|&apos;&apos;See subsection&apos;&apos;]]"},"subject":{"wt":""},"movement":{"wt":""},"signature":{"wt":""},"website":{"wt":""}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox biography vcard" about="#mwt4"><tbody><tr><th colspan="2" class="infobox-above"><div class="fn">Gene Wolfe</div></th></tr><tr><td colspan="2" class="infobox-image"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:Gene_Wolfe,_2005.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Gene_Wolfe,_2005.png" src="//upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Gene_Wolfe%2C_2005.png/250px-Gene_Wolfe%2C_2005.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/d/d6/Gene_Wolfe%2C_2005.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="287" data-file-height="383" data-file-type="bitmap" height="334" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><div class="infobox-caption">Wolfe at the 2005 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nebula_Award" title="Nebula Award">Nebula Awards</a></div></td></tr><tr><th scope="row" class="infobox-label">Born</th><td class="infobox-data"><div style="display:inline" class="nickname">Gene Rodman Wolfe</div><br/><span style="display:none">(<span class="bday">1931-05-07</span>)</span>May 7, 1931<br/><div style="display:inline" class="birthplace"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/New_York_City" title="New York City">New York City</a>, U.S.</div><span style="display:none" data-plural="1"></span></td></tr><tr><th scope="row" class="infobox-label">Died</th><td class="infobox-data">April 14, 2019<span style="display:none">(2019-04-14)</span> (aged<span typeof="mw:Entity"> </span>87)<br/><div style="display:inline" class="deathplace"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Peoria,_Illinois" title="Peoria, Illinois">Peoria</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Illinois" title="Illinois">Illinois</a>, U.S.</div><span style="display:none" data-plural="1"></span></td></tr><tr><th scope="row" class="infobox-label">Education</th><td class="infobox-data"><span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style></span><div class="plainlist"><ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Texas_A&amp;M_University" title="Texas A&amp;M University">Texas A&amp;M University</a></li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/University_of_Houston" title="University of Houston">University of Houston</a></li></ul></div></td></tr><tr><th scope="row" class="infobox-label">Occupations</th><td class="infobox-data role">Novelist, short story writer</td></tr><tr><th scope="row" class="infobox-label">Spouse</th><td class="infobox-data"><span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r1298804929" typeof="mw:Extension/templatestyles" about="#mwt7" data-mw='{"name":"templatestyles","attrs":{"src":"Template:Marriage/styles.css"}}'>.mw-parser-output .marriage-line-margin2px{line-height:0;margin-bottom:-2px}.mw-parser-output .marriage-line-margin3px{line-height:0;margin-bottom:-3px}.mw-parser-output .marriage-display-inline{display:inline}</style></span>

