<td id="mwAac">1981 Nebula Award<sup about="#mwt163" class="mw-ref reference" id="cite_ref-worldswithoutend1981_46-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"worldswithoutend1981"}}'><a href="#cite_note-worldswithoutend1981-46" id="mwAag"><span class="mw-reflink-text" id="mwAak"><span class="cite-bracket" id="mwAao">[</span>43<span class="cite-bracket" id="mwAas">]</span></span></a></sup></td></tr>
<tr id="mwAaw">
<td id="mwAa0">1982 Locus Award</td></tr>
<tr id="mwAa4">
<td rowspan="2" style="vertical-align: top;" id="mwAa8"><i id="mwAbA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Sword_of_the_Lictor" title="The Sword of the Lictor" id="mwAbE">The Sword of the Lictor</a></i></td>
<td rowspan="2" style="vertical-align: top;" id="mwAbI">Novel</td>
<td id="mwAbM">1983 Locus Award<sup about="#mwt166" class="mw-ref reference" id="cite_ref-worldswithoutend1983_47-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"worldswithoutend1983"},"body":{"id":"mw-reference-text-cite_note-worldswithoutend1983-47"}}'><a href="#cite_note-worldswithoutend1983-47" id="mwAbQ"><span class="mw-reflink-text" id="mwAbU"><span class="cite-bracket" id="mwAbY">[</span>44<span class="cite-bracket" id="mwAbc">]</span></span></a></sup></td></tr>
<tr id="mwAbg">
<td id="mwAbk">1983 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/British_Fantasy_Award_for_Best_Novel" title="British Fantasy Award for Best Novel" id="mwAbo">August Derleth Award</a></td></tr>
<tr id="mwAbs">
<td id="mwAbw"><i id="mwAb0">The Citadel of the Autarch</i></td><td id="mwAb4">Novel</td><td id="mwAb8">1984 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/John_W._Campbell_Memorial_Award_for_Best_Science_Fiction_Novel" title="John W. Campbell Memorial Award for Best Science Fiction Novel" id="mwAcA">Campbell Award</a><sup about="#mwt169" class="mw-ref reference" id="cite_ref-worldswithoutend1984_48-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"worldswithoutend1984"},"body":{"id":"mw-reference-text-cite_note-worldswithoutend1984-48"}}'><a href="#cite_note-worldswithoutend1984-48" id="mwAcE"><span class="mw-reflink-text" id="mwAcI"><span class="cite-bracket" id="mwAcM">[</span>45<span class="cite-bracket" id="mwAcQ">]</span></span></a></sup></td></tr>
