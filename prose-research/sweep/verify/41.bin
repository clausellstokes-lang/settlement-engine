<tr id="mwAZw">
<td id="mwAZ0">1981 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Fantasy_Award" title="World Fantasy Award" id="mwAZ4">World Fantasy Award</a><sup about="#mwt162" class="mw-ref reference" id="cite_ref-worldswithoutend1981_46-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"worldswithoutend1981"}}'><a href="#cite_note-worldswithoutend1981-46" id="mwAZ8"><span class="mw-reflink-text" id="mwAaA"><span class="cite-bracket" id="mwAaE">[</span>43<span class="cite-bracket" id="mwAaI">]</span></span></a></sup></td></tr>
<tr id="mwAaM">
<td rowspan="2" style="vertical-align: top;" id="mwAaQ"><i id="mwAaU">The Claw of the Conciliator</i></td>
