<li id="mwAms"><i id="mwAmw">Caldé of the Long Sun</i> (1994) Nebula nominee, 1996<sup about="#mwt219" class="mw-ref reference" id="cite_ref-61" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-61"}}'><a href="#cite_note-61" id="mwAm0"><span class="mw-reflink-text" id="mwAm4"><span class="cite-bracket" id="mwAm8">[</span>58<span class="cite-bracket" id="mwAnA">]</span></span></a></sup></li>
<li id="mwAnE"><i id="mwAnI">Exodus From the Long Sun</i> (1996)</li></ul></li>
