essage_text\":\"\",\"homepage_message_link\":\"\",\"about_us_author_ids\":\"\",\"archived_section_ids\":\"\",\"column_section_ids\":\"\",\"fp_primary_column_section_ids\":\"\",\"event_section_ids\":\"\",\"podcasts_metadata\":\"\",\"video_section_ids\":\"\",\"post_metering_enabled\":false,\"account_based_post_metering_enabled\":false,\"use_custom_theme\":false,\"reply_rules\":null,\"automatic_moderation_enabled\":true,\"auto_translate_enabled\":true,\"additional_post_languages_enabled\":false,\"high_res_recording_beta\":false},\"publicationUserSettings\":null,\"userSettings\":{\"user_id\":null,\"activity_likes_enabled\":true,\"dashboard_nav_refresh_enabled\":false,\"is_guest_post_enabled\":true,\"invite_friends_nux_dismissed_at\":null,\"suggestions_feed_item_last_shown_at\":null,\"last_notification_alert_shown_at\":null,\"disable_reply_hiding\":false,\"newest_seen_chat_item_published_at\":null,\"explicitContentEnabled\":false,\"contactMatchingEnabled\":false,\"messageRequestLevel\":\"everyone\",\"liveStreamAcceptableInviteLevel\":\"everyone\",\"liveStreamAcceptableChatLevel\":\"everyone\",\"creditTokensTreatmentExposed\":false,\"appBadgeIncludesChat\":false,\"autoPlayVideo\":true,\"autoAdvanceVideo\":true,\"smart_delivery_enabled\":false,\"chatbotTermsLastAcceptedAt\":null,\"has_seen_notes_post_app_upsell\":false,\"first_note_id\":null,\"show_concurrent_live_stream_viewers\":false,\"edit_profile_feed_item_dismissed_at\":null,\"mobile_permalink_app_upsell_seen_at\":null,\"new_user_checklist_enabled\":false,\"has_seen_youtube_shorts_auto_publish_announcement\":false,\"has_seen_publish_youtube_connect_upsell\":false,\"notificationQualityFilterEnabled\":true,\"hasSeenOnboardingNewslettersScreen\":false,\"bestsellerBadgeEnabled\":true,\"hasSelfIdentifiedAsCreator\":false,\"autoTranslateEnabled\":true,\"autoTranslateBlocklist\":[],\"fineTuneFeedItemSeenAt\":null,\"fineTuneFeedItemDismissedAt\":null,\"aiGeneratedTextMode\":\"show\",\"feedVideoPreference\":5,\"feedAudioPreference\":5,\"feedLongerPostsPreference\":5,\"feedChatPreference\":5},\"mux_env_key\":\"u42pci814i6011qg3segrcpp9\",\"persona_environment_id\":\"env_o1Lbk4JhpY4PmvNkwaBdYwe5Fzkt\",\"sentry_environment\":\"production\",\"launchWelcomePage\":false,\"pendingInviteForActiveLiveStream\":null,\"isEligibleForLiveStreamCreation\":true,\"webviewPlatform\":null,\"noIndex\":false,\"post\":{\"audience\":\"everyone\",\"audience_before_archived\":null,\"canonical_url\":\"https://donbeck1.substack.com/p/structure-of-the-new-sun\",\"default_comment_sort\":null,\"editor_v2\":false,\"exempt_from_archive_paywall\":false,\"free_unlock_required\":false,\"id\":165087166,\"podcast_art_url\":null,\"podcast_duration\":null,\"podcast_preview_upload_id\":null,\"podcast_upload_id\":null,\"podcast_url\":null,\"post_date\":\"2025-06-03T11:54:50.979Z\",\"updated_at\":\"2025-09-10T04:15:33.081Z\",\"publication_id\":4470358,\"search_engine_description\":null,\"search_engine_title\":null,\"section_id\":null,\"should_send_free_preview\":false,\"show_guest_bios\":true,\"slug\":\"structure-of-the-new-sun\",\"social_title\":null,\"subtitle\":\"How Gene Wolfe's sci-fi masterpiece ignores plotting advice--thank goodness\",\"teaser_post_eligible\":true,\"title\":\"Structure of the New Sun\",\"type\":\"newsletter\",\"video_upload_id\":null,\"write_comment_permissions\":\"everyone\",\"meter_type\":\"none\",\"live_stream_id\":null,\"is_published\":true,\"restacks\":3,\"reactions\":{\"\u2764\":22},\"top_exclusions\":[],\"pins\":[],\"section_pins\":[],\"has_shareable_clips\":false,\"previous_post_slug\":\"your-next-read-the-book-of-the-new\",\"next_post_slug\":\"sloths-in-suits-animal-stories-for\",\"cover_image\":\"https://substackcdn.com/image/fetch/$s_!O2y0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg\",\"cover_image_is_square\":false,\"cover_image_is_explicit\":false,\"videoUpload\":null,\"podcastFields\":{\"post_id\":165087166,\"podcast_episode_number\":null,\"podcast_season_number\":null,\"podcast_episode_type\":null,\"should_syndicate_to_other_feed\":null,\"syndicate_to_section_id\":null,\"hide_from_feed\":false,\"free_podcast_url\":null,\"free_podcast_duration\":null,\"preview_contains_ad\":false,\"was_imported_self_serve_sync\":false,\"draft_free_podcast_url\":null,\"draft_free_podcast_duration\":null},\"podcastUpload\":null,\"podcastPreviewUpload\":null,\"voiceover_upload_id\":null,\"voiceoverUpload\":null,\"has_voiceover\":false,\"description\":\"How Gene Wolfe's sci-fi masterpiece ignores plotting advice. Thank goodness\",\"body_html\":\"<p>In <a href=\\\"https://open.substack.com/pub/donbeck1/p/your-next-read-the-book-of-the-new?r=1sx4ig&amp;utm_campaign=post&amp;utm_medium=web&amp;showWelcomeOnShare=true\\\">my last post</a>, I recommended Gene Wolfe\u2019s <em>Book of the New Sun</em>, boldly calling it life-changing.</p><p>There are countless reasons for this\u2014more than I could do justice to without extensive research and time. Honestly, I\u2019m not interested in that right now, not so soon after finishing Wolfe\u2019s masterpiece. I\u2019m still basking in its glow, still processing the thoughts and emotions it stirred. Like falling in love, some things should be felt before they\u2019re dissected.</p><p>And yet\u2014here I am, dissecting it. At least in one respect: structure.</p><p>Much has been said about Wolfe\u2019s Melvillean prose, his science-fantasy world, the character of Severian, his symbolism, his themes. All of it matters. But the aspect that struck me most as a reader (and excites me most as a writer) is the novel\u2019s narrative flow.</p><div class=\\\"subscription-widget-wrap-editor\\\" data-attrs=\\\"{&quot;url&quot;:&quot;https://donbeck1.substack.com/subscribe?&quot;,&quot;text&quot;:&quot;Subscribe&quot;,&quot;language&quot;:&quot;en&quot;}\\\" data-component-name=\\\"SubscribeWidgetToDOM\\\"><div class=\\\"subscription-widget show-subscribe\\\"><div class=\\\"preamble\\\"><p class=\\\"cta-caption\\\">Thanks for reading The Reading Room! Subscribe for free to receive new posts and support my work.</p></div><form class=\\\"subscription-widget-subscribe\\\"><input type=\\\"email\\\" class=\\\"email-input\\\" name=\\\"email\\\" placeholder=\\\"Type your email\u2026\\\" tabindex=\\\"-1\\\"><input type=\\\"submit\\\" class=\\\"button primary\\\" value=\\\"Subscribe\\\"><div class=\\\"fake-input-wrapper\\\"><div class=\\\"fake-input\\\"></div><div class=\\\"fake-button\\\"></div></div></form></div></div><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!O2y0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!O2y0!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 424w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 848w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!O2y0!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg\\\" width=\\\"1456\\\" height=\\\"757\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/f8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:757,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:null,&quot;alt&quot;:&quot;Acclaimed sci-fi author Gene Wolfe has passed away at the age of 87 ...&quot;,&quot;title&quot;:null,&quot;type&quot;:null,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:true,&quot;internalRedirect&quot;:null,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"Acclaimed sci-fi author Gene Wolfe has passed away at the age of 87 ...\\\" title=\\\"Acclaimed sci-fi author Gene Wolfe has passed away at the age of 87 ...\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!O2y0!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 424w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 848w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!O2y0!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Ff8296b37-1927-4100-81a3-7ea70bbaca45_2040x1061.jpeg 1456w\\\" sizes=\\\"100vw\\\" fetchpriority=\\\"high\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div><h3>New Sun\u2019s Structure</h3><p>At its core, a novel\u2019s \u201Cstructure\u201D is simply the order in which plot events are told\u2014the blueprint that guides readers through the story. Writers are often taught that this part of storytelling is practically scientific: follow the formula, hit the beats, satisfy the reader. A quote from the publishing website <a href=\\\"https://blog.reedsy.com/guide/story-structure/\\\">Reedsy</a> sums it up:</p><blockquote><p>\u201C\u201CWhile stories can be told in a wide variety of ways, most Western story structures commonly share certain elements: exposition, rising action, climax, falling action, and resolution.</p><p>A tightly controlled structure will answer a reader's questions, provide a climax followed by resolution and information at the end of the story, further the characters\u2019 development, and unravel any central conflicts. In other words, it's responsible for a satisfying narrative experience that accomplishes the author\u2019s aims.</p><p>Writing is an art, but if there\u2019s one part of the craft that\u2019s closer to science, this would be it.\u201D</p></blockquote><p>Gene Wolfe seems unconcerned with such guidelines. He bends the rules of structure until they nearly snap. And yet the result works beautifully. That may be a bit dramatic\u2014I see the key elements (rising action, climax, etc.),  but not in the usual places, and not in the usual ways.</p><h3>Steps on the Path</h3><p><em>New Sun</em>\u2019s structure is both tight and loose. </p><p>Severian\u2019s journey from apprentice to ruler unfolds episodically, with each event forming a small arc: a beginning, middle, and end. Some episodes span a single chapter; others stretch across several. Often the pattern is: \u201CSeverian stumbles into X, does Y, and ends up Z.\u201D  For example, at the start of the novel:</p><ul><li><p>He stumbles upon the rebel Vodalus, protects him, and receives a gift that binds him to the rebellion.</p></li><li><p>He finds a dying dog, nurses it back to health, allowing it to find freedom.</p></li><li><p>He\u2019s promoted in his guild, participates in the Saint Katherine rite, and asserts authority over his peers.</p></li></ul><p>Each episode basically stands on its own. In fact, if <em>Book of the New Sun</em> were a TV series, these could be self-contained installments\u2014complete with the occasional \u201CTo Be Continued.\u201D (Let\u2019s pray no one ever tries to make this a show, though: I shudder to imagine how Amazon or Netflix would would butcher it.)</p><p>But is <em>New Sun</em> just a loosely strung series of vignettes? Not quite. It\u2019s much more than a collection of stories featuring the same protagonist. I see Wolfe using three key techniques to tie the novel into a unified, deeply satisfying whole.</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!Vf-U!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!Vf-U!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 424w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 848w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!Vf-U!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg\\\" width=\\\"736\\\" height=\\\"1312\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/e0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1312,&quot;width&quot;:736,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:166174,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://donbeck1.substack.com/i/165087166?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!Vf-U!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 424w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 848w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!Vf-U!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fe0b4b60b-59cc-4ffb-baf2-c78c837eee38_736x1312.jpeg 1456w\\\" sizes=\\\"100vw\\\" loading=\\\"lazy\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div><h3>Three Techniques</h3><p>First, there\u2019s the narrative hook of Severian\u2019s destiny. From the outset, he tells us he\u2019ll \u201Cback into the throne,\u201D eventually becoming the Autarch. This isn\u2019t a spoiler\u2014it\u2019s a source of dramatic tension. We\u2019re invited to wonder <em>how</em> this disgraced torturer\u2019s apprentice could possibly rise to rule Urth. Telling us the end, giving readers crucial information about the conclusion, keeps us turning pages, wondering how and when it will happen.  </p><p>Second, there\u2019s the voice and character of Severian himself. To be honest, I found him emotionally flat\u2014detached, clinical, and morally inconsistent. But that fits. He\u2019s a man raised to torture, clinically trained to suppress empathy. He treats women as objects, acts impulsively, and yet, crucially, he's not evil. In fact, he\u2019s frequently kind, honest, and surprisingly often he\u2019s self-sacrificing. Severian is a good man raised wrong, surviving in a fallen world. </p><p>Watching him progress, following his change, is part of what makes the novel so compelling. Wolfe doesn\u2019t foreground this transformation as most novelists do, but the signposts are there: Severian not only falls in love but in the end devotes himself to one woman; he becomes an adoptive father; once ruler, he vows to reform (or possibly abolish) the very Guild that shaped him. Even his religious awakening, focusing on death and rebirth (through the Claw and the alzebo) builds quietly until it culminates in a beautiful revelation on the beach:</p><blockquote><p>What struck me on the beach\u2013and it struck me indeed, so that I staggered as at a blow\u2013was that if the Eternal Principle had rested in that curved thorn I had carried about my neck across so many leagues, and if it now rested in the new thorn (perhaps the same thorn) I had only now put there, then it might rest in everything, in every thorn in every bush, in every drop of water in the sea. The thorn was a sacred Claw because all thorns were sacred Claws; the sand in my boots was sacred sand because it came from a beach of sacred sand... Everything was a relic. All the world was a relic. I drew off my boots, that had traveled with me so far, and threw them into the waves that I might not walk shod on holy ground.</p></blockquote><p>Finally, there\u2019s Wolfe\u2019s use of what I\u2019ll call <em>recursion</em>. Events echo across the narrative like memories resurfacing again and again. A dog from childhood reappears in thought hundreds of pages later. Names, objects, and moments are revisited, over and over, deepening their meaning each time. This not only unifies the structure, keeping the events from spinning from the overarching narrative, but it reflects Severian\u2019s mind: he remembers <em>everything</em>, and everything gains weight through memory. Stories within stories, plays within plays\u2014all follow the same small-scale structure of event and remembrance, creating a fractal pattern that mirrors the whole.</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!izLt!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!izLt!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 424w, https://substackcdn.com/image/fetch/$s_!izLt!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 848w, https://substackcdn.com/image/fetch/$s_!izLt!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!izLt!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!izLt!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg\\\" width=\\\"1456\\\" height=\\\"815\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:815,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:null,&quot;alt&quot;:&quot;A Book of the New Sun wallpaper. : r/genewolfe&quot;,&quot;title&quot;:null,&quot;type&quot;:null,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:null,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"A Book of the New Sun wallpaper. : r/genewolfe\\\" title=\\\"A Book of the New Sun wallpaper. : r/genewolfe\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!izLt!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 424w, https://substackcdn.com/image/fetch/$s_!izLt!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 848w, https://substackcdn.com/image/fetch/$s_!izLt!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!izLt!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef83315-832b-4c71-80be-4253a8fd9123_1456x815.jpeg 1456w\\\" sizes=\\\"100vw\\\" loading=\\\"lazy\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div><h3>Final Thoughts</h3><p>For we readers, Wolfe\u2019s inventiveness creates a layered, immersive, highly satisfying experience. </p><p>For writers, Wolfe offers a powerful lesson: structure doesn\u2019t have to follow a \u201CSave the Cat\u201D formula to satisfy. It just has to fit the soul of the story. In <em>Book of the New Sun</em>, that soul is mysterious, digressive, recursive, and strange\u2014but all the more powerful because of it.</p><div><hr></div><p><em>Thanks for visiting The Reading Room! I\u2019d love to hear your thoughts, as I\u2019m enjoying grappling with Wolfe\u2014and will be for a long, long time.</em></p><div class=\\\"subscription-widget-wrap-editor\\\" data-attrs=\\\"{&quot;url&quot;:&quot;https://donbeck1.substack.com/subscribe?&quot;,&quot;text&quot;:&quot;Subscribe&quot;,&quot;language&quot;:&quot;en&quot;}\\\" data-component-name=\\\"SubscribeWidgetToDOM\\\"><div class=\\\"subscription-widget show-subscribe\\\"><div class=\\\"preamble\\\"><p class=\\\"cta-caption\\\">Thanks for reading The Reading Room! Subscribe for free to receive new posts and support my work.</p></div><form class=\\\"subscription-widget-subscribe\\\"><input type=\\\"email\\\" class=\\\"email-input\\\" name=\\\"email\\\" placeholder=\\\"Type your email\u2026\\\" tabindex=\\\"-1\\\"><input type=\\\"submit\\\" class=\\\"button primary\\\" value=\\\"Subscribe\\\"><div class=\\\"fake-input-wrapper\\\"><div class=\\\"fake-input\\\"></div><div class=\\\"fake-button\\\"></div></div></form></div></div>\",\"has_dynamic_content\":false,\"truncated_body_text\":\"In my last post, I recommended Gene Wolfe\u2019s Book of the New Sun, boldly calling it life-changing.\",\"wordcount\":1156,\"post_preview_limit\":null,\"language\":\"en\",\"postTags\":[{\"id\":\"54ccb4bf-d6c0-49e2-a71e-cd173013ced1\",\"publication_id\":4470358,\"name\":\"fantasy\",\"slug\":\"fantasy\",\"hidden\":false},{\"id\":\"609385c2-3092-4c2f-a3c8-b70aaf282175\",\"publication_id\":4470358,\"name\":\"sci-fi\",\"slug\":\"sci-fi\",\"hidden\":false},{\"id\":\"6f57075f-29ec-467e-b001-ccd574965356\",\"publication_id\":4470358,\"name\":\"Gene Wolfe\",\"slug\":\"gene-wolfe\",\"hidden\":false},{\"id\":\"8dbfdc7a-2b3f-4676-9b8e-b63db40dab43\",\"publication_id\":4470358,\"name\":\"reading\",\"slug\":\"reading\",\"hidden\":false},{\"id\":\"c0408c53-7c09-494e-a8ff-193b04d8e546\",\"publication_id\":4470358,\"name\":\"Book of the New Sun\",\"slug\":\"book-of-the-new-sun\",\"hidden\":false},{\"id\":\"e39f6485-5e00-47b0-a2ed-3d3ee40f9d1a\",\"publication_id\":4470358,\"name\":\"fiction\",\"slug\":\"fiction\",\"hidden\":false},{\"id\":\"f1361501-7f00-4554-9eca-54cd1826f2a8\",\"publication_id\":4470358,\"name\":\"science fiction\",\"slug\":\"science-fiction\",\"hidden\":false},{\"id\":\"f54d40ba-7599-481d-b596-1bfd9a4d2a2c\",\"publication_id\":4470358,\"name\":\"aliens\",\"slug\":\"aliens\",\"hidden\":false},{\"id\":\"fa5dde25-2ea1-4128-8ef1-0d2679e1cdb2\",\"publication_id\":4470358,\"name\":\"writing\",\"slug\":\"writing\",\"hidden\":false}],\"postCountryBlocks\":[],\"headlineTest\":null,\"coverImagePalette\":{\"Vibrant\":{\"rgb\":[179,79,68],\"population\":42},\"DarkVibrant\":{\"rgb\":[76,46,28],\"population\":3},\"LightVibrant\":{\"rgb\":[252,245,224],\"population\":239},\"Muted\":{\"rgb\":[140,110,88],\"population\":400},\"DarkMuted\":{\"rgb\":[85,71,56],\"population\":466},\"LightMuted\":{\"rgb\":[205,197,173],\"population\":210}},\"publishedBylines\":[{\"id\":109040920,\"name\":\"Don Beck\",\"handle\":\"donbeck1\",\"previous_name\":null,\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/4095ae91-6657-42a2-8c35-b3aa89398a5f_810x810.png\",\"bio\":\"Fiction writer. Fiction reader. Fantasy, sci-fi, and lit nerd. Orthodox Christian. I see life for what it truly is--enchanted.\",\"profile_set_up_at\":\"2023-07-01T01:15:22.889Z\",\"reader_installed_at\":\"2023-07-01T13:13:23.479Z\",\"publicationUsers\":[{\"id\":4560220,\"user_id\":109040920,\"publication_id\":4470358,\"role\":\"admin\",\"public\":true,\"is_primary\":true,\"publication\":{\"id\":4470358,\"name\":\"The Reading Room\",\"subdomain\":\"donbeck1\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"Chatting about the wonder of fantasy, science fiction, and classic literature.\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/c2d3542e-7787-4627-beed-5197f26b09f7_600x600.png\",\"author_id\":109040920,\"primary_user_id\":109040920,\"theme_var_background_pop\":\"#FF6719\",\"created_at\":\"2025-03-23T17:11:00.929Z\",\"email_from_name\":\"Don Beck, from The Reading Room\",\"copyright\":\"Don Beck\",\"founding_plan_name\":\"Founding Member\",\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"enabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"magaziney\",\"is_personal_mode\":false,\"logo_url_wide\":\"https://substack-post-media.s3.amazonaws.com/public/images/7b0d0d99-b961-4d5b-bb4c-68b52d565e5b_2100x400.png\"}}],\"is_guest\":false,\"bestseller_tier\":null,\"status\":{\"bestsellerTier\":null,\"subscriberTier\":null,\"leaderboard\":null,\"vip\":false,\"badge\":null,\"subscriber\":null}}],\"reaction\":null,\"reaction_count\":22,\"comment_count\":8,\"child_comment_count\":2,\"audio_items\":[{\"post_id\":165087166,\"voice_id\":\"en-US-OnyxTurboMultilingualNeural\",\"audio_url\":\"https://substack-video.s3.amazonaws.com/video_upload/post/165087166/tts/38410bff-919f-4e0d-a02e-efe5e82f6cec/en-US-OnyxTurboMultilingualNeural.mp3\",\"type\":\"tts\",\"status\":\"completed\"}],\"is_geoblocked\":false,\"hasCashtag\":false},\"comments\":[{\"id\":122884899,\"body\":\"The book of the new sun is the single finest sci-fi/fantasy ever written.\",\"body_json\":{\"type\":\"doc\",\"attrs\":{\"schemaVersion\":\"v1\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The book of the new sun is the single finest sci-fi/fantasy ever written.\"}]}]},\"publication_id\":4470358,\"post_id\":165087166,\"user_id\":58399504,\"ancestor_path\":\"\",\"type\":\"comment\",\"deleted\":false,\"date\":\"2025-06-04T19:20:30.478Z\",\"edited_at\":null,\"status\":\"published\",\"pinned_by_user_id\":null,\"restacks\":0,\"name\":\"Alex\",\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/0b0783ce-cec6-4491-817a-a9eea23a8343_1079x1430.jpeg\",\"handle\":\"alexandrosinla\",\"reactor_names\":[\"Don Beck\"],\"reaction\":null,\"reactions\":{\"\u2764\":2},\"reaction_count\":2,\"children\":[],\"bans\":[],\"suppressed\":false,\"user_banned\":false,\"user_banned_for_comment\":false,\"user_slug\":\"alexandrosinla\",\"metadata\":{\"is_author\":false,\"membership_state\":null,\"eligibleForGift\":true,\"author_on_other_pub\":{\"name\":\"Alex\u2019s Substack\",\"id\":2803697,\"base_url\":\"https://jafrank09.substack.com\"}},\"user_bestseller_tier\":null,\"can_dm\":true,\"userStatus\":null,\"score\":7,\"children_count\":0,\"reported_by_user\":false,\"restacked\":false},{\"id\":122482458,\"body\":\"Although Severian says he remembers everything, Wolfe is careful revealing this power. Severian does recall events or people like Howard Cosell. I think, based on interviews I have read with Wolfe, he wanted to provide the reader confidence that the imperfect narratation of the first person was going to be pretty much perfect. Knowing Severian has this power, we trust his recollections. Smart guy, Wolfe.\",\"body_json\":{\"type\":\"doc\",\"attrs\":{\"schemaVersion\":\"v1\"},\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Although Severian says he remembers everything, Wolfe is careful revealing this power. Severian does recall events or people like Howard Cosell. I think, based on interviews I have read with Wolfe, he wanted to provide the reader confidence that the imperfect narratation of the first person was going to be pretty much perfect. Knowing Severian has this power, we trust his recollections. Smart guy, Wolfe.\"}]}]},\"publication_id\":4470358,\"post_id\":165087166,\"user_id\":45645281,\"ancestor_path\":\"\",\"type\":\"comment\",\"deleted\":false,\"date\":\"2025-06-03T13:07:55.799Z\",\"edited_at\":null,\"status\":\"published