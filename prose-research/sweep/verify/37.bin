, 103, 25, 0.2)\",\"color_theme_bg_pop_30\":\"rgba(255, 103, 25, 0.3)\",\"print_pop\":\"#ff6719\",\"color_theme_accent\":\"#ff6719\",\"cover_print_primary\":\"#ffffff\",\"cover_print_secondary\":\"#d9d9d9\",\"cover_print_tertiary\":\"#d9d9d9\",\"cover_border_color\":\"#ffffff\",\"font_family_headings_preset\":\"Lora,sans-serif\",\"font_weight_headings_preset\":600,\"font_family_body_preset\":\"Lora,sans-serif\",\"font_weight_body_preset\":400,\"font_size_body_offset\":\"1px\",\"font_preset_heading\":\"fancy_serif\",\"font_preset_body\":\"fancy_serif\",\"home_hero\":\"feature\",\"home_posts\":\"grid\",\"home_show_top_posts\":true,\"web_bg_color\":\"#1d1d1d\",\"background_contrast_1\":\"#2b2b2b\",\"background_contrast_2\":\"#3c3c3c\",\"background_contrast_3\":\"#5d5d5d\",\"background_contrast_4\":\"#7d7d7d\",\"background_contrast_5\":\"#b8b8b8\",\"color_theme_bg_contrast_1\":\"#2b2b2b\",\"color_theme_bg_contrast_2\":\"#3c3c3c\",\"color_theme_bg_contrast_3\":\"#5d5d5d\",\"color_theme_bg_contrast_4\":\"#7d7d7d\",\"color_theme_bg_contrast_5\":\"#b8b8b8\",\"color_theme_bg_elevated\":\"#2b2b2b\",\"color_theme_bg_elevated_secondary\":\"#3c3c3c\",\"color_theme_bg_elevated_tertiary\":\"#5d5d5d\",\"color_theme_detail\":\"#343434\",\"background_contrast_pop\":\"rgba(255, 103, 25, 0.4)\",\"color_theme_bg_contrast_pop\":\"rgba(255, 103, 25, 0.4)\",\"theme_bg_is_dark\":\"1\",\"print_on_web_bg_color\":\"#ffffff\",\"print_secondary_on_web_bg_color\":\"#a5a5a5\",\"background_pop_rgb\":\"255, 103, 25\",\"color_theme_bg_pop_rgb\":\"255, 103, 25\",\"color_theme_accent_rgb\":\"255, 103, 25\"},\"recentEpisodes\":null,\"trackFrontendVisit\":true,\"activeLiveStream\":null,\"freeTrialCoupon\":{\"id\":\"06c9d312\",\"trial_period_days\":7},\"defaultCoupon\":null,\"isChatActive\":false,\"publicationPageAlert\":null,\"features\":{},\"browser\":{\"name\":\"WebKit\",\"version\":\"537.36\",\"major\":\"537\"},\"showCookieBanner\":false,\"disabledCookies\":[],\"dd_env\":\"prod\",\"dd_ti\":true}")</sc